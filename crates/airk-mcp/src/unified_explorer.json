[
  {
    "name": "airk_explorer_help_search",
    "description": "Search offline Explorer and AIRK engine guidance for this version: Developer, Tester, Architect, Writer workflows, indexing choices, document types, OCR, tools and UX. Returns topic ids for airk_explorer_help_get; check applicability before directing a user to a screen.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "area": {
          "type": "string",
          "enum": [
            "about",
            "engine",
            "explorer",
            "guidance",
            "management",
            "roles",
            "strategies"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 5
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 512,
          "maximum": 32768,
          "default": 4096
        }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "airk_explorer_help_get",
    "description": "Read one AIRK Explorer help topic by id: where it is in the UI, ordered steps, applicability for this installed version and related airk_help topics on AIRK Retrieval.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic_id"
      ],
      "properties": {
        "topic_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{2,63}$"
        },
        "detail": {
          "type": "string",
          "enum": [
            "summary",
            "steps",
            "full"
          ],
          "default": "full"
        }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "airk_explorer_ui_status",
    "description": "Report whether a trusted AIRK Explorer window is attached for this working directory, its binding fingerprint and draft revisions, the screens this version ships and the schema versions. Returns no paths or source content.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "airk_explorer_suggest_search",
    "description": "Propose a Search › Query form (lexical, vector or hybrid; literal path prefix; limit; byte budget). The user decides whether to run it. The draft goes to the Suggestions Inbox of the attached Explorer window and waits for the user; nothing is applied, saved or run. Bodies are limited to 16384 bytes; unknown fields are refused.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "idempotency_key",
        "title",
        "draft"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "description": "Reuse it to retry; the same key with a different body is refused."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "expected_target_revision": {
          "type": "integer",
          "minimum": 0,
          "description": "Target draft revision from airk_explorer_ui_status target_revisions."
        },
        "workspace_binding": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$",
          "description": "binding_fingerprint from airk_explorer_ui_status."
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "publication"
          ],
          "properties": {
            "publication": {
              "type": "string",
              "maxLength": 256,
              "description": "Exact AIRK publication token the evidence came from."
            },
            "citations": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "start_line"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "start_line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "end_line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "content_hash": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          }
        },
        "draft": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "query"
          ],
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "mode": {
              "type": "string",
              "enum": [
                "policy",
                "lexical",
                "vector",
                "hybrid"
              ],
              "default": "lexical"
            },
            "path_prefix": {
              "type": "string",
              "maxLength": 1024
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "max_bytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65536
            },
            "full_chunks": {
              "type": "boolean"
            }
          }
        },
        "intent": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "airk_explorer_suggest_strategy",
    "description": "Propose a Strategies › Studio draft from a core template (template_id such as airk.core/bug) and/or custom steps. Steps use only these operators: airk.status, airk.capabilities, airk.search, airk.listFiles, airk.fileInfo, airk.symbols, airk.imports, airk.codeFacts, airk.relationships, airk.references, airk.documentFacts, airk.outline, airk.readFile, airk.changes, host.hashSavedFiles, core.dedupe, core.sort, core.clip, core.cite, core.renderPrompt; arguments bind only ${params.NAME} and ${scope.pathPrefix}, and fan-out steps name an earlier step as input. The draft goes to the Suggestions Inbox of the attached Explorer window and waits for the user; nothing is applied, saved or run. Bodies are limited to 16384 bytes; unknown fields are refused.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "idempotency_key",
        "title"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "description": "Reuse it to retry; the same key with a different body is refused."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "expected_target_revision": {
          "type": "integer",
          "minimum": 0,
          "description": "Target draft revision from airk_explorer_ui_status target_revisions."
        },
        "workspace_binding": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$",
          "description": "binding_fingerprint from airk_explorer_ui_status."
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "publication"
          ],
          "properties": {
            "publication": {
              "type": "string",
              "maxLength": 256,
              "description": "Exact AIRK publication token the evidence came from."
            },
            "citations": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "start_line"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "start_line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "end_line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "content_hash": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          }
        },
        "template_id": {
          "type": "string",
          "pattern": "^airk\\.core/[a-z][a-z0-9-]*$"
        },
        "objective": {
          "type": "string",
          "maxLength": 4000
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 512
          },
          "maxProperties": 8
        },
        "path_prefix": {
          "type": "string",
          "maxLength": 1024
        },
        "steps": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "op",
              "args"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,31}$"
              },
              "op": {
                "type": "string",
                "enum": [
                  "airk.status",
                  "airk.capabilities",
                  "airk.search",
                  "airk.listFiles",
                  "airk.fileInfo",
                  "airk.symbols",
                  "airk.imports",
                  "airk.codeFacts",
                  "airk.relationships",
                  "airk.references",
                  "airk.documentFacts",
                  "airk.outline",
                  "airk.readFile",
                  "airk.changes",
                  "host.hashSavedFiles",
                  "host.gitDiff",
                  "host.readSavedText",
                  "core.dedupe",
                  "core.sort",
                  "core.clip",
                  "core.cite",
                  "core.renderPrompt"
                ]
              },
              "args": {
                "type": "object"
              },
              "input": {
                "type": "string"
              }
            }
          }
        },
        "evidence_budget_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 262144
        }
      }
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
