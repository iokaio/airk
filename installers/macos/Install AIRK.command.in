#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
# AIRK Service @@VERSION@@ for macOS @@ARCH@@ (split plan section 9). Per user;
# no administrator password. Verifies the disk image payload (pinned digests and
# the Developer ID signature) before any native program runs, places
# AIRK.app, notices/ and payload-inventory.json in the program folder and hands
# every other step to the bundled airk's private setup role through one
# airk-setup-operation/1 file. Interactive login startup uses SMAppService and
# may require System Settings approval. When ~/.local/bin exists it adds one receipt-owned airkctl
# link there; no shell startup file is edited.
set -euo pipefail
umask 077
# Native images are verified; standard tools resolve only from OS-owned locations.
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH
export LC_ALL=C

version='@@VERSION@@'
inventory_sha256='@@INVENTORY_SHA256@@'
roster_sha256='@@PAYLOAD_SUMS_SHA256@@'
airk_sha256='@@AIRK_SHA256@@'
file_count='@@PAYLOAD_FILE_COUNT@@'
requirement='=anchor apple generic and certificate leaf[subject.OU] = "@@TEAM_ID@@" and certificate leaf[field.1.2.840.113635.100.6.1.13] exists'
airk_relative='AIRK.app/Contents/MacOS/airk'
airkctl_relative='AIRK.app/Contents/MacOS/airkctl'

fail() { printf 'AIRK installer: %s\n' "$*" >&2; exit 1; }

program='' data='' state='' cache='' logs='' resume=''
overrides=false
acknowledged=false unattended=false start=true login=true
while [[ $# -gt 0 ]]; do
    case $1 in
        --resume)
            [ $# -ge 2 ] || fail "--resume needs the absolute original operation-request.json."
            [ -z "$resume" ] || fail "--resume may be supplied only once."
            resume=$2; shift 2; continue ;;
        --program-dir|--data-dir|--state-dir|--cache-dir|--logs-dir)
            overrides=true
            [[ $# -ge 2 ]] || fail "$1 needs a folder."
            name=${1#--}; name=${name%-dir}; printf -v "$name" '%s' "$2"; shift 2 ;;
        --program-dir=*|--data-dir=*|--state-dir=*|--cache-dir=*|--logs-dir=*)
            overrides=true
            name=${1%%=*}; name=${name#--}; name=${name%-dir}; printf -v "$name" '%s' "${1#*=}"; shift ;;
        --acknowledge-reset) overrides=true; acknowledged=true; shift ;;
        --silent|--yes) unattended=true; shift ;;
        --no-login-startup) overrides=true; login=false; shift ;;
        --no-start) overrides=true; start=false; shift ;;
        -h|--help)
            printf '%s\n' 'Options: --resume ORIGINAL-REQUEST (no overrides), --program-dir, --data-dir, --state-dir, --cache-dir, --logs-dir DIR;' \
                '--acknowledge-reset (unattended, when earlier AIRK installations are found); --silent (or --yes); --no-login-startup; --no-start.'
            exit 0 ;;
        *) fail "unknown option $1 (see --help)." ;;
    esac
done

if [ -n "$resume" ]; then
    [ "$overrides" = false ] || fail '--resume takes original options and locations; overrides are forbidden.'
    case $resume in /?*) ;; *) fail '--resume requires an absolute original request path.' ;; esac
    [ -f "$resume" ] && [ ! -L "$resume" ] || fail 'the original recovery request is missing or linked.'
fi

[[ "$(/usr/bin/uname -m)" == "@@ARCH@@" ]] || fail 'this installer is for @@ARCH@@ Macs. Download the installer for your Mac.'

# ---------- Verify the disk image before the first native execution ----------
installer_dir="$(cd "$(/usr/bin/dirname "$0")" && pwd -P)"
cd "$installer_dir"
sum() { /usr/bin/shasum -a 256 "$1" | { read -r digest _; printf '%s' "$digest"; }; }
[[ -f payload.sha256 && ! -L payload.sha256 && -d payload && ! -L payload ]] \
    || fail 'the payload is missing or linked. Download a fresh installer.'
[[ "$(sum payload.sha256)" == "$roster_sha256" ]] || fail 'the payload checksum roster changed. Download a fresh installer.'
unsafe=$(/usr/bin/find payload \( -type l -o \( ! -type f ! -type d \) -o \( -type f -links +1 \) \) -print | /usr/bin/head -n 1)
[[ -z "$unsafe" ]] || fail "the payload contains a linked or special file: $unsafe"
count=$(/usr/bin/find payload -type f -print | /usr/bin/wc -l | /usr/bin/tr -d '[:space:]')
[[ "$count" == "$file_count" ]] || fail 'the payload file roster changed. Download a fresh installer.'
/usr/bin/shasum -a 256 -c -s payload.sha256 || fail 'payload bytes differ from this installer. Download a fresh installer.'
[[ "$(sum payload/payload-inventory.json)" == "$inventory_sha256" ]] || fail 'the payload inventory differs from this installer.'
[[ "$(sum "payload/$airk_relative")" == "$airk_sha256" ]] || fail 'the bundled AIRK service image changed.'
/usr/bin/codesign --verify --strict -R "$requirement" payload/AIRK.app \
    || fail 'AIRK.app does not carry the expected Developer ID signature.'

# ---------- Locations (U39) ----------
home=${HOME:-}
[[ $home == /?* ]] || fail 'the home folder of this account could not be determined.'
work=$(/usr/bin/mktemp -d "$home/.airk-setup-recovery.XXXXXXXXXX") || fail 'no temporary folder.'
trap 'printf "AIRK setup recovery: %s\nOriginal request: %s\n" "$work" "${recovery_request:-${operation:-$resume}}" >&2' EXIT
/bin/cp -R payload/AIRK.app "$work/AIRK.app"
/usr/bin/codesign --verify --strict -R "$requirement" "$work/AIRK.app" || fail 'the retained setup bundle failed signature verification.'
image="$work/$airk_relative"
[[ "$(sum "$image")" == "$airk_sha256" ]] || fail 'the retained setup image changed.'

# Native validates canonical original custody, admitted ownership and actual roots.
# Its scalar output is data, never shell code; the wrapper does not decode I4.
recovery_field() {
    "$image" __airk_role setup --operation "$resume" --recovery-field "$1" 2>"$work/setup.err"
}
# Command substitution removes trailing LF; a success-only suffix preserves
# the native scalar exactly, including any suffix already present in a root.
recovery_location() {
    case $1 in program|data|state|cache|logs) ;; *) return 64 ;; esac
    recovery_scalar=$(recovery_field "$1" && printf '.') || return "$?"
    case $1 in
        program) program=${recovery_scalar%.} ;;
        data) data=${recovery_scalar%.} ;;
        state) state=${recovery_scalar%.} ;;
        cache) cache=${recovery_scalar%.} ;;
        logs) logs=${recovery_scalar%.} ;;
    esac
}

lease_wrapper() {
    held=$("$image" __airk_role setup --operation "$1" --recovery-field wrapper-lease-held 2>"$work/setup.err") || fail 'the original wrapper lease could not be reviewed.'
    case $held in
        true) return 0 ;;
        false)
            if [ "$unattended" = true ]; then
                exec "$image" __airk_role setup --operation "$1" --wrapper-lease-script "$installer_dir/Install AIRK.command" --wrapper-silent
            fi
            exec "$image" __airk_role setup --operation "$1" --wrapper-lease-script "$installer_dir/Install AIRK.command" ;;
        *) fail 'invalid native wrapper lease observation.' ;;
    esac
}
placement_required=true completion_required=true
if [ -n "$resume" ]; then
    recovery_kind=$(recovery_field kind) || fail 'original operation kind was refused.'
    recovery_requester=$(recovery_field requested-by) || fail 'original operation requester was refused.'
    case $recovery_kind in
        install|repair|upgrade) [ "$recovery_requester" = "dmg" ] || fail 'this request belongs to a different installer.' ;;
        uninstall|purge) [ "$recovery_requester" = airkctl ] || fail 'removal belongs to a different native owner.' ;;
        *) fail 'unsupported original operation kind.' ;;
    esac
    [ "$(recovery_field inventory-sha256)" = "$inventory_sha256" ] || fail 'resume requires the exact original installer payload.'
    recovery_location program || fail 'original program custody was refused.'
    recovery_location data || fail 'original data custody was refused.'
    recovery_location state || fail 'original state custody was refused.'
    recovery_location cache || fail 'original cache custody was refused.'
    recovery_location logs || fail 'original logs custody was refused.'
    case $recovery_kind in
        uninstall|purge)
            lease_wrapper "$resume"
            completion_required=$(recovery_field completion-required) || fail 'original removal state could not be reconciled.'
            case $completion_required in true|false) ;; *) fail 'invalid native removal observation.' ;; esac
            if [ "$completion_required" = true ]; then
                "$image" __airk_role setup --operation "$resume" >"$work/setup.out" 2>"$work/setup.err" || fail 'original removal did not complete; preserve the original request and recovery image.'
                cat "$work/setup.out"
            fi
            printf '%s\n' 'Original native removal completed; retained diagnostics are preserved.'
            exit 0 ;;
    esac
    placement_required=$(recovery_field placement-required) || fail 'original operation state could not be reconciled.'
    case $placement_required in true|false) ;; *) fail 'invalid native recovery observation.' ;; esac
    completion_required=$(recovery_field completion-required) || fail 'original native completion could not be reconciled.'
    case $completion_required in true|false) ;; *) fail 'invalid native completion observation.' ;; esac
    [ "$placement_required" = false ] || [ "$completion_required" = true ] || fail 'native placement/completion observation conflicts.'
    if [ "$completion_required" = true ] && [ "$unattended" = true ]; then
        [ "$(recovery_field trust)" = skip ] || fail 'the original request requires consent; resume interactively without --silent.'
    fi
    id=$(recovery_field operation-id) || fail 'original operation identity was refused.'
fi

support="$home/Library/Application Support/AIRK"
d_program="$support/program"
d_data="$support/data/indexes"
d_state="$support/state/service"
d_cache="$home/Library/Caches/AIRK/service"
d_logs="$home/Library/Logs/AIRK/service"
field() { printf '%s\n' "$2" | /usr/bin/sed -n 's/.*"'"$1"'":"\([^"\\]*\)".*/\1/p' | /usr/bin/head -n 1; }
pointer="$support/install-pointer/current.json"
if [[ -f $pointer && ! -L $pointer ]]; then
    previous=$(field program "$(/usr/bin/head -c 4096 "$pointer")")
    if [[ -n $previous && -f $previous/install-record.json && ! -L $previous/install-record.json ]]; then
        located=$(/usr/bin/head -c 65536 "$previous/install-record.json" | /usr/bin/sed -n 's/.*"locations":{\([^}]*\)}.*/\1/p')
        if [[ -n $located ]]; then
            d_program=$previous
            for role in data state cache logs; do
                found=$(field "$role" "$located")
                [[ -z $found ]] || printf -v "d_$role" '%s' "$found"
            done
        fi
    fi
fi
interactive=false
if [[ $unattended == false && -t 0 ]]; then interactive=true; fi
# No login registration or consent is implied by a headless install.
[[ $interactive == true ]] || login=false
ask() {
    local answer=''
    if [[ $interactive == true ]]; then read -r -p "$2 [$3]: " answer || answer=''; fi
    printf -v "$1" '%s' "${answer:-$3}"
}
[[ -n $program ]] || ask program 'Program folder' "$d_program"
[[ -n $data ]] || ask data 'Index data' "$d_data"
[[ -n $state ]] || state=$d_state
[[ -n $cache ]] || ask cache 'Cache' "$d_cache"
[[ -n $logs ]] || ask logs 'Logs' "$d_logs"
for role in program data state cache logs; do
    value=${!role}
    while [[ $value != / && $value == */ ]]; do value=${value%/}; done
    [[ $value == /?* ]] || fail "the $role location must be an absolute folder: $value"
    case $value in *[[:cntrl:]]*) fail "the $role location contains a control character: $value" ;; esac
    printf -v "$role" '%s' "$value"
done

# ---------- Setup operations (airk-setup-operation/1) ----------

# Keep ordinary UTF-8 literal; native Core rejects malformed Unicode.
# Controls were refused above. Escape the two remaining JSON metacharacters.
json_path() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
j_program=$(json_path "$program")
j_data=$(json_path "$data")
j_state=$(json_path "$state")
j_cache=$(json_path "$cache")
j_logs=$(json_path "$logs")
sequence=0
write_operation() { # kind acknowledged login trust start
    sequence=$((sequence + 1))
    folder="$work/operation-$sequence"
    /bin/mkdir -m 700 "$folder"
    /bin/cp payload/payload-inventory.json "$folder/payload-inventory.json"
    local id created
    id=$(/usr/bin/od -An -N16 -tx1 /dev/urandom | /usr/bin/tr -d ' \n')
    [[ ${#id} -eq 32 ]] || fail 'could not create an operation identity.'
    created=$(( $(/bin/date +%s) * 1000 ))
    operation="$folder/operation.json"
    printf '{"schema":"airk-setup-operation/1","operation_id":"%s","kind":"%s","created_unix_ms":%s,"expires_unix_ms":%s,"requested_by":"dmg","acknowledgements":{"predecessor_removal":%s,"index_reset":%s},"locations":{"program":"%s","data":"%s","state":"%s","cache":"%s","logs":"%s"},"payload_inventory_sha256":"%s","options":{"login_startup":%s,"trust":"%s","start":%s,"delete_indexes":"keep"}}\n' \
        "$id" "$1" "$created" "$((created + 600000))" "$2" "$2" \
        "$j_program" "$j_data" "$j_state" "$j_cache" "$j_logs" "$inventory_sha256" "$3" "$4" "$5" > "$operation"
    /bin/cp "$operation" "$folder/operation-request.json"
    recovery_request="$folder/operation-request.json"
}
run_setup() { # image [mode]
    "$1" __airk_role setup --operation "$operation" ${2:+"$2"} >"$work/setup.out" 2>"$work/setup.err"
}
setup_failure() {
    if [[ -s $folder/error.txt ]]; then /bin/cat "$folder/error.txt" >&2; else /bin/cat "$work/setup.err" >&2; fi
}


if [ -n "$resume" ]; then
    operation=$resume
    folder=$(dirname -- "$operation")
    recovery_request="$folder/operation-request.json"
    lease_wrapper "$operation"
    if [ "$placement_required" = true ]; then
        run_setup "$image" --prepare || { setup_failure; fail 'original setup could not resume preparation; nothing was placed.'; }
    fi
else
write_operation install false false skip false
run_setup "$image" --plan || { setup_failure; fail 'setup could not review this installation.'; }
plan=$(/bin/cat "$folder/plan.json")
/usr/bin/tr -d '\r' < "$folder/plan.txt"
[[ $plan == *'"location_problems":[]'* ]] || fail 'choose other locations (see above).'
[[ $plan == *'"blockers":[]'* ]] || fail 'resolve the native setup blockers before installation (see above).'
needs_acknowledgement=false
[[ $plan != *'"removed":true'* ]] || needs_acknowledgement=true
printf 'AIRK Service %s will be installed in %s\n' "$version" "$program"
if [[ $needs_acknowledgement == true && $acknowledged == false ]]; then
    [[ $interactive == true ]] \
        || fail 'pass --acknowledge-reset to confirm that earlier AIRK installations and their indexes are removed.'
    read -r -p 'Type "yes" to remove the earlier AIRK installations and their indexes: ' reply || reply=''
    [[ $reply == yes ]] || fail 'cancelled; nothing was changed.'
    acknowledged=true
fi

# Retirement and the drain run before any file is replaced (section 9.6).
trust=skip
[[ $interactive == false ]] || trust=ask
write_operation install "$acknowledged" "$login" "$trust" "$start"
lease_wrapper "$operation"
run_setup "$image" --prepare || { setup_failure; fail 'setup did not prepare the installation; nothing was placed.'; }

fi

# ---------- Place AIRK.app, notices/ and the inventory ----------
# The bundle is replaced whole so no file of an earlier build stays inside its
# seal; setup --prepare has verified that the program folder is empty or this
# installation's.
place() { # every step checked: errexit does not apply inside a || list
    umask 022
    /bin/mkdir -p "$program" || return 1
    # A prior interrupted staging directory is retained, never adopted or deleted.
    incoming=$(/usr/bin/mktemp -d "$program/.AIRK.app.XXXXXXXXXX") || return 1
    /usr/bin/ditto payload/AIRK.app "$incoming" || return 1
    if [[ -e $program/AIRK.app || -L $program/AIRK.app ]]; then
        [[ ! -e $work/previous-AIRK.app && ! -L $work/previous-AIRK.app ]] || return 1
        /bin/mv "$program/AIRK.app" "$work/previous-AIRK.app" || return 1
    fi
    /bin/mv "$incoming" "$program/AIRK.app" || return 1
    while read -r _ path; do
        relative=${path#payload/}
        [[ $relative == AIRK.app/* ]] && continue
        /bin/mkdir -p "$(/usr/bin/dirname "$program/$relative")" \
            || return 1
        temporary=$(/usr/bin/mktemp "$program/$relative.airk-new.XXXXXXXXXX") || return 1
        /bin/cp "$path" "$temporary" && /bin/chmod 644 "$temporary" \
            && /bin/mv -f "$temporary" "$program/$relative" \
            || { /bin/rm -f "$temporary"; return 1; }
    done < payload.sha256
}
if [ "$placement_required" = true ]; then
( place ) || fail "files could not be placed in $program; preserve the reported recovery folder and check service status before recovery."
[[ "$(sum "$program/$airk_relative")" == "$airk_sha256" ]] || fail 'the installed service image changed; its files were preserved.'
fi
if [ "$completion_required" = true ]; then
if ! run_setup "$image"; then
    setup_failure
    fail 'AIRK Service files are installed, but setup did not complete. Run "airkctl service status"; preserve the reported recovery folder and check service status before recovery.'
fi
/bin/cat "$work/setup.out"

fi

# ---------- airkctl on PATH: one receipt-owned link, no shell startup edits ----------
airkctl="$program/$airkctl_relative"
link="$home/.local/bin/airkctl"
receipt="$program/airkctl-link-owner.txt"
if [[ -d $home/.local/bin && ! -L $home/.local/bin ]]; then
    if [[ -L $link && "$(/usr/bin/readlink "$link")" == "$airkctl" ]]; then
        [[ -f $receipt ]] || printf '%s already links to %s; it is not claimed by this installation.\n' "$link" "$airkctl"
    elif [[ -e $link || -L $link ]]; then
        printf '%s exists and was left unchanged. airkctl is %s\n' "$link" "$airkctl"
    else
        printf 'airk-airkctl-link/1\n%s\n%s\n' "$link" "$airkctl" > "$receipt"
        /bin/ln -s "$airkctl" "$link" || { /bin/rm -f "$receipt"; printf 'airkctl is %s\n' "$airkctl"; }
    fi
else
    printf 'airkctl is %s (add its folder to PATH yourself; no shell startup file was changed).\n' "$airkctl"
fi
printf 'AIRK Service %s is installed. Run "airkctl service status" to inspect startup; start it with "airkctl service start" when needed.\n' "$version"
