{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "skipLibCheck": false,
    "noEmit": true,
    "types": []
  },
  "include": [
    "src/explorerWebview/**/*.ts",
    "src/explorerWebview/**/*.tsx",
    "src/explorerContracts.ts",
    "src/explorerRoutes.ts",
    "src/explorerFeatures.ts",
    "src/explorerErrors.ts",
    "src/explorerStatus.ts"
  ]
}
