{
  "name": "airk",
  "displayName": "AIRK — Artifact Indexing and Retrieval Kernel (beta)",
  "description": "Pre-release beta: local collection indexing and specialized MCP evidence for coding agents, with a bundled native helper.",
  "version": "0.1.0",
  "publisher": "iokaio",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/iokaio/airk.git" },
  "engines": { "vscode": "^1.140.0" },
  "categories": ["Other"],
  "main": "./out/extension.js",
  "files": ["out/*.js", "native/**", "images/*.png", "images/*.svg", "LICENSE", "NOTICE", "THIRD_PARTY_NOTICES.md", "README.md"],
  "extensionKind": ["workspace"],
  "activationEvents": ["onStartupFinished", "onMcpServerDefinitionProvider:airk.collections"],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": { "supported": "limited", "description": "AIRK requires workspace trust before starting its native helper or indexing files." }
  },
  "contributes": {
    "mcpServerDefinitionProviders": [{ "id": "airk.collections", "label": "AIRK workspace collections" }],
    "viewsContainers": { "activitybar": [{ "id": "airk", "title": "AIRK", "icon": "images/airk.svg" }] },
    "views": { "airk": [{ "id": "airk.collectionsView", "name": "Collections" }] },
    "menus": {
      "view/title": [{ "command": "airk.treeRefresh", "when": "view == airk.collectionsView", "group": "navigation" }],
      "view/item/context": [
        { "command": "airk.treeIndex", "when": "view == airk.collectionsView && viewItem == airkActiveCollection", "group": "inline@1" },
        { "command": "airk.treeReindex", "when": "view == airk.collectionsView && viewItem == airkActiveCollection", "group": "inline@2" },
        { "command": "airk.treePause", "when": "view == airk.collectionsView && viewItem == airkActiveCollection", "group": "inline@3" },
        { "command": "airk.treeRemove", "when": "view == airk.collectionsView && viewItem == airkInactiveCollection", "group": "inline@1" }
      ]
    },
    "commands": [
      { "command": "airk.treeRefresh", "title": "AIRK: Refresh Collections", "icon": "$(refresh)" },
      { "command": "airk.treeIndex", "title": "AIRK: Index Collection", "icon": "$(run)" },
      { "command": "airk.treeReindex", "title": "AIRK: Reindex Collection from View", "icon": "$(sync)" },
      { "command": "airk.treePause", "title": "AIRK: Pause All Auto-indexing", "icon": "$(debug-pause)" },
      { "command": "airk.treeRemove", "title": "AIRK: Remove Inactive Collection", "icon": "$(trash)" },
      { "command": "airk.menu", "title": "AIRK: Open Controls" },
      { "command": "airk.index", "title": "AIRK: Index Now" },
      { "command": "airk.reindex", "title": "AIRK: Reindex Collection" },
      { "command": "airk.indexMode", "title": "AIRK: Choose Indexing Mode" },
      { "command": "airk.pause", "title": "AIRK: Pause Auto-indexing" },
      { "command": "airk.resume", "title": "AIRK: Resume Auto-indexing" },
      { "command": "airk.chooseStorage", "title": "AIRK: Choose Index Storage Folder" },
      { "command": "airk.collections", "title": "AIRK: Manage Collections and Disk Space" },
      { "command": "airk.removeCollection", "title": "AIRK: Remove Unneeded Collection" },
      { "command": "airk.prune", "title": "AIRK: Trim Obsolete Index Generations" },
      { "command": "airk.retention", "title": "AIRK: Show Retention Status" },
      { "command": "airk.retentionPolicy", "title": "AIRK: Choose Retention Policy" },
      { "command": "airk.retentionRun", "title": "AIRK: Run Retention Maintenance" },
      { "command": "airk.history", "title": "AIRK: Show History Status" },
      { "command": "airk.historyPolicy", "title": "AIRK: Choose History Policy" },
      { "command": "airk.historyRun", "title": "AIRK: Run History Maintenance" },
      { "command": "airk.historyAvailable", "title": "AIRK: List Retained Publication Identities" },
      { "command": "airk.checkpoints", "title": "AIRK: Show Checkpoints" },
      { "command": "airk.createCheckpoint", "title": "AIRK: Create Checkpoint" },
      { "command": "airk.removeCheckpoint", "title": "AIRK: Remove Checkpoint" },
      { "command": "airk.purgeHistory", "title": "AIRK: Preview Logical History Purge" },
      { "command": "airk.extractionPolicy", "title": "AIRK: Show Extraction Policy" },
      { "command": "airk.configureExtractionPolicy", "title": "AIRK: Configure Extraction Policy" },
      { "command": "airk.status", "title": "AIRK: Show Collection Status" },
      { "command": "airk.usage", "title": "AIRK: Show Local Usage and Estimated Savings" },
      { "command": "airk.setupAgent", "title": "AIRK: Set Up Coding Agent" },
      { "command": "airk.verifyMcp", "title": "AIRK: Verify Native MCP Connection" },
      { "command": "airk.logs", "title": "AIRK: Show Output" }
    ],
    "configuration": {
      "title": "AIRK",
      "properties": {
        "airk.storage.path": { "type": "string", "default": "", "scope": "machine", "description": "Absolute index folder on this extension host. Empty uses per-user extension storage. Changing it preserves old indexes and indexes the current workspace in the new location." },
        "airk.storage.maxBytes": { "type": "number", "default": 0, "minimum": 0, "scope": "machine", "description": "Soft collection-state budget in bytes. Zero disables it. Automatic indexing pauses at the budget; manual indexing can exceed it. No collection is deleted automatically." },
        "airk.index.mode": { "type": "string", "enum": ["manual", "onSave", "debounced", "idle"], "default": "debounced", "scope": "window", "description": "Manual, after saves, after filesystem edits settle, or after editor activity settles." },
        "airk.index.quietMs": { "type": "number", "default": 2000, "minimum": 250, "maximum": 60000, "scope": "window", "description": "Quiet period after filesystem edits for debounced indexing." },
        "airk.index.idleMs": { "type": "number", "default": 10000, "minimum": 1000, "maximum": 300000, "scope": "window", "description": "Required absence of editor activity in idle mode." },
        "airk.index.maxDelayMs": { "type": "number", "default": 30000, "minimum": 1000, "maximum": 300000, "scope": "window", "description": "Maximum batching delay for debounced/on-save changes, subject to minimum interval and pause/budget controls." },
        "airk.index.minIntervalMs": { "type": "number", "default": 5000, "minimum": 0, "maximum": 300000, "scope": "window", "description": "Minimum interval between automatic indexing jobs. Jobs run serially in each extension host." }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test out/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/vscode": "1.140.0",
    "@vscode/vsce": "4.0.0",
    "typescript": "5.9.3"
  }
}
