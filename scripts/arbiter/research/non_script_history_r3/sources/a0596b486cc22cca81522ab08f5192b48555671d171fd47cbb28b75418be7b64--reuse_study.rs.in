//! Synthetic duplicate-computation census. No production result is reused.
use super::*;
use std::collections::VecDeque;

#[derive(Debug, Default)]
struct Census {
    parse_calls: u64,
    successful: u64,
    failed: u64,
    potential_exact_repeats: u64,
    admitted_key_misses: u64,
    evicted_keys: u64,
    input_bytes: u64,
    encoded_output_bytes: u64,
    parser_wall_ns: u128,
    census_wall_ns: u128,
    peak_key_capacity_bytes: usize,
}
fn census(inputs: &[String]) -> Result<Census> {
    ensure!(
        inputs.len() <= 4096 && inputs.iter().all(|input| input.len() <= 4096),
        "study input bound"
    );
    let mut result = Census::default();
    // Only successful exact input keys are retained for a capacity-only upper
    // bound. No output, failure, plan, publication, query vector or receipt cache.
    let mut recent = VecDeque::<String>::with_capacity(16);
    for input in inputs {
        let started = Instant::now();
        let parsed = parse_text(input);
        result.parser_wall_ns += started.elapsed().as_nanos();
        result.parse_calls += 1;
        result.input_bytes += input.len() as u64;
        match parsed {
            Ok(value) => {
                result.successful += 1;
                result.encoded_output_bytes += serde_json::to_vec(&value)?.len() as u64;
                let started = Instant::now();
                if let Some(position) = recent.iter().position(|key| key == input) {
                    let key = recent.remove(position).expect("known position");
                    recent.push_back(key);
                    result.potential_exact_repeats += 1;
                } else {
                    if recent.len() == 16 {
                        recent.pop_front();
                        result.evicted_keys += 1;
                    }
                    recent.push_back(input.clone());
                    result.admitted_key_misses += 1;
                }
                result.census_wall_ns += started.elapsed().as_nanos();
                result.peak_key_capacity_bytes = result
                    .peak_key_capacity_bytes
                    .max(recent.iter().map(String::capacity).sum());
            }
            Err(_) => {
                result.failed += 1;
            }
        }
    }
    Ok(result)
}

#[test]
fn duplicate_census_keeps_exact_input_and_does_not_reuse_parse_outcomes() -> Result<()> {
    let inputs = [
        "/search term",
        "/search  term",
        "/search term",
        "/search \"雪\"",
        "/search \"雪\"",
        "/search query --shell bad",
        "/search query --shell bad",
    ]
    .into_iter()
    .map(str::to_owned)
    .collect::<Vec<_>>();
    let measured = census(&inputs)?;
    assert_eq!(measured.parse_calls, inputs.len() as u64);
    assert_eq!(measured.successful, 5);
    assert_eq!(measured.failed, 2);
    assert_eq!(measured.potential_exact_repeats, 2);
    assert_eq!(measured.admitted_key_misses, 3);
    assert!(measured.encoded_output_bytes > 0);
    Ok(())
}

#[test]
#[ignore = "F15 synthetic study only; run explicitly with --ignored --nocapture"]
fn inert_parser_capacity_only_repeat_study() -> Result<()> {
    for (label, distinct) in [("repeated_four", 4), ("distinct_sixty_four", 64)] {
        let inputs = (0..64)
            .map(|index| format!("/search fixture-{}", index % distinct))
            .collect::<Vec<_>>();
        let measured = census(&inputs)?;
        assert_eq!(measured.parse_calls, 64);
        assert_eq!(measured.failed, 0);
        assert_eq!(
            measured.potential_exact_repeats,
            if distinct == 4 { 60 } else { 0 }
        );
        // Counts and synthetic workload label only. These durations are not
        // assertions, real-user hit rates, savings or a production cache result.
        eprintln!("f15_inert_parser_study label={label} {measured:?}");
    }
    Ok(())
}
