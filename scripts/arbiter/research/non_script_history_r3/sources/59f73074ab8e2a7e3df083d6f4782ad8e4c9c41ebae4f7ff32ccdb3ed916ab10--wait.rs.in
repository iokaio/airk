//! Bounded FIFO admission for usage callers within one process. The file lock
//! remains authoritative across processes and alternative spellings of a path.
use anyhow::{Result, ensure};
use std::{
    collections::{HashMap, VecDeque},
    path::{Path, PathBuf},
    sync::{Arc, Condvar, Mutex, OnceLock, Weak},
    time::{Duration, Instant},
};

const MAX_QUEUES: usize = 4096;
const MAX_WAITERS: usize = 4096;
static QUEUES: OnceLock<Mutex<HashMap<PathBuf, Weak<Queue>>>> = OnceLock::new();

#[derive(Default)]
struct Queue {
    order: Mutex<VecDeque<Arc<()>>>,
    changed: Condvar,
}

pub(super) struct Turn {
    queue: Arc<Queue>,
    token: Arc<()>,
}

pub(super) fn acquire_checked(path: &Path, started: Instant, budget: Duration,
    check: &dyn Fn() -> Result<()>, poll_cancellation: bool) -> Result<Turn> {
    acquire_accounted(path, started, budget, check, poll_cancellation, None)
}
pub(super) fn acquire_accounted(path: &Path, started: Instant, budget: Duration,
    check: &dyn Fn() -> Result<()>, poll_cancellation: bool,
    accounting: Option<&super::AccountingBudget>) -> Result<Turn> {
    check()?;
    let queue = {
        let mut queues = QUEUES
            .get_or_init(Mutex::default)
            .lock()
            .unwrap_or_else(|error| error.into_inner());
        queues.retain(|_, queue| queue.strong_count() != 0);
        if let Some(queue) = queues.get(path).and_then(Weak::upgrade) {
            queue
        } else {
            ensure!(
                queues.len() < MAX_QUEUES,
                "usage lock queue capacity reached"
            );
            let queue = Arc::new(Queue::default());
            queues.insert(path.to_path_buf(), Arc::downgrade(&queue));
            queue
        }
    };
    Turn::enqueue(queue)?.wait_accounted(started, budget, check, poll_cancellation, accounting)
}

impl Turn {
    fn enqueue(queue: Arc<Queue>) -> Result<Self> {
        let token = Arc::new(());
        {
            let mut order = queue
                .order
                .lock()
                .unwrap_or_else(|error| error.into_inner());
            ensure!(
                order.len() < MAX_WAITERS,
                "usage lock waiter capacity reached"
            );
            order.push_back(token.clone());
        }
        Ok(Self { queue, token })
    }

    #[cfg(test)]
    fn wait(self, started: Instant, budget: Duration) -> Result<Self> {
        self.wait_checked(started, budget, &|| Ok(()), false)
    }
    #[cfg(test)]
    fn wait_checked(self, started: Instant, budget: Duration,
        check: &dyn Fn() -> Result<()>, poll_cancellation: bool) -> Result<Self> {
        self.wait_accounted(started, budget, check, poll_cancellation, None)
    }
    fn wait_accounted(self, started: Instant, budget: Duration,
        check: &dyn Fn() -> Result<()>, poll_cancellation: bool,
        accounting: Option<&super::AccountingBudget>) -> Result<Self> {
        {
            let mut order = self
                .queue
                .order
                .lock()
                .unwrap_or_else(|error| error.into_inner());
            while !order
                .front()
                .is_some_and(|token| Arc::ptr_eq(token, &self.token))
            {
                if let Err(error) = check() { drop(order); return Err(error); }
                let remaining = match accounting {
                    Some(value) => match value.remaining() { Ok(left) => left, Err(error) => { drop(order); return Err(error); } },
                    None => budget.saturating_sub(started.elapsed()) };
                if remaining.is_zero() {
                    // Unlock before dropping the ticket; its removal wakes successors.
                    drop(order);
                    return Err(anyhow::Error::from(std::fs::TryLockError::WouldBlock)
                        .context("usage state is busy; observation may be dropped"));
                }
                let waiting = || self.queue.changed
                    .wait_timeout(order, if poll_cancellation { remaining.min(Duration::from_millis(2)) } else { remaining })
                    .unwrap_or_else(|error| error.into_inner());
                (order, _) = match accounting { Some(value) => value.blocked("fifo",waiting), None => waiting() };
            }
        }
        check()?;
        Ok(self)
    }
}

impl Drop for Turn {
    fn drop(&mut self) {
        let mut order = self
            .queue
            .order
            .lock()
            .unwrap_or_else(|error| error.into_inner());
        order.retain(|token| !Arc::ptr_eq(token, &self.token));
        self.queue.changed.notify_all();
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn cancelled_queued_waiter_is_removed_and_does_not_block_successor() -> Result<()> {
        use std::cell::Cell;
        let queue = Arc::new(Queue::default());
        let first = Turn::enqueue(queue.clone())?;
        let cancelled = Turn::enqueue(queue.clone())?;
        let successor = Turn::enqueue(queue.clone())?;
        let checks = Cell::new(0);
        assert!(cancelled.wait_checked(Instant::now(), Duration::from_secs(1), &|| {
            checks.set(checks.get() + 1);
            ensure!(checks.get() < 2, "fixture cancellation");
            Ok(())
        }, true).is_err());
        assert_eq!(queue.order.lock().unwrap().len(), 2);
        drop(first);
        drop(successor.wait(Instant::now(), Duration::ZERO)?);
        assert!(queue.order.lock().unwrap().is_empty());
        Ok(())
    }

    #[test]
    fn returning_worker_cannot_overtake_a_queued_worker() -> Result<()> {
        let queue = Arc::new(Queue::default());
        let first = Turn::enqueue(queue.clone())?.wait(Instant::now(), Duration::ZERO)?;
        let waiting = Turn::enqueue(queue.clone())?;
        drop(first);
        let returning = Turn::enqueue(queue.clone())?;
        // This worker would acquire a free OS lock, but must yield to the waiter.
        assert!(returning.wait(Instant::now(), Duration::ZERO).is_err());
        let waiting = waiting.wait(Instant::now(), Duration::ZERO)?;
        drop(waiting);
        assert!(queue.order.lock().unwrap().is_empty());
        Ok(())
    }

    #[test]
    fn timed_out_waiter_is_removed_without_blocking_successors() -> Result<()> {
        let queue = Arc::new(Queue::default());
        let first = Turn::enqueue(queue.clone())?;
        let expired = Turn::enqueue(queue.clone())?;
        let successor = Turn::enqueue(queue.clone())?;
        assert!(expired.wait(Instant::now(), Duration::ZERO).is_err());
        assert_eq!(queue.order.lock().unwrap().len(), 2);
        drop(first);
        drop(successor.wait(Instant::now(), Duration::ZERO)?);
        assert!(queue.order.lock().unwrap().is_empty());
        Ok(())
    }

    #[test]
    fn release_wakes_waiter_and_other_paths_remain_independent() -> Result<()> {
        let root = tempfile::tempdir()?;
        let first_path = root.path().join("first");
        let first = acquire(&first_path, Instant::now(), Duration::from_secs(2))?;
        let waiting = Turn::enqueue(first.queue.clone())?;
        let other = acquire(&root.path().join("other"), Instant::now(), Duration::ZERO)?;
        std::thread::scope(|threads| -> Result<()> {
            let worker =
                threads.spawn(move || waiting.wait(Instant::now(), Duration::from_secs(2)));
            drop(first);
            drop(worker.join().unwrap()?);
            Ok(())
        })?;
        drop(other);
        Ok(())
    }
}
