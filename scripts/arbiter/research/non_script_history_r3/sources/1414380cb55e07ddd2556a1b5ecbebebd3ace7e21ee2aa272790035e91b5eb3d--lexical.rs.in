// SPDX-License-Identifier: Apache-2.0
//! FTS5 candidates in the current database. Physical shadow rows are authenticated
//! before lookup, including empty results, or reused under cache.rs's bounded
//! change-witness contract; retained artifacts remain authoritative.
use super::{CurrentRead, journal::valid_current_path};
use airk_core::{
    Artifact, Citation, SearchQuery,
    identity::{Sha256Digest, framed_digest},
    lexical::terms,
};
use anyhow::{Context, Result, ensure};
use rusqlite::{Connection, params};
use serde::{Deserialize, Serialize};
use sha2::{Digest, Sha256};
pub(super) mod cache;
mod reference;
mod seal;
pub use reference::LexicalReferencePosition;
pub(crate) use seal::Snapshot;

pub const ENGINE: &str = "sqlite-fts5/current-lexical-1";
pub const MAX_PATH_DOCUMENTS: usize = 8192;
const MAX_ROW_BYTES: usize = 64 << 20;
const MAX_INDEX_BYTES: u64 = 1 << 40;
// Experimental S1 candidate; not a storage/FTS format change or BM25 score.
const RANKING_POOL_MULTIPLIER: usize = 8;
const MAX_RANKING_POOL: usize = 800;
const MAX_RANKING_METADATA_BYTES: usize = 8 << 20;

fn charge_ranking_metadata(used: usize, path_bytes: usize, payload_bytes: usize) -> Result<usize> {
    let fixed = std::mem::size_of::<CurrentLexicalCandidate>()
        + std::mem::size_of::<(std::cmp::Reverse<usize>, Sha256Digest, usize)>();
    let charged = used
        .checked_add(path_bytes)
        .and_then(|bytes| bytes.checked_add(payload_bytes))
        .and_then(|bytes| bytes.checked_add(fixed))
        .context("lexical ranking metadata byte overflow")?;
    ensure!(
        payload_bytes <= MAX_ROW_BYTES && charged <= MAX_RANKING_METADATA_BYTES,
        "lexical ranking metadata budget exceeded"
    );
    Ok(charged)
}

fn path_term_affinity(path: &str, wanted: &std::collections::BTreeSet<String>) -> usize {
    terms(path).intersection(wanted).count()
}
fn rank_lexical_pool(
    values: &mut [CurrentLexicalCandidate],
    wanted: &std::collections::BTreeSet<String>,
) {
    values.sort_by_cached_key(|candidate| {
        (
            std::cmp::Reverse(path_term_affinity(&candidate.citation.path, wanted)),
            candidate.stable_id,
        )
    });
}
const SCHEMA: &str = "CREATE TABLE current_lexical_docs(id INTEGER PRIMARY KEY,path TEXT NOT NULL,local INTEGER NOT NULL,stable_id TEXT NOT NULL UNIQUE,payload TEXT NOT NULL,terms TEXT NOT NULL);
CREATE INDEX current_lexical_paths ON current_lexical_docs(path);
CREATE VIRTUAL TABLE current_fts USING fts5(terms,content='current_lexical_docs',content_rowid='id',tokenize='ascii tokenchars ''_''',detail=none,columnsize=0);
CREATE TABLE current_pending_fts(path TEXT PRIMARY KEY CHECK(length(path) BETWEEN 1 AND 8192),metadata BLOB CHECK(metadata IS NULL OR (typeof(metadata)='blob' AND length(metadata)<=262144))) WITHOUT ROWID;";

pub(crate) fn create(connection: &Connection) -> Result<()> {
    connection.execute_batch(SCHEMA)?;
    Ok(())
}

#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
#[serde(deny_unknown_fields)]
pub struct LexicalManifest {
    pub version: u32,
    pub engine: String,
    pub root: Sha256Digest,
    pub bytes: u64,
    pub updates: Sha256Digest,
}
impl LexicalManifest {
    pub fn empty() -> Result<Self> {
        let connection = Connection::open_in_memory()?;
        create(&connection)?;
        capture(&connection, updates_digest(&[])?)
    }
    pub fn canonical_bytes(&self) -> Result<Vec<u8>> {
        ensure!(
            self.version == 2 && self.engine == ENGINE && self.bytes <= MAX_INDEX_BYTES,
            "unsupported lexical format; rebuild the collection with SQLite FTS5"
        );
        Ok(serde_json::to_vec(self)?)
    }
    pub fn digest(&self) -> Result<Sha256Digest> {
        Ok(framed_digest(
            b"current-lexical-manifest/1",
            &[&self.canonical_bytes()?],
        ))
    }
    pub fn decode(bytes: &[u8], expected: Sha256Digest) -> Result<Self> {
        ensure!(
            bytes.len() <= 4096,
            "oversized FTS5 manifest; rebuild incompatible lexical storage"
        );
        let manifest: Self = serde_json::from_slice(bytes)
            .context("incompatible lexical manifest; rebuild the collection with SQLite FTS5")?;
        ensure!(
            manifest.canonical_bytes()? == bytes && manifest.digest()? == expected,
            "current lexical manifest digest or encoding mismatch"
        );
        Ok(manifest)
    }
    pub(crate) fn verify(&self, connection: &Connection) -> Result<()> {
        ensure!(
            capture(connection, self.updates)? == *self,
            anyhow::Error::new(super::PrivateIntegrityFailure)
                .context("current FTS5 physical index digest mismatch")
        );
        Ok(())
    }
}

pub fn stable_id(path: &str, local: u64) -> Result<Sha256Digest> {
    ensure!(valid_current_path(path), "invalid current lexical path");
    Ok(framed_digest(
        b"current-lexical-document/1",
        &[path.as_bytes(), &local.to_be_bytes()],
    ))
}

// Prefixes separate literal aliases from digested overlong terms. The ascii
// tokenizer is byte-stable for non-ASCII text; '_' explicitly preserves whole
// identifier aliases alongside the components emitted by terms().
fn token(term: &str) -> String {
    if term.len() > 8000 {
        format!(
            "h{}",
            framed_digest(b"fts5-long-term/1", &[term.as_bytes()])
        )
    } else {
        format!("x{term}")
    }
}

#[derive(Clone, Debug)]
pub struct CurrentLexicalCandidate {
    pub stable_id: Sha256Digest,
    pub local: u64,
    pub citation: Citation,
}
#[derive(Clone, Debug)]
pub struct CurrentLexicalCandidates {
    pub manifest_digest: Sha256Digest,
    pub values: Vec<CurrentLexicalCandidate>,
    pub incomplete: bool,
}
#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
pub struct LexicalWork {
    pub changed_artifacts: usize,
    pub added_documents: u64,
}

pub(crate) fn capture(connection: &Connection, updates: Sha256Digest) -> Result<LexicalManifest> {
    Snapshot::capture(connection)?.manifest(updates)
}

pub(crate) fn updates_digest(updates: &[(String, Option<Vec<u8>>)]) -> Result<Sha256Digest> {
    let mut hash = Sha256::new();
    hash.update(b"fts5-captured-updates/1");
    let mut previous: Option<&str> = None;
    for (path, value) in updates {
        ensure!(
            valid_current_path(path) && previous.is_none_or(|p| p < path.as_str()),
            "invalid FTS5 update path/order"
        );
        previous = Some(path);
        hash.update((path.len() as u64).to_be_bytes());
        hash.update(path.as_bytes());
        match value {
            Some(bytes) => {
                ensure!(
                    bytes.len() <= super::MAX_INPUT_METADATA_BYTES,
                    "oversized FTS5 captured input"
                );
                hash.update([1]);
                hash.update((bytes.len() as u64).to_be_bytes());
                hash.update(bytes);
            }
            None => hash.update([0]),
        }
    }
    Ok(Sha256Digest::from_bytes(hash.finalize().into()))
}

pub(crate) fn replace(
    connection: &Connection,
    path: &str,
    artifact: Option<&Artifact>,
) -> Result<u64> {
    ensure!(valid_current_path(path), "invalid FTS5 path");
    connection.execute("INSERT INTO current_fts(current_fts,rowid,terms) SELECT 'delete',id,terms FROM current_lexical_docs WHERE path=?1", [path])?;
    connection.execute("DELETE FROM current_lexical_docs WHERE path=?1", [path])?;
    let Some(artifact) = artifact else {
        return Ok(0);
    };
    ensure!(
        artifact.path == path && artifact.chunks.len() <= MAX_PATH_DOCUMENTS,
        "invalid FTS5 artifact/path or document count"
    );
    for (local, chunk) in artifact.chunks.iter().enumerate() {
        let citation = Citation {
            path: path.into(),
            content_hash: artifact.content_hash.clone(),
            start_line: chunk.start_line,
            end_line: chunk.end_line,
            location: chunk.location.clone(),
        };
        let payload = serde_json::to_string(&citation)?;
        let encoded = terms(&format!("{path} {}", chunk.text))
            .iter()
            .map(|term| token(term))
            .collect::<Vec<_>>()
            .join(" ");
        ensure!(
            payload.len().saturating_add(encoded.len()) <= MAX_ROW_BYTES,
            "FTS5 document byte bound exceeded"
        );
        connection.execute("INSERT INTO current_lexical_docs(path,local,stable_id,payload,terms) VALUES(?1,?2,?3,?4,?5)", params![path,local as i64,stable_id(path,local as u64)?.to_string(),payload,encoded])?;
        let id = connection.last_insert_rowid();
        connection.execute(
            "INSERT INTO current_fts(rowid,terms) VALUES(?1,?2)",
            params![id, encoded],
        )?;
    }
    Ok(artifact.chunks.len() as u64)
}

pub(crate) fn flush(connection: &Connection) -> Result<()> {
    // Supported by the pinned SQLite 3.53.3 fts5SpecialInsert implementation.
    // Flush pending postings before sealing shadow rows; do not force optimize.
    connection.execute("INSERT INTO current_fts(current_fts) VALUES('flush')", [])?;
    Ok(())
}

impl CurrentRead {
    /// Explicit diagnostics bypass process-local change witnesses and hash all rows.
    pub fn verify_lexical_integrity(&self) -> Result<()> {
        let manifest =
            LexicalManifest::decode(&self.lexical_manifest()?, self.head().lexical_commit)?;
        self.with_connection(|connection| manifest.verify(connection))
    }
    pub fn verify_lexical(&self) -> Result<()> {
        if self.lexical_verified.get().is_some() {
            return Ok(());
        }
        let manifest =
            LexicalManifest::decode(&self.lexical_manifest()?, self.head().lexical_commit)?;
        self.with_connection(|connection| {
            cache::verified(connection, &self.lexical_path, &manifest)
        })?;
        let _ = self.lexical_verified.set(());
        Ok(())
    }
    pub fn lexical_search(&self, query: &SearchQuery) -> Result<CurrentLexicalCandidates> {
        self.lexical_search_paths(query, None)
    }

    /// The caller selects these paths from the same authenticated current reader.
    /// Filtering precedes LIMIT; it must not discard only an unfiltered top-k.
    pub fn lexical_search_paths(
        &self,
        query: &SearchQuery,
        paths: Option<&std::collections::BTreeSet<String>>,
    ) -> Result<CurrentLexicalCandidates> {
        query.validate()?;
        let query_terms = terms(&query.text);
        ensure!(
            !query_terms.is_empty(),
            "query must contain a letter or number"
        );
        if !self.private_query_eligible()? {
            self.verify_lexical()?;
        }
        let expression = query_terms
            .iter()
            .map(|term| format!("\"{}\"", token(term)))
            .collect::<Vec<_>>()
            .join(" AND ");
        let scope = self.scope_atoms_json()?;
        let scope_aliases = self.scope_aliases_json()?;
        let paths = paths.map(serde_json::to_string).transpose()?;
        ensure!(
            paths.as_ref().is_none_or(|paths| paths.len() <= 4 << 20),
            "filtered lexical path selector exceeds byte budget"
        );
        // Every scope, alias, prefix and metadata predicate remains inside
        // the existing SQL WHERE before this expanded bounded first cutoff.
        let pool_limit = query
            .limit
            .saturating_mul(RANKING_POOL_MULTIPLIER)
            .min(MAX_RANKING_POOL);
        let result = self.with_connection(|connection| {
            let sql = if scope.is_some() { "SELECT d.path,d.local,d.stable_id,d.payload FROM current_fts JOIN current_lexical_docs AS d NOT INDEXED ON d.id=current_fts.rowid WHERE current_fts MATCH ?1 AND (?2 IS NULL OR substr(d.path,1,length(?2))=?2 COLLATE BINARY) AND (?4 IS NULL OR d.path IN (SELECT value FROM json_each(?4))) AND (?5 IS NULL OR EXISTS (SELECT 1 FROM json_each(?5) AS a WHERE NOT EXISTS (SELECT 1 FROM json_each(?6) AS alias WHERE ((d.path='@'||alias.value COLLATE BINARY OR substr(d.path,1,length(alias.value)+2)='@'||alias.value||'/' COLLATE BINARY) != (json_extract(a.value,'$.path')='@'||alias.value COLLATE BINARY OR substr(json_extract(a.value,'$.path'),1,length(alias.value)+2)='@'||alias.value||'/' COLLATE BINARY))) AND (d.path=json_extract(a.value,'$.path') COLLATE BINARY OR (json_extract(a.value,'$.kind')='subtree' AND (json_extract(a.value,'$.path')='' OR substr(d.path,1,length(json_extract(a.value,'$.path'))+1)=json_extract(a.value,'$.path')||'/' COLLATE BINARY))))) ORDER BY d.stable_id LIMIT ?3" } else { "SELECT d.path,d.local,d.stable_id,d.payload FROM current_fts JOIN current_lexical_docs AS d NOT INDEXED ON d.id=current_fts.rowid WHERE current_fts MATCH ?1 AND (?2 IS NULL OR substr(d.path,1,length(?2))=?2 COLLATE BINARY) AND (?4 IS NULL OR d.path IN (SELECT value FROM json_each(?4))) ORDER BY d.stable_id LIMIT ?3" };
            let mut statement = connection.prepare(sql)?;
            let mut rows = if scope.is_some() { statement.query(params![expression,query.path_prefix,(pool_limit + 1) as i64,paths,scope,scope_aliases])? } else { statement.query(params![expression,query.path_prefix,(pool_limit + 1) as i64,paths])? };
            let mut values = Vec::new();
            let mut incomplete = false;
            let mut ranking_bytes = 0usize;
            while let Some(row) = rows.next()? {
                if values.len() == pool_limit { incomplete = true; break; }
                // Inspect borrowed SQLite text before allocating the path or
                // deserializing citation strings. This budget charges serialized
                // metadata plus fixed candidate/key storage, not total RSS or
                // SQLite's existing page/sort buffers.
                let path = row.get_ref(0)?.as_str()?;
                let payload = row.get_ref(3)?.as_str()?;
                ranking_bytes = charge_ranking_metadata(ranking_bytes, path.len(), payload.len())?;
                let local = u64::try_from(row.get::<_, i64>(1)?)?;
                let stable_id: Sha256Digest = row.get_ref(2)?.as_str()?.parse()?;
                ensure!(stable_id == self::stable_id(path,local)?, "FTS5 candidate identity mismatch");
                let citation: Citation = serde_json::from_str(payload)?;
                ensure!(citation.path == path, "invalid FTS5 candidate citation");
                values.push(CurrentLexicalCandidate { stable_id, local, citation });
            }
            rank_lexical_pool(&mut values, &query_terms);
            incomplete |= values.len() > query.limit;
            values.truncate(query.limit);
            Ok(CurrentLexicalCandidates { manifest_digest: self.head().lexical_commit, values, incomplete })
        });
        let result = self.observe_private_integrity(result)?;
        self.token()?;
        Ok(result)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    #[test]
    fn experimental_metadata_charge_refuses_cap_and_overflow_before_decoding() -> Result<()> {
        let overhead = charge_ranking_metadata(0, 0, 0)?;
        assert_eq!(
            charge_ranking_metadata(MAX_RANKING_METADATA_BYTES - overhead, 0, 0)?,
            MAX_RANKING_METADATA_BYTES
        );
        assert!(charge_ranking_metadata(MAX_RANKING_METADATA_BYTES - overhead, 0, 1).is_err());
        assert!(charge_ranking_metadata(usize::MAX, 1, 1).is_err());
        Ok(())
    }
    #[test]
    fn experimental_path_affinity_matches_tokens_not_substrings() {
        let wanted = terms("authorize_refund");
        assert!(
            path_term_affinity("src/authorize_refund.rs", &wanted)
                > path_term_affinity("docs/guide.md", &wanted)
        );
        assert_eq!(
            path_term_affinity("src/authorizer.rs", &terms("authorize")),
            0
        );
        assert_eq!(path_term_affinity("@specs/refund.md", &terms("refund")), 1);
    }
    #[test]
    fn experimental_equal_affinity_uses_stable_identity_despite_input_order() -> Result<()> {
        let make = |path: &str| -> Result<CurrentLexicalCandidate> {
            Ok(CurrentLexicalCandidate {
                stable_id: stable_id(path, 0)?,
                local: 0,
                citation: Citation {
                    path: path.into(),
                    content_hash: "fixture".into(),
                    start_line: 1,
                    end_line: 1,
                    location: airk_core::DocumentLocation::Lines { start: 1, end: 1 },
                },
            })
        };
        let mut left = vec![make("src/a.rs")?, make("src/b.rs")?];
        let mut right = left.iter().rev().cloned().collect::<Vec<_>>();
        rank_lexical_pool(&mut left, &terms("unmatched"));
        rank_lexical_pool(&mut right, &terms("unmatched"));
        assert_eq!(
            left.iter().map(|value| value.stable_id).collect::<Vec<_>>(),
            right
                .iter()
                .map(|value| value.stable_id)
                .collect::<Vec<_>>()
        );
        assert!(left[0].stable_id < left[1].stable_id);
        Ok(())
    }
    #[test]
    fn flush_rollback_and_replay_have_identical_seals() -> Result<()> {
        let mut c = Connection::open_in_memory()?;
        create(&c)?;
        let empty = LexicalManifest::empty()?;
        empty.verify(&c)?;
        let artifact = Artifact {
            path: "a.cs".into(),
            content_hash: Sha256Digest::from_bytes([1; 32]).to_string(),
            bytes: 12,
            chunks: vec![airk_core::Chunk {
                start_line: 1,
                end_line: 1,
                text: "CamelCase cafÃ© Î»".into(),
                location: airk_core::DocumentLocation::Lines { start: 1, end: 1 },
            }],
            language: "csharp".into(),
            extraction_method: "fixture".into(),
            parse_status: "ok".into(),
            facts: vec![],
            retained: None,
        };
        let manifest = {
            let tx = c.transaction()?;
            replace(&tx, &artifact.path, Some(&artifact))?;
            flush(&tx)?;
            let m = capture(&tx, empty.updates)?;
            tx.rollback()?;
            m
        };
        empty.verify(&c)?;
        {
            let tx = c.transaction()?;
            replace(&tx, &artifact.path, Some(&artifact))?;
            flush(&tx)?;
            manifest.verify(&tx)?;
            tx.commit()?;
        }
        manifest.verify(&c)?;
        c.execute(
            "INSERT INTO current_fts(current_fts,rank) VALUES('integrity-check',1)",
            [],
        )?;
        manifest.verify(&c)?;
        Ok(())
    }
    #[test]
    fn tracked_seals_match_full_scans_through_merges_replacements_and_deletions() -> Result<()> {
        let mut c = Connection::open_in_memory()?;
        create(&c)?;
        c.execute(
            "INSERT INTO current_fts(current_fts,rank) VALUES('automerge',2)",
            [],
        )?;
        let updates = LexicalManifest::empty()?.updates;
        let mut base = Snapshot::capture(&c)?;
        for batch in 0..70 {
            let apply = |c: &Connection| -> Result<()> {
                for i in 0..12 {
                    let path = format!("file_{}.rs", (batch * 12 + i) % 360);
                    if batch > 35 && i % 3 == 0 {
                        replace(c, &path, None)?;
                        continue;
                    }
                    let text = format!(
                        "CamelCase snake_case cafÃ© Î» {} {}",
                        "z".repeat(9000),
                        (0..100)
                            .map(|n| format!("word{batch}item{n}"))
                            .collect::<Vec<_>>()
                            .join(" ")
                    );
                    let artifact = Artifact {
                        path: path.clone(),
                        content_hash: "hash".into(),
                        bytes: text.len(),
                        chunks: vec![airk_core::Chunk {
                            text,
                            start_line: 1,
                            end_line: 1,
                            location: airk_core::DocumentLocation::Lines { start: 1, end: 1 },
                        }],
                        language: "rust".into(),
                        extraction_method: "fixture".into(),
                        parse_status: "ok".into(),
                        facts: vec![],
                        retained: None,
                    };
                    replace(c, &path, Some(&artifact))?;
                }
                flush(c)
            };
            let target = {
                let tx = c.transaction()?;
                let next = base.apply_tracked(&tx, || apply(&tx))?.0;
                assert_eq!(
                    next.manifest(updates)?,
                    capture(&tx, updates)?,
                    "prepare batch {batch}"
                );
                tx.rollback()?;
                next.manifest(updates)?
            };
            let tx = c.transaction()?;
            let next = base.apply_tracked(&tx, || apply(&tx))?.0;
            assert_eq!(next.manifest(updates)?, target, "replay batch {batch}");
            assert_eq!(target, capture(&tx, updates)?, "physical batch {batch}");
            tx.commit()?;
            base = next;
        }
        let expression = format!(
            "\"{}\" AND \"{}\"",
            token("snake_case"),
            token(&"z".repeat(9000))
        );
        let count: i64 = c.query_row(
            "SELECT count(*) FROM current_fts WHERE current_fts MATCH ?1",
            [&expression],
            |r| r.get(0),
        )?;
        assert!(count > 0);
        c.execute(
            "INSERT INTO current_fts(current_fts,rank) VALUES('integrity-check',1)",
            [],
        )?;
        Ok(())
    }
}
