#[test]
fn native_project_worker_accepted_verify_cancel_and_closed_input_retain_owned_drain() -> Result<()> {
    use airk_cli::project_protocol::{self, Command as Control, Reply, WorkControl};
    for action in ["cancel", "eof", "stop"] {
        let owned = tempfile::tempdir()?;
        let root = owned.path().canonicalize()?;
        fs::write(root.join("fixture-owned"), MARKER)?;
        fs::create_dir(root.join("source"))?;
        airk_cli::local_ipc::prepare_root(&root.join("control"))?;
        let original = "accepted Verify retained input\n";
        for ordinal in 0..65 {
            fs::write(root.join("source").join(format!("fixture-{ordinal:03}.txt")), original)?;
        }
        let mut setup = OwnedProcess::start(&root, "setup")?;
        let ready = setup.event("setup")?;
        setup.finish()?;
        drop(setup);
        let job: Sha256Digest = serde_json::from_value(ready["job"].clone())?;
        let project = registration(&root)?;
        let mut worker = NativeProtocolWorker::start(&root)?;
        worker.send(&project_protocol::Init {
            engine: Sha256Digest::from_bytes([0; 32]), runtime: root.join("control"),
            project: project.binding, service: namespace(),
            worker: airk_kernel::service_broker::new_instance_id()?,
        })?;
        let Reply::Ready { identity, .. } = worker.reply()? else {
            anyhow::bail!("accepted-drain worker Ready missing")
        };
        worker.send(&Control::Activate { identity,
            allowance: airk_core::service::QueryAllowance { concurrent_queries: 1, response_bytes: airk_core::service::MAX_FRAME_BYTES },
            pool: None, pool_pending: false })?;
        ensure!(matches!(worker.reply()?, Reply::Activated), "accepted-drain activation refused");
        // Use the existing service quota lock only after all activation/setup.
        // Its real job admission reports NativeLock and checks WorkControl.
        let ledger = fs::OpenOptions::new().read(true).write(true)
            .open(root.join("data/.quota-1.4/ledger.lock"))?;
        ledger.try_lock()?;
        let grant = allowance(identity, job)?;
        let grant_id = grant.id;
        worker.send(&Control::RunJob { identity, allowance: grant })?;
        ensure!(matches!(worker.reply()?, Reply::WorkAccepted), "accepted-drain RunJob refused");
        let deadline = Instant::now() + Duration::from_secs(15);
        loop {
            ensure!(Instant::now() < deadline, "accepted Verify did not enter actual quota admission");
            worker.send(&Control::WorkStatus { identity, control: None, keep_for_maintenance: false, freshness: None })?;
            let Reply::WorkStatus { observation } = worker.reply()? else {
                anyhow::bail!("accepted-drain WorkStatus missing")
            };
            ensure!(observation.finished != Some(grant_id), "Verify finished while its actual ledger was held");
            let registry = ServiceRegistry::open_saved(&root.join("control"))?;
            let record = registry.job(job)?;
            if record.state == JobState::Running && observation.waiting_for == Some(airk_core::service_resources::WaitReason::NativeLock) {
                ensure!(observation.active == Some(grant_id), "waiting grant changed");
                ensure!(observation.progress.as_ref().is_some_and(|p| p.verified_objects == 0), "blocked Verify invented physical work");
                // Read the actual persisted veto through an independent read-only
                // handle; no production connection or mutation hook is exposed.
                let connection = rusqlite::Connection::open_with_flags(root.join("control/service-1.4.sqlite3"), rusqlite::OpenFlags::SQLITE_OPEN_READ_ONLY)?;
                let saved: String = connection.query_row(
                    "SELECT engine FROM service_recovery_budget WHERE scope=?1 AND failures=0 AND suppressed=1",
                    [format!("integrity:{}",project.binding)], |row| row.get(0))?;
                ensure!(saved == job.to_string(), "accepted Verify guard was not durably admitted");
                break;
            }
            thread::sleep(Duration::from_millis(10));
        }
        if action == "cancel" {
            worker.send(&Control::WorkStatus { identity,
                control: Some(WorkControl { grant: grant_id, paused: false, canceled: true }),
                keep_for_maintenance: false, freshness: None })?;
            ensure!(matches!(worker.reply()?, Reply::WorkStatus { .. }), "explicit cancellation was not observed");
        }
        if action != "eof" { worker.send(&Control::Stop)?; }
        worker.input.take();
        ensure!(worker.child.try_wait()?.is_none(), "accepted work owner exited before ledger release");
        let held = ProjectLease::acquire(&root.join("control"), project.binding).err()
            .context("closed-input worker released its accepted project lease")?;
        ensure!(matches!(held.downcast_ref::<std::fs::TryLockError>(), Some(std::fs::TryLockError::WouldBlock)), "unexpected lease refusal: {held:#}");
        ledger.unlock()?;
        drop(ledger);
        worker.finish()?;
        drop(worker);
        let registry = ServiceRegistry::open_saved(&root.join("control"))?;
        let completed = registry.job(job)?;
        let progress = registry.progress_observation(project.binding)?.context("drained progress missing")?.progress;
        if action == "cancel" {
            ensure!(matches!(completed.outcome, Some(JobOutcome::Canceled)), "explicitly canceled Verify did not remain Canceled");
            ensure!(progress.verified_objects == 0, "canceled-before-physical Verify reported physical work");
        } else {
            let durable = durable_verify_state(&root, &project)?;
            ensure!(durable["verify"]["checked_files"] == 65 && durable["verify"]["job"] == serde_json::to_value(job)?, "closed-input owner did not finish its exact65-file job");
            let physical: airk_store::service::collection::integrity::verify::VerifyProgress = serde_json::from_value(durable["verify"].clone())?;
            ensure!(physical.complete(), "closed-input owner did not finish physical proof");
            let head: airk_store::current::CurrentHead = serde_json::from_value(durable["head"].clone())?;
            let token = head.token()?;
            let expected = airk_core::identity::RevisionToken { incarnation: token.incarnation, generation: token.sequence, revision: token.digest };
            ensure!(matches!(&completed.outcome, Some(JobOutcome::Succeeded { revision: Some(revision) }) if *revision==expected), "closed-input owner did not consume exact completion proof");
            ensure!(progress.verified_objects == 66, "closed-input aggregate did not retain65files plus1inspection");
        }
        let connection = rusqlite::Connection::open_with_flags(root.join("control/service-1.4.sqlite3"), rusqlite::OpenFlags::SQLITE_OPEN_READ_ONLY)?;
        let guarded: bool = connection.query_row("SELECT EXISTS(SELECT 1 FROM service_recovery_budget WHERE scope=?1)", [format!("integrity:{}",project.binding)], |row| row.get(0))?;
        ensure!(!guarded, "clean fresh Verify drain retained an audit veto");
        drop(connection);
        drop(registry);
        drop(ProjectLease::acquire(&root.join("control"), project.binding)?);
        for ordinal in 0..65 {
            ensure!(fs::read_to_string(root.join("source").join(format!("fixture-{ordinal:03}.txt")))? == original, "accepted Verify drain changed source bytes");
        }
    }
    Ok(())
}
