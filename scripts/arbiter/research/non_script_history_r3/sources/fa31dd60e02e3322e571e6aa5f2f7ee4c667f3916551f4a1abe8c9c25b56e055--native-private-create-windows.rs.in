/// Exclusive new native root creation only. Never changes an existing ACL.
pub(super) fn create_native_root(path:&std::path::Path)->Result<()> {
    use std::os::windows::{ffi::OsStrExt,io::{OwnedHandle,FromRawHandle}};
    use windows_sys::Win32::{Security::{Authorization::{ConvertSidToStringSidW,
        ConvertStringSecurityDescriptorToSecurityDescriptorW,SDDL_REVISION_1},SECURITY_ATTRIBUTES},
        Storage::FileSystem::CreateDirectoryW};
    let mut token=std::ptr::null_mut();
    ensure!(unsafe{OpenProcessToken(GetCurrentProcess(),TOKEN_QUERY,&mut token)}!=0,"native root token unavailable");
    let token=unsafe{OwnedHandle::from_raw_handle(token)};
    let mut user=[0usize;64];let mut returned=0;
    ensure!(unsafe{GetTokenInformation(token.as_raw_handle(),TokenUser,user.as_mut_ptr().cast(),
        mem::size_of_val(&user) as u32,&mut returned)}!=0
        &&returned as usize>=mem::size_of::<TOKEN_USER>(),"native root user token unavailable");
    let sid=unsafe{(*user.as_ptr().cast::<TOKEN_USER>()).User.Sid};
    ensure!(unsafe{IsValidSid(sid)}!=0,"native root user SID invalid");
    let mut text=std::ptr::null_mut();
    ensure!(unsafe{ConvertSidToStringSidW(sid,&mut text)}!=0,"native root SID conversion failed");
    let _sid_owner=Descriptor(text.cast());
    let mut length=0;
    while length<256 && unsafe{*text.add(length)}!=0{length+=1;}
    ensure!(length<256,"native root SID exceeds bound");
    let sid=String::from_utf16(unsafe{std::slice::from_raw_parts(text,length)})?;
    let sddl:Vec<u16>=format!("O:{sid}D:P(A;OICI;FA;;;{sid})").encode_utf16().chain(Some(0)).collect();
    let mut descriptor=std::ptr::null_mut();
    ensure!(unsafe{ConvertStringSecurityDescriptorToSecurityDescriptorW(sddl.as_ptr(),SDDL_REVISION_1,
        &mut descriptor,std::ptr::null_mut())}!=0,"native private root descriptor invalid");
    let _descriptor_owner=Descriptor(descriptor);
    let attributes=SECURITY_ATTRIBUTES{nLength:mem::size_of::<SECURITY_ATTRIBUTES>() as u32,
        lpSecurityDescriptor:descriptor,bInheritHandle:0};
    let path:Vec<u16>=path.as_os_str().encode_wide().chain(Some(0)).collect();
    // SAFETY: all owned token/descriptor/name storage remains live until return.
    // CreateDirectoryW is exclusive; ERROR_ALREADY_EXISTS never rewrites ACLs.
    ensure!(unsafe{CreateDirectoryW(path.as_ptr(),&attributes)}!=0,
        "native private root creation refused: {}",std::io::Error::last_os_error());
    Ok(())
}
