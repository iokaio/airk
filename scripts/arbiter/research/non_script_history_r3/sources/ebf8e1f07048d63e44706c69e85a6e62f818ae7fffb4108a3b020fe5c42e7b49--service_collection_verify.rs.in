//! Off-query dated observations. No method in this module authorizes a query.
use super::*;
use crate::current::postings::Lookup;

#[derive(Clone,Debug,Default,Serialize,Deserialize)]
#[serde(deny_unknown_fields)]
pub struct ProjectionComponentCoverage {
    pub checked_files:u64,pub missing_files:u64,
    pub first_observed_unix_ms:Option<u64>,pub through_unix_ms:Option<u64>,
}
impl ProjectionComponentCoverage {
    fn observe(&mut self,available:bool,now:u64)->Result<()>{
        if available{
            self.checked_files=self.checked_files.checked_add(1).context("projection coverage overflow")?;
            self.first_observed_unix_ms.get_or_insert(now);self.through_unix_ms=Some(now);
        }else{self.missing_files=self.missing_files.checked_add(1).context("missing projection coverage overflow")?;}
        Ok(())
    }
}
#[derive(Clone,Debug,Serialize,Deserialize)]
#[serde(deny_unknown_fields)]
pub struct ProjectionAuditProgress {
    pub artifact_root:Sha256Digest,pub started_unix_ms:u64,pub after:Option<String>,
    pub visited_files:u64,pub scalars:ProjectionComponentCoverage,
    pub native_facts:ProjectionComponentCoverage,pub exhausted:bool,
}
impl ProjectionAuditProgress{
    fn new(root:Sha256Digest,now:u64)->Self{Self{artifact_root:root,started_unix_ms:now,after:None,
        visited_files:0,scalars:Default::default(),native_facts:Default::default(),exhausted:false}}
    fn record(&mut self,path:&str,scalars:bool,native:bool,now:u64)->Result<()>{
        self.scalars.observe(scalars,now)?;self.native_facts.observe(native,now)?;
        self.visited_files=self.visited_files.checked_add(1).context("projection visited count overflow")?;
        self.after=Some(path.into());Ok(())
    }
    fn validate(&self)->Result<()>{
        ensure!(self.after.as_ref().is_none_or(|path|!path.is_empty()&&path.len()<=8192&&!path.contains('\0')),
            "invalid projection audit continuation");
        for component in [&self.scalars,&self.native_facts]{
            ensure!(component.checked_files.checked_add(component.missing_files)==Some(self.visited_files)
                &&((component.checked_files==0&&component.first_observed_unix_ms.is_none()&&component.through_unix_ms.is_none())
                    ||(component.checked_files>0&&component.first_observed_unix_ms.is_some()&&component.through_unix_ms.is_some())),
                "invalid projection audit coverage counters");
        }
        Ok(())
    }
    /// Historical component coverage only, never private-root/query authority.
    pub fn complete_coverage(&self)->bool{
        self.exhausted&&self.scalars.missing_files==0&&self.native_facts.missing_files==0
            &&self.scalars.checked_files==self.visited_files&&self.native_facts.checked_files==self.visited_files
    }
}

#[derive(Clone, Debug, Serialize, Deserialize)]
#[serde(deny_unknown_fields)]
pub struct VerifyProgress {
    version: u32,
    job: Sha256Digest,
    scope: crate::current::CurrentScope,
    artifact_root: Sha256Digest,
    lexical_commit: Sha256Digest,
    lexical_observed_unix_ms: Option<u64>,
    started_unix_ms: u64,
    through_unix_ms: u64,
    after: Option<String>,
    checked_files: u64,
    checked_bytes: u64,
    objects_complete: bool,
    /// Includes uncertain I/O; not a declaration of physical corruption.
    /// Never automatically cleared by a later successful observation.
    unresolved: bool,
    #[serde(default,skip_serializing_if="Option::is_none")]
    projections:Option<ProjectionAuditProgress>,
}
impl VerifyProgress {
    pub fn requires_repair(&self) -> bool { self.unresolved }
    fn reconcile(old: Option<Self>, job: Sha256Digest, head: &CurrentHead, now: u64) -> Self {
        let unresolved = old.as_ref().is_some_and(|old| old.unresolved);
        let Some(mut old) = old.filter(|old| old.version == 1 && old.job == job && old.scope == head.scope) else {
            return Self { version: 1, job, scope: head.scope.clone(),
                artifact_root: head.artifact_root, lexical_commit: head.lexical_commit,
                lexical_observed_unix_ms: None, started_unix_ms: now, through_unix_ms: now,
                after: None, checked_files: 0, checked_bytes: 0,
                objects_complete: false, unresolved,projections:Some(ProjectionAuditProgress::new(head.artifact_root,now)) };
        };
        // Metadata/semantic/graph-only publication need not discard unrelated
        // observed object work. These are authenticated component identities.
        if old.artifact_root != head.artifact_root {
            old.artifact_root = head.artifact_root;
            old.after = None;
            old.checked_files = 0;
            old.checked_bytes = 0;
            old.objects_complete = false;
            old.started_unix_ms = now;
        }
        if old.lexical_commit != head.lexical_commit {
            old.lexical_commit = head.lexical_commit;
            old.lexical_observed_unix_ms = None;
        }
        if old.projections.as_ref().is_none_or(|projection|projection.artifact_root!=head.artifact_root){
            old.projections=Some(ProjectionAuditProgress::new(head.artifact_root,now));
        }
        old
    }
    pub fn projection_coverage(&self)->Option<&ProjectionAuditProgress>{self.projections.as_ref()}
    pub fn complete(&self) -> bool {
        self.objects_complete && self.lexical_observed_unix_ms.is_some() && !self.unresolved
    }
}

pub struct VerifyTurn {
    pub progress: VerifyProgress,
    pub blocked_large: bool,
}
impl VerifyTurn{
    // A completed campaign can honestly report unavailable projection coverage.
    // Historical VerifyProgress::complete retains its original component meaning.
    pub fn work_complete(&self)->bool{self.progress.complete()
        &&self.progress.projections.as_ref().is_some_and(|projection|projection.exhausted)}
}
impl IntegrityOwner<'_> {
    /// One optional legacy lexical component and one bounded retained-object page.
    /// Acquire the existing writer before entry, release it between turns. No
    /// CurrentRead, transaction, writer or object lease survives this call.
    /// `checkpoint` is the existing service job cancellation/admission hook.
    pub fn verify_turn(&self, writer: &mut crate::WriterLock, job: Sha256Digest, max_files: usize,
        max_bytes: u64, now: u64, checkpoint: impl Fn() -> Result<()>) -> Result<VerifyTurn> {
        ensure!((1..=128).contains(&max_files) && (1..=512 << 20).contains(&max_bytes),
            "invalid off-query verification bounds");
        checkpoint()?;
        let fence = self.check()?;
        ensure!(self.registry.integrity_audit_veto(self.lease)? == Some(job),
            "Verify requires its durably admitted audit veto");
        let selected = self.collection.select()?;
        crate::maintenance::check_writer(&selected.store, writer,
            &Quota::open_service(Path::new(&self.collection.owner.data_root))?)?;
        let generation = writer.census_mutation_epoch();
        let scope = selected.store.current_owned_scope()?.context("verification scope missing")?;
        let read = selected.store.current_read(&scope)?;
        let head = read.head().clone();
        let mut observation = {
            let _lock = manifest_lock(&self.collection.directory)?;
            self.load(fence.0)?
        };
        let old = observation.as_mut().and_then(|value| value.verify.take());
        if let Some(saved) = &old {
            saved.scope.validate()?;
            if let Some(projection)=&saved.projections{projection.validate()?;}
            ensure!(saved.version == 1 && saved.after.as_ref().is_none_or(|path| !path.is_empty()
                && path.len() <= 8192 && !path.contains('\0')),
                "unsupported or malformed Verify continuation");
        }
        let mut progress = VerifyProgress::reconcile(old, job, &head, now);
        if observation.as_ref().is_some_and(|value| value.known_damage.len() >= MAX_DAMAGE
            || value.known_damage.iter().any(|damage| damage.incarnation == head.scope.incarnation)) {
            progress.unresolved = true;
        }
        let mut blocked_large = false;
        let mut interrupted = false;
        let mut check = || match checkpoint() {
            Ok(()) => Ok(()),
            Err(error) => { interrupted = true; Err(error) }
        };
        let work = (|| -> Result<()> {
            if progress.lexical_observed_unix_ms.is_none() {
                check()?;
                // Existing v2 auxiliary SHA streams are indivisible; this can
                // take longer than a turn. Never called once per object page.
                read.verify_lexical_integrity()?;
                progress.lexical_observed_unix_ms = Some(now);
            }
            check()?;
            let mut remaining_files=max_files;
            let mut bytes=0u64;
            if !progress.objects_complete {
            let page = read.lookup_paths(Lookup::Files, "", progress.after.as_deref(), max_files + 1)?;
            let mut visited = 0usize;
            for path in page.paths.iter().take(max_files) {
                check()?;
                let artifact = read.artifact(path)?.context("verification artifact missing")?;
                let reference = artifact.retained.as_ref().context("verification retained reference missing")?;
                let aligned=progress.projections.as_ref().is_some_and(|projection|projection.after==progress.after);
                let metadata_bytes=if aligned{read.file_metadata_bytes(path)? as u64}else{0};
                let object_size=(artifact.bytes as u64).checked_add(reference.object_bytes as u64)
                    .context("verification byte overflow")?;
                let size=object_size.checked_add(metadata_bytes).context("verification byte overflow")?;
                if size > max_bytes { blocked_large = true; break; }
                if bytes.saturating_add(size) > max_bytes { break; }
                selected.store.verify_retained_source(&artifact)?;
                selected.store.load_retained_bounded(&artifact, max_bytes)?;
                if aligned{
                    let scalars=read.audit_file_scalars(&selected.store,path)?;check()?;
                    let native=read.audit_native_fact_projection(&selected.store,path)?;check()?;
                    progress.projections.as_mut().context("projection progress missing")?.record(path,scalars,native,now)?;
                }
                bytes += size;
                remaining_files-=1;
                progress.checked_files = progress.checked_files.checked_add(1).context("verification count overflow")?;
                progress.checked_bytes = progress.checked_bytes.checked_add(object_size).context("verification size overflow")?;
                progress.after = Some(path.clone());
                visited += 1;
            }
            progress.objects_complete = visited == page.paths.len() && page.next_after.is_none();
            if progress.objects_complete&&progress.projections.as_ref().is_some_and(|projection|projection.after==progress.after){
                progress.projections.as_mut().context("projection progress missing")?.exhausted=true;
            }
            progress.through_unix_ms = now;
            }
            // Legacy saved campaigns may already have completed historical objects.
            // Continue only the new component cursor without rewriting those ages.
            if remaining_files>0&&!progress.projections.as_ref().is_some_and(|projection|projection.exhausted){
                let projection=progress.projections.as_mut().context("projection progress missing")?;
                let page=read.lookup_paths(Lookup::Files,"",projection.after.as_deref(),remaining_files+1)?;
                let mut visited=0usize;
                for path in page.paths.iter().take(remaining_files){
                    check()?;
                    let artifact=read.artifact(path)?.context("projection audit artifact missing")?;
                    let retained=artifact.retained.as_ref().context("projection audit extraction missing")?;
                    let metadata_bytes=read.file_metadata_bytes(path)? as u64;
                    let size=(artifact.bytes as u64).checked_add(retained.object_bytes as u64)
                        .and_then(|size|size.checked_add(metadata_bytes)).context("projection audit byte overflow")?;
                    if size>max_bytes{blocked_large=true;break;}
                    if bytes.saturating_add(size)>max_bytes{break;}
                    let scalars=read.audit_file_scalars(&selected.store,path)?;check()?;
                    let native=read.audit_native_fact_projection(&selected.store,path)?;check()?;
                    projection.record(path,scalars,native,now)?;
                    bytes+=size;visited+=1;
                }
                projection.exhausted=visited==page.paths.len()&&page.next_after.is_none();
            }
            Ok(())
        })();
        // Partial successes precede the failing object; retain them, but never
        // turn an uncertain/failed turn into a complete clean audit.
        if work.is_err() && !interrupted { progress.unresolved = true; }
        drop(read);
        let persistence = (|| -> Result<()> {
            let _lock = manifest_lock(&self.collection.directory)?;
            ensure!(self.check()? == fence && writer.census_mutation_epoch() == generation,
                "verification owner changed");
            ensure!(self.registry.integrity_audit_veto(self.lease)? == Some(job),
                "verification audit admission changed");
            let manifest = self.collection.manifest()?;
            let current = FileStore::new(self.collection.slot(manifest.active));
            let check = current.current_read(&scope)?;
            ensure!(check.token()? == head.token()?, "verification publication changed");
            drop(check);
            // Reload to preserve concurrent sticky damage; never overwrite an
            // old saved observation with the earlier in-memory copy.
            let mut state = self.load(fence.0)?.context("anchor required before Verify")?;
            if state.known_damage.len() >= MAX_DAMAGE || state.known_damage.iter()
                .any(|damage| damage.incarnation == head.scope.incarnation) {
                progress.unresolved = true;
            }
            state.verify = Some(progress.clone());
            state.head = head;
            state.worker_epoch = fence.1;
            write(self.collection, RECEIPT, &state)?;
            Ok(())
        })();
        match (work, persistence) {
            (Err(primary), Err(persist)) => return Err(primary.context(format!(
                "Verify progress persistence also failed: {persist:#}"))),
            (Err(primary), Ok(())) => return Err(primary),
            (Ok(()), Err(persist)) => return Err(persist),
            (Ok(()), Ok(())) => {}
        }
        Ok(VerifyTurn { progress, blocked_large })
    }
}

