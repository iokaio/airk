// SPDX-License-Identifier: Apache-2.0
import * as path from 'node:path';
import { validateCatalogSession } from './catalogSession';
import { isDeepStrictEqual } from 'node:util';
import { explorerError, ExplorerError } from './explorerErrors';
import { McpSessionError, McpStdioOptions, McpStdioSession } from './mcpStdioSession';
import { LaunchSpec, launchArgs } from './model';
import { hasNativeMetadataReferences, materializeNativeMetadata } from './nativeMetadata';

/** Read-only native tool catalog. The Explorer calls nothing else on AIRK Retrieval. */
export const NATIVE_TOOLS = ['airk_search', 'airk_read_file', 'airk_list_files', 'airk_status', 'airk_diagnostics', 'airk_help', 'airk_file_info', 'airk_outline',
    'airk_symbols', 'airk_imports', 'airk_document_facts', 'airk_references', 'airk_context', 'airk_capabilities', 'airk_code_facts',
    'airk_relationships', 'airk_changes', 'airk_query_scope'] as const;
export type NativeTool = typeof NATIVE_TOOLS[number];
export const WORKBENCH_TOOLS = [...NATIVE_TOOLS, 'airk_parse'] as const;
export type EvidenceTool = typeof WORKBENCH_TOOLS[number];

/** Usage attribution label recorded by the native worker (ClientFamily::Explorer). */
export const EXPLORER_CLIENT_NAME = 'airk-explorer';

export class EvidenceFailure extends Error {
    /** An actual native error reply, retained separately from friendly guidance.
     * Transport failures have no native response and never synthesize one. */
    readonly nativeResponse?: Record<string,unknown>;
    readonly nativePayload?: Record<string,unknown>;
    constructor(readonly error: ExplorerError, nativeResponse?:Record<string,unknown>, nativePayload?:Record<string,unknown>) {
        super(error.message);
        if(nativeResponse)this.nativeResponse=structuredClone(nativeResponse);
        if(nativePayload)this.nativePayload=structuredClone(nativePayload);
    }
}
export interface ToolResult { readonly payload: Record<string, unknown>; readonly rawPayload?: Record<string, unknown>; readonly publication?: string }
/** A changed, present identity is retryable at report scope; missing identity is not. */
export class PublicationChanged extends EvidenceFailure {
    constructor() { super(explorerError('EVIDENCE_MISMATCH', 'The index changed during this report; refresh it.')); }
}
/** One report must never silently combine different publications. Missing identity fails closed. */
export function samePublication(expected: string | undefined, result: ToolResult): string {
    if (!result.publication) { throw new EvidenceFailure(explorerError('EVIDENCE_MISMATCH', 'AIRK returned no publication identity; this report cannot be verified.')); }
    if (expected && result.publication !== expected) { throw new PublicationChanged(); }
    return result.publication;
}
export function absentFromIndex(payload: Record<string, unknown>): boolean {
    const read = payload.read as Record<string, unknown> | undefined;
    return read?.status === 'removed_from_index' || read?.status === 'unknown' && read?.reason === 'path is absent from the current index';
}
export interface CallOptions {
    /** UI deadline. The native call may still finish; its late reply is discarded. */
    readonly timeout?: number;
    /** Calls sharing a key supersede older ones: only the newest result is delivered. */
    readonly supersede?: string;
}

/**
 * Accept only the native "safe to repeat this exact read" replies (publication or
 * selection busy, or an unsubmitted busy admission). Anything else is a real result.
 */
/** Exact counterpart of Core combined_reads::read_retry::validated_retry.
 * The declared pointer retains the original native receipt. A failed sibling in
 * a partial union never grants permission to replay its successful siblings. */
export function singleRequiredMemberRetry(combined: Record<string, any>): Record<string, unknown> | undefined {
    const object=(value:unknown):value is Record<string,any>=>!!value&&typeof value==='object'&&!Array.isArray(value);
    const integer=(value:unknown,min:number,max=Number.MAX_SAFE_INTEGER):value is number=>Number.isSafeInteger(value)&&Number(value)>=min&&Number(value)<=max;
    const fields=(value:Record<string,unknown>,keys:string[])=>Object.keys(value).every(key=>keys.includes(key));
    const id=(value:unknown,prefix:string)=>typeof value==='string'&&new RegExp(`^${prefix}_[0-9a-f]{32}$`).test(value);
    const digest=(value:unknown)=>typeof value==='string'&&/^[0-9a-f]{64}$/.test(value);
    try {
        if(Buffer.byteLength(JSON.stringify(combined),'utf8')>65536||combined.schema!=='airk.combined-read/1'
            ||combined.partial!==true||combined.truncated!==false||!Array.isArray(combined.ranking)||combined.ranking.length!==0
            ||combined.shared_values!==undefined&&combined.shared_values!==null)return;
        const selected=combined.selection;
        if(!object(selected)||!fields(selected,['project_ids','index_ids','grant_id','grant_revision','member_availability','identity'])
            ||selected.member_availability!=='require'||!Array.isArray(selected.index_ids)||selected.index_ids.length!==1||!id(selected.index_ids[0],'idx')
            ||!Array.isArray(selected.project_ids)||selected.project_ids.length<1||selected.project_ids.length>32
            ||!selected.project_ids.every((value:unknown)=>id(value,'prj'))||new Set(selected.project_ids).size!==selected.project_ids.length
            ||!id(selected.grant_id,'grt')||!integer(selected.grant_revision,1)||!digest(selected.identity))return;
        const index=selected.index_ids[0];
        if(!Array.isArray(combined.members)||combined.members.length!==1)return;
        const member=combined.members[0];
        if(!object(member)||member.index_id!==index||member.outcome!=='failed'||member.is_error!==true
            ||member.cutoff!==undefined&&member.cutoff!==null)return;
        const allocation=member.allocation;
        if(!object(allocation)||!fields(allocation,['index_id','limit','max_bytes','deadline_ms','verification_max_sources','verification_max_bytes','verification_deadline_ms'])
            ||allocation.index_id!==index||!integer(allocation.limit,1,100)||!integer(allocation.max_bytes,1,65536)||!integer(allocation.deadline_ms,1,30000)
            ||!integer(allocation.verification_max_sources,0,256)||!integer(allocation.verification_max_bytes,0,1073741824)
            ||!integer(allocation.verification_deadline_ms,0,30000))return;
        const error=combined.error;
        if(!object(error)||error.code!=='member_unavailable'||error.retryable!==false
            ||!Array.isArray(error.failed_members)||error.failed_members.length!==1||error.failed_members[0]!==index)return;
        const vector=combined.publication_vector;
        if(!object(vector)||!fields(vector,['authority','observed_from_unix_ms','observed_to_unix_ms','members'])||!digest(vector.authority)
            ||!integer(vector.observed_from_unix_ms,0)||!integer(vector.observed_to_unix_ms,vector.observed_from_unix_ms)
            ||!Array.isArray(vector.members)||vector.members.length!==1)return;
        const publication=vector.members[0];
        if(!object(publication)||!fields(publication,['index_id','publication'])||publication.index_id!==index
            ||publication.publication!==undefined&&publication.publication!==null)return;
        const result=member.result;
        if(!object(result)||Object.hasOwn(result,'isError')&&result.isError!==true)return;
        let body=result,suffix='';
        if(Object.hasOwn(result,'structuredContent')){
            if(result.isError!==true||!Array.isArray(result.content)||result.content.length!==1
                ||result.content[0]?.type!=='text'||typeof result.content[0]?.text!=='string')return;
            if(!isDeepStrictEqual(JSON.parse(result.content[0].text),result.structuredContent))return;
            body=result.structuredContent;suffix='/structuredContent';
        }else if(Object.hasOwn(result,'content'))return;
        if(!object(body)||Object.hasOwn(body,'query_replay_safe')&&body.query_replay_safe!==true
            ||Object.hasOwn(body,'query_submitted')&&body.query_submitted!==false)return;
        if(Object.hasOwn(body,'request_id')&&(typeof body.request_id!=='string'||body.request_id.length===0||Buffer.byteLength(body.request_id,'utf8')>128))return;
        if(Object.hasOwn(body,'scope_observation')){
            const scope=body.scope_observation;
            if(!object(scope)||!fields(scope,['schema','qualifier','fingerprint','provenance','grant','members'])||scope.schema!==1
                ||scope.qualifier!=='selected_subset'||!digest(scope.fingerprint)||!['user_reviewed_project_grant','imported_legacy_snapshot'].includes(scope.provenance)
                ||!object(scope.grant)||!fields(scope.grant,['id','revision'])||scope.grant.id!==selected.grant_id||scope.grant.revision!==selected.grant_revision
                ||!Array.isArray(scope.members)||scope.members.length!==1||Buffer.byteLength(JSON.stringify(scope),'utf8')>16384)return;
            const scoped=scope.members[0];
            if(!object(scoped)||!fields(scoped,['index_id','memberships','source_root_ids','source_revision','policy_epoch','policy_digest'])
                ||scoped.index_id!==index||!integer(scoped.source_revision,1)||!integer(scoped.policy_epoch,0)
                ||(scoped.policy_epoch===0?scoped.policy_digest!==undefined&&scoped.policy_digest!==null:!digest(scoped.policy_digest))
                ||!Array.isArray(scoped.memberships)||scoped.memberships.length<1||scoped.memberships.length>32
                ||!scoped.memberships.every((item:unknown)=>object(item)&&fields(item,['project_id','membership_revision'])
                    &&id(item.project_id,'prj')&&selected.project_ids.includes(item.project_id)&&integer(item.membership_revision,1))
                ||new Set(scoped.memberships.map((item:any)=>item.project_id)).size!==scoped.memberships.length
                ||!Array.isArray(scoped.source_root_ids)||scoped.source_root_ids.length>17
                ||!scoped.source_root_ids.every((source:unknown)=>id(source,'src'))||new Set(scoped.source_root_ids).size!==scoped.source_root_ids.length)return;
        }
        let code:string,delay:unknown,fresh:boolean;
        if(body.status==='retry'){
            if(!fields(body,['status','code','retryable','action','retry_after_ms','request_id','scope_observation','query_replay_safe','query_submitted','fresh_brokerage_required'])
                ||!['publication_busy','selection_busy'].includes(body.code)||body.retryable!==true||body.action!=='repeat_same_request'
                ||Object.hasOwn(body,'fresh_brokerage_required')&&body.fresh_brokerage_required!==false)return;
            code=body.code;delay=body.retry_after_ms;fresh=false;
        }else{
            if(!fields(body,['error','request_id','scope_observation','query_replay_safe','query_submitted','fresh_brokerage_required'])||!object(body.error))return;
            const refusal=body.error;
            if(!fields(refusal,['code','reason','query_submitted','retryable','retry_after_ms','fresh_brokerage_required','query_replay_safe'])
                ||!['direct_query_admission','direct_query_setup'].includes(refusal.code))return;
            code=refusal.code;fresh=code==='direct_query_setup';
            if(refusal.reason!=='busy'||refusal.query_submitted!==false||refusal.retryable!==true||refusal.fresh_brokerage_required!==fresh
                ||Object.hasOwn(refusal,'query_replay_safe')&&refusal.query_replay_safe!==true
                ||Object.hasOwn(body,'fresh_brokerage_required')&&body.fresh_brokerage_required!==fresh)return;
            delay=refusal.retry_after_ms;
        }
        if(!integer(delay,1,1000))return;
        const proposed={schema:1,scope:'same_single_required_member',index_id:index,selection_identity:selected.identity,
            action:'repeat_same_request',query_replay_safe:true,result_pointer:`/members/0/result${suffix}`,code,retry_after_ms:delay,fresh_brokerage_required:fresh};
        if(isDeepStrictEqual(combined.read_retry,proposed))return proposed;
    }catch{/* Unparseable or unbounded metadata never permits another read. */}
    return;
}

export function readRetryDelay(envelope: unknown, expectedScope?: unknown): number | undefined {
    if (!envelope || typeof envelope !== 'object') { return; }
    const value = envelope as Record<string, unknown>, content = value.content;
    if (value.isError !== true || !Array.isArray(content) || content.length !== 1 || content[0]?.type !== 'text' || typeof content[0]?.text !== 'string') { return; }
    let hint: Record<string, any>;
    try { hint = JSON.parse(content[0].text); } catch { return; }
    if (!hint || typeof hint !== 'object') { return; }
    let delay: unknown;
    if (hint.schema === 'airk.combined-read/1') {
        if(value.structuredContent!==undefined&&!isDeepStrictEqual(value.structuredContent,hint))return;
        return singleRequiredMemberRetry(hint)?.retry_after_ms as number|undefined;
    }
    if (hint.error?.code === 'scoped_status_prepare_timeout' || hint.error?.code === 'scoped_connection_unavailable') {
        const error=hint.error,scope=hint.requested_scope;
        const fields=(value:unknown,keys:string[]):value is Record<string,any>=>!!value&&typeof value==='object'&&!Array.isArray(value)
            &&Object.keys(value).every(key=>keys.includes(key));
        if(!fields(hint,['error','requested_scope'])||!fields(error,['code','query_submitted','retryable','retry_after_ms','fresh_brokerage_required','native_control_response','query_replay_safe'])
            ||error.query_submitted!==false||error.retryable!==true||error.fresh_brokerage_required!==true
            ||Object.hasOwn(error,'query_replay_safe')&&error.query_replay_safe!==true
            ||!fields(scope,['confirmed','selection'])||scope.confirmed!==false||expectedScope===undefined
            ||!isDeepStrictEqual(value.structuredContent,hint))return;
        try {if(!isDeepStrictEqual(validateCatalogSession(scope.selection),validateCatalogSession(expectedScope)))return;}catch{return;}
        if(error.code==='scoped_connection_unavailable'){
            const native=error.native_control_response;
            if(!fields(native,['status','code'])||native.status!=='failure'||!['broker_busy','project_starting_or_unavailable',
                'project_unavailable_or_busy','previous_workers_draining','catalog_revision_changed','catalog_clock_pending',
                'catalog_connection_busy','project_capacity_busy','project_restart_backoff'].includes(native.code))return;
        }else if(error.native_control_response!==undefined)return;
        return Number.isInteger(error.retry_after_ms)&&error.retry_after_ms>=1&&error.retry_after_ms<=1000?error.retry_after_ms:undefined;
    }
    if (hint.status === 'retry') {
        if (hint.retryable !== true || hint.action !== 'repeat_same_request' || !['publication_busy', 'selection_busy'].includes(hint.code)) { return; }
        delay = hint.retry_after_ms;
    } else {
        const error = hint.error;
        if (!error || !['direct_query_admission', 'direct_query_setup'].includes(error.code) || error.reason !== 'busy'
            || error.query_submitted !== false || error.retryable !== true || error.fresh_brokerage_required !== (error.code === 'direct_query_setup')) { return; }
        delay = error.retry_after_ms;
    }
    return Number.isInteger(delay) && Number(delay) >= 1 && Number(delay) <= 1000 ? Number(delay) : undefined;
}

function publicationOf(payload: Record<string, unknown>): string | undefined {
    const read = payload.read as Record<string, unknown> | undefined;
    const evidence = payload.evidence as Record<string, unknown> | undefined;
    const tokens = [payload.publication, evidence?.publication, read?.current_publication, read?.publication].flatMap(publication => {
        if (typeof publication === 'string') { return [publication]; }
        return publication && typeof publication === 'object' && typeof (publication as Record<string, unknown>).token === 'string'
            ? [(publication as Record<string, unknown>).token as string] : [];
    });
    if (new Set(tokens).size > 1) { throw new EvidenceFailure(explorerError('EVIDENCE_MISMATCH', 'AIRK returned inconsistent publication identities.')); }
    return tokens[0];
}

function toolFailure(text: string, nativeResponse:Record<string,unknown>): EvidenceFailure {
    let nativePayload: Record<string,unknown> | undefined;
    try {
        const parsed: unknown = JSON.parse(text);
        if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
            nativePayload = materializeNativeMetadata(parsed as Record<string,unknown>);
        }
    } catch { nativePayload = {}; /* Refuse derived cards; retain the original response for copying. */ }
    if (/current revision expired|known_hash does not match/.test(text)) { return new EvidenceFailure(explorerError('EVIDENCE_MISMATCH'),nativeResponse,nativePayload); }
    if (/workspace is not indexed|index_unavailable|no readable publication/i.test(text)) { return new EvidenceFailure(explorerError('INDEX_UNAVAILABLE'),nativeResponse,nativePayload); }
    try {
        const parsed = JSON.parse(text);
        const error = parsed?.error ?? parsed;
        if (error && typeof error === 'object' && typeof error.code === 'string') {
            // Native messages may contain source excerpts or paths. Preserve
            // them only in the original result, never in persistable guidance.
            return new EvidenceFailure(explorerError(error.code),nativeResponse,nativePayload);
        }
    } catch { /* Plain native error text belongs only to nativeResponse. */ }
    return new EvidenceFailure(explorerError('TOOL_ERROR'),nativeResponse,nativePayload);
}

interface Task { tool: EvidenceTool; args: Record<string, unknown>; options: CallOptions; generation?: number; resolve(value: ToolResult): void; reject(error: Error): void }
type Opener = (options: McpStdioOptions, handshakeTimeout: number) => Promise<{ session: McpStdioSession }>;

/**
 * The Explorer's evidence session: one persistent stdio MCP connection to the bound
 * project through the same verified launcher agents use. The native bridge accepts
 * at most 4 in-flight calls and serializes them per connection, so this client keeps
 * its own queue with at most 3 calls outstanding.
 */
export class EvidenceClient {
    private session?: McpStdioSession;
    private opening?: Promise<McpStdioSession>;
    private readonly queue: Task[] = [];
    private readonly generations = new Map<string, number>();
    private active = 0;
    private disposed = false;

    constructor(readonly spec: LaunchSpec, private readonly clientVersion: string, private readonly options: {
        open?: Opener; maxInFlight?: number; timeout?: number; retryBudget?: number; handshakeTimeout?: number;
        clientName?: 'airk-explorer' | 'airk-workbench'; workbench?: boolean;
    } = {}) {
        if (!spec.service) { throw new EvidenceFailure(explorerError('NO_PROJECT')); }
    }

    get project(): string { return this.spec.service!.project; }

    /** Fence queued and admitted replies without claiming native work was undone. */
    cancel(key: string): void {
        this.generations.set(key, (this.generations.get(key) ?? 0) + 1);
        for (let i=this.queue.length-1;i>=0;i--) {
            if (this.queue[i].options.supersede===key) { this.queue.splice(i,1)[0].reject(new EvidenceFailure(explorerError('REQUEST_SUPERSEDED'))); }
        }
    }

    call(tool: EvidenceTool, args: Record<string, unknown>, options: CallOptions = {}): Promise<ToolResult> {
        if (this.disposed) { return Promise.reject(new EvidenceFailure(explorerError('SERVICE_UNAVAILABLE', 'The Explorer evidence session was closed.'))); }
        if (!((this.options.workbench ? WORKBENCH_TOOLS : NATIVE_TOOLS) as readonly string[]).includes(tool)) { return Promise.reject(new EvidenceFailure(explorerError('INVALID_MESSAGE'))); }
        return new Promise((resolve, reject) => {
            const task: Task = { tool, args, options, resolve, reject };
            if (options.supersede) {
                const generation = (this.generations.get(options.supersede) ?? 0) + 1;
                this.generations.set(options.supersede, generation); task.generation = generation;
                // A queued call that has not started yet is dropped immediately.
                for (let index = this.queue.length - 1; index >= 0; index--) {
                    if (this.queue[index].options.supersede === options.supersede) {
                        this.queue.splice(index, 1)[0].reject(new EvidenceFailure(explorerError('REQUEST_SUPERSEDED')));
                    }
                }
            }
            if (this.queue.length >= 64) { reject(new EvidenceFailure(explorerError('RATE_LIMITED', 'The evidence request queue is full.'))); return; }
            this.queue.push(task); this.pump();
        });
    }

    dispose(): void {
        this.disposed = true;
        for (const task of this.queue.splice(0)) { task.reject(new EvidenceFailure(explorerError('SERVICE_UNAVAILABLE', 'The Explorer evidence session was closed.'))); }
        this.session?.close(); this.session = undefined;
    }

    private pump(): void {
        while (!this.disposed && this.active < (this.options.maxInFlight ?? 3) && this.queue.length) {
            const task = this.queue.shift()!;
            this.active++;
            void this.run(task).then(result => {
                const current = task.options.supersede ? this.generations.get(task.options.supersede) : undefined;
                if (current !== undefined && current !== task.generation) { task.reject(new EvidenceFailure(explorerError('REQUEST_SUPERSEDED'))); }
                else { task.resolve(result); }
            }, error => task.reject(error)).finally(() => { this.active--; this.pump(); });
        }
    }

    private async run(task: Task): Promise<ToolResult> {
        const deadline = Date.now() + (this.options.retryBudget ?? 5000);
        while (true) {
            const session = await this.connect();
            let envelope: any;
            try {
                envelope = await session.request('tools/call', { name: task.tool, arguments: task.args }, task.options.timeout ?? this.options.timeout ?? 15000);
            } catch (error) {
                if (error instanceof McpSessionError && error.code === 'overloaded') { throw new EvidenceFailure(explorerError('RATE_LIMITED')); }
                if (error instanceof McpSessionError && error.code === 'timeout') { throw new EvidenceFailure(explorerError('REQUEST_TIMEOUT')); }
                if (error instanceof McpSessionError && error.code === 'rpc') { throw new EvidenceFailure(explorerError('TOOL_ERROR', error.message)); }
                throw new EvidenceFailure(explorerError('SERVICE_UNAVAILABLE', error instanceof Error ? error.message : String(error)));
            }
            const delay = task.tool === 'airk_parse' ? undefined : readRetryDelay(envelope,this.spec.catalogSession);
            if (delay !== undefined && Date.now() + delay < deadline && !this.disposed) {
                await new Promise(resolve => setTimeout(resolve, delay)); continue;
            }
            const text = Array.isArray(envelope?.content) ? envelope.content.find((part: any) => part?.type === 'text')?.text : undefined;
            if (envelope?.isError === true) { throw toolFailure(typeof text === 'string' ? text : 'AIRK returned an error without text.',envelope); }
            if (typeof text !== 'string') { throw new EvidenceFailure(explorerError('TOOL_ERROR', 'AIRK returned no text content.')); }
            let payload: unknown;
            try { payload = JSON.parse(text); } catch { throw new EvidenceFailure(explorerError('TOOL_ERROR', 'AIRK returned content that is not JSON.')); }
            if (!payload || typeof payload !== 'object' || Array.isArray(payload)) { throw new EvidenceFailure(explorerError('TOOL_ERROR', 'AIRK returned an unexpected payload.')); }
            const raw = payload as Record<string, unknown>;
            let record: Record<string,unknown>;
            try { record = materializeNativeMetadata(raw); }
            catch { throw new EvidenceFailure(explorerError('TOOL_ERROR', 'AIRK native metadata could not be decoded. The original response is retained.'), envelope, {}); }
            return { payload: record, ...(hasNativeMetadataReferences(raw) ? { rawPayload: raw } : {}), publication: publicationOf(record) };
        }
    }

    private async connect(): Promise<McpStdioSession> {
        if (this.session && !this.session.closed) { return this.session; }
        if (!this.opening) {
            const open = this.options.open ?? ((options, timeout) => McpStdioSession.open(options, timeout));
            this.opening = open({ command: this.spec.command, args: launchArgs(this.spec,'mcp',true), cwd: path.dirname(this.spec.command),
                clientName: this.options.clientName ?? EXPLORER_CLIENT_NAME, clientVersion: this.clientVersion }, this.options.handshakeTimeout ?? 90000)
                .then(({ session }) => {
                    if (this.disposed) { session.close(); throw new EvidenceFailure(explorerError('SERVICE_UNAVAILABLE', 'The Explorer evidence session was closed.')); }
                    this.session = session; return session;
                }, error => {
                    throw error instanceof EvidenceFailure ? error : new EvidenceFailure(explorerError('SERVICE_UNAVAILABLE', error instanceof Error ? error.message : String(error)));
                })
                .finally(() => { this.opening = undefined; });
        }
        return this.opening;
    }
}
