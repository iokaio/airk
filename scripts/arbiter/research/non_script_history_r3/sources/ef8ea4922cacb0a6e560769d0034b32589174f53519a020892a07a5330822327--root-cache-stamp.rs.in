#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct SavedScopeStamp {
    pub namespace: Incarnation,
    pub revision: u64,
}
#[derive(Debug)]
pub struct SavedScopeExpired;
impl std::fmt::Display for SavedScopeExpired {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result { f.write_str("source scope observation admission expired") }
}
impl std::error::Error for SavedScopeExpired {}
/// Only pre-query metadata admission failures, never uncertain query outcomes.
pub fn source_scope_retryable(error: &anyhow::Error) -> bool {
    error.downcast_ref::<SavedScopeExpired>().is_some()
        || error.downcast_ref::<rusqlite::Error>().is_some_and(|error| matches!(error,
            rusqlite::Error::SqliteFailure(failure, _) if matches!(failure.code,
                rusqlite::ErrorCode::DatabaseBusy | rusqlite::ErrorCode::DatabaseLocked)))
}
pub(super) fn scope_remaining(deadline: Option<std::time::Instant>) -> Result<Duration> {
    let remaining = deadline.map_or(Duration::from_secs(2), |until| until.saturating_duration_since(std::time::Instant::now()));
    if remaining.is_zero() { return Err(SavedScopeExpired.into()); }
    Ok(remaining.min(Duration::from_secs(2)))
}
impl ServiceRegistry {
    /// One authenticated scalar row, zero project payload decodes. Not a deep audit.
    pub fn source_scope_stamp(&self, deadline: Option<std::time::Instant>) -> Result<SavedScopeStamp> {
        self.connection.busy_timeout(scope_remaining(deadline)?)?;
        let (namespace, revision): (String,i64) = self.connection.query_row(
            "SELECT incarnation,revision FROM service_meta WHERE id=1", [], |row| Ok((row.get(0)?,row.get(1)?)))?;
        let stamp = SavedScopeStamp { namespace: namespace.parse()?, revision: u64::try_from(revision)? };
        ensure!(stamp.namespace == retained_namespace(&self.root)?, "source stamp owner changed");
        scope_remaining(deadline)?;
        Ok(stamp)
    }
}
