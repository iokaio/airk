//! One frontend-owned scalar observation; never an evidence-query replay queue.
use super::*;
use std::sync::{Mutex, atomic::{AtomicBool,AtomicU64,Ordering}};
type Shared=std::result::Result<Arc<Snapshot>,Arc<anyhow::Error>>;
#[derive(Debug)]
struct ObservationFailure(Arc<anyhow::Error>);
impl std::fmt::Display for ObservationFailure {
    fn fmt(&self,f:&mut std::fmt::Formatter<'_>)->std::fmt::Result{std::fmt::Display::fmt(&self.0,f)}
}
impl std::error::Error for ObservationFailure {
    fn source(&self)->Option<&(dyn std::error::Error+'static)>{self.0.as_ref().as_ref().source()}
}

#[derive(Clone,PartialEq)]
struct Key {project:ProjectBinding,source:Option<SourceFence>,expires:Option<Instant>,args:serde_json::Value}
struct Snapshot {scope:CacheScope,epoch:u64,result:serde_json::Value,
    cached:Option<CachedStatus>,submitted:bool,reused:bool,receipt:airk_mcp::response::StatusReceipt}
struct Attempt {key:Key,result:tokio::sync::watch::Receiver<Option<Shared>>,
    task:tokio::sync::Mutex<Option<tokio::task::JoinHandle<()>>>,
    joined:Mutex<Option<std::result::Result<(),Arc<anyhow::Error>>>>,failure:tokio::sync::OnceCell<Shared>}
#[derive(Default)]
enum State {#[default] Idle,Running(Arc<Attempt>),Closed}
// A permit covers exactly one immediately following request, never the pipeline.
// The retained observer owns its completion; it is not a durable service receipt.
pub(super) struct OperationPermit<'a>{_owner:std::marker::PhantomData<&'a StatusOwner>}
pub(crate) struct StatusOwner {
    closed:AtomicBool,epoch:AtomicU64,state:tokio::sync::Mutex<State>,
    scope:Mutex<Option<CacheScope>>,cache:Mutex<Option<Arc<Snapshot>>>,
    scope_worker:tokio::sync::Mutex<Option<tokio::task::JoinHandle<Result<Option<CacheScope>>>>>,
    receipt:Mutex<airk_mcp::response::StatusReceipt>,
}
impl Default for StatusOwner {
    fn default()->Self{Self{closed:AtomicBool::new(false),epoch:AtomicU64::new(0),state:Default::default(),
        scope:Mutex::new(None),cache:Mutex::new(None),scope_worker:Default::default(),receipt:Default::default()}}
}
impl Drop for StatusOwner {fn drop(&mut self){self.close();}}
impl Attempt {
    async fn join(&self)->Result<()>{
        let mut slot=self.task.lock().await;
        let remembered=self.joined.lock().unwrap_or_else(|e|e.into_inner()).clone();
        let result=if let Some(result)=remembered{result}else{
            let result=if let Some(task)=slot.as_mut(){
                task.await.context("owned status observer failed").map_err(Arc::new)
            }else{Ok(())};
            // Publish the actual outcome before any subsequent cancelable await.
            *self.joined.lock().unwrap_or_else(|e|e.into_inner())=Some(result.clone());
            *slot=None;result
        };
        result.map_err(|error|anyhow::Error::new(ObservationFailure(error)))
    }
    async fn failed(&self,owner:&StatusOwner)->Shared{
        self.failure.get_or_init(||async{
            let cause=self.join().await.err().unwrap_or_else(||anyhow::anyhow!("owned status observer ended without result"));
            if let Err(error)=owner.drain_scope().await{return Err(Arc::new(cause.context(format!("status scope drain also failed: {error:#}"))));}
            Err(Arc::new(cause))
        }).await.clone()
    }
}
impl StatusOwner {
    pub(super) fn accepting(&self)->Result<()>{ensure!(!self.closed.load(Ordering::Acquire),"status owner closed");Ok(())}
    pub(super) fn admit_request(&self)->Result<OperationPermit<'_>>{
        // A successful RMW linearizes this exact request against close without
        // holding a mutex across I/O. Accepted-before-close work may drain.
        self.closed.compare_exchange(false,false,Ordering::AcqRel,Ordering::Acquire)
            .map_err(|_|anyhow::anyhow!("status owner closed"))?;
        Ok(OperationPermit{_owner:std::marker::PhantomData})
    }
    pub(crate) fn close(&self){self.closed.store(true,Ordering::Release);self.invalidate();}
    pub(crate) fn invalidate(&self){
        if self.epoch.fetch_update(Ordering::AcqRel,Ordering::Acquire,|value|value.checked_add(1)).is_err(){self.closed.store(true,Ordering::Release);}
        *self.cache.lock().unwrap_or_else(|e|e.into_inner())=None;
    }
    pub(crate) fn source_scope(&self,fence:SourceFence){self.set_scope(CacheScope::Source(fence));}
    pub(crate) fn clear_scope(&self){self.invalidate();*self.scope.lock().unwrap_or_else(|e|e.into_inner())=None;*self.receipt.lock().unwrap_or_else(|e|e.into_inner())=Default::default();}
    fn set_scope(&self,scope:CacheScope){
        let mut current=self.scope.lock().unwrap_or_else(|e|e.into_inner());
        if *current!=Some(scope){self.invalidate();*current=Some(scope);*self.receipt.lock().unwrap_or_else(|e|e.into_inner())=Default::default();}
    }
    pub(crate) fn receipt(&self)->airk_mcp::response::StatusReceipt{*self.receipt.lock().unwrap_or_else(|e|e.into_inner())}
    pub(crate) fn observed_receipt(&self,value:airk_mcp::response::StatusReceipt){*self.receipt.lock().unwrap_or_else(|e|e.into_inner())=value;}
    pub(super) fn receipt_fence(&self)->(Option<CacheScope>,u64,airk_mcp::response::StatusReceipt){
        let scope=self.scope.lock().unwrap_or_else(|e|e.into_inner());
        (*scope,self.epoch.load(Ordering::Acquire),self.receipt())
    }
    pub(super) fn adopt_receipt(&self,fence:(Option<CacheScope>,u64,airk_mcp::response::StatusReceipt),receipt:airk_mcp::response::StatusReceipt){
        let scope=self.scope.lock().unwrap_or_else(|e|e.into_inner());
        if !self.closed.load(Ordering::Acquire)&&*scope==fence.0&&self.epoch.load(Ordering::Acquire)==fence.1{
            self.observed_receipt(receipt);
        }
    }
    async fn pinned_scope(&self,root:PathBuf,project:ProjectBinding)->Result<Option<CacheScope>>{
        let mut slot=self.scope_worker.lock().await;
        if let Some(previous)=slot.as_mut(){let result=previous.await;*slot=None;drop(result?);}
        let _scope_request=self.admit_request()?;
        *slot=Some(tokio::task::spawn_blocking(move||status_scope(&root,project)));
        let result=slot.as_mut().expect("owned scope handle").await.context("status scope worker failed");
        *slot=None;result?
    }
    async fn drain_scope(&self)->Result<()>{
        let mut slot=self.scope_worker.lock().await;
        if let Some(worker)=slot.as_mut(){let result=worker.await;*slot=None;drop(result?);}Ok(())
    }
    fn reply(&self,snapshot:&Snapshot,source_expires:Option<Instant>,hit:bool)->Result<serde_json::Value>{
        ensure!(!self.closed.load(Ordering::Acquire),"status owner closed");
        let current=self.scope.lock().unwrap_or_else(|e|e.into_inner());
        if *current!=Some(snapshot.scope)||self.epoch.load(Ordering::Acquire)!=snapshot.epoch
            ||source_expires.is_some_and(|until|Instant::now()>=until)
            ||snapshot.cached.as_ref().is_some_and(|cached|Instant::now().saturating_duration_since(cached.captured)>=Duration::from_secs(5)){
            return Ok(if snapshot.submitted&&!hit{superseded()}else{source_scope_superseded()});
        }
        // Only a live caller observing a completed reply advances this frontend
        // receipt. Background completion after caller timeout never acknowledges it.
        self.observed_receipt(snapshot.receipt);
        Ok(snapshot.cached.as_ref().and_then(|cached|cached.reply(snapshot.scope,Instant::now(),hit))
            .unwrap_or_else(||snapshot.result.clone()))
    }
    pub(crate) async fn status(self:&Arc<Self>,root:PathBuf,project:ProjectBinding,
        args:serde_json::Map<String,serde_json::Value>,source:Option<SourceFence>,expires:Option<Instant>,
        client:airk_core::usage::ClientFamily)->Result<serde_json::Value>{
        ensure!(!self.closed.load(Ordering::Acquire),"status owner closed");
        if let Some(fence)=source {
            if *self.scope.lock().unwrap_or_else(|e|e.into_inner())!=Some(CacheScope::Source(fence)){return Ok(source_scope_superseded());}
        }
        let key=Key{project,source,expires,args:serde_json::Value::Object(args.clone())};
        if let Some(fence)=source{
            let cached=self.cache.lock().unwrap_or_else(|e|e.into_inner()).clone();
            if let Some(cached)=cached.filter(|cached|cached.scope==CacheScope::Source(fence)
                &&cached.cached.as_ref().is_some_and(|snapshot|snapshot.scope==cached.scope&&Instant::now().saturating_duration_since(snapshot.captured)<Duration::from_secs(5))){
                return self.reply(&cached,expires,true);
            }
        }
        self.observe(key,expires,move|owner|async move{
            owner.materialize(root,project,args,source,expires,client).await
        }).await
    }
    // Shared owner path. The private producer seam allows real IPC ownership
    // fixtures without constructing a second service broker in each unit test.
    async fn observe<F,Fut>(self:&Arc<Self>,key:Key,expires:Option<Instant>,produce:F)->Result<serde_json::Value>
    where F:FnOnce(Arc<Self>)->Fut+Send+'static,Fut:Future<Output=Result<Snapshot>>+Send+'static{
        let attempt=loop{
            let mut state=self.state.lock().await;
            ensure!(!self.closed.load(Ordering::Acquire),"status owner closed");
            match &*state{
                State::Closed=>anyhow::bail!("status owner closed"),
                State::Running(attempt) if attempt.result.borrow().is_some()=>{
                    let joined=attempt.join().await;
                    *state=State::Idle;
                    joined?;continue;
                }
                State::Running(attempt)=>{
                    if attempt.key!=key{return Ok(busy());}break attempt.clone();
                }
                State::Idle=>{
                    let(sender,result)=tokio::sync::watch::channel(None);
                    let attempt=Arc::new(Attempt{key:key.clone(),result,task:Default::default(),joined:Default::default(),failure:Default::default()});
                    let owner=self.clone();let keep=attempt.clone();
                    let task=tokio::spawn(async move{
                        let _keep=keep;
                        let result=produce(owner).await.map(Arc::new).map_err(Arc::new);
                        let _=sender.send_replace(Some(result));
                    });
                    *attempt.task.try_lock().expect("new status task slot")=Some(task);
                    *state=State::Running(attempt.clone());break attempt;
                }
            }
        };
        let mut ticket=attempt.result.clone();
        let result=loop{
            if let Some(result)=ticket.borrow_and_update().clone(){break result;}
            if ticket.changed().await.is_err(){break attempt.failed(self).await;}
        };
        {
            let mut state=self.state.lock().await;
            if matches!(&*state,State::Running(current) if Arc::ptr_eq(current,&attempt)){
                let joined=attempt.join().await;
                *state=State::Idle;
                // The shared failure below retains the actual cohort cause.
                // A successful published outcome still cannot hide a driver panic.
                if result.is_ok(){joined?;}
            }
        }
        match result{
            Ok(snapshot)=>self.reply(&snapshot,expires,snapshot.reused),
            Err(error) if airk_store::service::registry::source_scope_retryable(&error)=>Ok(source_scope_superseded()),
            Err(error)=>Err(anyhow::Error::new(ObservationFailure(error)).context("status observation failed")),
        }
    }
    async fn materialize(self:&Arc<Self>,root:PathBuf,project:ProjectBinding,
        args:serde_json::Map<String,serde_json::Value>,source:Option<SourceFence>,expires:Option<Instant>,
        client:airk_core::usage::ClientFamily)->Result<Snapshot>{
        let scope=match source{Some(fence)=>Some(CacheScope::Source(fence)),None=>self.pinned_scope(root.clone(),project).await?};
        let Some(scope)=scope else {return Err(anyhow::anyhow!("registered status scope unavailable"));};
        if source.is_none(){self.set_scope(scope);}
        if *self.scope.lock().unwrap_or_else(|e|e.into_inner())!=Some(scope){
            return Ok(Snapshot{scope,epoch:self.epoch.load(Ordering::Acquire),result:source_scope_superseded(),cached:None,submitted:false,reused:false,receipt:self.receipt()});
        }
        let epoch=self.epoch.load(Ordering::Acquire);
        ensure!(!self.closed.load(Ordering::Acquire),"status owner closed");
        if expires.is_some_and(|until|Instant::now()>=until){return Ok(Snapshot{scope,epoch,result:source_scope_superseded(),cached:None,submitted:false,reused:false,receipt:self.receipt()});}
        if let Some(cached)=self.cache.lock().unwrap_or_else(|e|e.into_inner()).clone()
            .filter(|cached|cached.scope==scope&&cached.epoch==epoch&&cached.cached.as_ref().is_some_and(|value|value.scope==scope&&Instant::now().saturating_duration_since(value.captured)<Duration::from_secs(5))){
            return Ok(Snapshot{scope,epoch,result:cached.result.clone(),cached:cached.cached.as_ref().map(|value|CachedStatus{
                scope:value.scope,captured:value.captured,observed_unix_ms:value.observed_unix_ms,body:value.body.clone()}),submitted:false,reused:true,receipt:cached.receipt});
        }
        let mut connection=match Connection::connect_once_checked(&root,project,client,Some(self)).await{
            Ok(connection)=>connection,
            Err(error)=>{
                self.accepting()?;
                let _=error; // no evidence query was submitted
                let result=airk_mcp::unified::success(serde_json::json!({"version":env!("CARGO_PKG_VERSION"),"health":"unknown",
                    "index_state":"unavailable","publication":null,"files":null,"chunks":null,
                    "index_error":{"code":"index_worker_unavailable","message":"No index query was submitted. Call diagnostics for service and queued-job diagnosis."}}));
                return Ok(Snapshot{scope,epoch,result,cached:None,submitted:false,reused:false,receipt:self.receipt()});
            }
        };
        if expires.is_some_and(|until|Instant::now()>=until){return Ok(Snapshot{scope,epoch,result:source_scope_superseded(),cached:None,submitted:false,reused:false,receipt:self.receipt()});}
        self.accepting()?;
        if self.epoch.load(Ordering::Acquire)!=epoch||*self.scope.lock().unwrap_or_else(|e|e.into_inner())!=Some(scope){
            return Ok(Snapshot{scope,epoch,result:source_scope_superseded(),cached:None,submitted:false,reused:false,receipt:self.receipt()});
        }
        connection.restore_status_receipt(self.receipt());
        let _request=self.admit_request()?;
        let result=connection.call("airk_status".into(),args).await?;
        let snapshot=Snapshot{scope,epoch,cached:CachedStatus::new(scope,&result),result,submitted:true,reused:false,receipt:connection.status_receipt()};
        let mut cache=self.cache.lock().unwrap_or_else(|e|e.into_inner());
        if !self.closed.load(Ordering::Acquire)&&self.epoch.load(Ordering::Acquire)==epoch
            &&expires.is_none_or(|until|Instant::now()<until)&&snapshot.cached.is_some(){
            // Immutable logical observation only: no stream/read/transaction retained.
            let saved=Snapshot{scope,epoch,result:serde_json::Value::Null,cached:snapshot.cached.as_ref().map(|value|CachedStatus{
                scope:value.scope,captured:value.captured,observed_unix_ms:value.observed_unix_ms,body:value.body.clone()}),submitted:snapshot.submitted,reused:false,receipt:snapshot.receipt};
            *cache=Some(Arc::new(saved));
        }
        Ok(snapshot)
    }
    #[cfg(test)]
    pub(super) fn seed(&self,cached:CachedStatus){
        self.set_scope(cached.scope);let epoch=self.epoch.load(Ordering::Acquire);
        *self.cache.lock().unwrap_or_else(|e|e.into_inner())=Some(Arc::new(Snapshot{scope:cached.scope,epoch,
            result:serde_json::Value::Null,cached:Some(cached),submitted:false,reused:false,receipt:Default::default()}));
    }
    pub(crate) async fn shutdown(&self)->Result<()>{
        self.close();let mut state=self.state.lock().await;
        // Drain both owners even when the observer panics. A canceled drain keeps
        // the state and each actual handle in its slot for the next drain.
        let observed=if let State::Running(attempt)=&*state{attempt.join().await}else{Ok(())};
        let scoped=self.drain_scope().await;
        *state=State::Closed;
        match (observed,scoped){
            (Err(error),Err(scope))=>Err(error.context(format!("status scope drain also failed: {scope:#}"))),
            (Err(error),_)|(_,Err(error))=>Err(error),
            _=>Ok(()),
        }
    }
}
fn busy()->serde_json::Value{
    let detail=serde_json::json!({"error":{"code":"direct_query_admission","reason":"busy","query_submitted":false,
        "retryable":true,"retry_after_ms":25,"fresh_brokerage_required":false}});
    serde_json::json!({"content":[{"type":"text","text":detail.to_string()}],"isError":true})
}
fn superseded()->serde_json::Value{
    let detail=serde_json::json!({"error":{"code":"status_observation_superseded","query_submitted":true,
        "retryable":true,"fresh_brokerage_required":true}});
    serde_json::json!({"content":[{"type":"text","text":detail.to_string()}],"isError":true})
}

#[cfg(test)]
mod ownership_tests {
    use super::*;
    #[tokio::test]
    async fn source_and_pinned_cached_status_report_actual_reuse_and_original_age()->Result<()> {
        use airk_core::service::ProjectRegistration;
        use airk_store::service::registry::ServiceRegistry;
        let temporary=tempfile::tempdir()?;
        let namespace=airk_core::identity::Incarnation::from_bytes([95;16]);
        let mut registry=ServiceRegistry::open(temporary.path(),namespace)?;
        let project=ProjectRegistration::new("/cache-source".into(),"/cache-data".into(),"fixture".into())?;
        registry.register(&project)?;
        let pinned=status_scope(temporary.path(),project.binding)?.context("pinned scope missing")?;
        let fence=match pinned {CacheScope::Registered(fence)=>fence,_=>anyhow::bail!("registered pinned scope required")};
        for source in [false,true] {
            let owner=Arc::new(StatusOwner::default());
            let scope=if source{CacheScope::Source(fence)}else{pinned};
            let result=airk_mcp::unified::success(serde_json::json!({"index_state":"available","publication":{"token":"cached-original"}}));
            let mut cached=CachedStatus::new(scope,&result).context("cache construction failed")?;
            cached.captured=Instant::now()-Duration::from_secs(1);
            cached.observed_unix_ms=123;
            let captured=cached.captured;
            owner.seed(cached);
            // No native control listener exists. Only actual cached reuse can
            // produce this available reply; pinned still observes real registry.
            let reply=owner.status(temporary.path().into(),project.binding,Default::default(),
                source.then_some(fence),None,airk_core::usage::ClientFamily::Unknown).await?;
            let body:serde_json::Value=serde_json::from_str(reply["content"][0]["text"].as_str().context("cache reply missing")?)?;
            assert_eq!(body["cached"],true);
            assert_eq!(body["observed_unix_ms"],123);
            assert!(body["cache_age_ms"].as_u64().context("cache age missing")?>=1000);
            assert_eq!(body["publication"]["token"],"cached-original");
            assert_eq!(owner.cache.lock().unwrap().as_ref().unwrap().cached.as_ref().unwrap().captured,captured,
                "reuse must not rejuvenate its original capture time");
            owner.shutdown().await?;
        }
        Ok(())
    }
    #[tokio::test(flavor="multi_thread",worker_threads=2)]
    async fn coalesced_ipc_status_survives_all_waiters_then_eof_drain()->Result<()> {
        let directory=tempfile::tempdir()?;
        let root=directory.path().join("runtime");local_ipc::prepare_root(&root)?;
        let endpoint=local_ipc::endpoint(&root,"owned-status-test")?;
        let mut listener=local_ipc::Listener::bind(&endpoint)?;
        let (sent,submitted)=tokio::sync::oneshot::channel();
        let (release,finish)=tokio::sync::oneshot::channel();
        let receipt:airk_mcp::response::StatusReceipt=serde_json::from_value(serde_json::json!({"freshness":"cd".repeat(32)}))?;
        let peer=tokio::spawn(async move{
            let mut stream=listener.accept().await?;
            let query:Query=local_ipc::read_message(&mut stream,Duration::from_secs(5)).await?.context("missing status query")?;
            ensure!(query.tool=="airk_status","unexpected query");
            let _=sent.send(());finish.await?;
            local_ipc::write_message(&mut stream,&protocol::QueryResult{
                result:airk_mcp::unified::success(serde_json::json!({"index_state":"available","publication":{"token":"same"}})),
                status_receipt:receipt,rebind:false},Duration::from_secs(5)).await?;
            Ok::<_,anyhow::Error>(())
        });
        let stream=local_ipc::connect(&endpoint).await?;let now=Instant::now();
        let mut connection=Connection{stream,authorized_until:now+Duration::from_secs(55),last_finished:now,healthy:true,status_receipt:Default::default()};
        let owner=Arc::new(StatusOwner::default());
        let project="ab".repeat(32).parse()?;
        let fence=SourceFence{namespace:airk_core::identity::Incarnation::from_bytes([94;16]),revision:1,project,fencing_generation:1};
        owner.source_scope(fence);let scope=CacheScope::Source(fence);let epoch=owner.epoch.load(Ordering::Acquire);
        let key=Key{project,source:Some(fence),expires:None,args:serde_json::json!({})};
        {
        let first=owner.observe(key.clone(),None,move|owned|async move{
            let _accepted=owned.admit_request()?;
            let result=connection.call("airk_status".into(),Default::default()).await?;
            Ok(Snapshot{scope,epoch,result,cached:None,submitted:true,reused:false,receipt:connection.status_receipt()})
        });
        tokio::pin!(first);
        tokio::select!{result=&mut first=>anyhow::bail!("completed before release: {result:?}"),result=submitted=>{result?;}}
        let mut other=Vec::new();
        for _ in 0..3 {
            let mut request=Box::pin(owner.observe(key.clone(),None,|_|async{panic!("coalesced producer invoked")}));
            assert!(std::future::poll_fn(|cx|std::task::Poll::Ready(request.as_mut().poll(cx))).await.is_pending());
            other.push(request);
        }
        drop(other);
        // Drop the final waiter before EOF: the actual submitted exchange stays owned.
        } // drops the actual first future, not merely its pinned reference
        owner.close();
        {
            let drain=owner.shutdown();tokio::pin!(drain);
            assert!(std::future::poll_fn(|cx|std::task::Poll::Ready(drain.as_mut().poll(cx))).await.is_pending());
        }
        assert!(matches!(*owner.state.lock().await,State::Running(_)));
        release.send(()).map_err(|_|anyhow::anyhow!("peer disappeared"))?;
        owner.shutdown().await?;peer.await??;
        assert_eq!(owner.receipt(),Default::default());
        assert!(matches!(*owner.state.lock().await,State::Closed));
        Ok(())
    }
    #[tokio::test(flavor="multi_thread",worker_threads=2)]
    async fn canceled_shutdown_retains_actual_registry_worker_for_second_drain()->Result<()> {
        let owner=Arc::new(StatusOwner::default());
        let (entered,started)=tokio::sync::oneshot::channel();
        let (release,wait)=std::sync::mpsc::channel();
        *owner.scope_worker.lock().await=Some(tokio::task::spawn_blocking(move||{
            let _=entered.send(());wait.recv().context("release registry fixture")?;Ok(None)
        }));
        started.await?;
        {
            let shutdown=owner.shutdown();tokio::pin!(shutdown);
            assert!(std::future::poll_fn(|cx|std::task::Poll::Ready(shutdown.as_mut().poll(cx))).await.is_pending());
        }
        assert!(owner.closed.load(Ordering::Acquire));
        assert!(owner.scope_worker.lock().await.is_some());
        assert!(owner.admit_request().is_err());
        release.send(())?;
        owner.shutdown().await?;
        assert!(owner.scope_worker.lock().await.is_none());
        assert!(matches!(*owner.state.lock().await,State::Closed));
        Ok(())
    }
    #[tokio::test]
    async fn panic_fans_out_then_next_owned_observation_can_succeed()->Result<()> {
        let owner=Arc::new(StatusOwner::default());
        let project="ab".repeat(32).parse()?;
        let fence=SourceFence{namespace:airk_core::identity::Incarnation::from_bytes([95;16]),revision:1,project,fencing_generation:1};
        owner.source_scope(fence);
        let key=Key{project,source:Some(fence),expires:None,args:serde_json::json!({})};
        let (entered,started)=tokio::sync::oneshot::channel();
        let (release,wait)=tokio::sync::oneshot::channel();
        {
            let first=owner.observe(key.clone(),None,|_|async move{
                let _=entered.send(());let _=wait.await;panic!("cohort-status-panic")
            });tokio::pin!(first);
            tokio::select!{result=&mut first=>anyhow::bail!("premature result: {result:?}"),result=started=>{result?;}}
            let second=owner.observe(key.clone(),None,|_|async{panic!("duplicate producer")});tokio::pin!(second);
            assert!(std::future::poll_fn(|cx|std::task::Poll::Ready(second.as_mut().poll(cx))).await.is_pending());
            release.send(()).map_err(|_|anyhow::anyhow!("driver disappeared"))?;
            let (first,second)=tokio::join!(first,second);
            for error in [first.unwrap_err(),second.unwrap_err()]{assert!(format!("{error:#}").contains("cohort-status-panic"));}
        }
        assert!(matches!(*owner.state.lock().await,State::Idle));
        let epoch=owner.epoch.load(Ordering::Acquire);
        let result=owner.observe(key,None,move |_|async move{Ok(Snapshot{
            scope:CacheScope::Source(fence),epoch,result:serde_json::json!({"recovered":true}),
            cached:None,submitted:true,reused:false,receipt:Default::default()})}).await?;
        assert_eq!(result["recovered"],true);
        owner.shutdown().await?;
        Ok(())
    }
    #[tokio::test(flavor="multi_thread",worker_threads=2)]
    async fn canceled_failure_drain_retains_original_driver_panic()->Result<()> {
        let owner=StatusOwner::default();
        let (sender,result)=tokio::sync::watch::channel(None);
        drop(sender);
        let attempt=Attempt{key:Key{project:"ab".repeat(32).parse()?,source:None,expires:None,args:serde_json::json!({})},
            result,task:tokio::sync::Mutex::new(Some(tokio::spawn(async{panic!("original-status-driver-panic")}))),
            joined:Default::default(),failure:Default::default()};
        let original=attempt.join().await.unwrap_err();
        assert!(format!("{original:#}").contains("original-status-driver-panic"));
        let (entered,started)=tokio::sync::oneshot::channel();
        let (release,wait)=std::sync::mpsc::channel();
        *owner.scope_worker.lock().await=Some(tokio::task::spawn_blocking(move||{
            let _=entered.send(());wait.recv()?;Ok(None)
        }));
        started.await?;
        {
            let failed=attempt.failed(&owner);tokio::pin!(failed);
            assert!(std::future::poll_fn(|cx|std::task::Poll::Ready(failed.as_mut().poll(cx))).await.is_pending());
        }
        assert!(owner.scope_worker.lock().await.is_some());
        release.send(())?;
        let error=match attempt.failed(&owner).await{Err(error)=>error,Ok(_)=>panic!("panic became success")};
        assert!(format!("{error:#}").contains("original-status-driver-panic"));
        assert!(!format!("{error:#}").contains("ended without result"));
        assert!(owner.scope_worker.lock().await.is_none());
        Ok(())
    }
    #[test]
    fn exact_request_admission_linearizes_before_close_without_reusable_authority(){
        let owner=StatusOwner::default();
        let accepted=owner.admit_request().unwrap();
        owner.close();
        assert!(owner.admit_request().is_err());
        drop(accepted); // ownership permits only completion of this accepted request
    }
    #[test]
    fn late_old_scope_receipt_cannot_acknowledge_replacement()->Result<()> {
        let owner=StatusOwner::default();
        let old=SourceFence{namespace:airk_core::identity::Incarnation::from_bytes([92;16]),
            revision:7,project:"ab".repeat(32).parse()?,fencing_generation:1};
        owner.source_scope(old);
        let captured=owner.receipt_fence();
        let receipt:airk_mcp::response::StatusReceipt=serde_json::from_value(serde_json::json!({"freshness":"cd".repeat(32)}))?;
        owner.source_scope(SourceFence{revision:8,..old});
        owner.adopt_receipt(captured,receipt);
        assert_eq!(owner.receipt(),Default::default());
        let current=owner.receipt_fence();
        owner.adopt_receipt(current,receipt);
        assert_eq!(owner.receipt(),receipt);
        Ok(())
    }
    #[test]
    fn same_head_invalidation_rejects_old_snapshot_without_receipt_ack()->Result<()> {
        let owner=StatusOwner::default();
        let fence=SourceFence{namespace:airk_core::identity::Incarnation::from_bytes([93;16]),
            revision:7,project:"ab".repeat(32).parse()?,fencing_generation:1};
        owner.source_scope(fence);
        let snapshot=Snapshot{scope:CacheScope::Source(fence),epoch:owner.epoch.load(Ordering::Acquire),
            result:serde_json::Value::Null,cached:None,submitted:true,reused:false,receipt:Default::default()};
        owner.invalidate(); // model/work/pause may change while publication stays identical
        let reply=owner.reply(&snapshot,None,false)?;
        let detail:serde_json::Value=serde_json::from_str(reply["content"][0]["text"].as_str().unwrap())?;
        assert_eq!(detail["error"]["code"],"status_observation_superseded");
        assert_eq!(detail["error"]["query_submitted"],true);
        Ok(())
    }
}
