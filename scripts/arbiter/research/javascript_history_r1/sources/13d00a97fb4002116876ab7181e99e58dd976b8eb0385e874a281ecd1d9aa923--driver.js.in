 })().catch(error=>fs.writeFile("D:\\code\\Github\\airk\\artifacts\\editor-qualification\\agent-install-VhoaRv\\error.json",JSON.stringify({error:String(error),stack:error.stack}))).finally(()=>{if(!reloading)return vscode.commands.executeCommand('workbench.action.quit');});};