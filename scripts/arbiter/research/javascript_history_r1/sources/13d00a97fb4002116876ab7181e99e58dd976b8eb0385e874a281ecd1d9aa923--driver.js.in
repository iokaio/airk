const vscode=require('vscode'),fs=require('node:fs/promises'),path=require('node:path'),assert=require('node:assert/strict');
exports.activate=()=>{let reloading=false;void (async()=>{
 const extension=vscode.extensions.getExtension('iokaio.airk');assert.ok(extension);assert.ok(extension.extensionPath.startsWith("D:\\code\\Github\\airk\\artifacts\\editor-qualification\\agent-install-VhoaRv\\extensions"));
 const api=await extension.activate();const definitions=await api.getServerDefinitions();assert.equal(definitions.length,1);
