  reloading=true;await vscode.commands.executeCommand('workbench.action.reloadWindow');return;
 }
 assert.equal(extension.packageJSON.version,"1.4.1");
 if(true){const old=JSON.parse(await fs.readFile("D:\\code\\Github\\airk\\artifacts\\editor-qualification\\agent-install-VhoaRv\\baseline.json",'utf8'));assert.equal(old.args[12],definition.args[12]);assert.equal(old.args[8],definition.args[8]);}
 if(true){
  const spec={command:definition.command,root:"D:\\code\\Github\\airk\\artifacts\\editor-qualification\\agent-install-VhoaRv\\workspace",dataDir:definition.args[8],collection:"project-358bf72c9402c772f617971f",name:'fixture',service:{installDir:definition.args[3],project:definition.args[12]}};
  const live=await require(path.join(extension.extensionPath,'out/native.js')).probeMcp(spec,16,'upgrade-before-reconnect');
  const status=JSON.parse(live.status.content[0].text);assert.equal(status.runtime.service.version,"1.4.1");
  await fs.writeFile("D:\\code\\Github\\airk\\artifacts\\editor-qualification\\agent-install-VhoaRv\\new-runtime-active.json",JSON.stringify(status));
  const deadline=Date.now()+45000;while(!await fs.access("D:\\code\\Github\\airk\\artifacts\\editor-qualification\\agent-install-VhoaRv\\clients-reconnected.json").then(()=>true,()=>false)){if(Date.now()>deadline)throw new Error('Retained clients were not disconnected');await new Promise(resolve=>setTimeout(resolve,100));}
 }
 const texts=await Promise.all(files.map(file=>fs.readFile(file,'utf8')));
 for(const text of texts){assert.ok(text.includes('airk-launcher'));assert.ok(text.includes('--service-project'));assert.ok(text.includes("project-358bf72c9402c772f617971f"));}
 assert.ok(texts[0].includes('enabled = false'));assert.ok(texts[0].includes('AIRK_CLIENT = "fixture"'));
 for(const index of [1,2]){const value=JSON.parse(texts[index]),servers=value[index===1?'mcpServers':'servers'];assert.equal(servers[name].disabled,true);assert.equal(servers[name].env.AIRK_CLIENT,'fixture');assert.equal(servers.other.command,'preserve-other');assert.equal(servers[name].command,definition.command);assert.deepEqual(servers[name].args,definition.args);}
 await vscode.commands.executeCommand('airk.installCli');assert.deepEqual(await Promise.all(files.map(file=>fs.readFile(file,'utf8'))),texts);
 await vscode.commands.executeCommand('notifications.showList');
 await fs.writeFile("D:\\code\\Github\\airk\\artifacts\\editor-qualification\\agent-install-VhoaRv\\notification-ready.json",'{}');
 const noticeDeadline=Date.now()+45000;
 while(!await fs.access("D:\\code\\Github\\airk\\artifacts\\editor-qualification\\agent-install-VhoaRv\\notification-verified.json").then(()=>true,()=>false)){if(Date.now()>noticeDeadline)throw new Error('Installer notification was not verified');await new Promise(resolve=>setTimeout(resolve,100));}
 const spec={command:definition.command,root:"D:\\code\\Github\\airk\\artifacts\\editor-qualification\\agent-install-VhoaRv\\workspace",dataDir:definition.args[8],collection:"project-358bf72c9402c772f617971f",name:'fixture',service:{installDir:definition.args[3],project:definition.args[12]}};
 const probe=await require(path.join(extension.extensionPath,'out/native.js')).probeMcp(spec,16,'installer-acceptance');assert.ok(probe.tools.includes('airk_status'));
