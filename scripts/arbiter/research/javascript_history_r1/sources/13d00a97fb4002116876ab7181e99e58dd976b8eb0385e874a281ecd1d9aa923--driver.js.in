 if("1.4.0"&&!await fs.access("D:\\code\\Github\\airk\\artifacts\\editor-qualification\\agent-install-VhoaRv\\baseline.json").then(()=>true,()=>false)){
  assert.equal(extension.packageJSON.version,"1.4.0");
