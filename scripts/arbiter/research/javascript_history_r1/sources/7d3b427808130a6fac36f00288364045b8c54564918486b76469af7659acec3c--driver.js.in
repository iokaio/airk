const vscode=require('vscode'),path=require('node:path'),{publishMailbox}=require("D:\\code\\Github\\airk\\scripts\\editor-mailbox.cjs");
exports.activate=()=>{if(!process.env.AIRK_EDITOR_RUN)return;void require("D:\\code\\Github\\airk\\packages\\vscode\\out\\test\\installedEditor.js").run()
.catch(error=>publishMailbox(path.join(process.env.AIRK_EDITOR_RUN,process.env.AIRK_EDITOR_SCENARIO,process.env.AIRK_EDITOR_ROLE+'-error.json'),{error:String(error),stack:error.stack}))
.finally(()=>vscode.commands.executeCommand('workbench.action.quit'));};