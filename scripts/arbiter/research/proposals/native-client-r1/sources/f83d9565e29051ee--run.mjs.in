const bundle=await build({absWorkingDir:root,entryPoints:['src/workbenchWebview/main.tsx'],bundle:true,write:false,outdir:'out/unused-enter-diagnostic',format:'iife',platform:'browser',jsx:'automatic',jsxImportSource:'preact'});const b=await browserHarness();const observations=[];
const sample=async name=>observations.push({name,...await b.evaluate(`({focused:document.hasFocus(),active:{tag:document.activeElement?.tagName,label:document.activeElement?.getAttribute('aria-label'),text:document.activeElement?.textContent},panel:document.querySelector('#evidence-options')?.getAttribute('aria-label'),context:!!document.querySelector('[aria-label="Context question"]'),keys:window.keys,requests:window.requests})`)});
const key=async(value,text)=>{const n={ArrowDown:40,End:35,Home:36,Enter:13}[value];await b.call('Input.dispatchKeyEvent',{type:'keyDown',key:value,code:value,windowsVirtualKeyCode:n,...(text?{text:String.fromCharCode(13),unmodifiedText:String.fromCharCode(13)}:{})});await b.call('Input.dispatchKeyEvent',{type:'keyUp',key:value,code:value,windowsVirtualKeyCode:n});await b.evaluate('new Promise(resolve=>requestAnimationFrame(()=>requestAnimationFrame(resolve)))');};
try{await b.call('Emulation.setDeviceMetricsOverride',{width:320,height:720,deviceScaleFactor:1,mobile:false});await b.evaluate(`document.body.replaceChildren();{const root=document.createElement('div');root.id='root';document.body.append(root);}window.requests=[];window.keys=[];window.acquireVsCodeApi=()=>({postMessage:message=>window.requests.push(message)});for(const type of ['keydown','keyup','keypress'])document.addEventListener(type,event=>window.keys.push({type,key:event.key,code:event.code,which:event.which,charCode:event.charCode,keyCode:event.keyCode,trusted:event.isTrusted,prevented:event.defaultPrevented,target:event.target.textContent?.slice(0,60),focus:document.hasFocus()}));`);await b.evaluate(`{const style=document.createElement('style');style.textContent=${JSON.stringify(bundle.outputFiles.find(f=>f.path.endsWith('.css')).text)};document.head.append(style);}`);await b.evaluate(bundle.outputFiles.find(f=>f.path.endsWith('.js')).text);await b.observed(`window.requests.some(e=>e.type==='ready')`);await b.evaluate(`window.dispatchEvent(new MessageEvent('message',{data:{type:'state',state:{projects:[{id:'c'.repeat(64),name:'Fixture'}],project:'c'.repeat(64),recent:[],cards:{},busy:false,save:'',persistence:false}}}));`);await b.evaluate(`document.querySelector('button[aria-controls="evidence-options"]').click()`);await b.observed(`document.querySelector('#evidence-options[role="menu"]')`);await key('ArrowDown');await key('End');await key('Home');await sample('before-original-enter');await key('Enter',true);await sample('after-complete-enter');
const hits=await b.evaluate(`['textarea[aria-label="Request indexed evidence"]','.toolbar .project'].map(selector=>{const node=document.querySelector(selector),r=node.getBoundingClientRect(),point={x:r.x+Math.min(20,r.width/2),y:r.y+Math.min(20,r.height/2)},hit=document.elementFromPoint(point.x,point.y);return {selector,rect:JSON.parse(JSON.stringify(r)),point,actual_hit:{tag:hit?.tagName,label:hit?.getAttribute('aria-label'),text:hit?.textContent?.slice(0,80)},popup:hit?.closest('#evidence-options')!==null};})`);observations.push({name:'actual-pointer-hit-targets',hits});
const point=hits[1].point;await b.call('Input.dispatchMouseEvent',{type:'mousePressed',...point,button:'left',clickCount:1});await b.call('Input.dispatchMouseEvent',{type:'mouseReleased',...point,button:'left',clickCount:1});await b.evaluate('new Promise(resolve=>requestAnimationFrame(()=>requestAnimationFrame(resolve)))');await sample('after-actual-uncovered-project-click');

}finally{await b.close();await writeFile(join(out,'observations.json'),JSON.stringify({scope:'fresh actual Edge/source DOM, synthetic host, trusted CDP key variants; diagnosis only',observations,browser:b.observation},null,2));}
