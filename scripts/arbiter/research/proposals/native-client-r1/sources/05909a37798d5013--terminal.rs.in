#[derive(Clone, Debug, Serialize)]
pub struct TerminalPanelSummary {
    pub population: usize,
    pub accepted: usize,
    pub accepted_repository_clusters: usize,
    pub coverage: f64,
    pub accepted_sample: Sha256Digest,
}
#[derive(Clone, Debug, Serialize)]
pub struct TerminalQualificationSummary {
    pub action: ContextActionClass,
    pub calibration: TerminalPanelSummary,
    pub confirmation: TerminalPanelSummary,
    pub one_sided_95_false_acceptance_upper: f64,
}
fn nonzero(digest: Sha256Digest) -> bool {
    digest.as_bytes().iter().any(|byte| *byte != 0)
}

/// Bind preregistered panel membership before scores exist. Rust emits this
/// identity; model scores and downstream capture paths cannot select members.
pub fn population_identity(rows: &[TerminalObservation]) -> Result<Sha256Digest> {
    let mut members = rows
        .iter()
        .map(|row| {
            Ok((
                &row.id,
                &row.repository_cluster,
                row.visible_input()?,
                row.human_annotations,
            ))
        })
        .collect::<Result<Vec<_>>>()?;
    members.sort_by(|left, right| left.0.cmp(right.0));
    Ok(framed_digest(
        b"airk.arbiter.context-terminal-population/1",
        &[&serde_json::to_vec(&members)?],
    ))
}
fn validate_terminal_rule(rule: &JointRule) -> Result<()> {
    ensure!(
        rule.minimum_raw_margin.is_finite()
            && rule.minimum_raw_margin >= 0.0
            && !rule.allowed_gaps.is_empty()
            && rule.allowed_gaps.len() <= 8
            && !rule.allowed_reasons.is_empty()
            && rule.allowed_reasons.len() <= 10
            && rule.allowed_roles.len() <= 7
            && rule.allowed_relevance.len() <= 4,
        "invalid terminal whole-card rule"
    );
    unique(&rule.allowed_gaps)?;
    unique(&rule.allowed_reasons)?;
    unique(&rule.allowed_roles)?;
    unique(&rule.allowed_relevance)?;
    match rule.action {
        ContextActionClass::Read => anyhow::bail!("generic Read cannot supply terminal semantics"),
        ContextActionClass::Sufficient => ensure!(
            rule.allowed_gaps == [Gap::Sufficient]
                && rule.allowed_reasons == [ContextReason::RetainedEvidenceCoversQuestion]
                && !rule.allowed_roles.is_empty()
                && !rule.allowed_roles.contains(&EvidenceRole::Unknown)
                && !rule.allowed_relevance.is_empty()
                && rule.allowed_relevance.iter().all(|value| matches!(
                    value,
                    RelevanceHypothesis::Useful | RelevanceHypothesis::Complementary
                )),
            "terminal Sufficient rule lacks complete retained support semantics"
        ),
        ContextActionClass::Clarify => ensure!(
            rule.allowed_gaps == [Gap::Ambiguous]
                && rule.allowed_reasons.iter().all(|value| matches!(
                    value,
                    ContextReason::AmbiguousQuestion | ContextReason::ConflictingEvidence
                )),
            "terminal Clarify rule lacks genuine ambiguity semantics"
        ),
        ContextActionClass::NoJustifiedRead => ensure!(
            !rule.allowed_gaps.contains(&Gap::Sufficient)
                && rule.allowed_reasons == [ContextReason::NoVerifiedUsefulRead],
            "terminal NoJustifiedRead rule lacks complete-menu semantics"
        ),
    }
    Ok(())
}

fn replay(
    rule: &JointRule,
    policy: Sha256Digest,
    rows: &[TerminalObservation],
) -> Result<TerminalPanelSummary> {
    ensure!(
        !rows.is_empty() && rows.len() <= 10_000,
        "bounded nonempty terminal panel required"
    );
    let mut ids = BTreeSet::new();
    let mut inputs = BTreeSet::new();
    let mut clusters = BTreeSet::new();
    let mut accepted = Vec::new();
    for row in rows {
        row.validate(rule.action, policy)?;
        ensure!(
            ids.insert(&row.id) && inputs.insert(row.visible_input()?),
            "duplicate terminal question or visible input"
        );
        let selected = row
            .scores
            .as_ref()
            .map(|scores| raw_winner(scores))
            .transpose()?
            .flatten();
        if let Some((index, margin)) = selected {
            let card = &row.roster.cards[index];
            if rule.supports(card) && margin >= rule.minimum_raw_margin {
                ensure!(
                    row.accepted_whole_cards.contains(&card.id),
                    "false or UNKNOWN terminal admission"
                );
                clusters.insert(&row.repository_cluster);
                accepted.push((
                    &row.id,
                    &row.repository_cluster,
                    row.visible_input()?,
                    card.id,
                    margin,
                    row.human_annotations,
                    row.native_capture,
                ));
            }
        }
    }
    Ok(TerminalPanelSummary {
        population: rows.len(),
        accepted: accepted.len(),
        accepted_repository_clusters: clusters.len(),
        coverage: accepted.len() as f64 / rows.len() as f64,
        accepted_sample: framed_digest(
            b"airk.arbiter.context-terminal-accepted-sample/1",
            &[&serde_json::to_vec(&accepted)?],
        ),
    })
}

/// CAL-only cutoff fit. It never creates labels, confirmation or qualification.
pub fn fit_terminal_rule(
    template: &JointRule,
    policy: Sha256Digest,
    rows: &[TerminalObservation],
) -> Result<Option<JointRule>> {
    validate_terminal_rule(template)?;
    ensure!(
        !rows.is_empty() && rows.len() <= 10_000,
        "bounded terminal CAL panel required"
    );
    let mut seen = BTreeSet::new();
    let mut inputs = BTreeSet::new();
    for row in rows {
        ensure!(
            seen.insert(&row.id) && inputs.insert(row.visible_input()?),
            "duplicate terminal CAL question/input"
        );
    }
    let mut boundaries = vec![0.0_f32];
    for row in rows {
        row.validate(template.action, policy)?;
        if let Some(scores) = &row.scores {
            if let Some((_, margin)) = raw_winner(scores)? {
                boundaries.push(margin);
                if margin.next_up().is_finite() {
                    boundaries.push(margin.next_up());
                }
            }
        }
    }
    boundaries.sort_by(f32::total_cmp);
    boundaries.dedup_by(|a, b| *a == *b);
    let mut best: Option<(usize, JointRule)> = None;
    for margin in boundaries {
        let mut candidate = template.clone();
        candidate.minimum_raw_margin = margin;
        // A nonadmitted class is never substituted for the raw global winner.
        if let Ok(summary) = replay(&candidate, policy, rows) {
            if summary.accepted > 0
                && best.as_ref().is_none_or(|(accepted, rule)| {
                    summary.accepted > *accepted
                        || summary.accepted == *accepted && margin > rule.minimum_raw_margin
                })
            {
                best = Some((summary.accepted, candidate));
            }
        }
    }
    Ok(best.map(|(_, rule)| rule))
}

impl TerminalQualification {
    /// Native pre-score template. Only its CAL-chosen numeric cutoff may change.
    pub fn criteria_freeze_document(&self) -> Result<serde_json::Value> {
        let mut criteria = serde_json::to_value(&self.criteria)?;
        criteria
            .as_object_mut()
            .ok_or_else(|| anyhow::anyhow!("terminal criteria object"))?
            .remove("freeze");
        let mut template = self.rule.clone();
        template.minimum_raw_margin = 0.0;
        Ok(
            serde_json::json!({"schema":"airk.arbiter.context-terminal-criteria-freeze/1","action":self.rule.action,"criteria":criteria,"rule_template":template}),
        )
    }
    pub fn validate_criteria_freeze(&self, raw: &[u8]) -> Result<()> {
        let actual: serde_json::Value = serde_json::from_slice(raw)?;
        let expected = self.criteria_freeze_document()?;
        ensure!(
            ["schema", "action", "criteria", "rule_template"]
                .iter()
                .all(|key| actual[*key] == expected[*key]),
            "terminal criteria/population/rule differ from the pre-score freeze"
        );
        Ok(())
    }

    pub fn validate(
        &self,
        calibration: &JointCalibration,
        analysis: &IndependenceAnalysis,
    ) -> Result<TerminalQualificationSummary> {
        self.criteria.validate()?;
        validate_terminal_rule(&self.rule)?;
        ensure!(
            self.criteria.calibration_population == population_identity(&self.calibration)?
                && self.criteria.confirmation_population
                    == population_identity(&self.confirmation)?,
            "terminal panel differs from preregistered population"
        );
        calibration.validate_class_support()?;
        ensure!(
            self.schema == QUALIFICATION_SCHEMA
                && self.rule.action != ContextActionClass::Read
                && self.model == calibration.model
                && self.compiler == calibration.compiler
                && self.task_policy == calibration.task_policy
                && self.assets == calibration.assets
                && calibration.schema == CALIBRATION_SCHEMA_V2
                && calibration
                    .rules
                    .iter()
                    .filter(|rule| rule.action == self.rule.action)
                    .count()
                    == 1
                && calibration.rules.iter().any(
                    |rule| serde_json::to_vec(rule).ok() == serde_json::to_vec(&self.rule).ok()
                )
                && nonzero(self.independence_analysis),
            "terminal qualification/profile/rule mismatch"
        );
        let mut ids = BTreeSet::new();
        let mut inputs = BTreeSet::new();
        let cal_clusters: BTreeSet<_> = self
            .calibration
            .iter()
            .map(|row| &row.repository_cluster)
            .collect();
        for row in self.calibration.iter().chain(&self.confirmation) {
            ensure!(
                ids.insert(&row.id) && inputs.insert(row.visible_input()?),
                "CAL/confirmation question or visible-input overlap"
            );
        }
        ensure!(
            self.confirmation
                .iter()
                .all(|row| !cal_clusters.contains(&row.repository_cluster)),
            "CAL/confirmation repository cluster overlap"
        );
        let fitted = fit_terminal_rule(&self.rule, self.task_policy, &self.calibration)?
            .ok_or_else(|| anyhow::anyhow!("no positive zero-error CAL terminal cutoff"))?;
        ensure!(
            fitted.minimum_raw_margin.to_bits() == self.rule.minimum_raw_margin.to_bits(),
            "terminal cutoff differs from the deterministic CAL-only fit"
        );
        let cal = replay(&self.rule, self.task_policy, &self.calibration)?;
        let confirmation = replay(&self.rule, self.task_policy, &self.confirmation)?;
        ensure!(
            cal.population >= self.criteria.minimum_cal_population
                && confirmation.population >= self.criteria.minimum_confirmation_population
                && cal.accepted >= self.criteria.minimum_cal_accepted
                && confirmation.accepted >= self.criteria.minimum_confirmation_accepted
                && cal.coverage >= self.criteria.minimum_coverage
                && confirmation.coverage >= self.criteria.minimum_coverage,
            "terminal population/positive/coverage criteria not met"
        );
        ensure!(
            analysis.schema == INDEPENDENCE_SCHEMA
                && analysis.action == self.rule.action
                && analysis.criteria_freeze == self.criteria.freeze
                && analysis.accepted_sample == confirmation.accepted_sample
                && analysis.accepted_cases == confirmation.accepted
                && analysis.repository_clusters == confirmation.accepted_repository_clusters
                && analysis.method == "reviewed_repository_cluster_effective_n/1"
                && analysis.effective_independent_cases.is_finite()
                && analysis.effective_independent_cases > 0.0
                && analysis.effective_independent_cases <= confirmation.accepted as f64,
            "missing or mismatched reviewed repository-cluster independence analysis"
        );
        let upper = 1.0 - 0.05_f64.powf(1.0 / analysis.effective_independent_cases);
        ensure!(
            upper.is_finite()
                && upper < self.criteria.maximum_false_acceptance_upper
                && upper < 0.01,
            "terminal one-sided95% false-acceptance upper risk not below frozen limit"
        );
        Ok(TerminalQualificationSummary {
            action: self.rule.action,
            calibration: cal,
            confirmation,
            one_sided_95_false_acceptance_upper: upper,
        })
    }
    /// Compare each human/capture row with exact original approved source bytes.
    /// The caller, never this metadata, establishes human/native authority.
    pub fn validate_sources(
        &self,
        annotations: &BTreeMap<Sha256Digest, TerminalAnnotations>,
        captures: &BTreeMap<Sha256Digest, TerminalRawCapture>,
    ) -> Result<()> {
        for row in self.calibration.iter().chain(&self.confirmation) {
            let labels = annotations
                .get(&row.human_annotations)
                .ok_or_else(|| anyhow::anyhow!("original human annotation source missing"))?;
            ensure!(
                labels.schema == ANNOTATIONS_SCHEMA
                    && !labels.human_review_reference.trim().is_empty()
                    && labels.human_review_reference.len() <= 4096
                    && labels
                        .rows
                        .iter()
                        .map(|label| &label.id)
                        .collect::<BTreeSet<_>>()
                        .len()
                        == labels.rows.len(),
                "human annotation source identity/duplicates"
            );
            let label = labels
                .rows
                .iter()
                .find(|label| label.id == row.id)
                .ok_or_else(|| anyhow::anyhow!("human whole-card label missing"))?;
            ensure!(
                label.action == self.rule.action
                    && label.repository_cluster == row.repository_cluster
                    && label.visible_input == row.visible_input()?
                    && label.accepted_whole_cards == row.accepted_whole_cards,
                "human label does not cover the exact whole-card claim"
            );
            let capture = captures
                .get(&row.native_capture)
                .ok_or_else(|| anyhow::anyhow!("original native score capture missing"))?;
            ensure!(
                capture.schema == RAW_CAPTURE_SCHEMA
                    && capture.model == self.model
                    && capture.compiler == self.compiler
                    && capture.task_policy == self.task_policy
                    && capture.assets == self.assets
                    && !capture.execution_identity.trim().is_empty()
                    && capture.execution_identity.len() <= 4096
                    && nonzero(capture.native_execution_receipt)
                    && capture
                        .rows
                        .iter()
                        .map(|raw| &raw.id)
                        .collect::<BTreeSet<_>>()
                        .len()
                        == capture.rows.len(),
                "native terminal capture binding/duplicates"
            );
            let raw = capture
                .rows
                .iter()
                .find(|raw| raw.id == row.id)
                .ok_or_else(|| anyhow::anyhow!("native raw score row missing"))?;
            ensure!(
                raw.scores.is_none()
                    || raw.compiled_input.is_some_and(nonzero)
                        && raw
                            .input_tokens
                            .is_some_and(|tokens| (1..=8192).contains(&tokens)),
                "scored terminal row lacks actual compiled input binding"
            );
            ensure!(
                raw.visible_input == row.visible_input()? && same_scores(&raw.scores, &row.scores),
                "native terminal raw scores/input differ"
            );
        }
        Ok(())
    }
}
fn same_scores(left: &Option<Vec<f32>>, right: &Option<Vec<f32>>) -> bool {
    match (left, right) {
        (None, None) => true,
        (Some(left), Some(right)) => {
            left.len() == right.len()
                && left
                    .iter()
                    .zip(right)
                    .all(|(left, right)| left.to_bits() == right.to_bits())
        }
        _ => false,
    }
}

#[cfg(test)]
mod tests;
