import assert from 'node:assert/strict';
import {createServer} from 'node:http';import {once} from 'node:events';import {createHash} from 'node:crypto';import {readFile,writeFile} from 'node:fs/promises';import {dirname,join} from 'node:path';import {fileURLToPath} from 'node:url';
import {browserHarness} from 'file:///D:/code/Github/airk/artifacts/v190/final-plan/candidate-worktree-r1/packages/ui/test/browserHarness.mjs';
const out=dirname(fileURLToPath(import.meta.url));const r={schema:'airk.private.windows-clipboard-control/1',passed:false,projection:'Only CRLF to LF; reject bare CR; preserve all other characters and trailing newlines',cases:[]};
const sha=s=>createHash('sha256').update(s).digest('hex');const server=createServer((req,res)=>{res.setHeader('Content-Type','text/html');res.end('<title>Private clipboard roundtrip control</title>');});server.listen(0,'127.0.0.1');await once(server,'listening');const origin='http://127.0.0.1:'+server.address().port;
const b=await browserHarness();r.browser=b.observation;let previous,ownedLast;
try{await b.call('Browser.grantPermissions',{origin,permissions:['clipboardReadWrite','clipboardSanitizedWrite']});await b.call('Page.navigate',{url:origin});await b.call('Emulation.setFocusEmulationEnabled',{enabled:true});await b.call('Page.bringToFront');await b.observed('!!navigator.clipboard&&document.hasFocus()');previous=await b.evaluate('navigator.clipboard.readText()');
const manual=JSON.parse(await readFile(join(out,'../ui-live-admin-r1/request.json'),'utf8')).endpoint.manual;
const cases=[{name:'LF exact sentinel with trailing newline and non-ASCII',text:'AIRK clipboard sentinel Î±\\literal\n
second
last
'},{name:'CRLF native Windows control',text:'AIRK CRLF
second
'},...manual.map(e=>({name:'complete '+e.client+' native entry',text:e.text}))];
for(const row of cases){await b.evaluate(`navigator.clipboard.writeText(${JSON.stringify(row.text)})`);const actual=await b.evaluate('navigator.clipboard.readText()');ownedLast=actual;assert.ok(!/\r(?!\n)/.test(actual),'Bare CR rejected');const canonical=row.text.replaceAll('\r\n','\n');assert.equal(actual.replaceAll('\r\n','\n'),canonical);assert.equal(actual,canonical.replaceAll('\n','\r\n'),'Unexpected Windows newline projection');r.cases.push({name:row.name,sent:row.text,actual,source_sha256:sha(row.text),actual_sha256:sha(actual),exact_platform_projection:true,all_non_newline_bytes_preserved:true});}
r.passed=true;
}finally{try{if(previous!==undefined){const current=await b.evaluate('navigator.clipboard.readText()');if(current===ownedLast){await b.evaluate(`navigator.clipboard.writeText(${JSON.stringify(previous)})`);r.original_clipboard_restored_in_memory=(await b.evaluate('navigator.clipboard.readText()'))===previous;}else r.clipboard_restore='Not overwritten: clipboard changed outside this control';}}finally{await b.close();server.close();await writeFile(join(out,'result.json'),JSON.stringify(r,null,2)+'\n');}}
console.log(JSON.stringify({passed:r.passed,cases:r.cases.length,original_clipboard_restored_in_memory:r.original_clipboard_restored_in_memory,browser:r.browser}));
