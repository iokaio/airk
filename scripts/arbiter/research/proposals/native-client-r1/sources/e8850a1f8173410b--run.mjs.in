import {readFile,writeFile} from 'node:fs/promises';import {dirname,join} from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
import {browserHarness} from 'file:///D:/code/Github/airk/artifacts/v190/final-plan/exec-20261116T052942Z/ui-workbench-build-r1/source/packages/ui/test/browserHarness.mjs';
const out=dirname(fileURLToPath(import.meta.url)),compiled=join(out,'../source/packages/vscode/out');const js=await readFile(join(compiled,'workbenchWebview.js'),'utf8'),css=await readFile(join(compiled,'workbenchWebview.css'),'utf8');const sha=s=>createHash('sha256').update(s).digest('hex');const b=await browserHarness();const r={scope:'Actual generated Workbench JS/CSS in real Edge with synthetic host state and explicit synthetic VSCode dark theme; not installed editor or native parity',js_sha256:sha(js),css_sha256:sha(css),views:[],browser:b.observation};
const theme={'--vscode-font-family':'Segoe UI, sans-serif','--vscode-font-size':'13px','--vscode-foreground':'#cccccc','--vscode-sideBar-background':'#181818','--vscode-editorWidget-background':'#202020','--vscode-panel-border':'#363636','--vscode-menu-background':'#252526','--vscode-menu-foreground':'#cccccc','--vscode-widget-border':'#454545','--vscode-widget-shadow':'#00000080','--vscode-input-background':'#313131','--vscode-input-foreground':'#cccccc','--vscode-input-border':'#454545','--vscode-button-secondaryBackground':'#333333','--vscode-button-secondaryHoverBackground':'#454545','--vscode-button-background':'#0078d4','--vscode-button-foreground':'#ffffff','--vscode-focusBorder':'#0078d4','--vscode-descriptionForeground':'#9d9d9d','--vscode-list-hoverBackground':'#353535','--vscode-toolbar-hoverBackground':'#353535','--vscode-editor-font-family':'Consolas, monospace','--vscode-editor-font-size':'13px','--vscode-textCodeBlock-background':'#171717'};r.synthetic_host_theme=theme;
const shot=async name=>{const img=await b.call('Page.captureScreenshot',{format:'png',captureBeyondViewport:false});await writeFile(join(out,name+'.png'),Buffer.from(img.data,'base64'));r.views.push({name,...await b.evaluate(`({composer_height:document.querySelector('.composer').getBoundingClientRect().height,transcript_height:document.querySelector('.transcript').getBoundingClientRect().height,popup:document.querySelector('#evidence-options')?.getAttribute('aria-label'),context_form_mounted:!!document.querySelector('[aria-label="Context question"]')})`)});};
try{await b.evaluate(`document.body.replaceChildren();{const root=document.createElement('div');root.id='root';document.body.append(root);const style=document.createElement('style');style.textContent=${JSON.stringify(css)};document.head.append(style);for(const [key,value]of Object.entries(${JSON.stringify(theme)}))document.documentElement.style.setProperty(key,value);}window.requests=[];window.acquireVsCodeApi=()=>({postMessage:message=>window.requests.push(message)});`);await b.evaluate(js);await b.observed(`window.requests.some(e=>e.type==='ready')`);await b.evaluate(`window.dispatchEvent(new MessageEvent('message',{data:{type:'state',state:{projects:[{id:'c'.repeat(64),name:'Preview workspace'}],project:'c'.repeat(64),session:{schema:1,id:'preview',project:'c'.repeat(64),title:'Preview',createdAt:1,updatedAt:1,revision:1,omitted:0,turns:[],formDraft:{revision:0,activeTool:'search',scope:'',recipe:'',values:{}}},sessionEpoch:1,recent:[],cards:{},busy:false,save:'',persistence:false}}}));{const input=document.querySelector('textarea[aria-label="Request indexed evidence"]');input.value='Where are request deadlines enforced?';input.dispatchEvent(new Event('input',{bubbles:true}));}`);
for(const width of [1000,320]){await b.call('Emulation.setDeviceMetricsOverride',{width,height:720,deviceScaleFactor:1,mobile:false});await shot('composer-rest-'+width);assert.equal(await b.evaluate(`document.querySelector('[aria-label="Context question"]')===null`),true);await b.evaluate(`document.querySelector('button[aria-controls="evidence-options"]').click()`);await b.observed(`document.querySelector('#evidence-options[role="menu"]')`);await shot('composer-plus-'+width);await b.evaluate(`[...document.querySelectorAll('[role="menuitem"]')].find(e=>e.textContent.startsWith('Gather cited context')).click()`);await b.observed(`document.querySelector('[aria-label="Context question"]')`);await shot('context-panel-'+width);await b.evaluate(`document.querySelector('#evidence-options summary').click()`);await shot('context-budget-'+width);await b.evaluate(`document.querySelector('[aria-label="Close evidence options"]').click()`);await b.observed(`!document.querySelector('#evidence-options')`);}
r.requests=await b.evaluate('window.requests');assert.deepEqual(r.requests,[{type:'ready'}]);r.passed=true;
}finally{await b.close();await writeFile(join(out,'receipt.json'),JSON.stringify(r,null,2));}
console.log(JSON.stringify({passed:r.passed,views:r.views,browser:r.browser}));
