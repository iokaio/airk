import {createRequire} from 'node:module';import {writeFile} from 'node:fs/promises';import {dirname,join} from 'node:path';import {fileURLToPath} from 'node:url';
import {browserHarness} from 'file:///D:/code/Github/airk/artifacts/v190/final-plan/exec-20261116T052942Z/ui-workbench-build-r1/source/packages/ui/test/browserHarness.mjs';
const out=dirname(fileURLToPath(import.meta.url)),root='D:/code/Github/airk/artifacts/v190/final-plan/exec-20261116T052942Z/ui-workbench-build-r1/source/packages/vscode';const {build}=createRequire(join(root,'package.json'))('esbuild');
const bundle=await build({absWorkingDir:root,entryPoints:['src/workbenchWebview/main.tsx'],bundle:true,write:false,outdir:'out/unused-enter-diagnostic',format:'iife',platform:'browser',jsx:'automatic',jsxImportSource:'preact'});const b=await browserHarness();const observations=[];
const sample=async name=>observations.push({name,...await b.evaluate(`({focused:document.hasFocus(),active:{tag:document.activeElement?.tagName,label:document.activeElement?.getAttribute('aria-label'),text:document.activeElement?.textContent},panel:document.querySelector('#evidence-options')?.getAttribute('aria-label'),context:!!document.querySelector('[aria-label="Context question"]'),keys:window.keys,requests:window.requests})`)});
const key=async(value,text)=>{const n={ArrowDown:40,End:35,Home:36,Enter:13}[value];await b.call('Input.dispatchKeyEvent',{type:'keyDown',key:value,code:value,windowsVirtualKeyCode:n,...(text?{text:String.fromCharCode(13),unmodifiedText:String.fromCharCode(13)}:{})});await b.call('Input.dispatchKeyEvent',{type:'keyUp',key:value,code:value,windowsVirtualKeyCode:n});await b.evaluate('new Promise(resolve=>requestAnimationFrame(()=>requestAnimationFrame(resolve)))');};
try{await b.call('Emulation.setDeviceMetricsOverride',{width:320,height:720,deviceScaleFactor:1,mobile:false});await b.evaluate(`document.body.replaceChildren();{const root=document.createElement('div');root.id='root';document.body.append(root);}window.requests=[];window.keys=[];window.acquireVsCodeApi=()=>({postMessage:message=>window.requests.push(message)});for(const type of ['keydown','keyup','keypress'])document.addEventListener(type,event=>window.keys.push({type,key:event.key,code:event.code,which:event.which,charCode:event.charCode,keyCode:event.keyCode,trusted:event.isTrusted,prevented:event.defaultPrevented,target:event.target.textContent?.slice(0,60),focus:document.hasFocus()}));`);await b.evaluate(bundle.outputFiles.find(f=>f.path.endsWith('.js')).text);await b.observed(`window.requests.some(e=>e.type==='ready')`);await b.evaluate(`window.dispatchEvent(new MessageEvent('message',{data:{type:'state',state:{projects:[{id:'c'.repeat(64),name:'Fixture'}],project:'c'.repeat(64),recent:[],cards:{},busy:false,save:'',persistence:false}}}));`);await b.evaluate(`document.querySelector('button[aria-controls="evidence-options"]').click()`);await b.observed(`document.querySelector('#evidence-options[role="menu"]')`);await key('ArrowDown');await key('End');await key('Home');await sample('before-original-enter');await key('Enter');await sample('after-original-enter');
if(!await b.evaluate(`!!document.querySelector('[aria-label="Context question"]')`)){await b.call('Emulation.setFocusEmulationEnabled',{enabled:true});await b.call('Page.bringToFront');await key('Enter');await sample('after-focus-and-identical-enter');}
if(!await b.evaluate(`!!document.querySelector('[aria-label="Context question"]')`)){await key('Enter',true);await sample('after-focused-enter-with-character');}
}finally{await b.close();await writeFile(join(out,'observations.json'),JSON.stringify({scope:'fresh actual Edge/source DOM, synthetic host, trusted CDP key variants; diagnosis only',observations,browser:b.observation},null,2));}
console.log(JSON.stringify(observations));
