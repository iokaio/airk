+    #[cfg(unix)]
+    {
+        let parent = base.join("redirected-parent");
+        std::os::unix::fs::symlink(&base, &parent)?;
+        assert!(require_missing_with_plain_parent(&parent.join("missing-child")).is_err());
+    }
+    Ok(())
