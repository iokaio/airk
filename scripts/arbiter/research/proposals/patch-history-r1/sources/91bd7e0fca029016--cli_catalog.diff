+        &self,
+        gate: NativeCatalogAdmission,
+    ) -> Result<CatalogControlHandle> {
+        let handle = CatalogControlHandle {
+            sender: Arc::downgrade(self.sender.as_ref().context("supervisor closed")?),
+            gate,
+            source: None,
