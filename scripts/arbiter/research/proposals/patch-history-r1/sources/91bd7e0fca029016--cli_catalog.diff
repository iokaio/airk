+            .is_err()
+    );
+    let response = CatalogCoordinator::observe_receipt(
+        &registry,
+        Some(&mut coordinator),
+        request.caller,
+        &request.key,
+    )?;
+    let first = serde_json::to_value(&response)?;
+    let airk_core::service::ControlResponse::CatalogReceiptUnprepared {
+        request: original,
+        request_digest,
+        catalog_clock,
+    } = response
