+        ControlMethod::CatalogApply {
+            request,
+            preview_digest,
+        },
+    )
+    .await?;
+    ensure!(
+        matches!(response, ControlResponse::CatalogApplied { .. }),
+        "union metadata apply refused: {}",
+        serde_json::to_string(&response)?
+    );
+    Ok(())
+}
