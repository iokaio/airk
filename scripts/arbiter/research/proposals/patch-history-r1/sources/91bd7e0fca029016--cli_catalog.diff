+    let wire = mcp.call(4, tool, args)?;
+    airk_core::index_catalog::encoded_size(&wire, 3 * airk_core::MAX_RESPONSE_BYTES + 8192)?;
+    ensure!(
+        wire.get("error").is_none() && wire.get("result").is_some_and(Value::is_object),
