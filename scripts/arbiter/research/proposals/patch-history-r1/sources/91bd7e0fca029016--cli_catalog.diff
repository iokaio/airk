+#[cfg(test)]
+#[path = "combined_frontend_tests.rs"]
+mod tests;
+
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct DiscoveryCursor {
+    schema: u32,
+    identity: Sha256Digest,
+    offset: usize,
+}
+
+#[derive(Default)]
+struct MemberProjection {
+    steps: Vec<Value>,
+    bindings: Vec<Value>,
+}
+
+fn collect_member_projections(
+    value: &Value,
+    pointer: &str,
+    subsets: &mut BTreeMap<IndexId, MemberProjection>,
+    depth: usize,
+) -> Result<()> {
+    ensure!(
+        depth <= 4,
+        "combined result nesting exceeds projection bound"
+    );
+    if let Some(rows) = value.as_array() {
+        ensure!(rows.len() <= 12, "combined plan fanout exceeds bound");
+        for (offset, row) in rows.iter().enumerate() {
+            collect_member_projections(row, &format!("{pointer}/{offset}"), subsets, depth + 1)?;
+        }
+        return Ok(());
+    }
+    let (body, pointer) = if let Some(body) = value.get("structuredContent") {
+        (body, format!("{pointer}/structuredContent"))
+    } else {
+        (value, pointer.to_owned())
+    };
+    if body.get("schema").and_then(Value::as_str) != Some("airk.combined-read/1") {
+        return Ok(());
+    }
+    let members = body
+        .get("members")
+        .and_then(Value::as_array)
+        .context("combined member projection missing")?;
+    ensure!(
+        members.len() <= 32,
+        "combined member projection exceeds bound"
+    );
+    for (offset, member) in members.iter().enumerate() {
+        let index: IndexId = serde_json::from_value(member["index_id"].clone())?;
+        let Some(result) = member.get("result").filter(|result| !result.is_null()) else {
+            continue;
+        };
+        // Failed reads can retain attempted evidence. Those returned references
+        // still need explicit verification accounting; a failure flag cannot
+        // silently remove them from the final projection's inventory.
+        let own = canonical_body(
+            &airk_core::combined_reads::shared_values::materialize_combined_member_result(
+                body, index,
+            )?,
+        );
+        ensure!(
+            own.get("schema").and_then(Value::as_str) != Some("airk.combined-read/1"),
+            "nested combined member projection refused"
+        );
+        let actual = format!(
+            "{pointer}/members/{offset}/result{}",
+            if result.get("structuredContent").is_some() {
+                "/structuredContent"
+            } else {
+                ""
+            }
+        );
+        let subset = subsets.entry(index).or_default();
+        let position = subset.steps.len();
+        subset.steps.push(json!({"result":own}));
+        subset.bindings.push(
+            json!({"member_pointer":format!("/steps/{position}/result"),"result_pointer":actual}),
+        );
+    }
+    Ok(())
+}
+
+fn canonical_body(result: &Value) -> Value {
+    if let Some(body) = result.get("structuredContent") {
+        return body.clone();
+    }
+    if let Some(text) = result.pointer("/content/0/text").and_then(Value::as_str)
+        && let Ok(body) = serde_json::from_str::<Value>(text)
+    {
+        return body;
+    }
+    result.clone()
+}
+
+fn publication_token(body: &Value) -> Option<&str> {
+    body.pointer("/publication/token")
+        .or_else(|| body.pointer("/read/publication/token"))
+        .or_else(|| body.pointer("/evidence/publication/token"))
+        .and_then(Value::as_str)
+}
+
+fn extend_observation_interval(body: &Value, from: &mut u64, to: &mut u64) {
+    for pointer in [
+        "/observed_unix_ms",
+        "/observed_from_unix_ms",
+        "/observed_to_unix_ms",
+        "/source_verification/observed_from_unix_ms",
+        "/source_verification/observed_to_unix_ms",
+    ] {
+        if let Some(observed) = body.pointer(pointer).and_then(Value::as_u64) {
+            *from = (*from).min(observed);
+            *to = (*to).max(observed);
+        }
+    }
+}
+
+fn result_failed(result: &Value) -> bool {
+    result
+        .get("isError")
+        .and_then(Value::as_bool)
+        .unwrap_or(false)
+        || canonical_body(result)
+            .get("error")
+            .is_some_and(|error| !error.is_null())
+}
+
+fn native_envelope(body: Value) -> Value {
+    if body.get("content").is_some() {
+        return body;
+    }
+    let failed = body.get("error").is_some_and(|error| !error.is_null());
+    json!({"content":[{"type":"text","text":body.to_string()}],"structuredContent":body,"isError":failed})
+}
+
+fn verification_uncertainty(
+    result: &Value,
+    mode: airk_core::verification::VerificationMode,
+) -> Value {
+    let mut body = canonical_body(result);
+    body["source_verification_observation"] = json!({"state":"unavailable","error":{"code":"member_verification_observation_unavailable","retryable":false,"query_submitted":null,"query_replay_safe":false},"requested_mode":mode});
+    if mode == airk_core::verification::VerificationMode::Require {
+        body["error"] = json!({"code":"verification_observation_unavailable","retryable":false,"query_replay_safe":false});
+    }
+    native_envelope(body)
+}
+
+fn verification_window(deadline: Instant, allocated_ms: u64) -> Option<Duration> {
+    let window = deadline
+        .saturating_duration_since(Instant::now())
+        .min(Duration::from_millis(allocated_ms));
+    (!window.is_zero()).then_some(window)
+}
+
+fn verification_not_submitted(
+    result: &Value,
+    mode: airk_core::verification::VerificationMode,
+) -> Value {
+    let mut body = canonical_body(result);
+    body["source_verification_observation"] = json!({"state":"not_submitted","error":{"code":"verification_deadline_exhausted","retryable":false,"query_submitted":false,"verification_performed":false,"query_replay_safe":false},"requested_mode":mode});
+    if mode == airk_core::verification::VerificationMode::Require {
+        body["error"] = json!({"code":"verification_deadline_exhausted","retryable":false,"query_submitted":false,"verification_performed":false,"query_replay_safe":false});
+    }
+    native_envelope(body)
+}
+
+fn source_projection_failure(result: &Value, observation: Option<Value>) -> Value {
+    let mut body = canonical_body(result);
+    body["source_projection_observation"]=observation.unwrap_or_else(||json!({"error":{"code":"source_projection_observation_unavailable","retryable":false,"query_submitted":null,"query_replay_safe":false}}));
+    body["error"] = json!({"code":"source_projection_expired","retryable":false,"query_submitted":true,"query_replay_safe":false});
+    native_envelope(body)
+}
+
+impl RemoteTools for Backend {
+    fn combined_selection(&self) -> Option<&CombinedConnectRequest> {
+        Some(&self.selection)
+    }
+    fn local_help(&self) -> bool {
+        false
+    }
+    fn catalog(&self) -> Vec<airk_mcp::remote::Tool> {
+        airk_mcp::combined::catalog()
+    }
+    fn query_concurrency(&self) -> usize {
+        crate::service_resource_policy::query_concurrency(&self.control)
+    }
+    fn uses_response_mode(&self, tool: &str) -> bool {
+        !matches!(tool, "airk_query_scope" | "query_scope")
+    }
+    fn client(&self, client: airk_core::usage::ClientFamily) {
+        if let Ok(mut current) = self.client.lock() {
+            *current = client;
+        }
+        if let Ok(children) = self.children.lock() {
+            for child in children.values() {
+                child.client(client);
+            }
+        }
+    }
+    fn close(&self) {
+        self.closed
+            .store(true, std::sync::atomic::Ordering::Release);
+        if let Ok(children) = self.children.lock() {
+            for child in children.values() {
+                child.close();
+            }
+        }
+    }
+    fn shutdown(&self) -> airk_mcp::remote::ReadyFuture<'_> {
+        Box::pin(async move {
+            self.close();
+            let children = self
+                .children
+                .lock()
+                .map_err(|_| ScopeReadRefused)?
+                .values()
+                .cloned()
+                .collect::<Vec<_>>();
+            for child in children {
+                child.shutdown().await?;
+            }
+            Ok(())
+        })
+    }
+    fn call(&self, tool: String, args: Map<String, Value>) -> RemoteFuture<'_> {
+        self.dispatch(tool, args, false, self.query_concurrency())
+    }
+    fn call_with_capacity(
+        &self,
+        tool: String,
+        args: Map<String, Value>,
+        capacity: usize,
+    ) -> RemoteFuture<'_> {
+        self.dispatch(tool, args, false, capacity)
+    }
+}
+
+impl Backend {
+    fn dispatch(
+        &self,
+        tool: String,
+        mut args: Map<String, Value>,
+        internal_allowed: bool,
+        capacity: usize,
+    ) -> RemoteFuture<'_> {
+        Box::pin(async move {
+            let dispatch_started = Instant::now();
+            if self.closed.load(std::sync::atomic::Ordering::Acquire) {
+                return Ok(failure(
+                    "combined_admission_closed",
+                    Some(false),
+                    &self.selection,
+                ));
+            }
+            let internal_verification = tool == "__airk_verify_projection";
+            if internal_verification && !internal_allowed {
+                return Ok(failure(
+                    "unknown_combined_tool",
+                    Some(false),
+                    &self.selection,
+                ));
+            }
+            if args.contains_key("__airk_plan_remaining_ms") && !internal_allowed {
+                return Ok(failure(
+                    "invalid_combined_argument",
+                    Some(false),
+                    &self.selection,
+                ));
+            }
+            let remaining_deadline_ms = args
+                .remove("__airk_plan_remaining_ms")
+                .map(serde_json::from_value::<u64>)
+                .transpose()?;
+            if remaining_deadline_ms == Some(0) {
+                return Ok(failure(
+                    "combined_plan_deadline_exhausted",
+                    Some(false),
+                    &self.selection,
+                ));
+            }
+            let native = if tool.starts_with("airk_") || internal_verification {
+                tool
+            } else {
+                format!("airk_{tool}")
+            };
+            if native == "airk_query_scope"
+                && !internal_allowed
+                && [
+                    "project_ids",
+                    "index_ids",
+                    "member_availability",
+                    "origin_publication",
+                ]
+                .iter()
+                .any(|key| args.contains_key(*key))
+            {
+                return Ok(failure(
+                    "invalid_query_scope_arguments",
+                    Some(false),
+                    &self.selection,
+                ));
+            }
+            let selected = match self.request_selection(&mut args) {
+                Ok(selected) => selected,
+                Err(_) => {
+                    return Ok(failure(
+                        "invalid_combined_selection",
+                        Some(false),
+                        &self.selection,
+                    ));
+                }
+            };
+            let before = match snapshot(&self.control, &self.selection, &selected).await {
+                Ok(before) => before,
+                Err(_) => {
+                    return Ok(failure(
+                        "combined_scope_unavailable",
+                        Some(false),
+                        &self.selection,
+                    ));
+                }
+            };
+            if internal_verification
+                && let Some(remaining) = args.get("remaining_deadline_ms").and_then(Value::as_u64)
+            {
+                args.insert(
+                    "remaining_deadline_ms".into(),
+                    json!(
+                        remaining.saturating_sub(
+                            dispatch_started
+                                .elapsed()
+                                .as_millis()
+                                .min(u128::from(u64::MAX)) as u64
+                        )
+                    ),
+                );
+            }
+            let observation_budget = if native == "airk_status" { 2000 } else { 30000 };
+            let deadline = dispatch_started
+                + Duration::from_millis(
+                    remaining_deadline_ms
+                        .unwrap_or(observation_budget)
+                        .min(observation_budget),
+                );
+            let remaining_deadline_ms = Some(
+                deadline
+                    .saturating_duration_since(Instant::now())
+                    .as_millis()
+                    .min(u128::from(u64::MAX)) as u64,
+            );
+            if remaining_deadline_ms == Some(0) {
+                return Ok(failure(
+                    "combined_plan_deadline_exhausted",
+                    Some(false),
+                    &self.selection,
+                ));
+            }
+            if native == "airk_help" {
+                return Ok(serde_json::to_value(airk_mcp::help::call_with_catalog(
+                    Value::Object(args),
+                    airk_mcp::combined::catalog(),
+                ))?);
+            }
+            let result = match native.as_str() {
+                "airk_query_scope" => self.discover(args, &selected, before, deadline).await,
+                "airk_parse" => {
+                    self.parse(args, &selected, before, deadline, capacity)
+                        .await
+                }
+                "__airk_verify_projection" => self.verify_projection(args, &selected, before).await,
+                _ => {
+                    self.execute_read(
+                        &native,
+                        args,
+                        &selected,
+                        before,
+                        remaining_deadline_ms,
+                        capacity,
+                    )
+                    .await
+                }
+            };
+            match result {
+                Ok(result) => Ok(result),
+                Err(error) if error.is::<airk_kernel::combined_reads::CombinedReplyBudget>() => Ok(
+                    native_envelope(airk_kernel::combined_reads::CombinedReplyBudget.receipt()),
+                ),
+                Err(error) if error.is::<ScopeReadRefused>() => {
+                    Ok(failure("combined_scope_expired", None, &self.selection))
+                }
+                Err(_) => Ok(failure("combined_read_unavailable", None, &self.selection)),
+            }
+        })
+    }
+}
diff --git a/crates/airk-cli/src/combined_frontend_cursor.rs b/crates/airk-cli/src/combined_frontend_cursor.rs
new file mode 100644
index 0000000..3801cb7
--- /dev/null
+++ b/crates/airk-cli/src/combined_frontend_cursor.rs
@@ -0,0 +1,492 @@
+// SPDX-License-Identifier: Apache-2.0
+//! Bounded combined consistency cursors. These are not authorization tokens;
+//! every resumed member still requires live native scope and publication checks.
+use airk_core::{
+    combined_reads::PublicationVector,
+    evidence::RevisionEnvelope,
+    identity::{RevisionToken, Sha256Digest, framed_digest},
+    index_catalog::{IndexId, MAX_SELECTION, encoded_size, unique_bounded},
+};
+use anyhow::{Context, Result, ensure};
+use serde::{Deserialize, Serialize};
+use serde_json::{Map, Value};
+use std::collections::BTreeMap;
+
+const PREFIX: &str = "airk-cq1:";
+const MAX_CURSOR_BYTES: usize = 32_768;
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct Continuation {
+    schema: u32,
+    tool: String,
+    arguments: Sha256Digest,
+    scope_identity: Sha256Digest,
+    vector: PublicationVector,
+    /// Every member is represented, including exhausted members whose exact
+    /// publication must still be checked before resuming any selected member.
+    children: BTreeMap<IndexId, Option<String>>,
+    checksum: Sha256Digest,
+}
+
+fn arguments_identity(tool: &str, args: &Map<String, Value>) -> Result<Sha256Digest> {
+    ensure!(
+        !tool.is_empty() && tool.len() <= 128,
+        "invalid combined cursor tool"
+    );
+    // Response mode/status repetition affects transport observations only.
+    // Projection, filters, modes, count/text/verification budgets all bind.
+    let mut semantic = args.clone();
+    for key in ["cursor", "response_mode", "include_status"] {
+        semantic.remove(key);
+    }
+    encoded_size(&semantic, airk_core::MAX_RESPONSE_BYTES)?;
+    Ok(framed_digest(
+        b"airk/combined-cursor-arguments/1",
+        &[tool.as_bytes(), &serde_json::to_vec(&semantic)?],
+    ))
+}
+
+impl Continuation {
+    pub(super) fn new(
+        tool: &str,
+        args: &Map<String, Value>,
+        scope_identity: Sha256Digest,
+        vector: PublicationVector,
+        child_cursors: BTreeMap<IndexId, Option<String>>,
+    ) -> Result<Self> {
+        let mut cursor = Self {
+            schema: 1,
+            tool: tool.into(),
+            arguments: arguments_identity(tool, args)?,
+            scope_identity,
+            vector,
+            children: child_cursors,
+            checksum: Sha256Digest::from_bytes([0; 32]),
+        };
+        cursor.validate()?;
+        cursor.checksum = cursor.expected_checksum()?;
+        // Establish the wire bound before returning a retained cursor object.
+        cursor.encode()?;
+        Ok(cursor)
+    }
+
+    fn validate(&self) -> Result<()> {
+        ensure!(
+            self.schema == 1 && !self.tool.is_empty() && self.tool.len() <= 128,
+            "unsupported combined cursor"
+        );
+        self.vector.validate()?;
+        ensure!(
+            self.vector.authority == self.scope_identity,
+            "combined cursor authority mismatch"
+        );
+        ensure!(
+            self.children.keys().copied().eq(self
+                .vector
+                .members
+                .iter()
+                .map(|member| member.index_id)),
+            "combined cursor must retain every selected member"
+        );
+        ensure!(
+            self.vector
+                .members
+                .iter()
+                .all(|member| member.publication.is_some()),
+            "unavailable member publication prevents combined continuation"
+        );
+        for child in self.children.values().flatten() {
+            ensure!(
+                !child.is_empty() && child.len() <= MAX_CURSOR_BYTES,
+                "invalid native child cursor"
+            );
+        }
+        Ok(())
+    }
+
+    fn expected_checksum(&self) -> Result<Sha256Digest> {
+        // Include original observation dates in the payload checksum. Resume
+        // compares exact publications, never those dates with a new interval.
+        Ok(framed_digest(
+            b"airk/combined-cursor/1",
+            &[&serde_json::to_vec(&(
+                self.schema,
+                &self.tool,
+                self.arguments,
+                self.scope_identity,
+                &self.vector,
+                &self.children,
+            ))?],
+        ))
+    }
+
+    pub(super) fn decode(
+        encoded: &str,
+        tool: &str,
+        args: &Map<String, Value>,
+        scope_identity: Sha256Digest,
+        selected_ids: &[IndexId],
+    ) -> Result<Self> {
+        ensure!(
+            encoded.len() <= MAX_CURSOR_BYTES,
+            "combined cursor exceeds 32 KiB"
+        );
+        unique_bounded(selected_ids, MAX_SELECTION)?;
+        ensure!(
+            !selected_ids.is_empty() && selected_ids.windows(2).all(|pair| pair[0] < pair[1]),
+            "combined cursor selected indexes are not canonical"
+        );
+        let cursor: Self = serde_json::from_str(
+            encoded
+                .strip_prefix(PREFIX)
+                .context("unsupported combined cursor version")?,
+        )
+        .context("malformed combined cursor")?;
+        cursor.validate()?;
+        ensure!(
+            cursor.tool == tool
+                && cursor.arguments == arguments_identity(tool, args)?
+                && cursor.scope_identity == scope_identity
+                && cursor
+                    .children
+                    .keys()
+                    .copied()
+                    .eq(selected_ids.iter().copied()),
+            "combined_cursor_expired"
+        );
+        ensure!(
+            cursor.checksum == cursor.expected_checksum()?,
+            "combined cursor checksum mismatch"
+        );
+        // Native emission is canonical. This also rejects duplicate JSON keys,
+        // silently overwritten map entries and noncanonical identity spellings.
+        ensure!(cursor.encode()? == encoded, "noncanonical combined cursor");
+        Ok(cursor)
+    }
+
+    pub(super) fn encode(&self) -> Result<String> {
+        self.validate()?;
+        ensure!(
+            self.checksum == self.expected_checksum()?,
+            "combined cursor checksum mismatch"
+        );
+        encoded_size(self, MAX_CURSOR_BYTES - PREFIX.len())?;
+        Ok(format!("{PREFIX}{}", serde_json::to_string(self)?))
+    }
+
+    pub(super) fn cursor(&self, index: IndexId) -> Option<&str> {
+        self.children.get(&index).and_then(Option::as_deref)
+    }
+
+    pub(super) fn is_exhausted(&self, index: IndexId) -> bool {
+        self.children.get(&index).is_some_and(Option::is_none)
+    }
+
+    pub(super) fn publication(&self, index: IndexId) -> Option<&RevisionEnvelope> {
+        self.vector
+            .members
+            .iter()
+            .find(|member| member.index_id == index)
+            .and_then(|member| member.publication.as_ref())
+    }
+
+    pub(super) fn has_more(&self) -> bool {
+        self.children.values().any(Option::is_some)
+    }
+
+    /// Called for *every* selected index, including exhausted members, using
+    /// an actual same-authority native observation in this resumed request.
+    pub(super) fn validate_publication(&self, index: IndexId, token: &str) -> Result<()> {
+        let expected = self
+            .publication(index)
+            .context("combined cursor contains no selected member publication")?;
+        let current: RevisionToken = token.parse()?;
+        ensure!(current == expected.token, "combined_cursor_expired");
+        Ok(())
+    }
+}
+
+/// Native discovery uses a top-level cursor; references owns its page cursor.
+/// A truncated page without a cursor is a declared budget cutoff, not exhaustion.
+pub(super) fn child_cursor(body: &Value) -> Result<Option<String>> {
+    let body = body.get("structuredContent").unwrap_or(body);
+    let top = body.get("cursor").filter(|value| !value.is_null());
+    let page = body
+        .pointer("/page/cursor")
+        .filter(|value| !value.is_null());
+    ensure!(
+        top.is_none() || page.is_none(),
+        "ambiguous native continuation fields"
+    );
+    if let Some(cursor) = top.or(page) {
+        let cursor = cursor
+            .as_str()
+            .context("native continuation is not a string")?;
+        ensure!(
+            !cursor.is_empty() && cursor.len() <= MAX_CURSOR_BYTES,
+            "native continuation exceeds bound"
+        );
+        return Ok(Some(cursor.into()));
+    }
+    let more = body
+        .get("truncated")
+        .and_then(Value::as_bool)
+        .unwrap_or(false)
+        || body
+            .pointer("/evidence/truncated")
+            .and_then(Value::as_bool)
+            .unwrap_or(false)
+        || body
+            .pointer("/page/more")
+            .and_then(Value::as_bool)
+            .unwrap_or(false);
+    ensure!(
+        !more,
+        "native page cannot resume within the selected budget"
+    );
+    Ok(None)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use airk_core::{combined_reads::MemberPublication, identity::Incarnation};
+    use serde_json::json;
+    fn index(n: u8) -> IndexId {
+        IndexId::from_identity(Incarnation::from_bytes([n; 16]))
+    }
+    fn publication(sequence: u64) -> RevisionEnvelope {
+        RevisionEnvelope::new(
+            "fixture".into(),
+            RevisionToken {
+                incarnation: Incarnation::from_bytes([1; 16]),
+                generation: sequence,
+                revision: Sha256Digest::from_bytes([sequence as u8; 32]),
+            },
+        )
+    }
+    fn authority() -> Sha256Digest {
+        Sha256Digest::from_bytes([7; 32])
+    }
+    fn args() -> Map<String, Value> {
+        json!({"limit":4,"max_bytes":8192,"reply_detail":"lean","verification":"report","verification_max_sources":8}).as_object().unwrap().clone()
+    }
+    fn vector() -> PublicationVector {
+        PublicationVector {
+            authority: authority(),
+            observed_from_unix_ms: 10,
+            observed_to_unix_ms: 20,
+            members: vec![
+                MemberPublication {
+                    index_id: index(1),
+                    publication: Some(publication(1)),
+                },
+                MemberPublication {
+                    index_id: index(2),
+                    publication: Some(publication(2)),
+                },
+            ],
+        }
+    }
+    fn cursor() -> Result<Continuation> {
+        Continuation::new(
+            "airk_symbols",
+            &args(),
+            authority(),
+            vector(),
+            BTreeMap::from([(index(1), Some("native-one".into())), (index(2), None)]),
+        )
+    }
+
+    #[test]
+    fn roundtrip_keeps_exhausted_member_in_the_whole_publication_vector() -> Result<()> {
+        let cursor = cursor()?;
+        let encoded = cursor.encode()?;
+        let decoded = Continuation::decode(
+            &encoded,
+            "airk_symbols",
+            &args(),
+            authority(),
+            &[index(1), index(2)],
+        )?;
+        assert_eq!(decoded.cursor(index(1)), Some("native-one"));
+        assert!(!decoded.is_exhausted(index(1)));
+        assert!(decoded.is_exhausted(index(2)));
+        assert!(!decoded.is_exhausted(index(3)));
+        assert!(decoded.has_more());
+        decoded.validate_publication(index(1), &publication(1).token.to_string())?;
+        decoded.validate_publication(index(2), &publication(2).token.to_string())?;
+        assert!(
+            decoded
+                .validate_publication(index(2), &publication(3).token.to_string())
+                .is_err()
+        );
+        assert!(
+            decoded
+                .validate_publication(index(3), &publication(1).token.to_string())
+                .is_err()
+        );
+        Ok(())
+    }
+
+    #[test]
+    fn tool_projection_filters_budgets_scope_and_selected_set_are_bound() -> Result<()> {
+        let encoded = cursor()?.encode()?;
+        for (key, value) in [
+            ("reply_detail", json!("rich")),
+            ("limit", json!(5)),
+            ("max_bytes", json!(8193)),
+            ("path_prefix", json!("src")),
+            ("verification", json!("off")),
+            ("verification_max_sources", json!(9)),
+        ] {
+            let mut changed = args();
+            changed.insert(key.into(), value);
+            assert!(
+                Continuation::decode(
+                    &encoded,
+                    "airk_symbols",
+                    &changed,
+                    authority(),
+                    &[index(1), index(2)]
+                )
+                .is_err()
+            );
+        }
+        assert!(
+            Continuation::decode(
+                &encoded,
+                "airk_code_facts",
+                &args(),
+                authority(),
+                &[index(1), index(2)]
+            )
+            .is_err()
+        );
+        assert!(
+            Continuation::decode(
+                &encoded,
+                "airk_symbols",
+                &args(),
+                Sha256Digest::from_bytes([8; 32]),
+                &[index(1), index(2)]
+            )
+            .is_err()
+        );
+        assert!(
+            Continuation::decode(&encoded, "airk_symbols", &args(), authority(), &[index(1)])
+                .is_err()
+        );
+        let mut display = args();
+        display.insert("cursor".into(), json!(&encoded));
+        display.insert("response_mode".into(), json!("full"));
+        display.insert("include_status".into(), json!(true));
+        Continuation::decode(
+            &encoded,
+            "airk_symbols",
+            &display,
+            authority(),
+            &[index(1), index(2)],
+        )?;
+        Ok(())
+    }
+
+    #[test]
+    fn malformed_overlong_tampered_or_noncanonical_cursors_are_refused() -> Result<()> {
+        let encoded = cursor()?.encode()?;
+        assert!(
+            Continuation::decode(
+                &"x".repeat(MAX_CURSOR_BYTES + 1),
+                "airk_symbols",
+                &args(),
+                authority(),
+                &[index(1), index(2)]
+            )
+            .is_err()
+        );
+        assert!(
+            Continuation::decode(
+                "airk-cq1:{malformed}",
+                "airk_symbols",
+                &args(),
+                authority(),
+                &[index(1), index(2)]
+            )
+            .is_err()
+        );
+        let changed = encoded.replace("native-one", "native-two");
+        assert!(
+            Continuation::decode(
+                &changed,
+                "airk_symbols",
+                &args(),
+                authority(),
+                &[index(1), index(2)]
+            )
+            .is_err()
+        );
+        let pretty = format!(
+            "{PREFIX}{}",
+            serde_json::to_string_pretty(&serde_json::from_str::<Value>(
+                encoded.strip_prefix(PREFIX).unwrap()
+            )?)?
+        );
+        assert!(
+            Continuation::decode(
+                &pretty,
+                "airk_symbols",
+                &args(),
+                authority(),
+                &[index(1), index(2)]
+            )
+            .is_err()
+        );
+        let mut unavailable = vector();
+        unavailable.members[1].publication = None;
+        assert!(
+            Continuation::new(
+                "airk_symbols",
+                &args(),
+                authority(),
+                unavailable,
+                BTreeMap::from([(index(1), Some("native".into())), (index(2), None)])
+            )
+            .is_err()
+        );
+        assert!(
+            Continuation::new(
+                "airk_symbols",
+                &args(),
+                authority(),
+                vector(),
+                BTreeMap::from([(index(1), None)])
+            )
+            .is_err()
+        );
+        Ok(())
+    }
+
+    #[test]
+    fn child_pagination_never_confuses_budget_cutoff_with_exhaustion() -> Result<()> {
+        assert_eq!(
+            child_cursor(&json!({"cursor":"one","truncated":true}))?,
+            Some("one".into())
+        );
+        assert_eq!(
+            child_cursor(
+                &json!({"page":{"cursor":"two","more":true},"evidence":{"truncated":true}})
+            )?,
+            Some("two".into())
+        );
+        assert_eq!(
+            child_cursor(&json!({"cursor":null,"truncated":false}))?,
+            None
+        );
+        assert!(child_cursor(&json!({"truncated":true})).is_err());
+        assert!(child_cursor(&json!({"evidence":{"truncated":true}})).is_err());
+        assert!(child_cursor(&json!({"cursor":42})).is_err());
+        assert!(child_cursor(&json!({"cursor":"one","page":{"cursor":"two"}})).is_err());
+        Ok(())
+    }
+}
