+        if(!/^[0-9a-f]{64}$/.test(id)||!Object.keys(fields).length||Object.keys(fields).some(key=>!shareableCapabilityField(key))||sharedCapabilityDigest(fields)!==id)throw new Error('Shared capability digest or namespace mismatch.');
