+    pub(crate) fn foreign_readable_root(path: &std::path::Path) -> Result<()> { directory_acl(path, true) }
+    fn directory_acl(path: &std::path::Path, foreign: bool) -> Result<()> {
+        let sid = user_sid()?;
+        let extra = if foreign { "(A;OICI;FR;;;WD)" } else { "" };
+        let text: Vec<u16> = format!("O:{sid}D:P(A;OICI;FA;;;{sid}){extra}").encode_utf16().chain(Some(0)).collect();
+        let mut descriptor = std::ptr::null_mut();
+        ensure!(unsafe { ConvertStringSecurityDescriptorToSecurityDescriptorW(text.as_ptr(), SDDL_REVISION_1,
+            &mut descriptor, std::ptr::null_mut()) } != 0, "private test descriptor invalid");
+        let _owner = Descriptor(descriptor);
+        let attributes = SECURITY_ATTRIBUTES { nLength: mem::size_of::<SECURITY_ATTRIBUTES>() as u32,
+            lpSecurityDescriptor: descriptor, bInheritHandle: 0 };
+        let path: Vec<u16> = path.as_os_str().encode_wide().chain(Some(0)).collect();
+        ensure!(unsafe { CreateDirectoryW(path.as_ptr(), &attributes) } != 0, "private test root creation failed");
+        Ok(())
+    }
+    #[test]
