+        // SAFETY: owned descriptor, terminated xattr name and bounded ACL bytes.
+        if unsafe { libc::fsetxattr(directory.as_raw_fd(), c"system.posix_acl_default".as_ptr(),
+            acl.as_ptr().cast(), acl.len(), 0) } != 0 {
+            return Err(std::io::Error::last_os_error().into());
+        }
+        assert!(proof.recheck()?.is_err(), "default inheritance must not stay eligible");
+        let path = root.path().join("state");
+        fs::write(&path, b"first inert object")?;
+        fs::set_permissions(&path, fs::Permissions::from_mode(0o600))?;
+        // The directory default ACL is minimal; remove it before file proof.
+        if unsafe { libc::fremovexattr(directory.as_raw_fd(), c"system.posix_acl_default".as_ptr()) } != 0 {
+            return Err(std::io::Error::last_os_error().into());
+        }
+        let original = File::open(&path)?;
+        let Observation::Private(proof) = inspect(&original, Kind::File)? else {
+            anyhow::bail!("inert private file did not qualify");
+        };
+        fs::rename(&path, root.path().join("old-state"))?;
+        fs::write(&path, b"replacement inert object")?;
+        fs::set_permissions(&path, fs::Permissions::from_mode(0o600))?;
+        assert!(proof.recheck()?.is_ok(), "old pinned object still exists privately");
+        assert!(!proof.check_current(&File::open(&path)?)?, "old proof cannot authenticate new path object");
+        Ok(())
+    }
+
+    #[test]
+    fn hardlink_is_never_positive_even_under_private_directory() -> Result<()> {
