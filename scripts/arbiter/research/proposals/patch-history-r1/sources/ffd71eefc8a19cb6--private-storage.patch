+        let local: Vec<u16> = r"\\?\Volume{01234567-89ab-cdef-0123-456789abcdef}\state".encode_utf16().collect();
+        let root = volume_guid_root(&local).expect("well formed handle GUID result");
+        assert!(fixed_volume(Some(&root), 3));
+        for unsupported in [0, 1, 2, 4, 5, 6] { assert!(!fixed_volume(Some(&root), unsupported)); }
+        assert!(!fixed_volume(None, 3));
+        for remote_or_unsupported in [r"\\server\share\state", r"\\?\UNC\server\share\state",
+            r"C:\state", r"\Device\Mup\server\share\state", r"\\?\Volume{bad}\state"] {
+            let path: Vec<u16> = remote_or_unsupported.encode_utf16().collect();
+            assert!(volume_guid_root(&path).is_none());
+        }
+    }
