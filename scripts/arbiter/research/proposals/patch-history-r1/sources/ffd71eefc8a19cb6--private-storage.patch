+        let sid = unsafe { (*user.as_ptr().cast::<TOKEN_USER>()).User.Sid };
+        let mut text = std::ptr::null_mut();
+        ensure!(unsafe { ConvertSidToStringSidW(sid, &mut text) } != 0, "test SID conversion failed");
+        let _owner = Descriptor(text.cast());
+        let mut length = 0;
+        while length < 256 && unsafe { *text.add(length) } != 0 { length += 1; }
+        ensure!(length < 256, "test SID exceeded bound");
+        Ok(String::from_utf16(unsafe { std::slice::from_raw_parts(text, length) })?)
