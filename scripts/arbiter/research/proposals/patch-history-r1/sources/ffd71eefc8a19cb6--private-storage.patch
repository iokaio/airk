+// SPDX-License-Identifier: Apache-2.0
+use super::*;
+use anyhow::ensure;
+use std::{ffi::c_void, mem, os::windows::io::AsRawHandle};
+use windows_sys::Win32::{
+    Foundation::LocalFree,
+    Security::{Authorization::{GetSecurityInfo, SE_FILE_OBJECT},
+        ACCESS_ALLOWED_ACE, ACE_HEADER, DACL_SECURITY_INFORMATION, OWNER_SECURITY_INFORMATION,
+        GetAce, GetSecurityDescriptorControl, GetSecurityDescriptorLength, GetTokenInformation,
+        EqualSid, IsValidSid, GetLengthSid, TOKEN_QUERY, TOKEN_USER, TokenUser},
+    Storage::FileSystem::{BY_HANDLE_FILE_INFORMATION, GetFileInformationByHandle, GetVolumeInformationByHandleW, GetFinalPathNameByHandleW, GetDriveTypeW},
+    System::Threading::{GetCurrentProcess, OpenProcessToken},
+};
+struct Descriptor(*mut c_void);
+impl Drop for Descriptor { fn drop(&mut self) { unsafe { LocalFree(self.0); } } }
+
+fn information(file: &File) -> Result<BY_HANDLE_FILE_INFORMATION> {
+    let mut info = mem::MaybeUninit::<BY_HANDLE_FILE_INFORMATION>::uninit();
+    // SAFETY: owned file handle and correctly sized writable output remain live.
+    ensure!(unsafe { GetFileInformationByHandle(file.as_raw_handle(), info.as_mut_ptr()) } != 0,
+        "private storage identity inspection failed");
+    Ok(unsafe { info.assume_init() })
+}
+// Only a handle-returned volume GUID root can reach drive classification.
+// This never accepts a caller-supplied drive letter/UNC/path-prefix guess.
+fn volume_guid_root(path: &[u16]) -> Option<Vec<u16>> {
+    let text = String::from_utf16(path).ok()?;
+    let rest = text.strip_prefix(r"\\?\Volume{")?;
+    let guid = rest.get(..36)?;
+    if !guid.bytes().enumerate().all(|(index, byte)| {
+        if [8, 13, 18, 23].contains(&index) { byte == b'-' } else { byte.is_ascii_hexdigit() }
+    }) || !rest.get(36..)?.starts_with("}\\") { return None; }
+    Some(text.get(..49)?.encode_utf16().chain(Some(0)).collect())
+}
+fn fixed_volume(root: Option<&[u16]>, drive_type: u32) -> bool {
+    root.is_some() && drive_type == 3 // DRIVE_FIXED; every unknown/remote/removable type refuses.
+}
+pub(super) fn local_volume(file: &File) -> Option<Vec<u16>> {
+    let mut path = vec![0u16; 32_768];
+    // SAFETY: owned file handle and bounded writable UTF-16 output live for call.
+    let length = unsafe { GetFinalPathNameByHandleW(file.as_raw_handle(), path.as_mut_ptr(),
+        path.len() as u32, 1 /* VOLUME_NAME_GUID | FILE_NAME_NORMALIZED */) } as usize;
+    if length == 0 || length >= path.len() { return None; }
+    let root = volume_guid_root(&path[..length])?;
+    // SAFETY: root is terminated and extracted only from this actual handle.
+    if !fixed_volume(Some(&root), unsafe { GetDriveTypeW(root.as_ptr()) }) { return None; }
+    Some(root)
+}
+
+pub(super) fn inspect(file: &File, kind: Kind) -> Result<std::result::Result<Evidence, Unknown>> {
+    use std::os::windows::io::{FromRawHandle, OwnedHandle};
+    let before = information(file)?;
+    let Some(volume) = local_volume(file) else { return Ok(Err(Unknown::UnsupportedFilesystem)); };
+    let directory = kind != Kind::File;
+    if before.dwFileAttributes & 0x400 != 0
+        || (before.dwFileAttributes & 0x10 != 0) != directory
+        || (!directory && before.nNumberOfLinks != 1)
+    { return Ok(Err(Unknown::RedirectedOrAliased)); }
+    let mut filesystem = [0u16; 32];
+    let mut flags = 0;
+    // SAFETY: file owns handle; optional outputs are null and buffers are sized.
+    if unsafe { GetVolumeInformationByHandleW(file.as_raw_handle(), std::ptr::null_mut(), 0,
+        std::ptr::null_mut(), std::ptr::null_mut(), &mut flags,
+        filesystem.as_mut_ptr(), filesystem.len() as u32) } == 0 {
+        return Ok(Err(Unknown::UnsupportedFilesystem));
+    }
+    let length = filesystem.iter().position(|c| *c == 0).unwrap_or(filesystem.len());
+    if flags & 0x8 == 0 || String::from_utf16(&filesystem[..length])? != "NTFS" {
+        return Ok(Err(Unknown::UnsupportedFilesystem));
+    }
+    let (mut owner, mut dacl, mut descriptor) = (std::ptr::null_mut(), std::ptr::null_mut(), std::ptr::null_mut());
+    // SAFETY: readable security outputs are allocated by the OS for this handle.
+    let error = unsafe { GetSecurityInfo(file.as_raw_handle(), SE_FILE_OBJECT,
+        OWNER_SECURITY_INFORMATION | DACL_SECURITY_INFORMATION, &mut owner, std::ptr::null_mut(),
+        &mut dacl, std::ptr::null_mut(), &mut descriptor) };
+    if error != 0 { return Err(std::io::Error::from_raw_os_error(error as i32).into()); }
+    let _descriptor = Descriptor(descriptor);
+    if owner.is_null() || dacl.is_null() { return Ok(Err(Unknown::NotPrivate)); }
+    let mut token = std::ptr::null_mut();
+    // SAFETY: current process pseudo handle is valid; output owns a real token handle.
+    ensure!(unsafe { OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &mut token) } != 0,
+        "private storage token inspection failed");
+    let token = unsafe { OwnedHandle::from_raw_handle(token) };
+    let mut user = [0usize; 64]; let mut returned = 0;
+    // SAFETY: aligned bounded buffer exceeds TOKEN_USER plus native SID maximum.
+    ensure!(unsafe { GetTokenInformation(token.as_raw_handle(), TokenUser, user.as_mut_ptr().cast(),
+        mem::size_of_val(&user) as u32, &mut returned) } != 0
+        && returned as usize >= mem::size_of::<TOKEN_USER>(), "invalid private storage user token");
+    let sid = unsafe { (*user.as_ptr().cast::<TOKEN_USER>()).User.Sid };
+    if unsafe { IsValidSid(owner) } == 0 || unsafe { EqualSid(owner, sid) } == 0 {
+        return Ok(Err(Unknown::NotPrivate));
+    }
+    let mut control = 0; let mut revision = 0;
+    ensure!(unsafe { GetSecurityDescriptorControl(descriptor, &mut control, &mut revision) } != 0,
+        "invalid private storage descriptor");
+    // Root must stop inheritance from a broader ancestor. Children are separately
+    // inspected; inheritance alone is never evidence of their actual descriptor.
+    if kind == Kind::RootDirectory && control & 0x1000 == 0 { return Ok(Err(Unknown::NotPrivate)); }
+    if unsafe { (*dacl).AceCount } != 1 { return Ok(Err(Unknown::UnsupportedAcl)); }
+    let mut ace = std::ptr::null_mut();
+    ensure!(unsafe { GetAce(dacl, 0, &mut ace) } != 0 && !ace.is_null(), "invalid private storage ACL");
+    let header = unsafe { &*ace.cast::<ACE_HEADER>() };
+    if header.AceType != 0 || (header.AceSize as usize) < mem::size_of::<ACCESS_ALLOWED_ACE>()
+        || header.AceFlags & 0x8 != 0
+    { return Ok(Err(Unknown::UnsupportedAcl)); }
+    let allowed = unsafe { &*ace.cast::<ACCESS_ALLOWED_ACE>() };
+    let allowed_sid = std::ptr::addr_of!(allowed.SidStart).cast_mut().cast();
+    if unsafe { IsValidSid(allowed_sid) } == 0
+        || 8usize + unsafe { GetLengthSid(allowed_sid) } as usize > header.AceSize as usize
+        || unsafe { EqualSid(allowed_sid, sid) } == 0 || allowed.Mask & 0x1f01ff != 0x1f01ff
+        || (directory && header.AceFlags & 3 != 3)
+    { return Ok(Err(Unknown::NotPrivate)); }
+    // Hash only a bounded self-relative descriptor, never pointer-valued layout.
+    let length = unsafe { GetSecurityDescriptorLength(descriptor) } as usize;
+    if control & 0x8000 == 0 || length == 0 || length > 65_536 { return Ok(Err(Unknown::UnsupportedAcl)); }
+    let mut security = Sha256::new();
+    security.update(b"airk.private-object.windows.v1\0");
+    for unit in volume { security.update(unit.to_le_bytes()); }
+    security.update(unsafe { std::slice::from_raw_parts(descriptor.cast::<u8>(), length) });
+    let security: [u8; 32] = security.finalize().into();
+    let after = information(file)?;
+    if (before.dwVolumeSerialNumber, before.nFileIndexHigh, before.nFileIndexLow,
+        before.dwFileAttributes, before.nNumberOfLinks) !=
+        (after.dwVolumeSerialNumber, after.nFileIndexHigh, after.nFileIndexLow,
+        after.dwFileAttributes, after.nNumberOfLinks) { return Ok(Err(Unknown::Changed)); }
+    Ok(Ok(Evidence { identity: [before.dwVolumeSerialNumber.into(), before.nFileIndexHigh.into(),
+        before.nFileIndexLow.into()], security, kind }))
+}
