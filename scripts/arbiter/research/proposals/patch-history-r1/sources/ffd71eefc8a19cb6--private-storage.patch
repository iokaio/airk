+#[cfg(windows)]
+#[path = "private_storage_windows.rs"]
+mod windows;
+#[cfg(windows)]
+fn platform(file: &File, kind: Kind) -> Result<std::result::Result<Evidence, Unknown>> { windows::inspect(file, kind) }
+#[cfg(not(any(windows, target_os = "linux")))]
+fn platform(_file: &File, _kind: Kind) -> Result<std::result::Result<Evidence, Unknown>> { Ok(Err(Unknown::UnsupportedPlatform)) }
+
+#[cfg(windows)]
+pub(crate) fn same_volume(left: &File, right: &File) -> bool {
+    match (windows::local_volume(left), windows::local_volume(right)) {
+        (Some(left), Some(right)) => left == right, _ => false,
+    }
+}
