+pub struct WriterLock {
+    path: PathBuf,
+    _file: File,
+    _lifecycle: Option<Arc<File>>,
+    object_captures: std::sync::atomic::AtomicUsize,
+    active: Arc<std::sync::atomic::AtomicBool>,
+}
