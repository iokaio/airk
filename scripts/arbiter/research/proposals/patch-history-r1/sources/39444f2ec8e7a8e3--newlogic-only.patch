+    assert_eq!(asset.sha256, pin);
+    assert_eq!(asset.bytes, result.calibration_bytes.len() as u64);
+    assert_eq!(asset.name, result.calibration_name);
+    assert_ne!(result.profile.manifest, cpu.manifest);
+    assert!(
