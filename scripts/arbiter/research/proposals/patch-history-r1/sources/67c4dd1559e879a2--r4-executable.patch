+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct NumericCase {
+    name: String,
+    input: CompiledInput,
+    reference_same_artifact: Option<Vec<f32>>,
+    reference_original_fp32: Option<Vec<f32>>,
+}
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct NumericFixture {
