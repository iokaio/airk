+#[cfg(feature = "local-inference")]
+impl StageOwner {
+    fn require_initialization_idle(&self) -> Result<()> {
+        use std::{
+            future::Future,
+            task::{Context as TaskContext, Poll, Waker},
+        };
+        let state = self
+            .lifecycle
+            .lock()
+            .map_err(|_| anyhow::anyhow!("native lifecycle observation unavailable"))?;
+        ensure!(
+            !state.busy && state.device_tasks == 0 && state.phase != Availability::Draining,
+            "actual lifecycle/native work prevents disabled initialization view"
+        );
+        if let Some(handle) = &state.handle {
+            let observed = handle.observation_for(self.stage)?;
+            ensure!(
+                observed.active_profile.is_none()
+                    && observed.warming_profile.is_none()
+                    && observed.running == 0
+                    && observed.queued == 0,
+                "actual resident/pending work prevents disabled initialization view"
+            );
+        }
+        for (_, charge) in &state.charges {
+            let mut wait = Box::pin(charge.wait());
+            ensure!(
+                matches!(
+                    wait.as_mut()
+                        .poll(&mut TaskContext::from_waker(Waker::noop())),
+                    Poll::Ready(Ok(()))
+                ),
+                "actual unreleased host charge prevents initialization view"
+            );
+        }
+        ensure!(
+            !self
+                .devices
+                .state
+                .lock()
+                .map_err(|_| anyhow::anyhow!("native device continuation unavailable"))?
+                .pending
+                .contains_key(&self.stage),
+            "pending device intent prevents initialization view"
+        );
+        Ok(())
+    }
+}
