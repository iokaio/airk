+    request["plan"] = json!({"steps":[{"id":"first","tool":"file_info","args":{"path":"policy.md"}},{"id":"again","tool":"read_file","args":{"path":"policy.md","start_line":1,"end_line":2}}]});
+    let prepared = client
+        .call("airk_parse".into(), request.as_object().unwrap().clone())
+        .await?;
