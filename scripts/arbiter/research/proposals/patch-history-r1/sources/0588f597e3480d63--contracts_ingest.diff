+/// capture. Permission/type/redirect errors are uncertainty, never absence.
+/// Does not enumerate directories or read bytes from an existing file.
+pub(crate) fn missing_protected_path(path: &Path) -> Result<bool> {
+    ensure!(
+        path.is_absolute(),
