+#[test]
+fn recommendations_match_query_selection_with_unused_selected_projects() -> Result<()> {
+    let frozen = grant(vec![member(1, 1, "app"), member(2, 2, "specs")]);
+    let available = selection(vec![project(1), project(2)], None).resolve(&frozen)?;
