+++ b/crates/airk-core/src/source_policy.rs
@@ -0,0 +1,227 @@
+// SPDX-License-Identifier: Apache-2.0
+//! Policy format and canonical predicates; native adapters enforce reviewed authority.
+use crate::{
+    identity::{Sha256Digest, framed_digest},
+    index_catalog::{
+        CatalogRevision, DenyId, IndexId, MAX_ATOMS, MAX_SOURCE_ROOTS, ScopeAtom, SourceRootId,
+        atoms, unique_bounded,
+    },
+};
+use anyhow::{Result, ensure};
+use serde::{Deserialize, Serialize};
+use std::collections::BTreeSet;
+
+pub const POLICY_SCHEMA: &str = "airk.source-policy/1";
+pub const MAX_POLICY_BYTES: usize = 1024 * 1024;
+
+#[path = "source_policy_mutation.rs"]
+mod mutation;
+pub use mutation::{PolicyChange, PolicyChangePreview};
+
+#[path = "source_policy_split.rs"]
+mod split;
+pub use split::{SplitDestination, SplitPolicyPlan};
+
+#[cfg(test)]
+#[path = "source_policy_tests.rs"]
+mod tests;
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct SourceRoot {
+    pub id: SourceRootId,
+    /// The native adapter establishes canonical identity; this field is not proof.
+    pub canonical_path: String,
+    pub aliases: Vec<String>,
+    pub owner: bool,
+}
+impl SourceRoot {
+    pub fn validate(&self) -> Result<()> {
+        validate_root_path(&self.canonical_path)?;
+        unique_bounded(&self.aliases, 16)?;
+        for alias in &self.aliases {
+            ensure!(
+                !alias.is_empty() && alias.len() <= 128 && !alias.chars().any(char::is_control),
+                "invalid source alias"
+            );
+        }
+        Ok(())
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum DenyReason {
+    Trim,
+    SplitTransfer,
+}
+
+/// Syntax only. The native adapter establishes actual canonical host identity.
+pub fn validate_root_path(path: &str) -> Result<()> {
+    let bytes = path.as_bytes();
+    let absolute = path.starts_with('/')
+        || path.starts_with("\\\\")
+        || bytes.len() >= 3
+            && bytes[0].is_ascii_alphabetic()
+            && bytes[1] == b':'
+            && matches!(bytes[2], b'/' | b'\\');
+    ensure!(
+        !path.is_empty() && path.len() <= 32768 && !path.contains('\0') && absolute,
+        "invalid canonical source root"
+    );
+    Ok(())
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct InheritedDeny {
+    pub index_id: IndexId,
+    pub rule_id: DenyId,
+    pub epoch: CatalogRevision,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct DenyRule {
+    pub source_root_id: SourceRootId,
+    pub kind: crate::index_catalog::PathScope,
+    pub path: String,
+    pub rule_id: DenyId,
+    pub reason: DenyReason,
+    pub created_epoch: CatalogRevision,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub inherited_from: Option<InheritedDeny>,
+}
+impl DenyRule {
+    pub fn atom(&self) -> ScopeAtom {
+        ScopeAtom {
+            source_root_id: self.source_root_id,
+            kind: self.kind,
+            path: self.path.clone(),
+        }
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct SourcePolicy {
+    pub schema: String,
+    pub index_id: IndexId,
+    pub owner_binding: Sha256Digest,
+    pub namespace: String,
+    pub collection: String,
+    pub epoch: CatalogRevision,
+    pub roots: Vec<SourceRoot>,
+    /// None means configured roots; Some([]) means no eligible sources.
+    pub positive_includes: Option<Vec<ScopeAtom>>,
+    pub denies: Vec<DenyRule>,
+}
+impl SourcePolicy {
+    pub fn validate(&self) -> Result<()> {
+        ensure!(
+            self.schema == POLICY_SCHEMA && self.namespace == "collections-1.4",
+            "unsupported source policy format"
+        );
+        ensure!(
+            !self.collection.is_empty()
+                && self.collection.len() <= 128
+                && !matches!(self.collection.as_str(), "." | "..")
+                && self
+                    .collection
+                    .bytes()
+                    .all(|b| b.is_ascii_alphanumeric() || b"._-".contains(&b)),
+            "invalid policy collection"
+        );
+        ensure!(
+            !self.roots.is_empty() && self.roots.len() <= MAX_SOURCE_ROOTS,
+            "invalid policy root capacity"
+        );
+        ensure!(
+            self.denies.len() <= MAX_ATOMS,
+            "policy deny capacity exceeded"
+        );
+        let mut ids = BTreeSet::new();
+        let mut paths = BTreeSet::new();
+        let mut aliases = BTreeSet::new();
+        for root in &self.roots {
+            root.validate()?;
+            ensure!(
+                ids.insert(root.id) && paths.insert(&root.canonical_path),
+                "duplicate policy source identity"
+            );
+            for alias in &root.aliases {
+                ensure!(aliases.insert(alias), "ambiguous policy source alias");
+            }
+        }
+        if let Some(includes) = &self.positive_includes {
+            atoms(includes)?;
+            ensure!(
+                includes
+                    .iter()
+                    .all(|atom| ids.contains(&atom.source_root_id)),
+                "policy include refers to unknown root"
+            );
+        }
+        let mut denies = BTreeSet::new();
+        let mut predicates = BTreeSet::new();
+        for deny in &self.denies {
+            let atom = deny.atom();
+            atom.validate()?;
+            ensure!(
+                ids.contains(&deny.source_root_id)
+                    && denies.insert(deny.rule_id)
+                    && predicates.insert(atom),
+                "invalid or duplicate policy deny"
+            );
+            ensure!(
+                deny.created_epoch <= self.epoch,
+                "policy deny belongs to a future epoch"
+            );
+            if let Some(inherited) = &deny.inherited_from {
+                ensure!(
+                    inherited.index_id != self.index_id,
+                    "policy deny cannot inherit from itself"
+                );
+            }
+        }
+        ensure!(
+            crate::index_catalog::encoded_size(self, MAX_POLICY_BYTES)? <= MAX_POLICY_BYTES,
+            "source policy exceeds byte budget"
+        );
+        Ok(())
+    }
+    pub fn identity(&self) -> Result<Sha256Digest> {
+        self.validate()?;
+        Ok(framed_digest(
+            b"airk/source-policy/1",
+            &[&serde_json::to_vec(self)?],
+        ))
+    }
+    /// Pure predicate only. Capture/read/delivery adapters must separately bind
+    /// roots and revision fences before this can confer any native authority.
+    pub fn allows_canonical(&self, root: SourceRootId, path: &str) -> bool {
+        if crate::index_catalog::relative_path(path, false).is_err()
+            || !self.roots.iter().any(|r| r.id == root)
+        {
+            return false;
+        }
+        let included = self
+            .positive_includes
+            .as_ref()
+            .is_none_or(|rules| rules.iter().any(|rule| rule.matches_canonical(root, path)));
+        included
+            && !self.denies.iter().any(|rule| {
+                rule.source_root_id == root
+                    && match rule.kind {
+                        crate::index_catalog::PathScope::Exact => rule.path == path,
+                        crate::index_catalog::PathScope::Subtree => {
+                            rule.path.is_empty()
+                                || rule.path == path
+                                || path
+                                    .strip_prefix(&rule.path)
+                                    .is_some_and(|tail| tail.starts_with('/'))
+                        }
+                    }
+            })
+    }
+}
diff --git a/crates/airk-core/src/source_policy_mutation.rs b/crates/airk-core/src/source_policy_mutation.rs
new file mode 100644
index 0000000..a0a7823
--- /dev/null
+++ b/crates/airk-core/src/source_policy_mutation.rs
@@ -0,0 +1,167 @@
+// SPDX-License-Identifier: Apache-2.0
+//! Pure reviewed policy transitions. Native admission must separately establish
+//! root identity, persist the successor and fence readers before reporting a block.
+use super::{DenyReason, DenyRule, POLICY_SCHEMA, SourcePolicy, SourceRoot};
+use crate::{
+    identity::Sha256Digest,
+    index_catalog::{CatalogRevision, DenyId, IndexDefinition, ScopeAtom, SourceImportState},
+};
+use anyhow::{Result, ensure};
+use serde::{Deserialize, Serialize};
+
+/// A trim cannot change includes, source bindings or another deny. Unblocking
+/// always names the exact reviewed rule; it never means clearing all exclusions.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(tag = "operation", rename_all = "snake_case", deny_unknown_fields)]
+pub enum PolicyChange {
+    Trim {
+        rule_id: DenyId,
+        selector: ScopeAtom,
+    },
+    Unblock {
+        rule_id: DenyId,
+    },
+    /// Native-only successor resolved from an admitted split journal. Generic
+    /// pure changes and ordinary source drafts cannot manufacture this policy.
+    SplitRemainder {
+        split_operation: crate::identity::Incarnation,
+        expected_split_receipt: Sha256Digest,
+    },
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct PolicyChangePreview {
+    pub before_digest: Sha256Digest,
+    pub after_digest: Sha256Digest,
+    pub before_epoch: CatalogRevision,
+    pub after: SourcePolicy,
+    pub change: PolicyChange,
+}
+
+impl SourcePolicy {
+    /// Build the first trim at epoch 1 from a native-observed empty-policy index.
+    /// These metadata checks do not establish filesystem identity or authority;
+    /// native admission must recheck the index/source revisions transactionally.
+    pub fn initial_trim(
+        index: &IndexDefinition,
+        roots: Vec<SourceRoot>,
+        rule_id: DenyId,
+        selector: ScopeAtom,
+    ) -> Result<Self> {
+        index.validate()?;
+        ensure!(
+            index.policy.is_none()
+                && !index.tombstone
+                && index.source_import == SourceImportState::Complete,
+            "initial trim requires an available empty-policy index"
+        );
+        ensure!(
+            roots.iter().filter(|root| root.owner).count() == 1
+                && roots.iter().any(|root| root.owner
+                    && root.canonical_path == index.backing.root
+                    && root.aliases.is_empty()),
+            "initial trim primary source binding changed"
+        );
+        let policy = Self {
+            schema: POLICY_SCHEMA.into(),
+            index_id: index.id,
+            owner_binding: index.backing.binding,
+            namespace: "collections-1.4".into(),
+            collection: index.backing.collection.clone(),
+            epoch: CatalogRevision::INITIAL,
+            roots,
+            positive_includes: None,
+            denies: vec![DenyRule {
+                source_root_id: selector.source_root_id,
+                kind: selector.kind,
+                path: selector.path,
+                rule_id,
+                reason: DenyReason::Trim,
+                created_epoch: CatalogRevision::INITIAL,
+                inherited_from: None,
+            }],
+        };
+        policy.validate()?;
+        Ok(policy)
+    }
+
+    /// Constructs no authority and performs no I/O. The native owner must compare
+    /// the digest again in its admission transaction; replay uses its exact saved
+    /// receipt rather than applying the same change to another policy revision.
+    pub fn preview_change(
+        &self,
+        expected_digest: Sha256Digest,
+        change: PolicyChange,
+    ) -> Result<PolicyChangePreview> {
+        let before_digest = self.identity()?;
+        ensure!(
+            before_digest == expected_digest,
+            "source policy review is stale"
+        );
+        let mut after = self.clone();
+        after.epoch = self.epoch.next()?;
+        match &change {
+            PolicyChange::Trim { rule_id, selector } => {
+                selector.validate()?;
+                ensure!(
+                    self.roots
+                        .iter()
+                        .any(|root| root.id == selector.source_root_id),
+                    "trim refers to an unknown source root"
+                );
+                ensure!(
+                    !self
+                        .denies
+                        .iter()
+                        .any(|rule| rule.rule_id == *rule_id || rule.atom() == *selector),
+                    "trim rule already exists"
+                );
+                after.denies.push(DenyRule {
+                    source_root_id: selector.source_root_id,
+                    kind: selector.kind,
+                    path: selector.path.clone(),
+                    rule_id: *rule_id,
+                    reason: DenyReason::Trim,
+                    created_epoch: after.epoch,
+                    inherited_from: None,
+                });
+            }
+            PolicyChange::SplitRemainder { .. } => {
+                anyhow::bail!("split remainder requires its exact admitted native journal");
+            }
+            PolicyChange::Unblock { rule_id } => {
+                let position = self
+                    .denies
+                    .iter()
+                    .position(|rule| rule.rule_id == *rule_id)
+                    .ok_or_else(|| anyhow::anyhow!("unblock rule is unavailable"))?;
+                ensure!(
+                    self.denies[position].reason == DenyReason::Trim,
+                    "split transfer fences require split recovery"
+                );
+                after.denies.remove(position);
+            }
+        }
+        let after_digest = after.identity()?;
+        Ok(PolicyChangePreview {
+            before_digest,
+            after_digest,
+            before_epoch: self.epoch,
+            after,
+            change,
+        })
+    }
+}
+
+impl PolicyChangePreview {
+    /// Recompute rather than trusting serialized successor fields. This is pure
+    /// validation only and cannot substitute for the native live revision fence.
+    pub fn validate_against(&self, current: &SourcePolicy) -> Result<()> {
+        ensure!(
+            *self == current.preview_change(self.before_digest, self.change.clone())?,
+            "source policy preview changed"
+        );
+        Ok(())
+    }
+}
