+    }
+    #[test]
+    fn missing_historical_detail_is_detailed_without_rewriting_profile_identity() -> Result<()> {
+        let profile = profile(None);
+        let policy = CollectionPolicyRevision {
+            detail: Some(IndexDetail::AgentLean),
