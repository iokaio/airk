+#[test]
+fn global_native_names_reject_local_foreign_and_oversized_names() {
+    for value in [
+        "Local\\AIRK-native",
+        "Global\\other\\object",
+        "Global\\",
+        "Global\\name\0other",
+    ] {
+        assert!(name(value).is_err());
+    }
+    assert!(name(&format!("Global\\{}", "a".repeat(241))).is_err());
+}
