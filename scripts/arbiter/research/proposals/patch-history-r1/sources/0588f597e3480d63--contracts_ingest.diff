new file mode 100644
index 0000000..dc16c77
--- /dev/null
+++ b/crates/airk-core/src/combined_reads/recommendations.rs
@@ -0,0 +1,182 @@
+// SPDX-License-Identifier: Apache-2.0
+//! Pure bounded advice over an already authorized metadata snapshot. No I/O.
+use super::{QuerySelection, ResolvedSelection, canonical_scope_union};
+use crate::index_catalog::{IndexDefinition, QueryProject, encoded_size};
+use anyhow::{Result, ensure};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum Situation {
+    #[default]
+    Keep,
+    Reuse,
+    FocusedTask,
+    SharedDependencies,
+    DifferentLifecycles,
+    Overlap,
+    IrrelevantPath,
+    NeverIndexPath,
+}
+
+/// Narrow only the captured connection, including each Project's own disjoint
+/// prefix grants. Filtering a union after resolution would retain excess scope.
+pub fn select(
+    available: &ResolvedSelection,
+    choice: Option<&QuerySelection>,
+) -> Result<ResolvedSelection> {
+    available.validate()?;
+    let Some(choice) = choice else {
+        return Ok(available.clone());
+    };
+    choice.validate()?;
+    let indexes = choice
+        .index_ids
+        .as_ref()
+        .ok_or_else(|| anyhow::anyhow!("explicit advice subset required"))?;
+    ensure!(
+        choice
+            .project_ids
+            .iter()
+            .all(|id| available.project_ids.contains(id)),
+        "advice Project outside connection"
+    );
+    let mut selected = available.clone();
+    selected.project_ids = choice.project_ids.clone();
+    selected.project_ids.sort();
+    selected.member_availability = choice.member_availability;
+    selected
+        .members
+        .retain(|member| indexes.contains(&member.index_id));
+    for member in &mut selected.members {
+        member
+            .memberships
+            .retain(|item| selected.project_ids.contains(&item.membership.project_id));
+        ensure!(
+            !member.memberships.is_empty(),
+            "advice index outside selected Project union"
+        );
+        member.scope = canonical_scope_union(
+            member
+                .memberships
+                .iter()
+                .flat_map(|item| item.membership.scope.iter().cloned()),
+        )?;
+    }
+    ensure!(
+        selected.members.len() == indexes.len(),
+        "unknown advice selection"
+    );
+    // Like QuerySelection::resolve, keep explicitly selected Projects even
+    // when the index subset omits all of their members. They add no scope.
+    selected.validate()?;
+    Ok(selected)
+}
+
+/// Observations are deliberately unknown when this metadata owner has no dated
+/// coverage/cost receipt. Opening advice must never probe workers to fill them.
+pub fn project(
+    available: &ResolvedSelection,
+    selected: &ResolvedSelection,
+    projects: &[QueryProject],
+    indexes: &[IndexDefinition],
+    situation: Situation,
+    observed_unix_ms: u64,
+) -> Result<Value> {
+    available.validate()?;
+    selected.validate()?;
+    ensure!(
+        indexes.len() <= 32 && projects.len() <= 32,
+        "advice candidate budget"
+    );
+    encoded_size(&(available, selected, projects, indexes), 1024 * 1024)?;
+    let choice = QuerySelection {
+        project_ids: selected.project_ids.clone(),
+        index_ids: Some(selected.members.iter().map(|m| m.index_id).collect()),
+        member_availability: selected.member_availability,
+    };
+    ensure!(
+        select(available, Some(&choice))? == *selected,
+        "advice scope mismatch"
+    );
+    let selected_ids = selected
+        .members
+        .iter()
+        .map(|m| m.index_id)
+        .collect::<Vec<_>>();
+    let members = available.members.iter().map(|member| {
+        let index = indexes.iter().find(|index| index.id == member.index_id);
+        json!({"index_id":member.index_id,"name":index.map(|index| &index.name),"selected":selected_ids.contains(&member.index_id),"project_ids":member.project_ids(),"scope":member.scope,
+            "source_revision":member.memberships[0].source_revision,"policy_epoch":member.memberships[0].policy_epoch,
+            "readiness":{"state":"unknown","reason":"no_dated_observation_in_catalog"},"source_lag":"unknown","semantic_availability":"unknown","counts":{"precision":"unknown","value":null},"query_cost":"unknown"})
+    }).collect::<Vec<_>>();
+    let (reason, action, benefit, tradeoff) = match situation {
+        Situation::Keep => (
+            "No demonstrated reason to change this layout.",
+            "keep_layout",
+            "Keep existing policies and memberships.",
+            "Narrower selection is optional; fewer indexes do not guarantee better recall or latency.",
+        ),
+        Situation::Reuse => (
+            "You requested reuse of existing authorized evidence.",
+            "review_reuse",
+            "An existing index may avoid duplicate scans and embeddings.",
+            "Verify actual source scope, policy and readiness; names do not establish ownership or suitable coverage.",
+        ),
+        Situation::FocusedTask => (
+            "You identified a focused task.",
+            "use_query_scope",
+            "An explicit index or supported query prefix can reduce unrelated evidence and fan-out.",
+            "Dependencies or specifications may be omitted. Widen deliberately within the current grant.",
+        ),
+        Situation::SharedDependencies => (
+            "You identified shared code or specifications.",
+            "use_query_scope",
+            "One combined request reads each shared index once.",
+            "Include only the purposeful combination; budgets are shared across selected indexes.",
+        ),
+        Situation::DifferentLifecycles => (
+            "You identified groups with different lifecycle or policy needs.",
+            "split_pending",
+            "Independent indexes could provide separate policy and budgets.",
+            "Prefer query filters when sufficient. Split is unavailable until P10; destination build, temporary space and future jobs cost work. Size alone is not a reason to split.",
+        ),
+        Situation::Overlap => (
+            "You asked to review possible overlapping indexes; physical overlap is unproven.",
+            "review_reuse",
+            "Choose one only after its profile and coverage are adequate.",
+            "Different profiles can be intentional. Membership removal and index deletion are separate reviewed operations; no automatic merge or pruning.",
+        ),
+        Situation::IrrelevantPath => (
+            "You identified evidence irrelevant to this task.",
+            "use_query_scope",
+            "Narrow the query or review Project defaults.",
+            "Other Projects may need this evidence. Query omission does not permanently deny a path.",
+        ),
+        Situation::NeverIndexPath => (
+            "You explicitly identified evidence that should never be indexed.",
+            "removal_pending",
+            "A reviewed permanent exclusion applies to every user of this index.",
+            "Use the selected index's Sources controls to review permanent exclusion. Advice-linked management previews remain pending P10. Review all affected Projects and other indexes; exclusion, cleanup and unblock are separate. Source files are never removed.",
+        ),
+    };
+    let selected_scope = selected
+        .members
+        .iter()
+        .map(|m| json!({"index_id":m.index_id,"project_ids":m.project_ids(),"scope":m.scope}))
+        .collect::<Vec<_>>();
+    Ok(json!({
+        "schema":"airk.recommendations/1","observed_unix_ms":observed_unix_ms,
+        "observation":{"source":"authorized_catalog_snapshot","evidence":"observed_metadata","coverage_and_cost":"unknown","expires":"revalidate_before_action"},
+        "available":members,"selected":selected.observation()?,"selected_scope":selected_scope,
+        "omitted_index_ids":available.members.iter().filter(|m| !selected_ids.contains(&m.index_id)).map(|m|m.index_id).collect::<Vec<_>>(),
+        "projects":projects.iter().filter(|p|available.project_ids.contains(&p.id)).map(|p|json!({"project_id":p.id,"name":p.name,"defaults_revision":p.defaults_revision,"default_indexes":p.default_indexes.iter().filter(|id|available.member(**id).is_some_and(|m|m.project_ids().contains(&p.id))).collect::<Vec<_>>()})).collect::<Vec<_>>(),
+        "connection_state":"active","pending_scope":null,
+        "cards":[{"id":"selection","reason":reason,"action":action,"expected_benefit":benefit,"tradeoff":tradeoff,"evidence":"user_stated_situation_and_authorized_metadata","affected_project_ids":selected.project_ids,"affected_index_ids":selected_ids},
+            {"id":"unknown_observations","reason":"Saved dated coverage, source lag, semantic readiness, overlap and cost observations are unavailable here.","action":"manual_selection","expected_benefit":"Review an explicit scope without starting new work.","tradeoff":"No completeness, safe split or measured savings claim is possible. Request existing metadata observations separately."},
+            {"id":"keep_layout","reason":"Recommendations confer no authority.","action":"keep_layout","expected_benefit":"Keep this layout or dismiss advice.","tradeoff":"Temporary selection never changes grants, indexing policy or saved defaults. Saving defaults requires separate native review and affects future selections for the Project's users."}],
+        "limits":{"candidate_indexes":32,"advisory_rows":8,"evidence_queries":0,"source_scans":0,"worker_probes":0},
+        "library_coverage":"connection_only","truncated":false,"continuation":null
+    }))
+}
diff --git a/crates/airk-core/src/combined_reads/shared_values.rs b/crates/airk-core/src/combined_reads/shared_values.rs
new file mode 100644
index 0000000..3f04f0a
--- /dev/null
+++ b/crates/airk-core/src/combined_reads/shared_values.rs
@@ -0,0 +1,388 @@
+// SPDX-License-Identifier: Apache-2.0
+//! Exact, capability-only common fields. References compress representation;
+//! they never omit native data or convey authority across member observations.
+use crate::{
+    combined_reads::COMBINED_READ_SCHEMA,
+    identity::{Sha256Digest, framed_digest},
+    index_catalog::{IndexId, MAX_SELECTION, encoded_size, unique_bounded},
+};
+use anyhow::{Context, Result, ensure};
+use serde::{Deserialize, Serialize};
+use serde_json::{Map, Value};
+use std::collections::BTreeMap;
+
+pub const SHARED_CAPABILITY_SCHEMA: &str = "airk.shared-capability-fields/1";
+pub const SHARED_CAPABILITY_REFERENCE: &str = "$airk_shared_capability_fields";
+const MAX_SAFE_INTEGER: u64 = 9_007_199_254_740_991;
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct SharedCapabilityValues {
+    pub schema: String,
+    pub values: BTreeMap<Sha256Digest, Map<String, Value>>,
+}
+
+/// Observation fields stay physically attached to their individual member,
+/// even when two current observations happen to have identical values.
+pub fn shareable_capability_field(key: &str) -> bool {
+    !key.is_empty()
+        && key.len() <= 128
+        && key.is_ascii()
+        && !key.starts_with("runtime")
+        && !key.ends_with("_observation")
+        && !matches!(
+            key,
+            SHARED_CAPABILITY_REFERENCE
+                | "__proto__"
+                | "constructor"
+                | "prototype"
+                | "$airk_shared_native_header_fields"
+                | "request_admission"
+                | "runtime"
+                | "work"
+                | "scope_observation"
+                | "publication"
+                | "freshness"
+                | "collection"
+                | "generation"
+                | "observed_unix_ms"
+                | "cache_age_ms"
+                | "cached"
+                | "status_observation"
+                | "request_id"
+                | "query_concurrency"
+                | "source_verification"
+                | "error"
+                | "requested_scope"
+        )
+}
+
+/// The shared subset uses the same canonical JSON bytes in Rust and host JS:
+/// recursively sorted ASCII keys, strings, booleans, null and safe integers.
+/// Other native values remain inline and therefore retain their exact encoding.
+pub(crate) fn canonical_value(value: &Value, depth: usize, remaining: &mut usize) -> bool {
+    if depth > 32 || *remaining == 0 {
+        return false;
+    }
+    *remaining -= 1;
+    match value {
+        Value::Null | Value::Bool(_) | Value::String(_) => true,
+        Value::Number(number) => {
+            number.as_u64().is_some_and(|n| n <= MAX_SAFE_INTEGER)
+                || number
+                    .as_i64()
+                    .is_some_and(|n| n.unsigned_abs() <= MAX_SAFE_INTEGER)
+        }
+        Value::Array(items) => items
+            .iter()
+            .all(|item| canonical_value(item, depth + 1, remaining)),
+        Value::Object(fields) => fields.iter().all(|(key, value)| {
+            key.is_ascii()
+                && !matches!(
+                    key.as_str(),
+                    SHARED_CAPABILITY_REFERENCE
+                        | "$airk_shared_native_header_fields"
+                        | "__proto__"
+                        | "constructor"
+                        | "prototype"
+                )
+                && canonical_value(value, depth + 1, remaining)
+        }),
+    }
+}
+
+fn identity(fields: &Map<String, Value>) -> Result<Sha256Digest> {
+    Ok(framed_digest(
+        b"airk/shared-capability-fields/1",
+        &[&serde_json::to_vec(fields)?],
+    ))
+}
+
+impl SharedCapabilityValues {
+    pub fn validate(&self) -> Result<()> {
+        ensure!(
+            self.schema == SHARED_CAPABILITY_SCHEMA
+                && !self.values.is_empty()
+                && self.values.len() <= MAX_SELECTION,
+            "unsupported shared capability values"
+        );
+        encoded_size(self, crate::MAX_RESPONSE_BYTES)?;
+        for (digest, fields) in &self.values {
+            ensure!(
+                !fields.is_empty()
+                    && fields.keys().all(|key| shareable_capability_field(key))
+                    && canonical_value(&Value::Object(fields.clone()), 0, &mut 32_768),
+                "invalid shared capability field group"
+            );
+            ensure!(
+                *digest == identity(fields)?,
+                "shared capability value digest mismatch"
+            );
+        }
+        Ok(())
+    }
+}
+
+/// Called only by the capability composer, on successful canonical member
+/// bodies. One reference names an entire common field group, rather than
+/// multiplying a per-field reference catalog by up to 32 members.
+pub fn share_capability_fields(
+    results: &mut [&mut Value],
+) -> Result<Option<SharedCapabilityValues>> {
+    ensure!(
+        results.len() <= MAX_SELECTION,
+        "too many shared capability members"
+    );
+    let Some(first) = results.first() else {
+        return Ok(None);
+    };
+    let first = first
+        .as_object()
+        .context("capability member is not a canonical object")?;
+    for result in results.iter() {
+        ensure!(
+            result.is_object()
+                && result.get(SHARED_CAPABILITY_REFERENCE).is_none()
+                && result.get("structuredContent").is_none()
+                && result.get("content").is_none(),
+            "capability sharing requires an unreferenced canonical native body"
+        );
+        encoded_size(result, crate::MAX_RESPONSE_BYTES)?;
+    }
+    let common = first
+        .iter()
+        .filter(|(key, value)| {
+            shareable_capability_field(key)
+                && canonical_value(value, 0, &mut 32_768)
+                && results
+                    .iter()
+                    .all(|result| result.get(key.as_str()) == Some(*value))
+        })
+        .map(|(key, value)| (key.clone(), value.clone()))
+        .collect::<Map<_, _>>();
+    if common.is_empty() {
+        return Ok(None);
+    }
+    let digest = identity(&common)?;
+    for result in results.iter_mut() {
+        let body = result
+            .as_object_mut()
+            .context("capability member is not an object")?;
+        for key in common.keys() {
+            body.remove(key);
+        }
+        body.insert(
+            SHARED_CAPABILITY_REFERENCE.into(),
+            Value::String(digest.to_string()),
+        );
+    }
+    let shared = SharedCapabilityValues {
+        schema: SHARED_CAPABILITY_SCHEMA.into(),
+        values: BTreeMap::from([(digest, common)]),
+    };
+    shared.validate()?;
+    Ok(Some(shared))
+}
+
+/// Materialize precisely one original native capability body. There are no
+/// arbitrary JSON pointers, recursive references or cross-namespace fallbacks.
+pub fn materialize_combined_member_result(combined: &Value, index: IndexId) -> Result<Value> {
+    ensure!(
+        combined.get("schema").and_then(Value::as_str) == Some(COMBINED_READ_SCHEMA),
+        "shared capability values require the combined read namespace"
+    );
+    let members = combined
+        .get("members")
+        .and_then(Value::as_array)
+        .context("combined members are missing")?;
+    ensure!(
+        !members.is_empty() && members.len() <= MAX_SELECTION,
+        "invalid combined member count"
+    );
+    let ids = members
+        .iter()
+        .map(|member| serde_json::from_value::<IndexId>(member["index_id"].clone()))
+        .collect::<Result<Vec<_>, _>>()?;
+    unique_bounded(&ids, MAX_SELECTION)?;
+    let member = members
+        .iter()
+        .find(|member| member["index_id"] == Value::String(index.to_string()))
+        .context("combined member is not selected")?;
+    let result = member
+        .get("result")
+        .context("combined member has no result")?;
+    if combined
+        .pointer("/shared_values/schema")
+        .and_then(Value::as_str)
+        == Some(super::header_templates::HEADER_SCHEMA)
+    {
+        ensure!(
+            result.get(SHARED_CAPABILITY_REFERENCE).is_none(),
+            "mixed native shared-value namespaces"
+        );
+        let table: super::header_templates::SharedHeaderTemplates =
+            serde_json::from_value(combined["shared_values"].clone())?;
+        let mut materialized = super::header_templates::materialize_header(&table, result)?;
+        super::origins::materialize_member_publications(combined, index, &mut materialized)?;
+        return Ok(materialized);
+    }
+    ensure!(
+        result
+            .get(super::header_templates::HEADER_REFERENCE)
+            .is_none(),
+        "native header table is missing"
+    );
+    let reference = result.get(SHARED_CAPABILITY_REFERENCE);
+    let shared = combined
+        .get("shared_values")
+        .filter(|value| !value.is_null())
+        .map(|value| serde_json::from_value::<SharedCapabilityValues>(value.clone()))
+        .transpose()?;
+    if let Some(shared) = &shared {
+        shared.validate()?;
+    }
+    let Some(reference) = reference else {
+        encoded_size(result, crate::MAX_RESPONSE_BYTES)?;
+        let mut materialized = result.clone();
+        super::origins::materialize_member_publications(combined, index, &mut materialized)?;
+        return Ok(materialized);
+    };
+    let id: Sha256Digest = reference
+        .as_str()
+        .context("invalid shared capability reference")?
+        .parse()?;
+    let shared = shared.context("shared capability table is missing")?;
+    let fields = shared
+        .values
+        .get(&id)
+        .context("shared capability reference is missing")?;
+    let mut materialized = result
+        .as_object()
+        .context("referenced capability member is not an object")?
+        .clone();
+    materialized.remove(SHARED_CAPABILITY_REFERENCE);
+    ensure!(
+        fields.keys().all(|key| !materialized.contains_key(key)),
+        "shared capability fields collide with member fields"
+    );
+    materialized.extend(fields.clone());
+    let mut materialized = Value::Object(materialized);
+    super::origins::materialize_member_publications(combined, index, &mut materialized)?;
+    encoded_size(&materialized, crate::MAX_RESPONSE_BYTES)?;
+    Ok(materialized)
+}
