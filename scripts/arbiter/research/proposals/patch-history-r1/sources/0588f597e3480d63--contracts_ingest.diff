+    std::fs::write(root.join("policy.md"), "changed saved bytes\n")?;
+    let required = json!({"schema":"airk.parse.request/1","mode":"execute","verification":"require",
+        "plan":{"steps":[{"id":"check","tool":"file_info","args":{"path":"policy.md"}}]}});
+    let failed = client
