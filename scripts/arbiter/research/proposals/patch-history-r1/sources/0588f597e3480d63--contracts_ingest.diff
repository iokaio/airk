+    assert!(prepared.get("source_verification").is_none());
+    assert_eq!(prepared["plan"]["verification"], "report");
+    let execute = json!({"schema":"airk.parse.request/1","mode":"execute","plan":prepared["plan"],"response_mode":"full"});
+    let run = client
