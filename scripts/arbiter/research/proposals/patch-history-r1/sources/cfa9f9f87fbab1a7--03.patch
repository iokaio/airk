+        self.scoped_read_fingerprint()?;
+        let body = match self.scope_observation() {
+            Some(observation) => {
+                airk_core::combined_reads::query_scope::installed_body(args, observation)?
+            }
+            None => airk_core::combined_reads::query_scope::legacy_body(args)?,
+        };
+        self.scoped_read_fingerprint()?;
+        Ok(body)
+    }
