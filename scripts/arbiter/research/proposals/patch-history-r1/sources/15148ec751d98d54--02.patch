+        ] {
+            let mut invalid = value.clone();
+            *invalid.pointer_mut(pointer).unwrap() = replacement;
+            assert!(validated_retry(&invalid).is_none(), "{pointer}");
+        }
+        let mut multiple = value.clone();
+        multiple["members"]
+            .as_array_mut()
+            .unwrap()
