+        assert_eq!(progress["after"], "a.txt");
+        drop(writer);
+        let next_store = store.clone();
+        std::thread::spawn(move || -> Result<()> {
+            let _writer = next_store.lock()?;
+            Ok(())
+        })
+        .join()
+        .map_err(|_| anyhow::anyhow!("writer release fixture panicked"))??;
+        progress
+    };
