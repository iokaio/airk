+fn planned_unit_records(
+    model: &EmbeddingModel,
+    source: &std::path::Path,
+    extracted: &[airk_core::RetrievalArtifact],
+) -> Result<Vec<Value>> {
+    let mut units = Vec::new();
+    for (ordinal, retained) in extracted.iter().enumerate() {
+        let file_started = Instant::now();
+        visibility_progress(
+            "unit_file_before",
+            ordinal,
+            extracted.len(),
+            units.len(),
+            file_started,
+        )?;
+        if retained.payload.text.as_bytes() != std::fs::read(source.join(&retained.artifact.path))?
+            || retained
+                .payload
+                .chunks
+                .iter()
+                .any(|chunk| chunk.region.is_some())
+        {
+            visibility_progress(
+                "unit_file_unmapped",
+                ordinal + 1,
+                extracted.len(),
+                units.len(),
+                file_started,
+            )?;
+            continue;
+        }
+        visit_vector_units(&retained.payload, model, |unit| {
+            ensure!(
+                units.len() < 100_000,
+                "visibility unit census bound exceeded"
+            );
+            let tokens = model.planning_tokens(&unit.input)?.len();
+            ensure!(tokens <= 256, "canonical planner overflow");
+            let body = unit
+                .members
+                .iter()
+                .map(|member| {
+                    retained
+                        .payload
+                        .text
+                        .get(member.span.start..member.span.end)
+                        .context("actual member span invalid")
+                })
+                .collect::<Result<Vec<_>>>()?
+                .concat();
+            let prefix = unit
+                .input
+                .strip_suffix(&body)
+                .context("native body is not an unchanged input suffix")?;
+            units.push(json!({"id":units.len(),"file":retained.artifact.path,"input":unit.input,"members":unit.members,"context_prefix":prefix,"context_prefix_bytes":prefix.len(),"native_tokens":tokens,"native_input_tensors":unit_tensors(model,&unit.input)?,"source_sha256":retained.artifact.content_hash,"payload_sha256":retained.payload_digest,"extraction_profile_sha256":retained.profile.identity()?,"published":false}));
+            Ok(())
+        })?;
+        visibility_progress(
+            "unit_file_after",
+            ordinal + 1,
+            extracted.len(),
+            units.len(),
+            file_started,
+        )?;
+    }
+
+    Ok(units)
+}
