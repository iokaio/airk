+pub(crate) fn native_boundary(
+    file: &File,
+    kind: Kind,
+) -> Result<Option<NativePrivateBoundary<'_>>> {
+    Ok(native_platform(file, kind)?
+        .ok()
+        .map(|evidence| NativePrivateBoundary { file, evidence }))
