+            selected: digest(b"native-selected/1", &locked.selected.id()?)?,
+            profile: super::verify::NATIVE_RECOVERY_PROFILE,
+        };
+        registry.require_recovery_epoch(lease, &context)?;
+        Ok(super::verify::RecoveryEpoch { context })
+    }
