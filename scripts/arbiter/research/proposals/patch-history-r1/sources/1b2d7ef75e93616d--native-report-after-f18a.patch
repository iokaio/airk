+pub fn observe_reported<T>(
+    operation: impl FnOnce() -> T,
+    observer: impl Fn(&Snapshot, Metric, bool) + 'static,
+) -> (T, Snapshot) {
+    let state = Rc::new(RefCell::new(Snapshot::default()));
