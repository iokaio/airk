+    let active_scope = Scope(previous);
+    let prior = OBSERVER.with(|slot| slot.replace(Some((state.clone(), Rc::new(observer)))));
+    let observer_scope = ObserverScope(prior);
+    let result = operation();
+    drop(observer_scope);
+    drop(active_scope);
+    let snapshot = state.borrow().clone();
+    (result, snapshot)
+}
