+const ORDINARY_RETIREMENT_SUFFIX: &str = ".retired";
+/// A complete original ordinary record, atomically renamed under native custody.
+/// This is never a partially written scratch or independently created authority.
+pub(super) fn retained_ordinary_record(name: &str) -> Result<Option<&str>> {
+    let Some(original) = name.strip_suffix(ORDINARY_RETIREMENT_SUFFIX) else {
+        return Ok(None);
+    };
+    ensure!(
+        name.len() <= 128 && original.starts_with("r-") && original.len() > 2
+            && original.bytes().all(|byte| byte.is_ascii_alphanumeric() || byte == b'-'),
+        "invalid retained ordinary reservation identity"
+    );
+    Ok(Some(original))
+}
