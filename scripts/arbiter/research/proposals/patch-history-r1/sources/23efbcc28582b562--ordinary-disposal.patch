+#[test]
+fn ordinary_disposal_retains_attribution_through_record_and_lease_interruptions() -> Result<()> {
+    let f = Fixture::new()?;
+    let retired = f.quota.reserve(&f.registration.collection, 4096)?;
+    let healthy = f.quota.reserve(&f.healthy.collection, 4096)?;
+    let record = retired.0.record_path.clone();
+    let lease_path = retired.0.lease_path.clone();
+    let original = fs::read(&record)?;
+    let original_pin = File::open(&record)?;
+    let retained = record.with_file_name(format!("{}.retired", record.file_name().unwrap().to_str().unwrap()));
+    let healthy_record = healthy.0.record_path.clone();
+    let healthy_bytes = fs::read(&healthy_record)?;
+    let healthy_grants = f.grants(&f.healthy.collection)?;
+    let original_grants = f.grants(&f.registration.collection)?;
+    // Actual reservation admission created the record/lease. A real held ledger
+    // prevents Drop cleanup, then releases both OS handles as after process exit.
+    let ledger = f.quota.lock()?;
+    drop(retired);
+    drop(ledger);
+    assert!(record.exists() && lease_path.exists());
+    fs::remove_dir_all(f.directory())?;
+    let project = f.lease()?;
+    // A foreign collision is never replaced, adopted or skipped.
+    fs::write(&retained, b"foreign retirement-name occupant")?;
+    assert!(AbsentCollectionSettlement::settle(&f.registration, &project, &f.control, f.namespace).is_err());
+    assert_eq!(fs::read(&retained)?, b"foreign retirement-name occupant");
+    assert_eq!(fs::read(&record)?, original);
+    assert_eq!(f.grants(&f.registration.collection)?, original_grants);
+    fs::remove_file(&retained)?;
+    for interrupt in [SettlementPoint::AfterReservationRecord, SettlementPoint::AfterReservationLease] {
+        let mut observed = false;
+        assert!(AbsentCollectionSettlement::settle_with_hook(&f.registration, &project, &f.control, f.namespace, |point| {
+            if point == interrupt { observed = true; anyhow::bail!("injected exact ordinary disposal boundary"); }
+            Ok(())
+        }).is_err());
+        assert!(observed, "failed before the requested durable boundary");
+        assert!(!record.exists());
+        assert_eq!(fs::read(&retained)?, original);
+        assert_eq!(file_identity(&File::open(&retained)?)?, file_identity(&original_pin)?);
+        assert_eq!(lease_path.exists(), interrupt == SettlementPoint::AfterReservationRecord);
+        assert_eq!(fs::read(&healthy_record)?, healthy_bytes);
+        assert_eq!(f.grants(&f.healthy.collection)?, healthy_grants);
+        // Normal accounting must not reject or garbage-collect the exact retained
+        // record, even after its lease is gone. Healthy B remains admissible.
+        f.quota.status()?;
+        assert!(retained.exists());
+        drop(f.quota.reserve(&f.healthy.collection, 1024)?);
+        assert_eq!(fs::read(&healthy_record)?, healthy_bytes);
+    }
+    drop(AbsentCollectionSettlement::settle(&f.registration, &project, &f.control, f.namespace)?);
+    assert!(!record.exists() && !retained.exists() && !lease_path.exists());
+    let reservations = f.quota.control_path().join("reservations");
+    let names = fs::read_dir(&reservations)?.map(|entry| Ok(entry?.path())).collect::<Result<Vec<_>>>()?;
+    assert_eq!(names.len(), 2, "selected A left quota inventory that could exhaust B's bounded ledger");
+    assert!(names.contains(&healthy_record) && names.contains(&healthy.0.lease_path));
+    assert_eq!(fs::read(&healthy_record)?, healthy_bytes);
+    assert_eq!(f.grants(&f.healthy.collection)?, healthy_grants);
+    drop(f.quota.reserve(&f.healthy.collection, 1024)?);
+    f.assert_sources()?;
+    Ok(())
+}
