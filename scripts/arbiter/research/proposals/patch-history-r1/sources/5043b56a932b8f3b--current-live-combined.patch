+/// Request-owned cumulative contention-wait allowance. Computation is excluded.
+/// No allowance is cloned/refilled; accepted operations settle normally.
+pub struct AccountingBudget {
+    remaining: std::sync::Mutex<Duration>,
+    cancelled: AccountingCancellation,
+    #[cfg(test)]
+    wait_clock: Option<std::sync::Arc<dyn Fn(&'static str,bool)->Instant+Send+Sync>>,
