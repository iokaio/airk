+        "incompatible runtime pair");
+    ensure!(pair.airk_sha256 == inventory.files[main_name()]
+        && pair.embed_sha256 == inventory.files[helper_name()], "runtime executable pair digest mismatch");
+    ensure!(approval.version == env!("CARGO_PKG_VERSION"), "matching runtime version required");
+    Ok(SelectedPreflight { root: root.canonicalize()?, control: layout::saved_control(root)?, approval })
