+    question: String,
+    document: String,
+    question_sha256: Sha256Digest,
+    document_sha256: Sha256Digest,
+    published_human_relevance_label: u8,
+}
+#[derive(Deserialize)]
+struct OldFocus {
+    compiled: Option<CompiledInput>,
+}
+#[derive(Deserialize)]
