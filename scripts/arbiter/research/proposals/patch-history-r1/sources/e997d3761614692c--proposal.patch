+#[test]
+fn scoped_device_semantic_case_emitter() -> Result<()> {
+    let cases: serde_json::Value = serde_json::from_slice(include_bytes!(
+        "../../../../../../fixtures/split/arbiter/device_cases.json"
+    ))?;
+    let mut outputs = Vec::new();
+    for index in [0, 4, 6] {
+        let status: DeviceStatus = serde_json::from_value(cases["cases"][index]["status"].clone())?;
+        let mut scope = crate::arbiter::stage_tests::scope();
+        scope.installation = status.configuration.installation;
+        scope.catalog = status.configuration.catalog;
+        outputs.push(serde_json::json!({"id":cases["cases"][index]["id"],"status":ScopedDeviceStatus::from_status(status,scope)?}));
+    }
+    let (_, scope) = fixture()?;
+    outputs.push(serde_json::json!({"id":"current_configuration_unavailable","status":ScopedDeviceStatus::unavailable(scope,"Current configuration4 unavailable; no migration or probe performed")?}));
+    if let Some(path) = std::env::var_os("AIRK_WRITE_SCOPED_DEVICE_CASES") {
+        use std::io::Write;
+        let mut file = std::fs::OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .open(path)?;
+        file.write_all(&serde_json::to_vec_pretty(&serde_json::json!({"schema":"airk.scoped-device-semantic-cases/1","qualification":false,"cases":outputs}))?)?;
+        file.write_all(b"\n")?;
+        file.sync_all()?;
+    }
+    Ok(())
+}
