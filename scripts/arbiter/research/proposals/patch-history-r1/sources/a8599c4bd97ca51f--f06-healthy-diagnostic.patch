+def startup_snapshot(fixture, identity, label, phase, reports):
+    # Read only known metadata in this already validated private installation.
+    install=fixture.install.resolve(strict=True)
+    require(install.parent.samefile(fixture.owner), 'diagnostic_install_owner_mismatch')
+    snapshot={'label':label,'phase':phase,'observed_unix_ms':time.time_ns()//1000000}
+    for kind,name in [('startup',f'startup-{identity}.json'),('bootstrap','bootstrap.json')]:
+        path=install/name
+        row={'exists':False}
+        try:
+            metadata=path.lstat()
+            require(path.is_file() and not path.is_symlink()
+                    and not metadata.st_file_attributes&0x400
+                    and path.resolve(strict=True).parent.samefile(install),'unsafe_diagnostic_metadata')
+            with path.open('rb') as stream:raw=stream.read(4097)
+            require(len(raw)<=4096,'oversized_diagnostic_metadata')
+            with (reports/f'{label}-{phase}-{kind}.private.json').open('xb') as stream:stream.write(raw)
+            row={'exists':True,'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest()}
+            if kind=='startup':
+                value=json.loads(raw);times=value.get('attempts_unix_ms')
+                valid=isinstance(times,list) and len(times)<=3 and all(type(t) is int and 0<=t<2**64 for t in times)
+                row['valid_attempts']=valid
+                if valid:
+                    now=snapshot['observed_unix_ms'];live=[t for t in times if max(0,now-t)<120000]
+                    row.update(attempts_unix_ms=times,live_attempt_count=len(live),circuit_open=len(live)>=3,
+                               backoff_active=bool(live) and max(0,now-live[-1])<(1<<len(live))*1000)
+        except FileNotFoundError:
+            pass
+        except Exception as error:
+            row={'exists':True,'snapshot_error_type':type(error).__name__[:64]}
+        snapshot[kind]=row
+    return snapshot
+
+
+def diagnostic_preflight(fixture, arguments, label, reports):
+    # This is a separate diagnostic request AFTER the preserved first error.
+    # It may expose normal startup denial, or succeed; neither qualifies recovery.
+    command=[str(fixture.binary),*map(str,arguments),'tools','call','airk_status','--args','{"response_mode":"full"}']
+    out_path=reports/f'{label}-diagnostic-cli.stdout';err_path=reports/f'{label}-diagnostic-cli.stderr'
+    row={'label':label,'diagnostic_only':True,'request_attempted':True,'started_unix_ms':time.time_ns()//1000000}
+    origin=time.monotonic()
+    try:
+        with out_path.open('xb') as output,err_path.open('xb') as error:
+            completed=subprocess.run(command,stdin=subprocess.DEVNULL,stdout=output,stderr=error,cwd=fixture.runtime,
+                env=fixture.environment,timeout=15,creationflags=subprocess.CREATE_NO_WINDOW)
+        row.update(returncode=completed.returncode,completed=True)
+    except subprocess.TimeoutExpired:
+        row.update(returncode=None,completed=False,failure_code='diagnostic_timeout')
+    row['elapsed_ms']=round((time.monotonic()-origin)*1000,3)
+    with err_path.open('rb') as stream:text=stream.read(16385).decode('utf-8',errors='replace')
+    row['stderr_classification']=('startup_backoff' if 'on-demand restart backoff active' in text else
+        'startup_circuit_open' if 'on-demand startup circuit open' in text else
+        'other_native_error' if row.get('returncode') else 'no_native_preflight_error')
+    row['diagnostic_cli_succeeded']=row.get('returncode')==0
+    row['cause_ambiguous']=row['stderr_classification'] not in ['startup_backoff','startup_circuit_open']
+    row['stderr_bytes']=err_path.stat().st_size
+    return row
+
