+pub fn within_for_scope(
+    envelope: &Value,
+    expected: &airk_core::service::ScopedConnectRequest,
+    deadline: Instant,
+) -> Option<Retry> {
+    classify_for_scope(envelope, expected).filter(|retry| Instant::now() + retry.delay < deadline)
+}
