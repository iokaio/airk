+            "cudnn",
+            "cublas",
+            "cudart",
+            "cufft",
+            "nvrtc",
+            "nvjitlink",
+        ]
+        .iter()
+        .any(|p| name.starts_with(p))
+}
+pub(super) fn baseline_allowed(current: &ModuleIdentity, approved: &[ModuleIdentity]) -> bool {
