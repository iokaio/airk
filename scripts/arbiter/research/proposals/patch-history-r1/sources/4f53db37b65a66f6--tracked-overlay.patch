+fn diagnostic_settlement(
+    admitted: bool,
+    retained: bool,
+    cleaned: bool,
+    released: bool,
+    poisoned: bool,
+) -> Result<()> {
+    ensure!(
+        (!retained && cleaned && released && !poisoned)
+            || (!admitted && retained && !cleaned && !released && poisoned),
+        "inconsistent runtime diagnostic native custody"
+    );
+    Ok(())
+}
