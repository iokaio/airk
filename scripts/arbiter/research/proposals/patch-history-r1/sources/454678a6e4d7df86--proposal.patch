+pub(super) fn saved_device(profile: &ExecutionProfile) -> Option<NativeDevice> {
+    #[cfg(feature = "gpu-cuda")]
+    {
+        profile.cuda_device().map(|device| NativeDevice {
+            device,
+            _private: (),
+        })
+    }
+    #[cfg(not(feature = "gpu-cuda"))]
+    {
+        let _ = profile;
+        None
+    }
