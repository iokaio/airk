+    let held = source.with_extension("held");
+    fs::rename(&source, &held)?;
+    let resumed_result = {
+        let owner = collection.integrity_owner(&registry, &lease, &bound)?;
+        let mut writer = store.lock()?;
+        owner.verify_turn(&mut writer, job, 1, 1 << 20, 300, || Ok(()))
