+fn dense_padding_value_spike_refuses_ignored_hole_above_unchanged_tolerance() {
+    assert_eq!(SYNTHETIC_PADDING_VALUE_SPIKE, 0.25);
+    for tokens in [17usize, 128] {
+        for query in 1..tokens {
+            let ignored_hole =
