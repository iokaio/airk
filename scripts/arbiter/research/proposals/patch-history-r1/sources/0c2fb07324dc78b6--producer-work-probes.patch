+#[test]
+fn semantic_probe_observes_actual_queue_turns_without_changing_publication_work() -> Result<()> {
+    use airk_store::current::work_probe::{Metric, observe};
+    let root = model_data_directory()?;
+    let data = model_data_directory()?;
+    write_static_test_model(&data.path().join("models/local"))?;
+    for index in 0..65 {
+        std::fs::write(
+            root.path().join(format!("file_{index:02}.txt")),
+            "authenticate original\n",
+        )?;
+    }
+    let kernel = Kernel::open(root.path(), Some(data.path().into()))?;
+    kernel.scheduled_index(false, false)?;
+    let before = kernel.status()?;
+    assert_eq!(before.semantic_readiness.completed_artifacts, 0);
+    let (result, probe) = observe(|| kernel.resume_current_enrichment_batches(3));
+    result?;
+    let after = kernel.status()?;
+    assert_eq!(after.files, before.files);
+    assert_eq!(after.chunks, before.chunks);
+    assert_eq!(after.semantic_readiness.completed_artifacts, 65);
+    assert_eq!(probe.get(Metric::SemanticUpdate).calls, 3);
+    assert_eq!(probe.get(Metric::QueueSelect).calls, 3);
+    assert_eq!(probe.get(Metric::QueueSelect).items, 65 + 33 + 1);
+    assert_eq!(probe.get(Metric::QueueRetain).items, 65 + 33 + 1);
+    assert_eq!(probe.get(Metric::PublicationCommit).calls, 3);
+    assert_eq!(probe.get(Metric::PublicationCommit).failures, 0);
+    assert!(probe.get(Metric::QueueDecode).bytes > 0);
+    assert!(probe.get(Metric::QueueEncode).bytes > 0);
+    assert!(probe.get(Metric::ResourceRead).bytes > 0);
+    let read = kernel.current_reader()?;
+    assert!(
+        enrichment::read_work(&read, &kernel.store)?
+            .unwrap()
+            .pending
+            .is_empty()
+    );
+    for index in 0..65 {
+        assert_eq!(
+            std::fs::read(root.path().join(format!("file_{index:02}.txt")))?,
+            b"authenticate original\n"
+        );
+    }
+    // This rollback fixture does not qualify service-WAL FTS captures or ONNX.
+    // Native qualification must print only these bounded counters plus existing
+    // cache/inference statistics, never source paths or model request payloads.
+    eprintln!("semantic_probe={probe:?}");
+    Ok(())
+}
