+    assert_eq!(
+        plan::admit_resume(&receipt(bytes, false), &install, bytes),
+        Ok(())
+    );
+    assert_eq!(
+        plan::admit_resume(&receipt(bytes, true), &install, bytes),
+        Err("setup_operation_consumed")
+    );
+    assert_eq!(
+        plan::admit_resume(
+            &receipt(bytes, false),
+            &install,
+            Sha256Digest::from_bytes([2; 32])
