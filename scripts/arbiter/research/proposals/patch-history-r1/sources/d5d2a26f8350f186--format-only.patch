-        self.receipt.closed = true;
-        // A receipt that cannot be written leaves the original error to report.
-        if !self.receipt.steps.is_empty() || std::fs::symlink_metadata(self.state()).is_ok() {
-            let _ = self.save_receipt();
-        }
-        Err(error)
-    }
