-        ensure!(parent.pop(), "missing existing data ancestor");
-    }
-    ensure!(parent.is_dir(), "data root ancestor must be a directory");
-    let mut path = parent.canonicalize()?;
-    for component in suffix.into_iter().rev() {
-        path.push(component);
-    }
-    Ok(path)
