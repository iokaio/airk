-        ensure!(
-            enforce_backoff,
-            "session startup requires a durable startup receipt"
-        );
-    }
-    let (observation, _attempt) = observe_startup_admission(
-        root,
-        &approval.manifest_sha256,
-        enforce_backoff,
-        cancel,
-        observation,
-        clock,
-        admission,
-    )
-    .await?;
-    if let Some(observation) = observation {
-        if observation.uptime_ms >= 60_000 {
-            if let Some(cancel) = cancel {
-                cancel.effect(|| clear_startup_attempts(root, &approval.manifest_sha256))?;
-            } else {
-                clear_startup_attempts(root, &approval.manifest_sha256)?;
-            }
-        }
-        return Ok(observation);
-    }
-    // The exact receipt-backed attempt above now settles once, even after EOF.
-    let service_executable =
-        airk_host::process_roles::executable(main, airk_host::process_roles::Role::Service)?;
-    let mut arguments: Vec<std::ffi::OsString> = vec![
-        "__airk_role".into(),
-        "service-foreground".into(),
-        "--runtime-dir".into(),
-        control.as_os_str().to_owned(),
-    ];
-    if let Some(seconds) = on_demand_idle_exit(saved_catalog_authority(control)) {
-        arguments.extend(["--idle-exit-seconds".into(), seconds.into()]);
-    }
-    let mut command = Command::new(&service_executable);
-    command
-        .args(&arguments)
-        .stdin(Stdio::null())
-        .stdout(Stdio::null())
-        .stderr(Stdio::null());
-    hidden(&mut command);
-    #[cfg(unix)]
-    airk_process::detached::new_session(&mut command);
-    if let Some(deadline) = admission.deadline() {
-        ensure!(
-            clock.monotonic() < deadline,
-            "approved service startup admission exceeded its 60-second deadline"
-        );
-    }
-    bootstrap(root, "starting", None, None)?;
-    #[cfg(windows)]
-    let launched = airk_host::native_process::spawn_detached(&service_executable, &arguments);
-    #[cfg(not(windows))]
-    let launched = airk_host::native_process::spawn(&mut command);
-    let mut child = match launched {
-        Ok(child) => child,
-        Err(error) => {
-            let _ = bootstrap(
-                root,
-                "execution_denied_or_unavailable",
-                None,
-                error.raw_os_error(),
-            );
-            return Err(error).context("cannot start approved user service; inspect execution policy and native dependencies");
-        }
-    };
-    let until = admission
-        .deadline()
-        .unwrap_or_else(|| clock.monotonic() + Duration::from_secs(60));
-    loop {
-        let observed = if admission.deadline().is_some() {
-            tokio::time::timeout_at(until, health(root, approval, expected_sha256))
-                .await
-                .map_err(anyhow::Error::from)
-                .and_then(|result| result)
-        } else {
-            health(root, approval, expected_sha256).await
-        };
-        if let Ok(observation) = observed
-            && (admission.deadline().is_none() || clock.monotonic() < until)
-        {
-            let _ = bootstrap(root, "ready", Some(observation.process_id), None);
-            // Reap if this host process remains alive after its detached child exits.
-            let _ = std::thread::Builder::new()
-                .name("airk-service-reaper".into())
-                .spawn(move || {
-                    let _ = child.wait();
-                });
-            return Ok(observation);
-        }
-        if let Some(status) = child.try_wait()? {
-            let _ = bootstrap(
-                root,
-                "exited_before_health",
-                Some(child.id()),
-                status.code(),
-            );
-            bail!("approved service exited before health: {status}");
-        }
-        if clock.monotonic() >= until {
-            let _ = child.kill();
-            let _ = child.wait();
-            let _ = bootstrap(root, "health_timeout", Some(child.id()), None);
-            bail!("approved service did not become healthy within 60 seconds");
-        }
-        clock
-            .wait_until(until.min(clock.monotonic() + Duration::from_millis(100)))
-            .await?;
-    }
-}
