+struct Allocation(*mut c_void);
+impl Drop for Allocation {
+    fn drop(&mut self) {
+        // SAFETY: only successful LocalAlloc-returning security APIs construct this owner.
+        unsafe {
+            LocalFree(self.0);
+        }
+    }
+}
