+pub fn record_login_opt_out(root: &Path) -> Result<()> {
+    replace_json(
+        root,
+        LOGIN_OPT_OUT,
+        &LoginOptOut {
+            schema: 1,
+            recorded_unix_ms: unix_ms()?,
