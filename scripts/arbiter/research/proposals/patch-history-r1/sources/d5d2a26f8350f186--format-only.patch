+fn digest(value: &str) -> Result<()> {
+    ensure!(
+        value.len() == 64
+            && value
+                .bytes()
+                .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)),
+        "invalid approved SHA-256 identity"
+    );
+    Ok(())
+}
+
+fn payload_path(root: &Path, name: &str) -> Result<PathBuf> {
+    ensure!(
+        !name.is_empty()
+            && name.is_ascii()
+            && name.len() <= 1024
+            && !name.contains('\\')
+            && !name.chars().any(char::is_control),
+        "invalid payload name"
+    );
+    ensure!(
+        name.split('/').all(|part| !part.is_empty()
+            && part != "."
+            && part != ".."
+            && !part.contains(':')
+            && !part.ends_with(['.', ' '])
+            && !matches!(
+                part.split('.')
+                    .next()
+                    .unwrap_or("")
+                    .to_ascii_uppercase()
+                    .as_str(),
+                "CON"
+                    | "PRN"
+                    | "AUX"
+                    | "NUL"
+                    | "COM1"
+                    | "COM2"
+                    | "COM3"
+                    | "COM4"
+                    | "COM5"
+                    | "COM6"
+                    | "COM7"
+                    | "COM8"
+                    | "COM9"
+                    | "LPT1"
+                    | "LPT2"
+                    | "LPT3"
+                    | "LPT4"
+                    | "LPT5"
+                    | "LPT6"
+                    | "LPT7"
+                    | "LPT8"
+                    | "LPT9"
+            )),
+        "non-portable or aliased payload name"
+    );
+    let path = Path::new(name);
+    ensure!(
+        path.components().count() <= 8
+            && path.components().all(|c| matches!(c, Component::Normal(_))),
+        "escaping payload name"
+    );
+    let joined = root.join(path);
+    for parent in joined
+        .parent()
+        .context("payload parent missing")?
+        .ancestors()
+    {
+        if parent == root {
+            break;
+        }
+        if let Ok(meta) = fs::symlink_metadata(parent) {
+            ensure!(
+                meta.is_dir() && !meta.file_type().is_symlink(),
+                "redirected payload directory"
+            );
+            #[cfg(windows)]
+            {
+                use std::os::windows::fs::MetadataExt;
+                ensure!(
+                    meta.file_attributes() & 0x400 == 0,
+                    "redirected payload directory"
+                );
+            }
+        }
+    }
+    Ok(joined)
+}
