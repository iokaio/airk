+        "started": true,
+        "operation_id": operation.operation_id,
+        "kind": operation.kind,
+        "delete_indexes": operation.options.delete_indexes,
+        "process_id": process,
+        "receipt": receipt,
+        "operation": path,
+        "recovery_program": recovery,
+    })
