+                airk_endpoint::http_endpoint::rotation::Phase::Finalized
+                    | airk_endpoint::http_endpoint::rotation::Phase::Aborted
+            ),
+            "issuer_rotation_pending_before_runtime_mutation: finish or abort the exact issuer operation first"
+        );
+    }
+    Ok(())
+}
