+fn recovery_error(line: ErrorLine, operation: &Path) -> ErrorLine {
+    let mut retained = ErrorLine::new(
+        line.class,
+        &line.code,
+        line.retryable,
+        &format!(
+            "retained original operation {}; {}",
+            operation.display(),
+            line.message
+        ),
+    );
+    retained.retry_after_ms = line.retry_after_ms;
+    retained.native = line.native;
+    retained
+}
