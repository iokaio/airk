-            }
-            if owner != path {
-                continue;
-            }
-            let adopted = self.owner.is_some() || ours.is_some_and(|ours| {
-                plan::roles(ours)
-                    .into_iter()
-                    .any(|(other, previous)| other == role && previous == path)
-            }) || (role != "program" && self.retained.as_ref().is_some_and(|retained| {
-                plan::roles(&retained.installation.record.locations).into_iter()
-                    .any(|(other, previous)| other == role && previous == path)
