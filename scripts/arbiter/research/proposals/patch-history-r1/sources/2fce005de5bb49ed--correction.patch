+fn stable_circuit_key(key: DeviceFaultKey, dispatch_epoch: u64) -> Result<DeviceFaultKey> {
+    ensure!(
+        dispatch_epoch > 0,
+        "device witness generation is unavailable"
+    );
+    // A wrapper/dispatch epoch is freshness evidence, never a circuit reset.
+    Ok(key)
+}
