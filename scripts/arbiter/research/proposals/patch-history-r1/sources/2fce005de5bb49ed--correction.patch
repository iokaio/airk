+pub(super) fn product_adapter_rank(
+    major: i32,
+    minor: i32,
+    dedicated: bool,
+    physical: u64,
+    ordinal: i32,
+) -> Option<(std::cmp::Reverse<u64>, i32)> {
+    (major == 8 && minor == 6 && dedicated && physical > 0 && ordinal >= 0)
+        .then_some((std::cmp::Reverse(physical), ordinal))
+}
