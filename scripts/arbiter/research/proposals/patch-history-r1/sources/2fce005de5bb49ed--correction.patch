+        | ManagementRequest::ConfigureDevice { .. }
+        | ManagementRequest::ProvisionDevice { .. }
+        | ManagementRequest::CancelDevice { .. }
+        | ManagementRequest::RemoveDevice { .. }
+        | ManagementRequest::RecoverDevice { .. } => true,
+        ManagementRequest::Status
