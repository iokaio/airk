+    // An unrelated ordinary source publication cannot re-sign qualification.
+    kernel.index_service_sources()?;
+    assert!(
+        kernel
+            .current_reader()?
+            .resource_reference(airk_core::source_control::CONTROL_BASELINE_RESOURCE)?
+            .is_none()
+    );
+    Ok(())
