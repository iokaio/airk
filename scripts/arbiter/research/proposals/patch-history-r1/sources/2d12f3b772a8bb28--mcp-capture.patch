+fn selected_sha(bytes: &[u8]) -> Sha256Digest {
+    Sha256Digest::from_bytes(Sha256::digest(bytes).into())
+}
+fn selected_source_snapshot(root: &std::path::Path) -> Result<Vec<(String, Vec<u8>)>> {
+    ensure!(root.is_absolute(), "selected source root must be absolute");
+    let mut result = Vec::new();
+    for entry in std::fs::read_dir(root)? {
+        let entry = entry?;
+        let metadata = std::fs::symlink_metadata(entry.path())?;
+        ensure!(metadata.is_file() && !metadata.file_type().is_symlink(), "selected source must contain regular flat original files");
+        #[cfg(windows)]
+        {
+            use std::os::windows::fs::MetadataExt;
+            ensure!(metadata.file_attributes() & 1024 == 0, "selected source reparse point");
+        }
+        let name = entry.file_name().into_string().map_err(|_|anyhow::anyhow!("non-UTF8 selected source name"))?;
+        result.push((name,std::fs::read(entry.path())?));
+    }
+    result.sort_by(|left,right| left.0.cmp(&right.0));
+    ensure!(result.len() >= 30, "selected source document floor");
+    Ok(result)
+}
+#[test]
+#[ignore = "Root-reviewed selected CAL100 corpus/source preparation; no NN or confirmation inputs"]
+fn prepare_selected_context_generic_read_global_cal_capture_input() -> Result<()> {
+    let corpus_raw = std::fs::read(path_env("AIRK_SELECTED_CONTEXT_CORPUS")?)?;
+    let corpus_sha = selected_sha(&corpus_raw);
+    ensure!(corpus_sha == std::env::var("AIRK_SELECTED_CONTEXT_CORPUS_SHA256")?.parse()?, "selected CAL corpus drift");
+    let corpus: Value = serde_json::from_slice(&corpus_raw)?;
+    ensure!(corpus["experiment_partition"] == "CAL" && corpus["tasks"].as_array().is_some_and(|tasks|tasks.len()==100), "CAL100 only; no confirmation");
+    let fixture = path_env("AIRK_SELECTED_CONTEXT_SOURCE_FIXTURE")?;
+    let manifest_raw = std::fs::read(fixture.join("manifest.private.json"))?;
+    let manifest_sha = selected_sha(&manifest_raw);
+    ensure!(manifest_sha == std::env::var("AIRK_SELECTED_CONTEXT_SOURCE_MANIFEST_SHA256")?.parse()?, "selected native source manifest drift");
+    let manifest: Value = serde_json::from_slice(&manifest_raw)?;
+    ensure!(manifest["experiment_partition"] == "CAL" && manifest["corpus_sha256"] == corpus_sha.to_string(), "selected source lineage mismatch");
+    let source_root = fixture.join("sources/hotpot");
+    let snapshot = selected_source_snapshot(&source_root)?;
+    let files = manifest["files"].as_array().context("native source files missing")?;
+    ensure!(files.len()==snapshot.len(), "selected source roster mismatch");
+    for (name, bytes) in &snapshot {
+        let relative = format!("sources/hotpot/{name}");
+        let rows:Vec<_> = files.iter().filter(|row|row["file"]==relative).collect();
+        ensure!(rows.len()==1 && rows[0]["sha256"]==selected_sha(bytes).to_string() && rows[0]["bytes"]==bytes.len(), "selected source bytes mismatch");
+    }
+    let mut seen = BTreeSet::new();
+    let mut questions=Vec::new();
+    for task in corpus["tasks"].as_array().context("CAL tasks missing")? {
+        let id=task["id"].as_str().context("CAL id missing")?.to_owned();
+        ensure!(seen.insert(id.clone()) && task["experiment_partition"]=="CAL" && task["dataset"]=="HotpotQA", "foreign selected CAL task");
+        questions.push(Question{id,question:task["question"].as_str().context("CAL question missing")?.to_owned(),split:"calibration".into(),
+            source_group:task["source_component"].as_str().context("CAL source component missing")?.to_owned(),
+            source:json!({"source_root":source_root,"source_manifest_sha256":manifest_sha})});
+    }
+    let native_ids:BTreeSet<_>=manifest["calibration_ids"].as_array().context("native CAL ids missing")?.iter().map(|id|id.as_str().map(str::to_owned).context("native CAL id type")).collect::<Result<_>>()?;
+    ensure!(seen==native_ids,"native CAL IDs differ");
+    let input=Input{schema:"airk.arbiter.context-action.selected-cal-sources/1".into(),facts_sha256:corpus_sha,
+        task_policy:std::env::var("AIRK_SELECTED_CONTEXT_TASK_POLICY")?.parse()?,data_root:path_env("AIRK_CONTEXT_ACTION_DATA_ROOT")?,questions};
+    let bytes=serde_json::to_vec_pretty(&input)?;
+    let output=path_env("AIRK_CONTEXT_ACTION_CAPTURE_INPUT")?;
+    use std::io::Write;
+    let mut file=std::fs::OpenOptions::new().write(true).create_new(true).open(output)?;
+    file.write_all(&bytes)?;file.sync_all()?;
+    println!("{}",json!({"questions":100,"source_documents":snapshot.len(),"input_sha256":selected_sha(&bytes),
+        "input_framed_digest":framed_digest(b"airk.context-action.publisher-source-input/1", &[&bytes]),"optional_NN_invocations":0}));
+    Ok(())
+}
