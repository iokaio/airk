+        options:Default::default(),configuration_inputs:Default::default()};
+    let payload=ExtractionPayload{semantic_projection:Default::default(),continuity_coverage:Default::default(),
+        contract_version:1,extraction_method:"utf8".into(),parse_status:"plain".into(),provenance:Vec::new(),text:"body".into(),
+        facts:Vec::new(),syntax_identities:Vec::new(),chunks:vec![LocalChunk{span:LocalSpan{start:0,end:4},start_line:1,end_line:1,
+            location:airk_core::DocumentLocation::Lines{start:1,end:1},region:None}],regions:Vec::new(),relationships:Vec::new(),
+        continuity:Vec::new(),diagnostics:Vec::new(),partial:false};
+    let artifact=airk_core::binding::bind_payload(&payload,&profile,airk_core::binding::ArtifactBinding{
+        path:"one.txt",source_hash:Sha256Digest::from_bytes(Sha256::digest(b"body").into()),source_bytes:4})?;
+    let quota=Quota::open_service(store.managed_path()?.root)?;
+    let reservation=quota.reserve(&scope.collection,1<<20)?;
+    let compact=store.retain_payload_with_budget(&artifact,&payload,&profile,Some(b"body"),Some(&reservation))?;
+    let writer=store.lock()?;
+    let mut current=store.current_write(&writer,&quota,&scope,8<<20)?;
+    let token=current.head()?.token()?;
+    current.commit_artifact(&token,"one.txt",Some(&crate::current::CapturedInput::new(compact.clone())))?;
+    drop(current);drop(writer);
+    {
+        let read=store.current_read(&scope)?;
+        collection.integrity_owner(&registry,&lease,&bound)?.anchor(&read)?;
+    }
+    let job=claim(&mut registry,&lease,111)?;
