+/** A live pre-fence witness may be refreshed only by a later retained original witness job.
+ * Reads may skip enqueue/completion/fence observations; the new job can already exist in old.jobs.
+ * Native status remains authority for job success and proof authenticity. */
+function isRetainedWitnessRefresh(old:CatalogObject,next:CatalogObject):boolean {
+    if(phase(old)!==3||phase(next)<3||catalogObject(next.state).state==='canceled_before_fence'||next.remainder_witness==null)return false;
+    const before=catalogObject(old.remainder_witness),after=catalogObject(next.remainder_witness),jobs=array(next.jobs,16).map(catalogObject);
+    const latest=jobs.map((job,index)=>({job,index})).filter(({job})=>job.purpose==='original_witness').pop();
+    if(!latest||after.job!==latest.job.job||after.job===before.job)return false;
+    if(before.job!=null){const previous=jobs.findIndex(job=>job.purpose==='original_witness'&&job.job===before.job);if(previous<0||previous>=latest.index)return false;}
+    return true;
 }
