+#[test]
+fn native_public_and_workbench_catalogs_share_evidence_limits() {
+    let native = local::tools();
+    let public = unified::tools();
+    let workbench = airk_kernel::workbench::operation_catalog();
+    for tool in ["changes", "search", "read_file", "list_files", "outline", "symbols", "imports", "document_facts", "references", "context", "code_facts", "relationships"] {
+        let native_name = format!("airk_{tool}");
+        for catalog in [&native, &public] {
+            let selected = catalog.iter().find(|entry| entry.name == tool || entry.name == native_name).unwrap();
+            let schema = serde_json::to_value(&selected.input_schema).unwrap();
+            for (field, maximum) in [("limit", 100), ("max_bytes", 65536)] {
+                if schema["properties"].get(field).is_none() { continue; }
+                assert_eq!(schema["properties"][field]["minimum"], 1, "{tool}.{field}");
+                assert_eq!(schema["properties"][field]["maximum"], maximum, "{tool}.{field}");
+                assert_eq!(workbench["operations"][tool]["properties"][field]["maximum"], maximum, "Workbench {tool}.{field}");
+            }
+            if tool == "context" {
+                for field in ["before", "after"] {
+                    assert_eq!(schema["properties"][field]["minimum"], 0);
+                    assert_eq!(schema["properties"][field]["maximum"], airk_core::native_reads::CONTEXT_RADIUS_MAX);
+                    assert_eq!(schema["properties"][field]["maximum"], workbench["operations"][tool]["properties"][field]["maximum"]);
+                    assert_eq!(schema["properties"][field]["default"], airk_core::native_reads::CONTEXT_RADIUS_DEFAULT);
+                    assert_eq!(schema["properties"][field]["default"], workbench["operations"][tool]["properties"][field]["default"]);
+                }
+            }
+            if tool == "relationships" {
+                assert_eq!(schema["properties"]["hops"]["minimum"], 1);
+                assert_eq!(schema["properties"]["hops"]["maximum"], 3);
+                assert_eq!(schema["properties"]["direction"]["enum"], json!(["incoming", "outgoing"]));
+                assert_eq!(schema["properties"]["direction"]["enum"], workbench["operations"][tool]["properties"]["direction"]["enum"]);
+            }
+        }
+    }
+    // Help and parse keep their independent documented payload contracts.
+    let help = public.iter().find(|entry| entry.name == "help").unwrap();
+    let description = serde_json::to_value(&help.input_schema).unwrap()["properties"]["max_bytes"]["description"].clone();
+    assert!(description.as_str().unwrap().contains("4096..32768"));
+}
