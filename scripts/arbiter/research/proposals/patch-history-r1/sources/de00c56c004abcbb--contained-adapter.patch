+    async fn canceled_waiter_and_shutdown_keep_the_actual_blocking_owner_until_drain() -> Result<()>
+    {
+        let owner = Arc::new(Owner::default());
+        let (entered, ready) = tokio::sync::oneshot::channel();
+        let (release, wait) = std::sync::mpsc::channel();
+        let wait = Mutex::new(Some(wait));
+        let entered = Mutex::new(Some(entered));
+        let call_owner = owner.clone();
+        let caller = tokio::spawn(async move {
+            call_owner
+                .call(
+                    move || {
+                        if let Some(entered) = entered.lock().unwrap().take() {
+                            let _ = entered.send(());
+                        }
+                        if let Some(wait) = wait.lock().unwrap().take() {
+                            wait.recv().context("fixture release closed")?;
+                        }
+                        Ok(Ok((None, None)))
+                    },
+                    PathBuf::from("never-opened-after-close"),
+                    "airk_explorer_templates_list".into(),
+                    Map::new(),
+                    airk_core::usage::ClientFamily::Cli,
+                )
+                .await
+        });
+        ready.await?;
+        caller.abort();
+        let _ = caller.await;
+        owner.close();
+        let mut drain = Box::pin(owner.shutdown());
+        std::future::poll_fn(|cx| {
+            assert!(std::future::Future::poll(drain.as_mut(), cx).is_pending());
