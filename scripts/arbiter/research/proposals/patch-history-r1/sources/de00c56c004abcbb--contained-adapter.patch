+// SPDX-License-Identifier: Apache-2.0
+//! One contained adapter and one retained blocking operation per frontend owner.
+use super::*;
+use crate::native_process::ContainedChild;
+use std::{
+    io::{BufRead, BufReader},
+    process::{ChildStdin, ChildStdout},
+    sync::{
+        Mutex,
+        atomic::{AtomicBool, AtomicU8, Ordering},
+    },
+};
+
+fn child_work_deadline(started: Instant) -> Instant {
+    started + Duration::from_secs(15)
+}
+#[derive(Debug)]
+struct ExchangeFailure {
+    primary: anyhow::Error,
+    _secondary: anyhow::Error,
+}
+impl std::fmt::Display for ExchangeFailure {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        std::fmt::Display::fmt(&self.primary, f)
+    }
+}
+impl std::error::Error for ExchangeFailure {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        let original: &(dyn std::error::Error + 'static) = self.primary.as_ref();
+        original.source()
+    }
+}
+fn settle_exchange(
+    reply: Result<Vec<u8>>,
+    written: Result<()>,
+    writer_first: bool,
+) -> Result<Vec<u8>> {
+    match (reply, written) {
+        (Ok(bytes), Ok(())) => Ok(bytes),
+        (Err(primary), Ok(())) => Err(primary),
+        (Ok(_), Err(primary)) => Err(primary),
+        (Err(reply), Err(written)) => {
+            let (primary, secondary) = if writer_first {
+                (written, reply)
+            } else {
+                (reply, written)
+            };
+            Err(anyhow::Error::new(ExchangeFailure {
+                primary,
+                _secondary: secondary,
+            }))
+        }
+    }
+}
+
+#[derive(Default)]
+struct Admission(AtomicU8);
+struct Permit<'a>(&'a Admission);
+impl Admission {
+    fn close(&self) {
+        self.0.fetch_or(1, Ordering::AcqRel);
+    }
+    fn closed(&self) -> bool {
+        self.0.load(Ordering::Acquire) & 1 != 0
+    }
+    fn accept(&self) -> Result<Permit<'_>> {
+        self.0
+            .compare_exchange(0, 2, Ordering::AcqRel, Ordering::Acquire)
+            .map_err(|_| anyhow::anyhow!("Explorer adapter admission closed or busy"))?;
+        Ok(Permit(self))
+    }
+}
+impl Drop for Permit<'_> {
+    fn drop(&mut self) {
+        self.0.0.fetch_and(!2, Ordering::AcqRel);
+    }
+}
