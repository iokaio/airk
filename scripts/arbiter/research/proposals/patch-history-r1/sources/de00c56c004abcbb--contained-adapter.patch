+struct Adapter {
+    launch: crate::explorer_assistance::Launch,
+    project: Option<String>,
+    root: Option<PathBuf>,
+    client: String,
+    child: Option<ContainedChild>,
+    stdin: Option<ChildStdin>,
+    stdout: Option<BufReader<ChildStdout>>,
+    sequence: u64,
+    started_at: Instant,
+}
+impl Adapter {
+    fn start(
+        launch: crate::explorer_assistance::Launch,
+        project: Option<String>,
+        root: Option<PathBuf>,
+        admission: &Admission,
+        client: String,
+    ) -> Result<Self> {
+        let mut command = crate::explorer_assistance::command(&launch);
+        command
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::null());
+        if let (Some(project), Some(root)) = (&project, &root) {
+            command
+                .arg("--project-binding")
+                .arg(project)
+                .arg("--project-root")
+                .arg(root);
+        }
+        // Exact establishment admission immediately before spawning. This permit
+        // does not authorize a later UI request; EOF must gate that separately.
+        let _establishment = admission.accept()?;
+        let mut child = ContainedChild::spawn(&mut command)?;
+        let started_at = Instant::now();
+        let stdin = child.stdin.take().context("Explorer input unavailable")?;
+        let stdout = child.stdout.take().context("Explorer output unavailable")?;
+        Ok(Self {
+            launch,
+            project,
+            root,
+            child: Some(child),
+            stdin: Some(stdin),
+            stdout: Some(BufReader::new(stdout)),
+            sequence: 0,
+            started_at,
+            client,
+        })
+    }
+    fn initialize(&mut self, admission: &Admission, deadline: Instant) -> Result<()> {
+        let parameters = json!({"protocolVersion":"2024-11-05","capabilities":{},"clientInfo":{"name":self.client,"version":self.launch.extension_version}});
+        self.rpc(
+            "initialize",
+            &serde_json::to_vec(&parameters)?,
+            admission,
+            deadline,
+        )?;
+        Ok(())
+    }
+    fn finish(mut self) -> Result<()> {
+        drop(self.stdin.take());
+        let deadline = Instant::now() + Duration::from_secs(5);
+        let status = loop {
+            match self
+                .child
+                .as_mut()
+                .context("Explorer child missing")?
+                .try_wait()?
+            {
+                Some(status) => break Some(status),
+                None if Instant::now() < deadline => std::thread::sleep(Duration::from_millis(10)),
+                None => break None,
+            }
+        };
+        drop(self.child.take());
+        ensure!(
+            status.is_some_and(|status| status.success()),
+            "Explorer EOF drain failed"
+        );
+        Ok(())
+    }
+    fn matches(
+        &self,
+        launch: &crate::explorer_assistance::Launch,
+        project: &Option<String>,
+        root: &Option<PathBuf>,
+        client: &str,
+    ) -> bool {
+        &self.launch == launch
+            && &self.project == project
+            && &self.root == root
+            && self.client == client
+    }
+    fn rpc(
+        &mut self,
+        method: &str,
+        request: &[u8],
+        admission: &Admission,
+        deadline: Instant,
+    ) -> Result<Value> {
+        ensure!(request.len() <= 65536, "Explorer request exceeds bound");
+        self.sequence = self
+            .sequence
+            .checked_add(1)
+            .filter(|n| *n <= 9_007_199_254_740_991)
+            .context("Explorer correlation exhausted")?;
+        let id = self.sequence;
+        let mut frame =
+            format!("{{\"jsonrpc\":\"2.0\",\"id\":{id},\"method\":\"{method}\",\"params\":")
+                .into_bytes();
+        frame.extend_from_slice(request);
+        frame.extend_from_slice(b"}\n");
+        if method == "initialize" {
+            frame.extend_from_slice(
+                b"{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}\n",
+            );
+        }
+        let mut stdin = self.stdin.take().context("Explorer input missing")?;
+        let mut stdout = self.stdout.take().context("Explorer output missing")?;
+        // Single exact request admission, not a reusable setup/pipeline permit.
+        // A close after this linearization drains this request; it never retries it.
+        let result = std::thread::scope(|scope| -> Result<_> {
+            enum IoEvent {
+                Reply(Result<Vec<u8>>),
+                WriteFailed,
+            }
+            let (send, receive) = std::sync::mpsc::sync_channel(2);
+            let failed = send.clone();
+            let writer = std::thread::Builder::new()
+                .name("airk-ui-input".into())
+                .spawn_scoped(scope, move || {
+                    let written = (|| -> Result<()> {
+                        ensure!(
+                            Instant::now() < deadline,
+                            "Explorer request deadline expired"
+                        );
+                        let _request = admission.accept()?;
+                        stdin.write_all(&frame)?;
+                        stdin.flush()?;
+                        Ok(())
+                    })();
+                    if written.is_err() {
+                        let _ = failed.send(IoEvent::WriteFailed);
+                    }
+                    (stdin, written)
+                })?;
+            let reader = match std::thread::Builder::new()
+                .name("airk-ui-output".into())
+                .spawn_scoped(scope, move || {
+                    let mut bytes = Vec::new();
+                    let result = (&mut stdout)
+                        .take(3_146_753)
+                        .read_until(b'\n', &mut bytes)
+                        .map_err(anyhow::Error::from)
+                        .and_then(|_| {
+                            ensure!(
+                                bytes.ends_with(b"\n") && bytes.len() <= 3_146_752,
+                                "Explorer reply frame invalid"
+                            );
+                            Ok(bytes)
+                        });
+                    let _ = send.send(IoEvent::Reply(result));
+                    stdout
+                }) {
+                Ok(reader) => reader,
+                Err(error) => {
+                    drop(self.child.take());
+                    return Err(error.into());
+                }
+            };
+            let (reply, writer_first) = match receive
+                .recv_timeout(deadline.saturating_duration_since(Instant::now()))
+            {
+                Ok(IoEvent::Reply(result)) => (result, false),
+                Ok(IoEvent::WriteFailed) => (Err(anyhow::anyhow!("Explorer input failed")), true),
+                Err(error) => (
+                    Err(anyhow::Error::new(error)
+                        .context("Explorer reply timed out or disconnected")),
+                    false,
+                ),
+            };
+            if reply.is_err() {
+                drop(self.child.take());
+            }
+            let written = writer
+                .join()
+                .map_err(|_| anyhow::anyhow!("Explorer input owner panicked"));
+            let read = reader
+                .join()
+                .map_err(|_| anyhow::anyhow!("Explorer output owner panicked"));
+            // Join both owners before returning. Teardown failures cannot replace
+            // the first observed reply/timeout; an input event uses its real cause.
+            let (stdin, written) = match written {
+                Ok(value) => value,
+                Err(error) => {
+                    return settle_exchange(reply, Err(error), writer_first)
+                        .and_then(|_| unreachable!());
+                }
+            };
+            let bytes = settle_exchange(reply, written, writer_first)?;
+            let stdout = read?;
+            Ok((stdin, stdout, bytes))
+        });
+        match result {
+            Ok((stdin, stdout, bytes)) => {
+                self.stdin = Some(stdin);
+                self.stdout = Some(stdout);
+                #[derive(serde::Deserialize)]
+                #[serde(deny_unknown_fields)]
+                struct Reply {
+                    jsonrpc: String,
+                    id: u64,
+                    result: Option<Value>,
+                    error: Option<Value>,
+                }
+                let reply: Reply = serde_json::from_slice(&bytes)?;
+                ensure!(
+                    reply.jsonrpc == "2.0" && reply.id == id,
+                    "Explorer reply correlation mismatch"
+                );
+                ensure!(
+                    reply.error.is_none(),
+                    "Explorer exchange failed or timed out"
+                );
+                reply.result.context("Explorer result missing")
+            }
+            Err(error) => {
+                drop(self.child.take());
+                Err(error)
+            }
+        }
+    }
+}
+
+fn request_parameters(
+    tool: String,
+    arguments: Map<String, Value>,
+    client: &str,
+) -> Result<Vec<u8>> {
+    let parameters = serde_json::to_vec(&json!({"name":tool,"arguments":arguments}))?;
+    let client_bytes = serde_json::to_vec(client)?;
+    // name/tool are equal length; the old one-shot extra field adds its
+    // encoded value and exactly comma + quoted key + colon (10 bytes).
+    let legacy_bytes = parameters
+        .len()
+        .checked_add(10)
+        .and_then(|bytes| bytes.checked_add(client_bytes.len()))
+        .context("Explorer request size overflow")?;
+    ensure!(legacy_bytes <= 65536, "Explorer request exceeds bound");
+    Ok(parameters)
+}
+
+#[derive(Default)]
+pub(super) struct Owner {
+    admission: Admission,
+    adapter: Mutex<Option<Adapter>>,
+    // Never take a pending handle out of the owner across an await.
+    worker: tokio::sync::Mutex<Option<tokio::task::JoinHandle<Result<Value>>>>,
+    drain_failure: Mutex<Option<anyhow::Error>>,
+    cleaned: AtomicBool,
+    closed: tokio::sync::Notify,
+    #[cfg(test)]
+    establishments: std::sync::atomic::AtomicUsize,
+}
+impl Owner {
+    pub(super) fn close(&self) {
+        self.admission.close();
+        self.closed.notify_waiters();
+    }
+    pub(super) async fn call<F>(
+        self: &Arc<Self>,
+        resolve: F,
+        descriptor: PathBuf,
+        tool: String,
+        arguments: Map<String, Value>,
+        client: airk_core::usage::ClientFamily,
+    ) -> Result<Value>
+    where
+        F: Fn() -> Result<std::result::Result<(Option<String>, Option<PathBuf>), Value>>
+            + Send
+            + 'static,
+    {
+        let closed = self.closed.notified();
+        tokio::pin!(closed);
+        closed.as_mut().enable();
+        ensure!(!self.admission.closed(), "Explorer adapter closed");
+        let mut worker = tokio::select! {
+            biased;
+            _=&mut closed=>anyhow::bail!("Explorer adapter closed"),
+            result=self.worker.lock()=>result,
+        };
+        if let Some(previous) = worker.as_mut() {
+            let _joined = tokio::select! {
+                biased;
+                _=&mut closed=>anyhow::bail!("Explorer adapter closed"),
+                result=previous=>result,
+            };
+            worker.take();
+        }
+        ensure!(
+            !self.admission.closed(),
+            "Explorer adapter admission expired"
+        );
+        let owner = self.clone();
+        *worker = Some(tokio::task::spawn_blocking(move || {
+            let (project, root) = match resolve() {
+                Ok(Ok(scope)) => scope,
+                Ok(Err(reply)) => {
+                    drop(
+                        owner
+                            .adapter
+                            .lock()
+                            .unwrap_or_else(std::sync::PoisonError::into_inner)
+                            .take(),
+                    );
+                    return Ok(reply);
+                }
+                Err(error) => {
+                    drop(
+                        owner
+                            .adapter
+                            .lock()
+                            .unwrap_or_else(std::sync::PoisonError::into_inner)
+                            .take(),
+                    );
+                    return Err(error);
+                }
+            };
+            ensure!(
+                !owner.admission.closed(),
+                "Explorer adapter admission expired"
+            );
+            // Keep current deep verification per call in this bounded first slice.
+            let mut launch = match crate::explorer_assistance::plan(&descriptor) {
+                Ok(launch) => launch,
+                Err(error) => {
+                    drop(
+                        owner
+                            .adapter
+                            .lock()
+                            .unwrap_or_else(std::sync::PoisonError::into_inner)
+                            .take(),
+                    );
+                    return Err(error);
+                }
+            };
+            let client_name = format!("{client:?}");
+            let request = request_parameters(tool, arguments, &client_name)?;
+            ensure!(!owner.admission.closed(), "Explorer adapter closed");
+            let mut adapter = owner
+                .adapter
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            if adapter
+                .as_ref()
+                .is_some_and(|current| !current.matches(&launch, &project, &root, &client_name))
+            {
+                drop(adapter.take());
+                // Revalidate after the old contained process has actually drained.
+                launch = crate::explorer_assistance::plan(&descriptor)?;
+            }
+            let mut execution_deadline = None;
+            if adapter.is_none() {
+                let mut started =
+                    Adapter::start(launch, project, root, &owner.admission, client_name)?;
+                let deadline = child_work_deadline(started.started_at);
+                started.initialize(&owner.admission, deadline)?;
+                execution_deadline = Some(deadline);
+                ensure!(
+                    crate::explorer_assistance::plan(&descriptor)? == started.launch,
+                    "Explorer launch changed during setup"
+                );
+                *adapter = Some(started);
+                #[cfg(test)]
+                owner.establishments.fetch_add(1, Ordering::SeqCst);
+            }
+            // Resolve again after all verification, teardown and initialization waits.
+            // A source refusal remains its original typed result; never submit/replay
+            // a UI request against the previously resolved binding.
+            let current = match resolve() {
+                Ok(Ok(scope)) => scope,
+                Ok(Err(reply)) => {
+                    drop(adapter.take());
+                    return Ok(reply);
+                }
+                Err(error) => {
+                    drop(adapter.take());
+                    return Err(error);
+                }
+            };
+            let bound = adapter.as_ref().context("Explorer adapter missing")?;
+            if current != (bound.project.clone(), bound.root.clone()) {
+                drop(adapter.take());
+                anyhow::bail!("Explorer source binding changed during setup");
+            }
+            let deadline =
+                execution_deadline.unwrap_or_else(|| child_work_deadline(Instant::now()));
+            let result = adapter.as_mut().context("Explorer adapter missing")?.rpc(
+                "tools/call",
+                &request,
+                &owner.admission,
+                deadline,
+            );
+            if result.is_err() {
+                drop(adapter.take());
+            }
+            let reply = result?;
+            let projected = (|| -> Result<Value> {
+                let value = if let Some(value) = reply.get("structuredContent") {
+                    value.clone()
+                } else {
+                    let content = reply["content"]
+                        .as_array()
+                        .context("Explorer content missing")?;
+                    ensure!(
+                        content.len() == 1 && content[0]["type"] == "text",
+                        "Explorer content invalid"
+                    );
+                    serde_json::from_str(
+                        content[0]["text"]
+                            .as_str()
+                            .context("Explorer text missing")?,
+                    )?
+                };
+                let mut raw = Map::new();
+                if reply["isError"] == true {
+                    let mut value = value;
+                    let mut error = value
+                        .get_mut("error")
+                        .map(Value::take)
+                        .unwrap_or(Value::Null);
+                    raw.insert("ok".into(), Value::Bool(false));
+                    if let Some(fields) = error.as_object_mut() {
+                        if let Some(code) = fields.remove("code") {
+                            raw.insert("code".into(), code);
+                        }
+                        if let Some(detail) = fields.remove("detail") {
+                            raw.insert("detail".into(), detail);
+                        }
+                    }
+                } else {
+                    raw.insert("ok".into(), Value::Bool(true));
+                    raw.insert("value".into(), value);
+                }
+                let raw = Value::Object(raw);
+                ensure!(
+                    serde_json::to_vec(&raw)?.len() <= 1_048_576,
+                    "Explorer result exceeds bound"
+                );
+                Ok(super::project_explorer_reply(raw))
+            })();
+            if projected.is_err() {
+                drop(adapter.take());
+            }
+            projected
+        }));
+        let joined = worker.as_mut().context("Explorer owner missing")?.await;
+        worker.take();
+        joined.context("Explorer blocking owner failed")?
+    }
+    pub(super) async fn shutdown(self: &Arc<Self>) -> Result<()> {
+        self.close();
+        let mut worker = self.worker.lock().await;
+        if let Some(previous) = worker.as_mut() {
+            let joined = previous.await;
+            worker.take();
+            let failure = match joined {
+                Ok(Err(error)) => Some(error),
+                Err(error) => Some(error.into()),
+                _ => None,
+            };
+            if let Some(error) = failure {
+                let mut saved = self
+                    .drain_failure
+                    .lock()
+                    .unwrap_or_else(std::sync::PoisonError::into_inner);
+                if saved.is_none() {
+                    *saved = Some(error);
+                }
+            }
+        }
+        if !self.cleaned.load(Ordering::Acquire) {
+            let owner = self.clone();
+            *worker = Some(tokio::task::spawn_blocking(move || {
+                let adapter = owner
+                    .adapter
+                    .lock()
+                    .unwrap_or_else(std::sync::PoisonError::into_inner)
+                    .take();
+                if let Some(adapter) = adapter {
+                    adapter.finish()?;
+                }
+                owner.cleaned.store(true, Ordering::Release);
+                Ok(Value::Null)
+            }));
+            let joined = worker
+                .as_mut()
+                .context("Explorer cleanup owner missing")?
+                .await;
+            worker.take();
+            let failure = match joined {
+                Ok(Err(error)) => Some(error),
+                Err(error) => Some(error.into()),
+                _ => None,
+            };
+            if let Some(error) = failure {
+                let mut saved = self
+                    .drain_failure
+                    .lock()
+                    .unwrap_or_else(std::sync::PoisonError::into_inner);
+                if saved.is_none() {
+                    *saved = Some(error);
+                }
+            }
+        }
+        // No await after consuming the saved cause. A canceled cleanup wait
+        // retains both its actual handle and first failure for a later drain.
+        match self
+            .drain_failure
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .take()
+        {
+            Some(error) => Err(error),
+            None => Ok(()),
+        }
+    }
+}
+impl Drop for Owner {
+    fn drop(&mut self) {
+        self.admission.close();
+        // Fail-safe for an abandoned frontend owner. Ordinary EOF uses async
+        // shutdown above; this final fallback does not detach an idle child.
+        drop(
+            self.adapter
+                .get_mut()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .take(),
+        );
+    }
+}
