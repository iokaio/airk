+// SPDX-License-Identifier: Apache-2.0
+use super::*;
+fn fact(name:&str,id:u32)->airk_core::extraction::LocalFact{
+    airk_core::extraction::LocalFact{id,owner:None,kind:"heading".into(),name:name.into(),
+        span:airk_core::extraction::LocalSpan{start:0,end:4},syntax_kind:"heading".into(),start_line:1,end_line:1,
+        location:airk_core::DocumentLocation::Lines{start:1,end:1},document:None,code:None,region:None,attributes:Default::default()}
+}
+#[test]
+fn publication_pages_preserve_original_ordinals_without_source_materialization()->Result<()> {
+    let fixture=Fixture::new()?;
+    let input=retained_input_with_facts(&fixture,"one.txt","body",vec![fact("Zulu",0),fact("Alpha",1),fact("Alpha",2)])?;
+    let lock=fixture.store.lock()?;
+    fixture.store.current_write(&lock,&fixture.quota,&fixture.scope,CAPACITY)?
+        .commit_artifact(&fixture.head.token()?,"one.txt",Some(&input))?;
+    drop(lock);
+    let read=fixture.store.current_read(&fixture.scope)?;
+    let full=fixture.store.load_retained(&input.artifact)?;
+    let page=read.native_fact_page("one.txt",0)?.context("projection absent")?;
+    assert_eq!(page.rows.iter().map(|row|row.ordinal).collect::<Vec<_>>(),vec![1,2,0]);
+    for row in &page.rows{assert_eq!(serde_json::to_value(&row.fact)?,serde_json::to_value(&full.facts[row.ordinal])?);}
+    let mut query=airk_core::FactQuery{path_prefix:"one.txt".into(),name:None,kind:None,language:None,
+        exact_name:false,limit:100,max_bytes:65536,path_exact:true,document_only:false};
+    let strict=read.native_facts_page(&fixture.store,&query,false,&Default::default())?;
+    let projected=page.rows.iter().map(|row|super::super::discovery::fact_hit(&full,&row.fact)).collect::<Vec<_>>();
+    assert_eq!(serde_json::to_value(&strict.facts)?,serde_json::to_value(&projected)?);
+    query.max_bytes=1;
+    let refused=read.native_facts_page(&fixture.store,&query,false,&Default::default())?;
+    assert_eq!(refused.page.required_record_bytes,Some(serde_json::to_vec(&projected[0])?.len()));
+    assert!(read.audit_native_fact_projection(&fixture.store,"one.txt")?);
+    let source=fixture.store.directory().join("objects/sources").join(&input.artifact.content_hash);
+    let held=source.with_extension("held");fs::rename(&source,&held)?;
+    let selected=read.native_fact_page("one.txt",0)?.context("selected projection depended on source")?;
+    assert_eq!(selected.rows.len(),3);
+    assert!(read.audit_native_fact_projection(&fixture.store,"one.txt").is_err());
+    fs::rename(held,source)?;
+    drop(read);
+    let lock=fixture.store.lock()?;
+    let mut writer=fixture.store.current_write(&lock,&fixture.quota,&fixture.scope,CAPACITY)?;
+    let token=writer.head()?.token()?;
+    writer.commit_artifact(&token,"one.txt",None)?;
+    drop(writer);drop(lock);
+    assert!(fixture.store.current_read(&fixture.scope)?.native_fact_header("one.txt")?.is_none());
+    Ok(())
+}
