+fn write_manifest(root: &Path, manifest: &InstallManifest) -> Result<String> {
+    let bytes = serde_json::to_vec(manifest)?;
+    fs::write(root.join("airk-install.json"), &bytes)?;
+    Ok(format!("{:x}", Sha256::digest(bytes)))
+}
