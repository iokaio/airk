-    let sha256 = runtime_pair::digest_file(temporary.path())?;
-    ensure!(
-        sha256 == expected,
-        "approved main changed while preparing the client launcher"
-    );
-    temporary.persist_noclobber(&destination)?;
-    replace_json(
-        root,
-        "launcher.json",
