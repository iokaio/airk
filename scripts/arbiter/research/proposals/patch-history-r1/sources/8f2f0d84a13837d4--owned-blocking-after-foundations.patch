+        let mut shutdown = Box::pin(ready.shutdown());
+        std::future::poll_fn(|cx| {
+            assert!(std::future::Future::poll(shutdown.as_mut(), cx).is_pending());
+            std::task::Poll::Ready(())
+        }).await;
+        drop(shutdown);
+        assert!(attempt.task.lock().await.is_some(), "driver handle remains owned after canceled join");
+        assert!(setup.worker_is_owned(), "blocking worker handle remains owned while blocked");
+        assert!(ready.run(|| async { panic!("closed setup cannot restart") }).await.is_err());
+        release.send(())?;
+        ready.shutdown().await?;
+        assert!(attempt.task.lock().await.is_none(), "second shutdown joined the driver");
+        assert!(!setup.worker_is_owned(), "second shutdown joined the blocking worker");
+        assert!(waiting.await.is_err());
+        Ok(())
+    }
+
+}
