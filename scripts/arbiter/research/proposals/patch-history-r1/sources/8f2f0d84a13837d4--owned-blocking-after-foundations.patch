-                part.split('.')
-                    .next()
-                    .unwrap_or("")
-                    .to_ascii_uppercase()
-                    .as_str(),
-                "CON"
-                    | "PRN"
-                    | "AUX"
-                    | "NUL"
-                    | "COM1"
-                    | "COM2"
-                    | "COM3"
-                    | "COM4"
