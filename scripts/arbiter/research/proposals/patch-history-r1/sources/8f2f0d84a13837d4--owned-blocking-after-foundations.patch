-fn ownership_contention(error: &anyhow::Error) -> bool {
-    error
-        .downcast_ref::<std::fs::TryLockError>()
-        .is_some_and(|error| matches!(error, std::fs::TryLockError::WouldBlock))
-        || airk_store::service::registry::is_read_contention(error)
