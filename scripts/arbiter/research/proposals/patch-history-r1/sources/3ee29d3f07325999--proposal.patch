+        "bounds":request,"actual_job":actual_job,"native_host_reservation_bytes":charge.bytes(),
+        "original_native_batch_expires_monotonic_ns":outer_ns,"forward_roster":forward_roster(),"completed_forwards":[],
+        "resource":ResourceSeries::new(profile.memory_reservation_bytes)?,"scope":"independent qualification load1/warmup1/samples20; no full process GPU peak, numeric/CAL/product Ready or final GPU qualification"});
+    flush(&mut file, &receipt)?;
+    let mut journal = operation::Journal::create(
