+        warmed.value?;
+        ensure!(warmed.within_deadline&&warmed.elapsed_us<=input.policy.p95_limit_us,"first warmup overrun; no measured forward admitted");
+        final_host_peak(peak_rss(),request.host_limit_bytes)?;
+        let mut series=ResourceSeries::new(profile.memory_reservation_bytes)?;
+        let mut ordinal=0;
+        let measured=observe_series(&mut series,&input.policy,|| {
+            ordinal+=1;
+            let label=format!("sample-{ordinal:02}");
+            let returned=observed(&mut journal,outer,outer_ns,operation::Kind::Sample,ordinal,Some(compiled.input_digest),|deadline|
+                actual_forward(&mut completed,&label,||scorer.score_with_deadline(&compiled,deadline)))?;
+            returned.value?;
+            let sample=ResourceSample{elapsed_us:returned.elapsed_us,peak_process_rss_bytes:peak_rss().context("actual benchmark host peak unavailable")?};
+            if !returned.within_deadline&&sample.elapsed_us<=input.policy.p95_limit_us {
+                anyhow::bail!("original parent clipped sample expiry exceeded");
+            }
+            Ok(sample)
+        },|series| {receipt["resource"]=json!(series);flush(&mut file,&receipt) });
+        receipt["resource"]=json!(series);receipt["completed_forwards"]=json!(completed);flush(&mut file,&receipt)?;
+        measured?;
+        ensure!(completed==forward_roster(),"actual completed forward denominator differs");
+        scorer.synchronize(outer)?;ensure!(scorer.device_settled(),"resource GPU settlement remains unknown");
+        let device=custody.device.as_ref().context("actual resource device absent")?;
+        receipt["capacity_after_scores"]=serde_json::to_value(device.observation(outer)?)?;
+        drop(custody.scorer.take());
+        ensure!(!device.poisoned()&&device.pending_claims()==Some(0),"actual resource teardown settlement remains unknown");
+        verify_files(custody.files.as_ref().unwrap(),&profile)?;
+        for pin in [&request_pin,&request.gpu_input,&input.profile] {pinned(pin,1<<20)?;}
+        pinned(&input.source_manifest,16<<20)?;pinned(&request.runtime_manifest,128<<10)?;pinned(&request.expectations,16<<20)?;
+        ensure!(Instant::now()<outer,"original resource batch expired during teardown/posthash");
+        Ok(())
+    });
+    let result = run.and_then(std::convert::identity);
+    drop(owner);
+    drop(lease);
+    let retained = control_parent.is_none();
+    let cleanup = control_parent
+        .take()
+        .map(tempfile::TempDir::close)
+        .transpose();
+    let mut waiting = std::pin::pin!(release.wait());
+    let released = matches!(
+        std::future::Future::poll(
+            waiting.as_mut(),
+            &mut std::task::Context::from_waker(std::task::Waker::noop())
+        ),
+        std::task::Poll::Ready(Ok(()))
+    );
+    receipt["native_control_retained_for_unknown_cuda"] = json!(retained);
+    receipt["native_control_cleanup_observed"] = json!(matches!(&cleanup, Ok(Some(()))));
+    receipt["native_control_cleanup_error"] =
+        json!(cleanup.as_ref().err().map(ToString::to_string));
+    receipt["native_host_charge_release_observed"] = json!(released);
+    let peak = peak_rss();
+    let peak_decision = final_host_peak(peak, request.host_limit_bytes);
+    receipt["final_host_peak_error"] = json!(peak_decision.as_ref().err().map(ToString::to_string));
+    let result = match (result, cleanup, peak_decision) {
+        (Err(primary), _, _) => Err(primary),
+        (Ok(()), Err(cleanup), _) => Err(cleanup.into()),
+        (Ok(()), Ok(_), Err(peak)) => Err(peak),
+        (Ok(()), Ok(_), Ok(_)) if released => Ok(()),
+        (Ok(()), Ok(_), Ok(_)) => Err(anyhow::anyhow!("native resource host release unknown")),
+    };
+    receipt["completed_forwards"] = json!(completed);
+    receipt["peak_process_rss_bytes"] = json!(peak);
+    receipt["process_cuda_poisoned"] = json!(cuda::process_poisoned());
+    receipt["complete"] = json!(result.is_ok());
+    receipt["latency_host_placement_passed"] = json!(result.is_ok());
+    if let Err(error) = &result {
+        receipt["error"] = json!(format!("{error:#}"));
+        if let Some(refusal) = error.downcast_ref::<cuda::PlacementRefusal>() {
+            receipt["placement_refusal"] = json!(&refusal.observation);
+        }
+    }
+    receipt["elapsed_us_to_final_report_start"] = json!(started.elapsed().as_micros());
+    flush(&mut file, &receipt)?;
+    if Instant::now() >= outer {
+        receipt["complete"] = json!(false);
+        receipt["latency_host_placement_passed"] = json!(false);
+        receipt["final_retention_exceeded_original_batch_cutoff"] = json!(true);
+        flush(&mut file, &receipt)?;
+        return result.and_then(|()| {
+            Err(anyhow::anyhow!(
+                "original resource batch cutoff exhausted during final receipt retention"
+            ))
+        });
+    }
+    result
+}
