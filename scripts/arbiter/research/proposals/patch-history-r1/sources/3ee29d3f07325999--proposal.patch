+#[test]
+fn later_warm_operation_outlives_expired_load_cutoff_without_renewing_original_batch() -> Result<()>
+{
+    let start = Instant::now();
+    let outer = start + Duration::from_secs(3600);
+    let (load, load_ns) = cutoff(outer, 3_600_000_000_000, start, 0, 120_000)?;
+    let later = start + Duration::from_secs(180);
+    assert!(later > load);
+    let (warm, warm_ns) = cutoff(outer, 3_600_000_000_000, later, 180_000_000_000, 120_000)?;
+    assert_eq!(load_ns, 120_000_000_000);
+    assert_eq!(warm, start + Duration::from_secs(300));
+    assert_eq!(warm_ns, 300_000_000_000);
+    assert!(warm < outer);
+    assert!(warm_ns < 3_600_000_000_000);
+    Ok(())
+}
