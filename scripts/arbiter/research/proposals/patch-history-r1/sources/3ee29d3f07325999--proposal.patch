+// SPDX-License-Identifier: Apache-2.0
+//! Injected schedules/clocks only; no CUDA witness or measured peak is fabricated.
+use super::*;
+use std::cell::Cell;
+#[test]
+fn frozen_resource_roster_is_twenty_one_forwards_with_one_warmup_and_twenty_samples() {
+    let roster = forward_roster();
+    assert_eq!(roster.len(), 21);
+    assert_eq!(roster.first().map(String::as_str), Some("warmup-0"));
+    assert_eq!(roster[1], "sample-01");
+    assert_eq!(roster[20], "sample-20");
+    assert_eq!(roster.iter().collect::<BTreeSet<_>>().len(), 21);
+    assert!(!roster.iter().any(|r| r.contains("load")));
+}
+#[test]
+fn operation_cutoff_clips_to_fixed_parent_and_never_refreshes_after_observer_io() -> Result<()> {
+    let start = Instant::now();
+    let outer = start + Duration::from_secs(3600);
+    let (d, n) = cutoff(outer, 3_600_000_000_000, start, 0, 120_000)?;
+    assert_eq!(d, start + Duration::from_secs(120));
+    assert_eq!(n, 120_000_000_000);
+    let (d, n) = cutoff(
+        outer,
+        3_600_000_000_000,
+        start + Duration::from_secs(3590),
+        3_590_000_000_000,
+        120_000,
+    )?;
+    assert_eq!(d, outer);
+    assert_eq!(n, 3_600_000_000_000);
+    assert!(cutoff(outer, 3_600_000_000_000, outer, 3_600_000_000_000, 120_000).is_err());
+    assert!(cutoff(outer, 3_600_000_000_000, start, 0, 120_001).is_err());
+    Ok(())
+}
+#[test]
+fn forward_completion_never_includes_failed_or_undispatched_calls() -> Result<()> {
+    let mut completed = vec![];
+    let calls = Cell::new(0);
+    actual_forward(&mut completed, "warmup-0", || {
+        calls.set(calls.get() + 1);
+        Ok(())
+    })?;
+    let failure = actual_forward(&mut completed, "sample-01", || -> Result<()> {
+        calls.set(calls.get() + 1);
+        anyhow::bail!("actual observed refusal")
+    });
+    assert!(failure.is_err());
+    assert_eq!(calls.get(), 2);
+    assert_eq!(completed, ["warmup-0"]);
+    assert_ne!(completed, forward_roster());
+    Ok(())
+}
