+#[cfg(feature = "local-inference")]
+fn continuation_current(
+    generations: &BTreeMap<Stage, u64>,
+    stage: Stage,
+    original: u64,
+) -> Result<()> {
+    ensure!(
+        generations.get(&stage).copied().unwrap_or(0) == original,
+        "device continuation was explicitly canceled"
+    );
+    Ok(())
