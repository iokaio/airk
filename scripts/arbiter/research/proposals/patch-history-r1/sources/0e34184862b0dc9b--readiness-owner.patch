+    /// Explicit EOF path: close admission, abort the async owner and join it.
+    /// No timeout detaches a potentially effectful task. Synchronous verification
+    /// remains nonpreemptible until the separate blocking/cancellation adapter lands.
+    async fn shutdown(&self) -> Result<()> {
+        let _shutdown = self.shutdown_gate.lock().await;
+        self.closing.store(true, std::sync::atomic::Ordering::Release);
+        let attempt = {
+            let state = self.state.lock().await;
+            match &*state {
+                ReadinessState::Running(attempt) => Some(attempt.clone()),
+                _ => None,
+            }
+        };
+        let mut joined = Ok(());
+        if let Some(attempt) = attempt {
+            // Keep the handle in owner state while awaiting: cancelling shutdown
+            // does not detach it, and the next shutdown can continue draining.
+            let mut slot = attempt.task.lock().await;
+            if let Some(task) = slot.as_mut() {
+                task.abort();
+                joined = match task.await {
+                    Ok(()) => Ok(()),
+                    Err(error) if error.is_cancelled() => Ok(()),
+                    Err(error) => Err(anyhow::Error::from(error)
+                        .context("runtime readiness owner shutdown failed")),
+                };
+            }
+            *slot = None;
+        }
+        *self.state.lock().await = ReadinessState::Closed;
+        joined?;
+        Ok(())
+    }
