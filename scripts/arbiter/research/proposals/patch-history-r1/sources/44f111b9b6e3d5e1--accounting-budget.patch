+// SPDX-License-Identifier: Apache-2.0
+//! Small transactional daily aggregates, independent of the index writer lock.
+//! A separate lifecycle lock prevents deletion/late-writer resurrection.
+use airk_core::usage::*;
+use anyhow::{Context, Result, ensure};
+use rusqlite::{Connection, OpenFlags, OptionalExtension, params};
+use serde::{Deserialize, Serialize};
+use std::{
+    fs::{self, File, OpenOptions},
+    path::{Path, PathBuf},
+    time::{Duration, Instant, SystemTime, UNIX_EPOCH},
+};
+
+mod wait;
+
+pub const DAY_MS: u64 = 86_400_000;
+const MAX_DEDUP: usize = 4096;
+const MAX_DIAGNOSTICS: usize = 128;
+const MAX_BUCKET_BYTES: usize = 65_536;
+const CONTENTION_BUDGET: Duration = Duration::from_secs(2);
+
+/// Request-owned cumulative admission allowance. Paused query time is excluded.
+/// Neither the allowance nor its active interval is cloned/refilled.
+pub struct AccountingBudget {
+    remaining: Duration,
+    active: Option<Instant>,
+    cancelled: AccountingCancellation,
+}
+#[derive(Clone, Default)]
+pub struct AccountingCancellation {
+    local: std::sync::Arc<std::sync::atomic::AtomicBool>,
+    session: Option<std::sync::Arc<std::sync::atomic::AtomicBool>>,
+}
+impl AccountingCancellation {
+    pub fn cancel(&self) { self.local.store(true, std::sync::atomic::Ordering::Release); }
+    /// One request-local signal plus its owning session's close signal.
+    pub fn request(&self) -> Self { Self { local: Default::default(), session: Some(self.local.clone()) } }
+    fn is_cancelled(&self) -> bool {
+        self.local.load(std::sync::atomic::Ordering::Acquire)
+            || self.session.as_ref().is_some_and(|value| value.load(std::sync::atomic::Ordering::Acquire))
+    }
+}
+impl AccountingBudget {
+    pub fn new(allowance: Duration) -> Self {
+        Self::with_cancellation(allowance, AccountingCancellation::default())
+    }
+    pub fn with_cancellation(allowance: Duration, cancelled: AccountingCancellation) -> Self {
+        Self { remaining: allowance, active: Some(Instant::now()), cancelled }
+    }
+    pub fn cancellation(&self) -> AccountingCancellation { self.cancelled.clone() }
+    pub fn pause(&mut self) { self.pause_at(Instant::now()); }
+    fn pause_at(&mut self, now: Instant) {
+        if let Some(started) = self.active.take() {
+            self.remaining = self.remaining.saturating_sub(now.saturating_duration_since(started));
+        }
+    }
+    pub fn resume(&mut self) { if self.active.is_none() { self.active = Some(Instant::now()); } }
+    fn remaining(&self) -> Result<Duration> {
+        ensure!(!self.cancelled.is_cancelled(), "usage accounting cancelled");
+        let started = self.active.context("usage accounting budget is paused")?;
+        let left = self.remaining.saturating_sub(started.elapsed());
+        ensure!(!left.is_zero(), "usage accounting admission budget exhausted");
+        Ok(left)
+    }
+    fn window(&self) -> Result<(Instant, Duration)> {
+        self.remaining()?;
+        Ok((self.active.expect("active budget checked"), self.remaining))
+    }
+    fn check(&self) -> Result<()> { self.remaining().map(|_| ()) }
+}
+
+pub fn unix_ms() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_millis()
+        .min(u128::from(u64::MAX)) as u64
+}
