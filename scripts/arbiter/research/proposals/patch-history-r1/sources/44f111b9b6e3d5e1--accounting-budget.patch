+    #[test]
+    fn cancelled_between_lifecycle_and_quota_leaves_no_partial_aggregate() -> Result<()> {
+        let (root, directory, scope) = setup()?;
+        let store = UsageStore::open_best_effort(&directory, &scope, &UsagePolicy::default())?.unwrap();
+        let lifecycle = deletion_guard(&directory)?;
+        let quota = OpenOptions::new().read(true).write(true)
+            .open(root.path().join(".quota-1.2/ledger.lock"))?;
+        quota.lock()?;
+        let budget = AccountingBudget::new(Duration::from_secs(5));
+        let cancellation = budget.cancellation();
+        let (entered, started) = std::sync::mpsc::channel();
+        std::thread::scope(|threads| -> Result<()> {
+            let worker = threads.spawn(|| {
+                entered.send(()).unwrap();
+                store.record_budgeted(&observation(&scope, 92), &budget)
+            });
+            started.recv()?;
+            // Release stage one, hold stage two, and revoke admission. No stage
+            // may replace the request's cancellation with a fresh quota budget.
+            drop(lifecycle);
+            let probe = OpenOptions::new().read(true).write(true).open(directory.join("usage.lock"))?;
+            let until = Instant::now() + Duration::from_secs(4);
+            loop {
+                match probe.try_lock() {
+                    Err(std::fs::TryLockError::WouldBlock) => break,
+                    Ok(()) => { probe.unlock()?; std::thread::yield_now(); }
+                    Err(error) => return Err(error.into()),
+                }
+                ensure!(Instant::now() < until, "worker never reached held quota stage");
+            }
+            cancellation.cancel();
+            assert!(worker.join().expect("accounting worker panicked").is_err());
+            Ok(())
+        })?;
+        drop(quota);
+        let read = UsageStore::read(&directory, &scope, 0, unix_ms() + DAY_MS)?;
+        assert!(read.lifetime.is_none_or(|summary| summary.calls == 0));
+        assert!(read.buckets.is_empty());
+        Ok(())
+    }
