+    #[test]
+    fn paused_query_interval_does_not_refill_or_consume_accounting_allowance() -> Result<()> {
+        let started = Instant::now();
+        let mut budget = AccountingBudget::new(Duration::from_millis(10));
+        budget.active = Some(started);
+        budget.pause_at(started + Duration::from_millis(4));
+        assert_eq!(budget.remaining, Duration::from_millis(6));
+        assert!(budget.window().is_err(), "paused budget cannot admit store work");
+        budget.active = Some(started + Duration::from_secs(100));
+        budget.pause_at(started + Duration::from_secs(100) + Duration::from_millis(3));
+        assert_eq!(budget.remaining, Duration::from_millis(3));
+        budget.pause_at(started + Duration::from_secs(200));
+        assert_eq!(budget.remaining, Duration::from_millis(3), "pause is idempotent");
+        Ok(())
+    }
