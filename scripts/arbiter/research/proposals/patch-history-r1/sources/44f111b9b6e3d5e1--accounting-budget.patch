+                entered.send(()).unwrap();
+                UsageStore::open_best_effort_budgeted(&directory, &scope, &UsagePolicy::default(), &budget)
+            });
+            started.recv()?;
+            drop(lifecycle);
+            let probe = OpenOptions::new().read(true).write(true).open(directory.join("usage.lock"))?;
+            let until = Instant::now() + Duration::from_secs(4);
+            loop {
