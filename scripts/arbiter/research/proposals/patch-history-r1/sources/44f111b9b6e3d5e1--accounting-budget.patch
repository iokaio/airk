+    #[test]
+    fn exhausted_or_cancelled_admission_creates_no_lock_file() -> Result<()> {
+        let directory = tempfile::tempdir()?;
+        for cancelled in [false, true] {
+            let budget = AccountingBudget::new(if cancelled { Duration::from_secs(1) } else { Duration::ZERO });
+            if cancelled { budget.cancellation().cancel(); }
+            let path = directory.path().join(if cancelled { "cancelled.lock" } else { "expired.lock" });
+            assert!(lock_before(path.clone(), Instant::now(), Duration::from_secs(1), &|| budget.check(), true).is_err());
+            assert!(!path.exists());
+        }
+        Ok(())
+    }
+
+    #[test]
+    fn cancellation_cannot_revoke_an_already_held_write_guard() -> Result<()> {
+        let directory = tempfile::tempdir()?;
+        let budget = AccountingBudget::new(Duration::from_secs(1));
+        let (started, allowance) = budget.window()?;
+        let path = directory.path().join("usage.lock");
+        let guard = lock_before(path.clone(), started, allowance, &|| budget.check(), true)?;
+        budget.cancellation().cancel();
+        assert!(lock(path.clone()).is_err(), "accepted owner keeps its OS lock through settlement");
+        drop(guard);
+        lock(path)?;
+        Ok(())
+    }
