+                            "invalid tokenizer input"
+                        );
+                        self.select_tokenizer(path, owner)?;
+                        require_live(owner)?;
+                        #[cfg(test)]
+                        if let Some(hook) = self.before_compute.as_mut() {
+                            hook(self.compute_context.as_ref(), &request);
+                        }
