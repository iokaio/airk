index 0000000..f60008d
--- /dev/null
+++ b/crates/airk-cli/src/embedding_pool_retirement.rs
@@ -0,0 +1,337 @@
+// SPDX-License-Identifier: Apache-2.0
+//! Bounded correlation state owned by the existing helper reply reader.
+use super::*;
+use std::collections::BTreeMap;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ProviderDrainState {
+    Pending,
+    Drained,
+    Unknown,
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Exchange {
+    Observe,
+    Forget,
+}
+struct Slot {
+    ticket: protocol::ProviderDrainTicket,
+    state: ProviderDrainState,
+    exchange: Option<(Exchange, Instant)>,
+}
+
+pub(super) struct Drains {
+    service: Incarnation,
+    helper: Incarnation,
+    members: BTreeMap<Incarnation, airk_core::service::WorkerIdentity>,
+    slots: BTreeMap<Incarnation, Slot>,
+    closed: bool,
+}
+impl Drains {
+    pub(super) fn new(service: Incarnation, helper: Incarnation) -> Self {
+        Self {
+            service,
+            helper,
+            members: BTreeMap::new(),
+            slots: BTreeMap::new(),
+            closed: false,
+        }
+    }
+    pub(super) fn validate_member(
+        &self,
+        identity: airk_core::service::WorkerIdentity,
+    ) -> Result<()> {
+        ensure!(
+            identity.service == self.service && identity.fencing_generation > 0,
+            "provider worker identity does not belong to this service"
+        );
+        ensure!(
+            !self
+                .slots
+                .values()
+                .any(|slot| slot.ticket.worker.worker == identity.worker),
+            "provider worker has an outstanding retirement obligation"
+        );
+        ensure!(
+            self.members
+                .get(&identity.worker)
+                .is_none_or(|member| *member == identity),
+            "provider worker fencing identity changed"
+        );
+        ensure!(
+            self.members.contains_key(&identity.worker)
+                || self.members.len() < protocol::MAX_PROVIDER_DRAINS,
+            "provider membership capacity exhausted"
+        );
+        Ok(())
+    }
+    pub(super) fn registered(&mut self, identity: airk_core::service::WorkerIdentity) {
+        self.members.insert(identity.worker, identity);
+    }
+    #[cfg(test)]
+    pub(super) fn revoked(&mut self, worker: Incarnation) {
+        if !self
+            .slots
+            .values()
+            .any(|slot| slot.ticket.worker.worker == worker)
+        {
+            self.members.remove(&worker);
+        }
+    }
+    pub(super) fn ticket(
+        &self,
+        identity: airk_core::service::WorkerIdentity,
+    ) -> Result<Option<protocol::ProviderDrainTicket>> {
+        ensure!(
+            identity.service == self.service,
+            "provider retirement worker belongs to another service"
+        );
+        Ok(self
+            .slots
+            .values()
+            .find(|slot| slot.ticket.worker == identity)
+            .map(|slot| slot.ticket))
+    }
+    pub(super) fn begin(
+        &mut self,
+        identity: airk_core::service::WorkerIdentity,
+        nonce: Incarnation,
+    ) -> Result<(protocol::ProviderDrainTicket, bool)> {
+        ensure!(
+            identity.service == self.service
+                && self.members.get(&identity.worker) == Some(&identity),
+            "provider retirement worker is not the exact registered native owner"
+        );
+        if let Some(slot) = self
+            .slots
+            .values()
+            .find(|slot| slot.ticket.worker == identity)
+        {
+            return Ok((slot.ticket, false));
+        }
+        ensure!(
+            self.slots.len() < protocol::MAX_PROVIDER_DRAINS && !self.slots.contains_key(&nonce),
+            "provider drain capacity or duplicate ticket"
+        );
+        let ticket = protocol::ProviderDrainTicket {
+            helper: self.helper,
+            worker: identity,
+            ticket: nonce,
+        };
+        self.slots.insert(
+            nonce,
+            Slot {
+                ticket,
+                state: if self.closed {
+                    ProviderDrainState::Unknown
+                } else {
+                    ProviderDrainState::Pending
+                },
+                exchange: Some((Exchange::Observe, Instant::now())),
+            },
+        );
+        Ok((ticket, !self.closed))
+    }
+    fn slot(&mut self, ticket: &protocol::ProviderDrainTicket) -> Result<&mut Slot> {
+        ensure!(
+            ticket.helper == self.helper && ticket.worker.service == self.service,
+            "provider retirement helper identity changed"
+        );
+        let slot = self
+            .slots
+            .get_mut(&ticket.ticket)
+            .context("provider retirement ticket is not owned")?;
+        ensure!(
+            slot.ticket == *ticket,
+            "provider retirement ticket identity mismatch"
+        );
+        Ok(slot)
+    }
+    pub(super) fn poll(
+        &mut self,
+        ticket: &protocol::ProviderDrainTicket,
+    ) -> Result<(ProviderDrainState, bool)> {
+        let closed = self.closed;
+        let slot = self.slot(ticket)?;
+        if slot.exchange.is_some_and(|(kind, sent)| {
+            kind == Exchange::Observe && sent.elapsed() >= Duration::from_secs(5)
+        }) {
+            slot.state = ProviderDrainState::Unknown;
+        }
+        let send = !closed && slot.state == ProviderDrainState::Pending && slot.exchange.is_none();
+        if send {
+            slot.exchange = Some((Exchange::Observe, Instant::now()));
+        }
+        Ok((slot.state, send))
+    }
+    pub(super) fn forget(&mut self, ticket: &protocol::ProviderDrainTicket) -> Result<bool> {
+        let slot = self.slot(ticket)?;
+        ensure!(
+            slot.state == ProviderDrainState::Drained,
+            "provider retirement has no engine completion acknowledgment"
+        );
+        if slot.exchange.is_some() {
+            return Ok(false);
+        }
+        slot.exchange = Some((Exchange::Forget, Instant::now()));
+        Ok(true)
+    }
+    pub(super) fn failed_write(&mut self, ticket: &protocol::ProviderDrainTicket) {
+        if let Ok(slot) = self.slot(ticket)
+            && slot.state != ProviderDrainState::Drained
+        {
+            slot.state = ProviderDrainState::Unknown;
+        }
+    }
+    pub(super) fn observe(
+        &mut self,
+        ticket: protocol::ProviderDrainTicket,
+        observation: protocol::ProviderDrainObservation,
+    ) {
+        let Ok(slot) = self.slot(&ticket) else {
+            return;
+        };
+        let Some((exchange, _)) = slot.exchange else {
+            return;
+        };
+        use protocol::ProviderDrainObservation as O;
+        match (exchange, observation) {
+            (Exchange::Observe, O::Pending) => {
+                slot.exchange = None;
+                slot.state = ProviderDrainState::Pending;
+            }
+            (Exchange::Observe, O::Drained) => {
+                slot.exchange = None;
+                slot.state = ProviderDrainState::Drained;
+            }
+            (Exchange::Forget, O::Forgotten) => {
+                self.slots.remove(&ticket.ticket);
+                self.members.remove(&ticket.worker.worker);
+            }
+            (_, O::Refused) => {
+                slot.exchange = None;
+                if slot.state != ProviderDrainState::Drained {
+                    slot.state = ProviderDrainState::Unknown;
+                }
+            }
+            _ => { /* An unsolicited or wrong-phase reply is never a proof. */ }
+        }
+    }
+    pub(super) fn closed(&mut self) {
+        self.closed = true;
+        for slot in self.slots.values_mut() {
+            if slot.state != ProviderDrainState::Drained {
+                slot.state = ProviderDrainState::Unknown;
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use airk_core::service::WorkerIdentity;
+    fn identity(member: u8) -> WorkerIdentity {
+        WorkerIdentity {
+            service: Incarnation::from_bytes([1; 16]),
+            worker: Incarnation::from_bytes([member; 16]),
+            project: Sha256Digest::from_bytes([member; 32]),
+            fencing_generation: 1,
+        }
+    }
+    fn registry() -> Drains {
+        Drains::new(identity(3).service, Incarnation::from_bytes([2; 16]))
+    }
+
+    #[test]
+    fn canceled_or_expired_waiter_retains_ticket_until_exact_engine_ack() -> Result<()> {
+        let mut drains = registry();
+        let worker = identity(3);
+        drains.registered(worker);
+        let (ticket, send) = drains.begin(worker, Incarnation::from_bytes([4; 16]))?;
+        assert!(send);
+        assert_eq!(drains.ticket(worker)?, Some(ticket));
+        assert!(drains.forget(&ticket).is_err());
+        let slot = drains.slots.get_mut(&ticket.ticket).unwrap();
+        slot.exchange = Some((Exchange::Observe, Instant::now() - Duration::from_secs(6)));
+        assert_eq!(drains.poll(&ticket)?, (ProviderDrainState::Unknown, false));
+        assert_eq!(
+            drains.begin(worker, Incarnation::from_bytes([5; 16]))?,
+            (ticket, false)
+        );
+        assert_eq!(drains.slots.len(), 1);
+        drains.observe(
+            protocol::ProviderDrainTicket {
+                helper: Incarnation::from_bytes([9; 16]),
+                ..ticket
+            },
+            protocol::ProviderDrainObservation::Drained,
+        );
+        assert_eq!(drains.poll(&ticket)?.0, ProviderDrainState::Unknown);
+        drains.observe(ticket, protocol::ProviderDrainObservation::Drained);
+        assert_eq!(drains.poll(&ticket)?, (ProviderDrainState::Drained, false));
+        assert!(drains.forget(&ticket)?);
+        assert_eq!(drains.slots.len(), 1, "writing Forget is not a receipt");
+        drains.observe(ticket, protocol::ProviderDrainObservation::Forgotten);
+        assert!(drains.ticket(worker)?.is_none());
+        Ok(())
+    }
+
+    #[test]
+    fn helper_eof_write_failure_and_foreign_identities_never_prove_drain() -> Result<()> {
+        let mut drains = registry();
+        let worker = identity(3);
+        drains.registered(worker);
+        let (ticket, _) = drains.begin(worker, Incarnation::from_bytes([4; 16]))?;
+        let foreign = protocol::ProviderDrainTicket {
+            worker: WorkerIdentity {
+                fencing_generation: 2,
+                ..worker
+            },
+            ..ticket
+        };
+        drains.observe(foreign, protocol::ProviderDrainObservation::Drained);
+        assert!(drains.poll(&foreign).is_err());
+        assert!(
+            drains
+                .begin(foreign.worker, Incarnation::from_bytes([5; 16]))
+                .is_err()
+        );
+        drains.failed_write(&ticket);
+        assert_eq!(drains.poll(&ticket)?, (ProviderDrainState::Unknown, false));
+        drains.closed();
+        assert_eq!(drains.poll(&ticket)?, (ProviderDrainState::Unknown, false));
+        assert!(drains.forget(&ticket).is_err());
+        assert_eq!(drains.slots.len(), 1);
+        Ok(())
+    }
+
+    #[test]
+    fn pending_ticket_capacity_is_fixed_and_only_explicit_acknowledged_forget_reclaims()
+    -> Result<()> {
+        let mut drains = registry();
+        let mut tickets = Vec::new();
+        for member in 3..35 {
+            let worker = identity(member);
+            drains.validate_member(worker)?;
+            drains.registered(worker);
+            tickets.push(
+                drains
+                    .begin(worker, Incarnation::from_bytes([member; 16]))?
+                    .0,
+            );
+        }
+        assert_eq!(drains.slots.len(), protocol::MAX_PROVIDER_DRAINS);
+        assert!(drains.validate_member(identity(35)).is_err());
+        let ticket = tickets[0];
+        assert!(drains.validate_member(ticket.worker).is_err());
+        drains.observe(ticket, protocol::ProviderDrainObservation::Drained);
+        drains.forget(&ticket)?;
+        assert!(drains.validate_member(identity(35)).is_err());
+        drains.observe(ticket, protocol::ProviderDrainObservation::Forgotten);
+        drains.validate_member(identity(35))?;
+        assert_eq!(drains.slots.len(), protocol::MAX_PROVIDER_DRAINS - 1);
+        Ok(())
+    }
+}
diff --git a/crates/airk-cli/src/embedding_pool_shared.rs b/crates/airk-cli/src/embedding_pool_shared.rs
new file mode 100644
index 0000000..97c87d6
--- /dev/null
+++ b/crates/airk-cli/src/embedding_pool_shared.rs
@@ -0,0 +1,402 @@
+// SPDX-License-Identifier: Apache-2.0
+//! Native shared-helper admission and predecessor recovery. Durable metadata is
+//! combined with actual OS completion; metadata/EOF alone never mint a witness.
+use super::*;
+#[cfg(windows)]
+use airk_store::service::registry::{
+    ProviderBoot, SharedHelperContainment, shared_helper_job_name,
+};
+use airk_store::service::registry::{
+    ServiceRegistry, SharedHelperDrain, SharedHelperIdentity, SharedHelperPhase,
+};
+
+pub struct SharedHelperPredecessorProof {
+    namespace: Incarnation,
+    service: Incarnation,
+    witnesses: Vec<ProviderReapWitness>,
+}
+impl SharedHelperPredecessorProof {
+    pub fn matches(&self, namespace: Incarnation, service: Incarnation) -> bool {
+        self.namespace == namespace && self.service == service
+    }
+    pub fn witnesses(&self) -> &[ProviderReapWitness] {
+        &self.witnesses
+    }
+}
+
+pub(crate) fn registry(root: &Path) -> Result<ServiceRegistry> {
+    let saved = ServiceRegistry::open_saved(root)?;
+    let state = saved
+        .catalog_state()?
+        .context("shared helper coverage is unavailable")?;
+    ensure!(
+        state.activated && state.authority_contract == 1,
+        "shared helper coverage requires actual authority-1 activation"
+    );
+    ServiceRegistry::open(root, state.namespace)
+}
+
+pub(crate) fn known_transition(
+    registry: &ServiceRegistry,
+    result: Result<SharedHelperDrain>,
+    expected: &SharedHelperDrain,
+) -> Result<SharedHelperDrain> {
+    match result {
+        Ok(record) => {
+            ensure!(
+                record == *expected,
+                "shared helper transition returned another identity"
+            );
+            Ok(record)
+        }
+        Err(error) => match registry.shared_helper_drain(expected.owner) {
+            Ok(Some(record)) if record == *expected => Ok(record),
+            _ => Err(error.context("shared helper transition outcome is not durably known")),
+        },
+    }
+}
+
+pub(crate) fn complete(root: &Path, owner: SharedHelperIdentity) -> Result<SharedHelperDrain> {
+    let mut registry = registry(root)?;
+    let record = registry
+        .shared_helper_drain(owner)?
+        .context("shared helper completion record missing")?;
+    let mut expected = record.clone();
+    expected.phase = SharedHelperPhase::Drained;
+    let result = registry.complete_shared_helper_drain(&record);
+    known_transition(&registry, result, &expected)
+}
+
+/// Called only under the current native service owner/start barrier. Current
+/// healthy helpers are never killed to satisfy one worker's retirement.
+pub fn recover_shared_helper(
+    root: &Path,
+    owner: SharedHelperIdentity,
+) -> Result<Option<ProviderReapWitness>> {
+    let mut registry = registry(root)?;
+    let current = registry
+        .recorded_service_instance()?
+        .context("current native service is not recorded")?;
+    let record = registry
+        .shared_helper_drain(owner)?
+        .context("shared helper has no canonical admission record")?;
+    if owner.service == current {
+        return Ok(None);
+    }
+    recover_record(root, &mut registry, &record)
+}
+
+/// Installer maintenance holds native service exclusion rather than inventing
+/// a replacement service instance. All recorded helpers are now excluded owners,
+/// including the last recorded instance. Never prune history here: worker drain
+/// obligations may still need these terminal observations on the next startup.
+pub(crate) fn quiesce_for_maintenance(lease: &airk_store::service::ServiceLease) -> Result<bool> {
+    let root = lease.root();
+    let saved = ServiceRegistry::open_saved(root)?;
+    let Some(state) = saved.catalog_state()? else {
+        return Ok(true); // Legacy helper lifetime remains covered by its lease.
+    };
+    if state.authority_contract == 0 {
+        return Ok(true);
+    }
+    ensure!(
+        state.activated && state.authority_contract == 1,
+        "installer shared helper coverage requires a supported active catalog"
+    );
+    let records = saved.shared_helper_drains()?;
+    drop(saved);
+    let mut registry = registry(root)?;
+    for record in records {
+        if recover_record(root, &mut registry, &record)?.is_none() {
+            return Ok(false);
+        }
+    }
+    Ok(true)
+}
+
+fn recover_record(
+    _root: &Path,
+    registry: &mut ServiceRegistry,
+    record: &SharedHelperDrain,
+) -> Result<Option<ProviderReapWitness>> {
+    let owner = record.owner;
+    // The strict canonical row records a prior native completion. Never open
+    // a newly recreated job name or probe a reused numerical group after that
+    // durable terminal transition; those resources are no longer ours.
+    if record.phase == SharedHelperPhase::Drained {
+        return Ok(Some(ProviderReapWitness {
+            service: owner.service,
+            helper: owner.helper,
+        }));
+    }
+    #[cfg(unix)]
+    let done = crate::unix_guardian::shared::recover(record, _root)?;
+    #[cfg(windows)]
+    let done = recover_windows(record)?;
+    if !done {
+        return Ok(None);
+    }
+    let mut expected = record.clone();
+    expected.phase = SharedHelperPhase::Drained;
+    let result = registry.complete_shared_helper_drain(record);
+    known_transition(registry, result, &expected)?;
+    // The predecessor service is excluded by the current native owner; its
+    // reader threads ended with that process. Native container/guardian proof
+    // above is additional, never inferred from service or row absence alone.
+    Ok(Some(ProviderReapWitness {
+        service: owner.service,
+        helper: owner.helper,
+    }))
+}
+
+pub fn recover_predecessor_shared_helpers(
+    root: &Path,
+    current: Incarnation,
+) -> Result<Option<SharedHelperPredecessorProof>> {
+    let registry = registry(root)?;
+    ensure!(
+        registry.recorded_service_instance()? == Some(current),
+        "predecessor helper recovery has another current native owner"
+    );
+    let namespace = registry.incarnation()?;
+    let records = registry.shared_helper_drains()?;
+    drop(registry);
+    let mut witnesses = Vec::new();
+    for record in records
+        .into_iter()
+        .filter(|record| record.owner.service != current)
+    {
+        let Some(witness) = recover_shared_helper(root, record.owner)? else {
+            return Ok(None);
+        };
+        witnesses.push(witness);
+    }
+    Ok(Some(SharedHelperPredecessorProof {
+        namespace,
+        service: current,
+        witnesses,
+    }))
+}
+
+/// Called by the existing native owner only after strict attach and retained
+/// resource/WDO reconciliation. The opaque proof is never a frontend boolean.
+pub fn prune_predecessor_shared_helpers(
+    root: &Path,
+    current: Incarnation,
+    lease: &airk_store::service::ServiceLease,
+    proof: &SharedHelperPredecessorProof,
+) -> Result<usize> {
+    let mut registry = registry(root)?;
+    ensure!(
+        proof.matches(registry.incarnation()?, current),
+        "shared helper predecessor cleanup proof differs"
+    );
+    let records = registry
+        .shared_helper_drains()?
+        .into_iter()
+        .filter(|record| record.owner.service != current)
+        .collect::<Vec<_>>();
+    ensure!(
+        records.len() <= proof.witnesses.len()
+            && records
+                .iter()
+                .all(|record| record.phase == SharedHelperPhase::Drained
+                    && proof
+                        .witnesses
+                        .iter()
+                        .any(|witness| witness.matches(record.owner.service, record.owner.helper))),
+        "shared helper predecessor cleanup has uncaptured ownership"
+    );
+    registry.prune_drained_shared_helpers(lease, current, &records)
+}
+
+#[cfg(test)]
+#[path = "embedding_pool_shared_tests.rs"]
+mod tests;
+
+#[cfg(windows)]
+fn recover_windows(record: &SharedHelperDrain) -> Result<bool> {
+    let SharedHelperContainment::Windows {
+        job_name,
+        user_sid,
+        created,
+        leader_pid,
+        ..
+    } = &record.containment
+    else {
+        anyhow::bail!("shared helper native platform changed");
+    };
+    ensure!(
+        crate::local_ipc::current_user()? == *user_sid,
+        "shared helper belongs to another native user"
+    );
+    if !created {
+        // The canonical producer never spawns before Created is durably known.
+        // A collided/foreign object with this name MUST NOT be opened or killed.
+        ensure!(
+            leader_pid.is_none() && record.phase != SharedHelperPhase::Bound,
+            "uncreated shared helper has a process binding"
+        );
+        return Ok(true);
+    }
+    match airk_process::ChildJob::open_named(job_name, |handle| {
+        crate::local_ipc::require_job_user(handle, user_sid)
+    })? {
+        airk_process::NamedJobOpen::Missing => Ok(true),
+        airk_process::NamedJobOpen::Owned(job) => {
+            job.terminate_and_wait(Duration::from_secs(2))?;
+            Ok(true)
+        }
+    }
+}
+
+#[cfg(windows)]
+pub(super) struct ManagedWindows {
+    pub child: Option<airk_process::AtomicJobChild>,
+    job: airk_process::ChildJob,
+    root: PathBuf,
+    owner: SharedHelperIdentity,
+    finished: bool,
+}
+#[cfg(windows)]
+impl ManagedWindows {
+    pub(super) fn member_pids(&self) -> Result<Vec<u32>> {
+        self.job.member_pids()
+    }
+    pub(super) fn spawn(
+        root: &Path,
+        service: Incarnation,
+        helper: Incarnation,
+        program: &Path,
+    ) -> Result<Self> {
+        let root = root.canonicalize()?;
+        let null = std::fs::OpenOptions::new().write(true).open("NUL")?;
+        let owner = SharedHelperIdentity { service, helper };
+        let mut registry = registry(&root)?;
+        let namespace = registry.incarnation()?;
+        let user = crate::local_ipc::current_user()?;
+        let job_name = shared_helper_job_name(namespace, owner, &user)?;
+        let record = registry.begin_shared_helper_drain(
+            owner,
+            SharedHelperContainment::Windows {
+                job_name: job_name.clone(),
+                user_sid: user.clone(),
+                session: session()?,
+                created: false,
+                leader_pid: None,
+            },
+            boot(&user)?,
+        )?;
+        let job =
+            match crate::local_ipc::with_current_user_job_security(|attributes, native_user| {
+                ensure!(native_user == user, "shared helper native user changed");
+                airk_process::ChildJob::unassigned_named(&job_name, attributes)
+            }) {
+                Ok(job) => job,
+                Err(error) => {
+                    let _ = complete(&root, owner);
+                    return Err(error);
+                }
+            };
+        let mut managed = Self {
+            child: None,
+            job,
+            root,
+            owner,
+            finished: false,
+        };
+        let mut expected = record.clone();
+        let SharedHelperContainment::Windows { created, .. } = &mut expected.containment else {
+            unreachable!()
+        };
+        *created = true;
+        let result = registry.mark_shared_job_created(&record);
+        let created = known_transition(&registry, result, &expected)?;
+        managed.child = Some(managed.job.spawn_guarded_with_stderr(
+            program,
+            "pool-guarded",
+            &null,
+        )?);
+        ensure!(
+            managed
+                .child
+                .as_ref()
+                .expect("created guarded helper")
+                .assigned_to(&managed.job)?,
+            "shared helper atomic job assignment is missing"
+        );
+        let mut expected = created.clone();
+        let SharedHelperContainment::Windows { leader_pid, .. } = &mut expected.containment else {
+            unreachable!()
+        };
+        let child = managed.child.as_mut().expect("created guarded helper");
+        *leader_pid = Some(child.id());
+        expected.phase = SharedHelperPhase::Bound;
+        let result = registry.bind_shared_helper(&created, child.id());
+        known_transition(&registry, result, &expected)?;
+        let permit = crate::embedding_pool_bootstrap::GuardPermit {
+            version: 2,
+            runtime: managed.root.clone(),
+            namespace,
+            owner,
+        };
+        service_ipc::write_frame(
+            child
+                .stdin
+                .as_mut()
+                .context("guarded helper input missing")?,
+            &permit,
+        )?;
+        Ok(managed)
+    }
+    pub(super) fn drain(&mut self, timeout: Duration) -> Result<()> {
+        if self.finished {
+            return Ok(());
+        }
+        self.job.terminate_and_wait(timeout)?;
+        if let Some(child) = self.child.as_mut() {
+            child.wait()?;
+        }
+        complete(&self.root, self.owner)?;
+        self.finished = true;
+        Ok(())
+    }
+}
+#[cfg(windows)]
+impl Drop for ManagedWindows {
+    fn drop(&mut self) {
+        while self.drain(Duration::from_secs(2)).is_err() {
+            std::thread::sleep(Duration::from_millis(25));
+        }
+    }
+}
+
+#[cfg(windows)]
+fn session() -> Result<u32> {
+    let mut session = 0;
+    // SAFETY: current process identity and correctly sized native output.
+    ensure!(
+        unsafe {
+            windows_sys::Win32::System::RemoteDesktop::ProcessIdToSessionId(
+                std::process::id(),
+                &mut session,
+            )
+        } != 0,
+        std::io::Error::last_os_error()
+    );
+    Ok(session)
+}
+#[cfg(windows)]
+fn boot(user: &str) -> Result<ProviderBoot> {
+    use sha2::{Digest, Sha256};
+    // SAFETY: scalar monotonic native uptime query with no pointer arguments.
+    let elapsed = unsafe { windows_sys::Win32::System::SystemInformation::GetTickCount64() };
+    Ok(ProviderBoot {
+        boot_id: None,
+        process_scope: format!("windows-global-user-{:x}", Sha256::digest(user.as_bytes())),
+        elapsed_ns: elapsed
+            .checked_mul(1_000_000)
+            .context("native Windows uptime overflow")?,
+        monotonic_reset_proves_boot: true,
+    })
+}
diff --git a/crates/airk-cli/src/embedding_pool_shared_native_tests.rs b/crates/airk-cli/src/embedding_pool_shared_native_tests.rs
new file mode 100644
index 0000000..c1cb016
--- /dev/null
+++ b/crates/airk-cli/src/embedding_pool_shared_native_tests.rs
@@ -0,0 +1,349 @@
+// SPDX-License-Identifier: Apache-2.0
+//! Explicit native qualification against the newly built verified executable
+//! pair. These are opt-in and fail if the pair is not supplied; a metadata
+//! fixture alone is never reported as guarded-helper qualification.
+use super::*;
+use std::time::{Duration, Instant};
+
+fn real_main() -> Result<PathBuf> {
+    std::env::var_os("AIRK_GUARDED_PAIR_MAIN")
+        .map(PathBuf::from)
+        .context("set AIRK_GUARDED_PAIR_MAIN to the newly built, verified airk executable pair")
+}
+
+#[test]
+#[ignore = "requires newly built verified airk/airk-embed native pair"]
+fn guarded_real_pair_starts_and_records_actual_native_completion() -> Result<()> {
+    let fixture = Fixture::new()?;
+    let mut pool = Pool::start_fixture(&fixture.root, OLD, &real_main()?)?;
+    assert!(matches!(
+        pool.status()?,
+        protocol::Observation::Status { .. }
+    ));
+    let owner = SharedHelperIdentity {
+        service: OLD,
+        helper: pool.identity(),
+    };
+    let row = registry(&fixture.root)?
+        .shared_helper_drain(owner)?
+        .context("actual native admission")?;
+    assert_eq!(row.phase, SharedHelperPhase::Bound);
+    match row.containment {
+        SharedHelperContainment::Unix {
+            guardian_pid,
+            group,
+            ..
+        } => {
+            assert!(guardian_pid.is_some());
+            assert_eq!(group, Some(pool.process_id()));
+        }
+        SharedHelperContainment::Windows {
+            created,
+            leader_pid,
+            ..
+        } => {
+            assert!(created);
+            assert_eq!(leader_pid, Some(pool.process_id()));
+        }
+    }
+    pool.terminate()?;
+    assert!(
+        pool.reap_witness()
+            .context("actual group/job and reader completion")?
+            .matches(OLD, owner.helper)
+    );
+    assert_eq!(
+        registry(&fixture.root)?
+            .shared_helper_drain(owner)?
+            .context("durable native completion")?
+            .phase,
+        SharedHelperPhase::Drained
+    );
+    Ok(())
+}
+
+struct Controller(std::process::Child);
+impl Drop for Controller {
+    fn drop(&mut self) {
+        let _ = self.0.kill();
+        let _ = self.0.wait();
+    }
+}
+
+#[test]
+#[ignore = "requires newly built verified airk/airk-embed native pair"]
+fn abrupt_service_exit_recovers_real_guarded_helper_before_predecessor_proof() -> Result<()> {
+    abrupt_service_exit_recovers(false)
+}
+
+#[test]
+#[ignore = "requires newly built verified airk/airk-embed native pair"]
+fn installer_maintenance_recovers_last_service_helper_without_new_service_identity() -> Result<()> {
+    abrupt_service_exit_recovers(true)
+}
+
+fn abrupt_service_exit_recovers(maintenance: bool) -> Result<()> {
+    let main = real_main()?;
+    let Fixture {
+        _directory,
+        root,
+        lease,
+    } = Fixture::new()?;
+    drop(lease);
+    let ready = _directory.path().join("native-ready");
+    let mut controller = Controller(
+        std::process::Command::new(std::env::current_exe()?)
+            .args([
+                "--exact",
+                "embedding_pool_process::shared::tests::native::guarded_shared_controller_fixture",
+                "--ignored",
+            ])
+            .env("AIRK_GUARDED_PAIR_MAIN", main)
+            .env("AIRK_GUARDED_CONTROL_ROOT", &root)
+            .env("AIRK_GUARDED_CONTROL_READY", &ready)
+            .stdin(std::process::Stdio::null())
+            .stdout(std::process::Stdio::null())
+            .stderr(std::process::Stdio::inherit())
+            .spawn()?,
+    );
+    let until = Instant::now() + Duration::from_secs(30);
+    while !ready.try_exists()? {
+        ensure!(
+            Instant::now() < until && controller.0.try_wait()?.is_none(),
+            "guarded controller did not reach native ready"
+        );
+        std::thread::sleep(Duration::from_millis(10));
+    }
+    let before = registry(&root)?.shared_helper_drains()?;
+    assert_eq!(before.len(), 1);
+    assert_eq!(before[0].phase, SharedHelperPhase::Bound);
+    controller.0.kill()?;
+    controller.0.wait()?;
+    let lease = ServiceLease::acquire(&root)?;
+    if maintenance {
+        let until = Instant::now() + Duration::from_secs(30);
+        while !quiesce_for_maintenance(&lease)? {
+            ensure!(
+                Instant::now() < until,
+                "installer helper containment did not drain"
+            );
+            std::thread::sleep(Duration::from_millis(25));
+        }
+        let saved = registry(&root)?;
+        assert_eq!(saved.recorded_service_instance()?, Some(OLD));
+        let after = saved.shared_helper_drains()?;
+        assert_eq!(after.len(), 1, "maintenance preserves obligations' history");
+        assert_eq!(after[0].owner, before[0].owner);
+        assert_eq!(after[0].phase, SharedHelperPhase::Drained);
+        assert!(
+            quiesce_for_maintenance(&lease)?,
+            "exact retry is idempotent"
+        );
+        return Ok(());
+    }
+    registry(&root)?.record_service_instance(&lease, CURRENT)?;
+    let until = Instant::now() + Duration::from_secs(30);
+    let proof = loop {
+        if let Some(proof) = recover_predecessor_shared_helpers(&root, CURRENT)? {
+            break proof;
+        }
+        ensure!(
+            Instant::now() < until,
+            "actual old guarded resources did not drain"
+        );
+        std::thread::sleep(Duration::from_millis(25));
+    };
+    assert_eq!(proof.witnesses().len(), 1);
+    assert!(proof.witnesses()[0].matches(OLD, before[0].owner.helper));
+    // This exclusion supplements actual native container proof above. It is
+    // never used as the proof by itself.
+    let _embedding = airk_store::service::EmbeddingLease::acquire(&root)?;
+    assert_eq!(
+        prune_predecessor_shared_helpers(&root, CURRENT, &lease, &proof)?,
+        1
+    );
+    assert!(registry(&root)?.shared_helper_drains()?.is_empty());
+    Ok(())
+}
+
+#[test]
+#[ignore = "isolated native controller entry; selected by its owning test only"]
