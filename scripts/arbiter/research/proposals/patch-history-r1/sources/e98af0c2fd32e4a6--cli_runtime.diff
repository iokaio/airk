+fn frame_initialize() -> Vec<u8> {
+    format!("{}\n", json!({"jsonrpc":"2.0","id":1,"method":"initialize","params":{
+        "protocolVersion":"2025-11-25","capabilities":{},"clientInfo":{"name":"frame-fixture","version":"1"}
+    }})).into_bytes()
