+            );
+            break;
+        }
+    }
+    let value = page(&items);
+    ensure!(
+        serde_json::to_vec(&value)?.len() <= airk_core::service::MAX_FRAME_BYTES,
+        "legacy candidate list exceeds reply budget"
+    );
+    Ok(value)
