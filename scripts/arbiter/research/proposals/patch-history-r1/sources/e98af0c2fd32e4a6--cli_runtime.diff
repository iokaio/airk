+    for (newline, chunk) in [(true, 1), (true, 8192), (false, LIMIT + 1)] {
+        let mut bytes = frame_initialize();
+        bytes.pop();
+        bytes.resize(LIMIT, b' ');
+        if newline {
+            bytes.push(b'\n');
+        } else {
