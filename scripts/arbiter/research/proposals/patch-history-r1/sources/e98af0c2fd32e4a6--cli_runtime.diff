+        backend.clone(),
+        Arc::new(move || close.close()),
+    )
+    .await;
+    let cleanup = backend.shutdown().await;
+    match (result, cleanup) {
+        (Err(error), Err(cleanup)) => {
+            Err(error.context(format!("combined native cleanup also failed: {cleanup:#}")))
