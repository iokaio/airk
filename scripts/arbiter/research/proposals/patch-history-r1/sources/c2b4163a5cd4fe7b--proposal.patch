+        let role = protocol::role(identity.worker);
+        let mut worker = local_ipc::Listener::bind(&local_ipc::endpoint(root, &role)?)?;
+        let grant = ConnectionGrant {
+            scope: None,
+            protocol: PROTOCOL_VERSION,
