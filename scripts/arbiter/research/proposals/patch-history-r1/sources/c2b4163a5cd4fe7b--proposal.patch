+    #[test]
+    fn semantic_retry_after_commit_only_repeats_observation() -> anyhow::Result<()> {
+        let turns = std::cell::Cell::new(0);
+        let reads = std::cell::Cell::new(0);
+        let result = super::semantic_publication(
+            || {
+                turns.set(turns.get() + 1);
