+            redirects: 0,
+        }
+    }
+    pub(super) fn live(&self) -> std::result::Result<(), Failure> {
+        if tokio::time::Instant::now() >= self.deadline {
+            Err(Failure::Deadline)
+        } else {
+            Ok(())
+        }
+    }
+    fn redirect(&mut self) -> Result<()> {
+        ensure!(self.redirects < 4, "Arbiter original part redirect limit");
+        self.redirects += 1;
+        Ok(())
+    }
+}
