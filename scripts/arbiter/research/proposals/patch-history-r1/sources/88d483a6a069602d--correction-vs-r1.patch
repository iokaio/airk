+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct HistoricalToolCustodyCopy {
+    pub tool: String,
+    pub original: ResourceFilePin,
+    pub copy: ResourceFilePin,
+    pub bytes: u64,
