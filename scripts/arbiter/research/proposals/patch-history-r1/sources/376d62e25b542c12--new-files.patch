+    }
+    let mut changed = value.clone();
+    changed.files[1].sha256 = hash(30);
+    assert!(!accepts(&changed, &native));
+    let mut changed = value.clone();
+    changed.files.push(changed.files[0].clone());
+    assert!(!accepts(&changed, &native));
+}
