-            text == format!("stage-{revision}"),
-            "Arbiter stage identity differs"
-        );
-        let stage = directory.open_dir(&name)?;
-        #[cfg(windows)]
-        let raw_stage = raw.open_child(&name)?;
-        #[cfg(windows)]
-        same_directory(&raw_stage, &stage)?;
