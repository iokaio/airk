-fn cleanup_stages(
-    directory: &SetupDirectory,
-    record: &Record,
-    #[cfg(windows)] raw: &airk_process::directory::OpenedDirectory,
-) -> Result<()> {
-    let mut names = Vec::new();
-    for name in directory.entries()? {
-        ensure!(names.len() < 2048, "Arbiter cleanup entry bound");
