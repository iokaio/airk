+        let n = file.read(&mut buffer[..limit])?;
+        ensure!(n > 0, "Arbiter asset shortened");
+        digest.update(&buffer[..n]);
+        remaining -= u64::try_from(n)?;
+        #[cfg(feature = "test-support")]
