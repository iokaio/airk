+            )
+            .is_err()
+    );
+    assert_eq!(calls.get(), 1);
+    let calls = Cell::new(0u64);
+    let fail_recovered_stage = |file: &File| -> Result<()> {
+        calls.set(calls.get() + 1);
+        if calls.get() == 2 {
+            anyhow::bail!("recovered stage is not durable");
+        }
+        file.sync_all()?;
+        Ok(())
+    };
+    assert!(
