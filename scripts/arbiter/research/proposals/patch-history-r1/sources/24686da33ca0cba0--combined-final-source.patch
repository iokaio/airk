+#[derive(Clone, Debug, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct DeviceStageStatus {
+    pub selected_model: Option<SelectedModel>,
+    pub device_policy: DevicePolicy,
+    pub gpu_precision: GpuPrecisionPreference,
+    pub active_profile: Option<Sha256Digest>,
+    pub availability: Availability,
+    pub reason: String,
+    pub queued: usize,
+    pub running: usize,
+    pub selection: Option<DeviceSelection>,
+    pub models: Vec<DeviceModelStatus>,
+}
+impl DeviceStageStatus {
+    pub fn validate(&self, stage: Stage, configuration: &DeviceStageConfiguration) -> Result<()> {
+        configuration.validate(stage)?;
+        ensure!(
+            self.selected_model == configuration.selected_model
+                && self.device_policy == configuration.device_policy
+                && self.gpu_precision == configuration.gpu_precision
+                && !self.reason.is_empty()
+                && self.reason.len() <= 1024,
+            "device stage requested identity/reason differs"
+        );
+        let expected = match stage {
+            Stage::Focus => BTreeSet::from([SelectedModel::Focus]),
+            Stage::Context => {
+                BTreeSet::from([SelectedModel::ContextCompact, SelectedModel::ContextLarge])
+            }
+        };
+        let mut models = BTreeSet::new();
+        let mut manifests = BTreeSet::new();
+        let mut active = None;
+        for model in &self.models {
+            ensure!(
+                model.model.stage() == stage
+                    && models.insert(model.model)
+                    && !model.reason.is_empty()
+                    && model.reason.len() <= 1024
+                    && model.tasks.iter().all(|task| stage.permits(*task)),
+                "foreign/duplicate device model slot"
+            );
+            if !model.variants.is_empty() {
+                let tasks = model
+                    .variants
+                    .iter()
+                    .flat_map(|variant| variant.tasks.iter().copied())
+                    .collect::<BTreeSet<_>>();
+                ensure!(
+                    tasks == model.tasks,
+                    "model task summary differs from native variant tasks"
+                );
+            }
+            ensure!(
+                model.availability != Availability::Ready
+                    || model
+                        .variants
+                        .iter()
+                        .any(|variant| variant.availability == Availability::Ready),
+                "ready model summary lacks an actual ready variant"
+            );
+            for variant in &model.variants {
+                ensure!(
+                    !variant.tasks.is_empty()
+                        && variant.tasks.iter().all(|task| stage.permits(*task))
+                        && variant.download_bytes.is_none_or(|bytes| bytes > 0)
+                        && variant
+                            .memory_reservation_bytes
+                            .is_none_or(|bytes| bytes > 0),
+                    "invalid native variant task/resource metadata"
+                );
+                if let Some(fit) = &variant.cpu_fit {
+                    fit.validate()?;
+                }
+                let mut targets = BTreeSet::new();
+                for target in &variant.qualified_targets {
+                    ensure!(
+                        targets.insert(&target.target)
+                            && target.execution_identity == variant.execution_identity
+                            && matches!(
+                                target.target.as_str(),
+                                "x86_64-pc-windows-msvc"
+                                    | "aarch64-apple-darwin"
+                                    | "x86_64-apple-darwin"
+                                    | "x86_64-unknown-linux-gnu"
+                            ),
+                        "invalid native variant qualified target metadata"
+                    );
+                }
+                ensure!(
+                    manifests.len() < 16
+                        && manifests.insert(variant.manifest)
+                        && !variant.execution_identity.is_empty()
+                        && variant.execution_identity.len() <= 4096
+                        && !variant.reason.is_empty()
+                        && variant.reason.len() <= 1024
+                        && variant.backend.is_some() == variant.precision.is_some(),
+                    "invalid device variant status"
+                );
+                if let Some(evidence) = &variant.device_evidence {
+                    ensure!(
+                        variant.backend.is_some()
+                            && evidence.execution_identity == variant.execution_identity
+                            && !evidence.target.is_empty()
+                            && evidence.target.len() <= 128
+                            && matches!(
+                                evidence.target.as_str(),
+                                "x86_64-pc-windows-msvc"
+                                    | "aarch64-apple-darwin"
+                                    | "x86_64-apple-darwin"
+                                    | "x86_64-unknown-linux-gnu"
+                            ),
+                        "device evidence does not bind variant"
+                    );
+                }
+                if variant.availability == Availability::Ready {
+                    ensure!(
+                        variant.model_admission != ModelAdmissionStatus::Unavailable
+                            && (variant.backend.is_none() || variant.device_evidence.is_some()),
+                        "ready variant lacks native model/device evidence"
+                    );
+                }
+                if self.active_profile == Some(variant.manifest) {
+                    active = Some((model.model, variant));
+                }
+            }
+        }
+        ensure!(models == expected, "missing device model slot");
+        if let Some(selection) = &self.selection {
+            ensure!(
+                selection.schema == DEVICE_STATUS_SCHEMA
+                    && Some(selection.model) == self.selected_model
+                    && selection.policy == self.device_policy
+                    && selection.gpu_precision == self.gpu_precision
+                    && selection.reasons.len() <= 18,
+                "device selection request identity differs"
+            );
+            ensure!(
+                selection.operation_failure.is_none() || selection.selected.is_none(),
+                "global device failure cannot select a variant"
+            );
+            if let Some(selected) = &selection.selected {
+                let variant = self
+                    .models
+                    .iter()
+                    .filter(|row| row.model == selection.model)
+                    .flat_map(|row| &row.variants)
+                    .find(|row| row.manifest == selected.manifest)
+                    .context("selected variant outside requested model")?;
+                ensure!(
+                    selected.execution_identity == variant.execution_identity
+                        && selected.backend == variant.backend
+                        && selected.precision == variant.precision
+                        && selected.capability_epoch > 0
+                        && !selected.adapter_key.is_empty()
+                        && selected.adapter_key.len() <= 256,
+                    "selected execution observation differs"
+                );
+                ensure!(
+                    self.device_policy != DevicePolicy::Cpu || selected.backend.is_none(),
+                    "forced CPU selected GPU"
+                );
+                if selected.backend.is_some() {
+                    ensure!(
+                        match self.gpu_precision {
+                            GpuPrecisionPreference::Auto => true,
+                            GpuPrecisionPreference::Fp32 =>
+                                selected.precision == Some(DevicePrecision::Float32),
+                            GpuPrecisionPreference::Fp16 =>
+                                selected.precision == Some(DevicePrecision::Float16),
+                        },
+                        "GPU precision preference differs"
+                    );
+                }
+            }
+        }
+        if self.availability == Availability::Ready {
+            let (model, variant) = active.context("ready device stage lacks resident variant")?;
+            ensure!(
+                configuration.enabled
+                    && Some(model) == self.selected_model
+                    && variant.availability == Availability::Ready,
+                "ready device stage lacks enabled selected model"
+            );
+            let selected = self
+                .selection
+                .as_ref()
+                .and_then(|row| row.selected.as_ref())
+                .context("ready device stage lacks actual selection")?;
+            ensure!(
+                Some(selected.manifest) == self.active_profile,
+                "resident differs from selected variant"
+            );
+        }
+        Ok(())
+    }
+}
