+impl Profile {
+    /// A compiled qualified release must bind every logical asset and each
+    /// bounded part with complete reviewed source ordinals. Downloaded metadata cannot supply this list.
+    pub fn validate_release_downloads(&self) -> Result<()> {
+        self.validate()?;
+        ensure!(
+            self.downloads.len() == self.assets.len(),
+            "incomplete Arbiter download closure"
+        );
+        let mut seen = BTreeSet::new();
+        for download in &self.downloads {
+            ensure!(
+                seen.insert(&download.asset_name),
+                "duplicate Arbiter asset download"
+            );
+            let asset = self
+                .assets
+                .iter()
+                .find(|asset| asset.name == download.asset_name)
+                .ok_or_else(|| anyhow::anyhow!("unknown Arbiter asset download"))?;
+            download.source_count()?;
+            let mut bytes = 0_u64;
+            for part in &download.parts {
+                bytes = bytes
+                    .checked_add(part.bytes)
+                    .ok_or_else(|| anyhow::anyhow!("Arbiter part byte overflow"))?;
+            }
+            ensure!(
+                bytes == asset.bytes,
+                "Arbiter logical asset length differs from parts"
+            );
+            ensure!(
+                download.parts.len() != 1 || download.parts[0].sha256 == asset.sha256,
+                "Arbiter single-part digest differs from logical asset"
+            );
+        }
+        Ok(())
+    }
+    /// Historical CPU receipt bytes stay CPU base; GPU receipts use the full
+    /// source/graph/math/provider/device-execution digest identity.
+    pub fn advice_runtime(&self)->Result<String> {
+        self.validate()?;
+        match &self.device_execution {None=>Ok(RUNTIME.into()),Some(execution)=>execution.execution_identity()}
+    }
+    pub fn device_execution_identity(&self) -> Result<String> {
+        match &self.device_execution {
+            Some(execution) => execution.execution_identity(),
+            None => self.cpu_fit.clone().unwrap_or_default().runtime_identity(),
+        }
+    }
+    pub fn validate(&self) -> Result<()> {
+        ensure!(
+            !self.profile_id.is_empty() && self.profile_id.len() <= 128,
+            "unsupported Arbiter profile runtime or identity"
+        );
+        if let Some(execution) = &self.device_execution {
+            execution.validate(self)?;
+        } else {
+            ensure!(self.runtime == RUNTIME, "unsupported legacy CPU profile runtime");
+            if let Some(fit) = &self.cpu_fit { fit.validate()?; }
+        }
+        if let Some(stage) = self.model.stage() {
+            self.validate_stage(stage)?;
+        } else {
+            ensure!(
+                self.stage.is_none(),
+                "historical profile cannot acquire a current stage"
+            );
+        }
+        ensure!(
+            self.task_policies
+                .keys()
+                .all(|task| self.tasks.contains(task)),
+            "policy for undeclared task"
+        );
+        let mut targets = BTreeSet::new();
+        for target in &self.qualified_targets {
+            ensure!(
+                matches!(
+                    target.target.as_str(),
+                    "x86_64-pc-windows-msvc"
+                        | "aarch64-apple-darwin"
+                        | "x86_64-apple-darwin"
+                        | "x86_64-unknown-linux-gnu"
+                ) && targets.insert(&target.target),
+                "unknown or duplicate qualification target"
+            );
+            ensure!(
+                self.device_execution.is_some() || self.cpu_fit.is_some(),
+                "qualified target lacks explicit execution fit"
+            );
+            ensure!(
+                target.execution_identity == self.device_execution_identity()?,
+                "qualified target execution identity mismatch"
+            );
+        }
+
+        ensure!(
+            (1..=8192).contains(&self.max_tokens) && (1..=64).contains(&self.max_candidates),
+            "unqualified Arbiter context profile"
+        );
+        ensure!(
+            !self.tasks.is_empty() && self.memory_reservation_bytes > 0 && self.peak_disk_bytes > 0,
+            "incomplete Arbiter task or resource profile"
+        );
+        let readout = match self.model {
+            ModelChoice::SmallIntern
+            | ModelChoice::LargeIntern
+            | ModelChoice::ContextQwenCompact
+            | ModelChoice::ContextQwenLarge => Readout::DecisionSymbol,
+            ModelChoice::SmallStrands | ModelChoice::LargeKev => Readout::PointerHead,
+            ModelChoice::FocusQwenReranker06B => Readout::FocusYesNo,
+        };
+        ensure!(
+            self.abi.readout == readout && self.abi.output.element == TensorType::Float32,
+            "Arbiter trained readout mismatch"
+        );
+        ensure!(
+            !self.abi.inputs.is_empty() && self.abi.inputs.len() <= 12,
+            "invalid Arbiter input catalog"
+        );
+        let mut names = BTreeSet::new();
+        for input in self
+            .abi
+            .inputs
+            .iter()
+            .chain(std::iter::once(&self.abi.output))
+        {
+            ensure!(
+                !input.name.is_empty()
+                    && input.name.len() <= 128
+                    && names.insert(&input.name)
+                    && !input.axes.is_empty()
+                    && input.axes.len() <= 4,
+                "invalid Arbiter tensor contract"
+            );
+        }
+        ensure!(
+            !self.assets.is_empty() && self.assets.len() <= 128,
+            "invalid Arbiter assets"
+        );
+        let mut names = BTreeSet::new();
+        for asset in &self.assets {
+            ensure!(
+                !asset.name.is_empty()
+                    && asset.name.len() <= 128
+                    && asset
+                        .name
+                        .bytes()
+                        .all(|byte| byte.is_ascii_alphanumeric()
+                            || matches!(byte, b'-' | b'_' | b'.'))
+                    && asset.name != "."
+                    && asset.name != ".."
+                    && names.insert(&asset.name)
+                    && asset.bytes > 0
+                    && asset.bytes <= 16u64 << 30,
+                "unsafe or unbounded Arbiter asset"
+            );
+        }
+        for role in [
+            AssetRole::Model,
+            AssetRole::Tokenizer,
+            AssetRole::Compiler,
+            AssetRole::Calibration,
+            AssetRole::Notice,
+            AssetRole::Fixture,
+        ] {
+            ensure!(
+                self.assets.iter().any(|asset| asset.role == role),
+                "incomplete Arbiter bundle"
+            );
+        }
+        for role in [
+            AssetRole::Model,
+            AssetRole::Tokenizer,
+            AssetRole::Compiler,
+            AssetRole::Calibration,
+        ] {
+            ensure!(
+                self.assets
+                    .iter()
+                    .filter(|asset| asset.role == role)
+                    .count()
+                    == 1,
+                "duplicated Arbiter singleton asset role"
+            );
+        }
+        ensure!(
+            self.assets
+                .iter()
+                .any(|asset| asset.role == AssetRole::Compiler && asset.sha256 == self.compiler),
+            "Arbiter compiler descriptor differs from exact raw asset bytes"
+        );
+        ensure!(
+            self.assets
+                .iter()
+                .any(|asset| asset.role == AssetRole::Calibration
+                    && asset.sha256 == self.calibration),
+            "Arbiter calibration descriptor differs from exact raw asset bytes"
+        );
+        Ok(())
+    }
+}
