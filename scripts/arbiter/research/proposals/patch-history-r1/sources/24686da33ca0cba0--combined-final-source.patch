+}
+impl DeviceVariantStatus {
+    /// Read-only descriptive copy from the actual immutable native profile.
+    /// Admission/evidence labels come from native owners; this never derives a
+    /// permission or qualification from a digest/metadata flag.
+    pub fn from_description(
+        profile: &Profile,
+        availability: Availability,
+        reason: String,
+        model_admission: ModelAdmissionStatus,
+        device_evidence: Option<DeviceEvidence>,
+    ) -> Result<Self> {
+        profile.validate()?;
+        SelectedModel::from_model(profile.model)?;
+        let download_bytes = profile.assets.iter().try_fold(0u64, |total, asset| {
+            total
+                .checked_add(asset.bytes)
+                .context("Arbiter asset total overflow")
+        })?;
+        Ok(Self {
+            cpu_fit: profile.cpu_fit.clone(),
+            qualified_targets: profile.qualified_targets.clone(),
+            tasks: profile.tasks.clone(),
+            download_bytes: Some(download_bytes),
+            memory_reservation_bytes: Some(profile.memory_reservation_bytes),
+            manifest: profile.manifest,
+            execution_identity: profile.device_execution_identity()?,
+            backend: profile
+                .device_execution
+                .as_ref()
+                .map(|device| device.backend),
+            precision: profile
+                .device_execution
+                .as_ref()
+                .map(|device| device.precision),
+            availability,
+            reason,
+            model_admission,
+            device_evidence,
+        })
+    }
+}
