+// SPDX-License-Identifier: Apache-2.0
+//! Current configuration/status views. Descriptive data is never source/compute authority.
+use super::*;
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct DeviceCatalogBinding {
+    pub catalog: Sha256Digest,
+    pub source: Sha256Digest,
+}
+impl DeviceCatalog {
+    pub fn binding<'a>(
+        &self,
+        source: Sha256Digest,
+        resolve: impl Fn(Sha256Digest) -> Option<&'a Profile>,
+    ) -> Result<DeviceCatalogBinding> {
+        self.validate(resolve)?;
+        let bytes = serde_json::to_vec(self)?;
+        Ok(DeviceCatalogBinding {
+            catalog: framed_digest(b"airk.arbiter.device-catalog/1", &[&bytes]),
+            source,
+        })
+    }
+}
+impl DeviceConfiguration {
+    /// Data-only transition: caller must authenticate old/new compiled snapshots.
+    /// This cannot admit execution or change source namespace/model/consent/policy.
+    pub fn rebind_catalog<'old, 'new>(
+        &self,
+        expected_old: &DeviceCatalogBinding,
+        new_binding: DeviceCatalogBinding,
+        old_catalog: &DeviceCatalog,
+        new_catalog: &DeviceCatalog,
+        resolve_old: impl Fn(Sha256Digest) -> Option<&'old Profile>,
+        resolve_new: impl Fn(Sha256Digest) -> Option<&'new Profile>,
+    ) -> Result<Self> {
+        self.validate()?;
+        ensure!(
+            &self.device_catalog == expected_old,
+            "current catalog is not expected old binding"
+        );
+        ensure!(
+            old_catalog.binding(expected_old.source, resolve_old)? == *expected_old,
+            "old compiled catalog/source proof differs"
+        );
+        ensure!(
+            new_catalog.binding(new_binding.source, resolve_new)? == new_binding,
+            "new compiled catalog/source proof differs"
+        );
+        ensure!(
+            new_binding != *expected_old,
+            "catalog rebind must change exact binding"
+        );
+        let mut value = self.clone();
+        value.device_catalog = new_binding;
+        value.revision = value
+            .revision
+            .checked_add(1)
+            .context("configuration revision exhausted")?;
+        value.validate()?;
+        Ok(value)
+    }
+    pub fn disabled(
+        installation: Sha256Digest,
+        catalog: Incarnation,
+        device_catalog: DeviceCatalogBinding,
+    ) -> Self {
+        Self {
+            schema: DEVICE_CONFIGURATION_SCHEMA.into(),
+            installation,
+            catalog,
+            revision: 1,
+            device_catalog,
+            focus: DeviceStageConfiguration::disabled(),
+            context: DeviceStageConfiguration::disabled(),
+        }
+    }
+    pub fn stage(&self, stage: Stage) -> &DeviceStageConfiguration {
+        match stage {
+            Stage::Focus => &self.focus,
+            Stage::Context => &self.context,
+        }
+    }
+    pub fn stage_mut(&mut self, stage: Stage) -> &mut DeviceStageConfiguration {
+        match stage {
+            Stage::Focus => &mut self.focus,
+            Stage::Context => &mut self.context,
+        }
+    }
+    pub fn decode(
+        bytes: &[u8],
+        installation: Sha256Digest,
+        catalog: Incarnation,
+        binding: &DeviceCatalogBinding,
+    ) -> Result<Self> {
+        ensure!(
+            bytes.len() <= MAX_CONFIGURATION_BYTES,
+            "device configuration byte limit"
+        );
+        let value: Self = serde_json::from_slice(bytes)?;
+        value.validate()?;
+        ensure!(
+            value.installation == installation
+                && value.catalog == catalog
+                && &value.device_catalog == binding,
+            "device configuration installation/source-catalog/device-catalog binding differs"
+        );
+        ensure!(
+            value.canonical_bytes()? == bytes,
+            "noncanonical device configuration"
+        );
+        Ok(value)
+    }
+}
