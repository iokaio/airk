+        .into(),
+        backend: gpu.then_some(GpuBackend::Cuda),
+        precision: gpu.then_some(DevicePrecision::Float32),
+        adapter_key: if gpu {
+            format!("adapter-{id}")
+        } else {
+            "cpu".into()
+        },
+        capability_epoch: 7,
+        rejection,
+    }
+}
