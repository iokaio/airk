+                    expected_revision: settings.revision,
+                    expected_configuration: Sha256Digest::from_bytes([99; 32]),
+                    expected_old: &old_binding,
+                    old_catalog: &old_catalog,
+                    new_catalog: &new_catalog,
+                    resolve_old: &resolve,
+                    resolve_new: &resolve,
+                    authorize: &authorize
