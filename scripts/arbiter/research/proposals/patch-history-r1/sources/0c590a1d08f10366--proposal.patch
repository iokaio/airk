+        crate::native_inference::require_service_compute()?;
+        let session = self
+            .session
+            .lock()
+            .map_err(|_| anyhow::anyhow!("native session owner poisoned"))?;
+        self.profile
+            .gpu
+            .as_ref()
+            .map(|b| b.device.placement(&session))
+            .transpose()
+    }
+}
