+            nodes: Vec::new(),
+            bytes: 0,
+            failed: false,
+        };
+        let p = (&mut sink as *mut Sink).cast();
+        assert_ne!(
+            unsafe {
+                collect_row(
+                    p,
+                    0,
+                    std::ptr::null(),
+                    1,
+                    std::ptr::null(),
+                    0,
+                    b"MatMul".as_ptr(),
+                    6,
+                    b"CUDAExecutionProvider".as_ptr(),
+                    21,
+                )
+            },
+            0
+        );
+        assert!(sink.failed);
+        assert!(sink.nodes.is_empty());
