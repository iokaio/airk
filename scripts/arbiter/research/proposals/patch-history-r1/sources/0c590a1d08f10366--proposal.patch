+        plan: cuda::DeviceCapacityPlan,
+        deadline: std::time::Instant,
+    ) -> Result<Self> {
+        crate::native_inference::require_service_compute()?;
+        ensure!(
+            self.execution_authorized() && self.evaluation() && !self.release,
