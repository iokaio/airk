+            self.schema == "airk.arbiter.gpu-probe-reservation/1"
+                && self.host_limit_bytes > 0
+                && self.device_limit_bytes > 0
+                && self.deadline_ms > 0
+                && self.deadline_ms <= 120000,
+            "invalid unqualified GPU probe bounds"
