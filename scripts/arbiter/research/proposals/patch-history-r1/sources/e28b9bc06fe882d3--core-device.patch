+#[test]
+fn materialization_never_returns_a_changed_unverified_resolver_reference() -> Result<()> {
+    use std::cell::Cell;
+    let profiles = [
+        literal_profile(SelectedModel::Focus, 1, false)?,
+        literal_profile(SelectedModel::ContextCompact, 2, false)?,
+        literal_profile(SelectedModel::ContextLarge, 3, false)?,
+    ];
+    let row = |i: usize| -> Result<VariantReference> {
+        Ok(VariantReference {
+            manifest: profiles[i].manifest,
+            execution_identity: profiles[i].device_execution_identity()?,
+        })
+    };
+    let catalog = DeviceCatalog {
+        schema: DEVICE_CATALOG_SCHEMA.into(),
+        focus: vec![row(0)?],
+        context_compact: vec![row(1)?],
+        context_large: vec![row(2)?],
+    };
+    let calls = Cell::new(0usize);
+    let resolve = |pin| {
+        if pin == profiles[1].manifest {
+            calls.set(calls.get() + 1);
+            Some(if calls.get() == 1 {
+                &profiles[1]
+            } else {
+                &profiles[2]
+            })
+        } else {
+            profiles.iter().find(|profile| profile.manifest == pin)
+        }
+    };
+    let selected =
+        catalog.materialize(SelectedModel::ContextCompact, profiles[1].manifest, resolve)?;
+    assert_eq!(calls.get(), 1);
+    assert!(std::ptr::eq(selected, &profiles[1]));
+    assert_ne!(selected.model, ModelChoice::ContextQwenLarge);
+    // A resolver giving the wrong object first is refused, never retried into success.
+    let calls = Cell::new(0usize);
+    let wrong_first = |pin| {
+        if pin == profiles[1].manifest {
+            calls.set(calls.get() + 1);
+            Some(if calls.get() == 1 {
+                &profiles[2]
+            } else {
+                &profiles[1]
+            })
+        } else {
+            profiles.iter().find(|profile| profile.manifest == pin)
+        }
+    };
+    assert!(
+        catalog
+            .materialize(
+                SelectedModel::ContextCompact,
+                profiles[1].manifest,
+                wrong_first
+            )
+            .is_err()
+    );
+    assert_eq!(calls.get(), 1);
+    Ok(())
+}
