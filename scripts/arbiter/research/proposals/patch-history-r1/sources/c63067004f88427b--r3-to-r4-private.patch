+def require_restart_scope_continuity(previous,current,previous_instance,current_instance):
+    require(previous_instance!=current_instance,'restart scope needs authentic new service instance')
+    fields={'schema','qualifier','fingerprint','selection','members'}
+    require(set(previous)==fields and set(current)==fields,'unknown restart scope projection')
+    require(previous['schema']==current['schema']==1
+        and previous['qualifier']==current['qualifier']=='selected_subset'
+        and previous['selection']==current['selection'] and previous['members']==current['members'],
+        'persisted public source authority changed across restart')
+    for scope in (previous,current):
+        value=scope['fingerprint']
+        require(isinstance(value,str) and len(value)==64 and all(c in '0123456789abcdef' for c in value),
+            'invalid native authority fingerprint')
+    require(previous['fingerprint']!=current['fingerprint'],
+        'old service-bound authority fingerprint replayed after restart')
+    # Never modify either observation or reproduce a native digest. The caller
+    # retains both, then binds subsequent reads to this exact new native scope.
