+#[tokio::test]
+async fn one_index_window_catalog_and_open_explicit_source_selectors_use_original_authorized_combined_owner() -> Result<()> {
+    let f = Fixture::with_runtime_topology(true, 3, false, None, false, true)?;
+    let _service = f.start().await?;
+    let ControlResponse::Health { observation } = airk_cli::service_runtime::request(&f.control, ControlMethod::Health).await? else { anyhow::bail!("health missing"); };
+    let clock = observation.catalog_clock.context("catalog clock")?;
+    let ControlResponse::WindowOpened { window_id, lease, .. } = airk_cli::service_runtime::request(&f.control, ControlMethod::WindowOpen {label:"one-index alias source navigation".into(),owner_pid:std::process::id()}).await? else {anyhow::bail!("window missing");};
+    let granted=airk_cli::service_runtime::request(&f.control,ControlMethod::WindowScopeGrant {window_id,lease:lease.clone(),selection:airk_core::service::WindowScopeSelection {namespace:clock.namespace,expected_catalog_revision:clock.revision,index_ids:vec![f.indexes[0]],project_ids:f.projects[..2].to_vec()}}).await?;
+    ensure!(matches!(granted,ControlResponse::WindowScopeGranted{..}),"grant refused: {granted:?}");
+    async fn once(f:&Fixture,selection:airk_core::service::ToolSelection,tool:&str,args:Value)->Result<Value>{
+        let response=airk_cli::service_runtime::request(&f.control,ControlMethod::ToolsCall{tool:tool.into(),arguments:args.as_object().context("arguments")?.clone(),selection,response_mode:airk_core::service::ToolResponseMode::Full,usage_client:airk_core::usage::ClientFamily::Unknown,read_attempt:None}).await?;
+        let ControlResponse::ToolResult{result}=response else {anyhow::bail!("read refused: {response:?}");};Ok(result)
+    }
+    let window=airk_core::service::ToolSelection::Window{window_id,lease};
+    let ordinary=once(&f,window.clone(),"airk_search",json!({"query":"boundaryneedle","mode":"lexical","path_prefix":"api/","verification":"report","response_mode":"full"})).await?;
+    ensure!(ordinary["isError"]!=true,"ordinary search refused: {ordinary}");
+    let original=body(&ordinary)?;
+    assert_ne!(original["schema"],"airk.combined-read/1","no-selector one-index route must remain the native singleton");
+    let hit=original["hits"][0].clone();let proof=&original["source_verification"];
+    let source=proof["sources"].as_array().context("source proof")?.iter().find(|source|source["path"]==hit["citation"]["path"]).context("exact source")?;
+    let origin=proof["origins"].as_array().context("origins")?.iter().find(|origin|origin["id"]==source["origin_id"]).context("exact origin")?;
+    assert_eq!(origin["project_ids"].as_array().context("project aliases")?.len(),2);
+    let arguments=json!({"path":hit["citation"]["path"],"project_ids":origin["project_ids"],"index_ids":[f.indexes[0]],"revision":origin["publication"],"known_hash":hit["citation"]["content_hash"],"response_mode":"full"});
+    let index=f.indexes[0].to_string();
+    let catalog=airk_core::service::ToolSelection::Catalog{request:ScopedConnectRequest{
+        schema:f.session.schema,context_key:f.session.context_key,namespace:f.session.namespace,
+        expected_catalog_revision:f.session.expected_catalog_revision,grant_id:f.session.grant_id,
+        expected_grant_revision:f.session.expected_grant_revision,index_id:f.indexes[0],project_ids:f.projects[..2].to_vec()}};
+    for selection in [window,catalog,open_selection(&[&index],&[],None)]{
+        let mut arguments=arguments.clone();
+        if matches!(selection,airk_core::service::ToolSelection::Catalog{..}) {
+            let direct=once(&f,selection.clone(),"airk_search",json!({"query":"boundaryneedle","mode":"lexical","path_prefix":"api/","verification":"report","response_mode":"full"})).await?;
+            assert_ne!(body(&direct)?["schema"],"airk.combined-read/1","no-selector Catalog remains singleton");
+        }
+        if matches!(selection,airk_core::service::ToolSelection::Open{..}) {
+            let ordinary_open=once(&f,selection.clone(),"airk_search",json!({"query":"boundaryneedle","mode":"lexical","path_prefix":"api/","verification":"report","response_mode":"full"})).await?;
+            let open_body=body(&ordinary_open)?;
+            let open_origins=open_body["source_verification"]["origins"].as_array().context("Open origins")?;
+            assert_eq!(open_origins.len(),1);assert_eq!(open_origins[0]["project_ids"],json!([]),"explicit Open must not invent Project attribution");
+            arguments["project_ids"]=open_origins[0]["project_ids"].clone();
+        }
+        let reply=once(&f,selection.clone(),"airk_file_info",arguments.clone()).await?;
+        ensure!(reply["isError"]!=true,"source narrowing refused: {reply}");
+        let combined=body(&reply)?;assert_eq!(combined["schema"],"airk.combined-read/1");
+        let members=combined["members"].as_array().context("members")?;assert_eq!(members.len(),1);assert_eq!(members[0]["index_id"],json!(f.indexes[0]));assert_eq!(members[0]["outcome"],"complete");
+        let member=body(&members[0]["result"])?;let info=member.get("content").filter(|value|value.is_object()).unwrap_or(&member);
+        assert_eq!(info["content_hash"],hit["citation"]["content_hash"]);
+        for foreign in [json!({"index_ids":[f.indexes[2]]}),json!({"project_ids":[f.projects[2]]})]{
+            let mut changed=arguments.clone();for (key,value) in foreign.as_object().unwrap(){changed[key]=value.clone();}
+            let rejected=once(&f,selection.clone(),"airk_file_info",changed).await?;
+            assert_eq!(rejected["isError"],true,"foreign narrowing must refuse: {rejected}");
+        }
+    }
+    let legacy=once(&f,airk_core::service::ToolSelection::Project{binding:f.registrations[0].binding},"airk_file_info",arguments).await?;
+    assert_eq!(legacy["isError"],true,"legacy Project must not gain combined scope authority");
+    assert_eq!(body(&legacy)?["error"]["code"],"QUERY_SCOPE_CONFIGURATION_REQUIRED");
+    Ok(())
+}
