+            .to_string_lossy()
+            .into_owned();
+        let sha256 = Sha256Digest::from_bytes(Sha256::digest(&raw).into());
+        let bytes = raw.len() as u64;
+        self.files.insert(path.clone(), raw);
+        FilePin {
+            path,
+            bytes,
+            sha256,
+        }
+    }
+    fn json(&mut self, name: &str, v: Value) -> FilePin {
+        self.bytes(name, serde_json::to_vec(&v).unwrap())
+    }
