+fn typed<T: serde::de::DeserializeOwned>(value: &Value) -> Result<T> {
+    Ok(serde_json::from_value(value.clone())?)
+}
+fn pin(value: &Value) -> Result<FilePin> {
+    let p: FilePin = typed(value)?;
+    p.resource()?;
+    Ok(p)
