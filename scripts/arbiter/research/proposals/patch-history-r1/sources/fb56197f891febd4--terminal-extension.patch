+}
+#[derive(Clone, Debug, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct TerminalQualification {
+    pub schema: String,
+    pub model: ModelChoice,
+    pub compiler: Sha256Digest,
