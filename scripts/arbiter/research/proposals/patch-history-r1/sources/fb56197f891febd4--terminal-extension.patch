+// SPDX-License-Identifier: Apache-2.0
+//! Additive terminal evidence. Authenticated metadata never creates human gold.
+use super::*;
+use crate::identity::framed_digest;
+
+pub const QUALIFICATION_SCHEMA: &str = "airk.arbiter.context-terminal-qualification/1";
+pub const ANNOTATIONS_SCHEMA: &str = "airk.arbiter.context-terminal-human-annotations/1";
+pub const RAW_CAPTURE_SCHEMA: &str = "airk.arbiter.context-terminal-native-raw/1";
+pub const INDEPENDENCE_SCHEMA: &str = "airk.arbiter.context-terminal-independence/1";
+
+/// This is also the runtime selection primitive: rank the complete roster before
+/// checking whether the winning class is supported. Never filter first.
+pub fn raw_winner(scores: &[f32]) -> Result<Option<(usize, f32)>> {
+    ensure!(
+        !scores.is_empty() && scores.len() <= 8 && scores.iter().all(|score| score.is_finite()),
+        "invalid whole-roster raw scores"
+    );
+    if scores.len() < 2 {
+        return Ok(None);
+    }
+    let mut order: Vec<usize> = (0..scores.len()).collect();
+    order.sort_by(|left, right| scores[*right].total_cmp(&scores[*left]));
+    let (best, runner) = (order[0], order[1]);
+    if scores[best] == scores[runner] {
+        return Ok(None);
+    }
+    let margin = scores[best] - scores[runner];
+    Ok(margin.is_finite().then_some((best, margin)))
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct TerminalCriteria {
+    /// Exact preregistered criteria source; independently approved at promotion.
+    pub freeze: Sha256Digest,
+    pub calibration_population: Sha256Digest,
+    pub confirmation_population: Sha256Digest,
+    pub minimum_cal_population: usize,
+    pub minimum_confirmation_population: usize,
+    pub minimum_cal_accepted: usize,
+    pub minimum_confirmation_accepted: usize,
+    pub minimum_coverage: f64,
+    pub maximum_false_acceptance_upper: f64,
+}
+impl TerminalCriteria {
+    pub fn validate(&self) -> Result<()> {
+        ensure!(
+            nonzero(self.freeze)
+                && nonzero(self.calibration_population)
+                && nonzero(self.confirmation_population)
+                && self.minimum_cal_population > 0
+                && self.minimum_confirmation_population > 0
+                && self.minimum_cal_accepted > 0
+                && self.minimum_confirmation_accepted > 0
+                && self.minimum_cal_accepted <= self.minimum_cal_population
+                && self.minimum_confirmation_accepted <= self.minimum_confirmation_population
+                && self.minimum_coverage.is_finite()
+                && self.minimum_coverage > 0.0
+                && self.minimum_coverage <= 1.0
+                && self.maximum_false_acceptance_upper.is_finite()
+                && self.maximum_false_acceptance_upper > 0.0
+                && self.maximum_false_acceptance_upper <= 0.01,
+            "invalid preregistered terminal criteria"
+        );
+        Ok(())
+    }
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct TerminalObservation {
+    pub id: String,
+    pub repository_cluster: String,
+    pub roster: ContextActionRoster,
+    pub records: Vec<EvidenceRecord>,
+    /// None retains a compiler refusal in the complete population denominator.
+    pub scores: Option<Vec<f32>>,
+    pub accepted_whole_cards: Vec<Sha256Digest>,
+    pub human_annotations: Sha256Digest,
+    pub native_capture: Sha256Digest,
+}
+impl TerminalObservation {
+    pub fn visible_input(&self) -> Result<Sha256Digest> {
+        Ok(framed_digest(
+            b"airk.arbiter.context-terminal-visible-input/1",
+            &[&serde_json::to_vec(&(&self.roster, &self.records))?],
+        ))
+    }
+    fn validate(&self, class: ContextActionClass, policy: Sha256Digest) -> Result<()> {
+        ensure!(
+            !self.id.trim().is_empty()
+                && self.id.len() <= 256
+                && !self.repository_cluster.trim().is_empty()
+                && self.repository_cluster.len() <= 256
+                && nonzero(self.human_annotations)
+                && nonzero(self.native_capture)
+                && self.roster.policy == policy
+                && self.records.len() <= 64,
+            "terminal observation identity/authority/policy missing"
+        );
+        self.roster.validate(&self.records)?;
+        if let Some(scores) = &self.scores {
+            ensure!(
+                scores.len() == self.roster.cards.len(),
+                "terminal score/roster mismatch"
+            );
+            raw_winner(scores)?;
+        }
+        unique(&self.accepted_whole_cards)?;
+        for accepted in &self.accepted_whole_cards {
+            ensure!(
+                self.roster.cards.iter().any(
+                    |card| card.id == *accepted && ContextActionClass::of(card.action) == class
+                ),
+                "human label is not this exact whole terminal card"
+            );
+        }
+        Ok(())
+    }
+}
+
