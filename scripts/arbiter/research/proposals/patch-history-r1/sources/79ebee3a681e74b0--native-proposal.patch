+        allocated_gqa_profile_for_model(
+            &serde_json::to_vec(&layers)?,
+            17,
+            36,
+            ModelChoice::ContextQwenLarge
+        )
+        .is_err()
+    );
+    let fit = airk_core::arbiter::CpuFit {
+        minimum_physical_cores: 16,
+        intra_threads: 16,
+        inter_threads: 1,
+        sequential: true,
+        spinning: false,
