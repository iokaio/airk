+            spinning: true,
+            ..fit.clone()
+        },
+    ] {
+        assert!(
+            selected_diagnostic_profile(
+                ModelChoice::ContextQwenLarge,
+                8192,
+                40u64 << 30,
+                Some(&changed),
+                ModelChoice::ContextQwenLarge
+            )
+            .is_err()
+        );
+    }
+    assert!(
+        selected_diagnostic_profile(
+            ModelChoice::ContextQwenLarge,
+            8192,
+            40u64 << 30,
+            None,
+            ModelChoice::ContextQwenLarge
+        )
+        .is_err()
+    );
+    let compact_fit = airk_core::arbiter::CpuFit {
+        minimum_physical_cores: 4,
+        intra_threads: 4,
+        ..fit
+    };
+    let compact = selected_diagnostic_profile(
+        ModelChoice::ContextQwenCompact,
