+    assert!(
+        selected_diagnostic_profile(
+            ModelChoice::ContextQwenCompact,
+            8192,
+            40u64 << 30,
+            Some(&fit),
+            ModelChoice::ContextQwenLarge
+        )
+        .is_err()
+    );
+    for (tokens, memory) in [(2048, 40u64 << 30), (8192, 16u64 << 30)] {
+        assert!(
+            selected_diagnostic_profile(
+                ModelChoice::ContextQwenLarge,
+                tokens,
+                memory,
+                Some(&fit),
+                ModelChoice::ContextQwenLarge
+            )
+            .is_err()
+        );
+    }
+    for changed in [
+        airk_core::arbiter::CpuFit {
+            minimum_physical_cores: 4,
+            intra_threads: 4,
+            ..fit.clone()
+        },
+        airk_core::arbiter::CpuFit {
+            inter_threads: 2,
+            ..fit.clone()
+        },
+        airk_core::arbiter::CpuFit {
+            sequential: false,
+            ..fit.clone()
+        },
