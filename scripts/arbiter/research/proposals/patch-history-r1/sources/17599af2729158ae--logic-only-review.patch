+#[derive(Clone, PartialEq, Eq)]
+struct MemoScope {
+    installation: Sha256Digest,
+    catalog: Incarnation,
+    revision: u64,
+    binding: airk_core::arbiter::device::DeviceCatalogBinding,
+}
+#[derive(Default)]
+struct FailureMemo {
+    scope: Option<MemoScope>,
+    keys: BTreeSet<device::DeviceFaultKey>,
+    saturated: bool,
+}
+impl FailureMemo {
+    fn configure(&mut self, configuration: &NativeConfiguration) {
+        let scope = match configuration {
+            NativeConfiguration::Device { document, .. } => Some(MemoScope {
+                installation: document.installation,
+                catalog: document.catalog,
+                revision: document.revision,
+                binding: document.device_catalog.clone(),
+            }),
+            NativeConfiguration::Legacy(_) => None,
+        };
+        if self.scope != scope {
+            self.keys.clear();
+            self.saturated = false;
+            self.scope = scope;
+        }
+    }
+    #[cfg(any(feature = "gpu-cuda", test))]
+    fn require_open(&self, key: &device::DeviceFaultKey) -> Result<()> {
+        ensure!(
+            !self.saturated,
+            "native eligibility failure memo capacity occupied"
+        );
+        ensure!(
+            !self.keys.contains(key),
+            "native eligibility circuit already open for this exact variant/device/source"
+        );
+        Ok(())
+    }
+    #[cfg(any(feature = "gpu-cuda", test))]
+    fn returned_failure(
+        &mut self,
+        key: device::DeviceFaultKey,
+        genuine: bool,
+        settled: bool,
+    ) -> Result<()> {
+        if !genuine || !settled {
+            return Ok(());
+        }
+        if self.keys.contains(&key) {
+            return Ok(());
+        }
+        if self.keys.len() >= 16 {
+            self.saturated = true;
+            anyhow::bail!("native eligibility failure memo capacity occupied");
+        }
+        self.keys.insert(key);
+        Ok(())
+    }
+}
