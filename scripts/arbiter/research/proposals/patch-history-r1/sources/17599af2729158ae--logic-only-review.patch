+        anyhow::bail!("product memo requires current typed configuration");
+    };
+    let key = device::circuit_key(profile, device, document)?;
+    shared
+        .queue
+        .lock()
+        .map_err(|_| anyhow::anyhow!("native eligibility memo unavailable"))?
+        .eligibility
+        .failures
