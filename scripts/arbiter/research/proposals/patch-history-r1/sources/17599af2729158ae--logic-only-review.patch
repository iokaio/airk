+fn require_retained_memo_open(
+    shared: &Arc<Shared>,
+    residents: &BTreeMap<Stage, device::GuardedResident>,
+    stage: Stage,
+) -> Result<()> {
+    let queue = shared
+        .queue
+        .lock()
+        .map_err(|_| anyhow::anyhow!("native retained memo unavailable"))?;
+    let configuration = queue
+        .configuration
+        .as_ref()
+        .context("native retained memo scope missing")?;
+    let required = residents
+        .iter()
+        .filter_map(|(stage, resident)| requires(resident.scorer()).then_some(*stage))
+        .collect();
+    for target in targets_for(configuration, stage, &required) {
+        let resident = residents
+            .get(&target)
+            .context("actual retained memo resident missing")?;
+        let NativeConfiguration::Device { document, .. } = configuration else {
+            anyhow::bail!("retained product memo needs current document");
+        };
+        let device = resident
+            .native_device()
+            .context("retained product memo device missing")?;
+        let key = device::circuit_key(resident.scorer().profile(), device, document)?;
+        queue.eligibility.failures.require_open(&key)?;
+    }
+    Ok(())
