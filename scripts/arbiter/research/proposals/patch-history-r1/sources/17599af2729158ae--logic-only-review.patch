+#[test]
+fn queued_population_observes_native_failure_before_service_recorder_runs() -> Result<()> {
+    let key = fault_key(84);
+    let mut state = State::default();
+    state.configure(&configuration());
+    // B passed its Service precheck and queued while A owns the native lane.
+    state.failures.require_open(&key)?;
+    let service_recorder_calls = 0;
+    let mut native_calls = 1; // A has returned a genuine, settled failure.
+    state.failures.returned_failure(key.clone(), true, true)?;
+    // The serialized lane tests B before dispatch, without awaiting Service.
+    if state.failures.require_open(&key).is_ok() {
+        native_calls += 1;
+    }
+    assert_eq!(native_calls, 1);
+    assert_eq!(service_recorder_calls, 0);
+    // A new joint nonce or revoked proof never clears a stable native fault.
+    state.invalidate();
+    state.generation += 1;
+    state.configure(&configuration());
+    assert!(state.failures.require_open(&key).is_err());
+    Ok(())
+}
+#[test]
+fn native_failure_memo_never_converts_nonfault_or_unknown_work_into_fault() -> Result<()> {
+    let mut memo = FailureMemo::default();
+    let key = fault_key(85);
+    memo.returned_failure(key.clone(), false, true)?;
+    memo.returned_failure(key.clone(), true, false)?;
+    assert!(memo.keys.is_empty());
+    assert!(!memo.saturated);
+    memo.require_open(&key)?;
+    memo.returned_failure(key.clone(), true, true)?;
+    assert_eq!(memo.keys.len(), 1);
+    memo.returned_failure(key, true, true)?;
+    assert_eq!(memo.keys.len(), 1);
+    Ok(())
+}
+#[test]
+fn sixteen_native_faults_bound_memory_and_seventeenth_refuses_without_eviction() -> Result<()> {
+    let mut state = State::default();
+    let original = configuration();
+    state.configure(&original);
+    for n in 1..=16 {
+        state.failures.returned_failure(fault_key(n), true, true)?;
+    }
+    assert_eq!(state.failures.keys.len(), 16);
+    assert!(
+        state
+            .failures
+            .returned_failure(fault_key(17), true, true)
+            .is_err()
+    );
+    assert_eq!(state.failures.keys.len(), 16);
+    assert!(state.failures.require_open(&fault_key(18)).is_err());
+    state.invalidate();
+    state.configure(&original);
+    assert!(state.failures.require_open(&fault_key(18)).is_err());
+    let mut changed = original;
+    if let NativeConfiguration::Device { document, .. } = &mut changed {
+        document.revision = 2;
+    }
+    state.configure(&changed);
+    assert!(!state.failures.saturated);
+    assert!(state.failures.keys.is_empty());
+    state.failures.require_open(&fault_key(18))?;
+    Ok(())
+}
