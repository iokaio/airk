+fn remember_native_failure(
+    shared: &Arc<Shared>,
+    profile: &airk_core::arbiter::Profile,
+    device: Option<&device::NativeDevice>,
+    configuration: Option<&NativeConfiguration>,
+    error: &anyhow::Error,
+    deadline: Option<Instant>,
+    authority: Option<&(dyn Fn() -> bool + Send + Sync)>,
+) -> Result<()> {
+    let genuine = airk_retrieval::arbiter::runtime::cuda::is_device_eligibility_failure(error);
+    let settled = device.is_some_and(device::NativeDevice::settlement_observed)
+        && !shared.unsettled.load(Ordering::Acquire)
+        && !airk_retrieval::arbiter::runtime::cuda::process_poisoned();
+    if !genuine || !settled || device::warm_admission(deadline, authority, Instant::now).is_err() {
+        return Ok(());
+    }
+    let (Some(device), Some(NativeConfiguration::Device { document, .. })) =
+        (device, configuration)
+    else {
+        return Ok(());
+    };
+    let key = device::circuit_key(profile, device, document)?;
+    let mut queue = shared
+        .queue
+        .lock()
+        .map_err(|_| anyhow::anyhow!("native failure memo unavailable"))?;
+    if !queue.configuration.as_ref().is_some_and(|current| {
+        configuration.is_some_and(|expected| current.same_selection(expected))
+    }) {
+        return Ok(());
+    }
+    // Revocation only removes readiness. This does not claim GPU cleanup.
+    queue.eligibility.invalidate();
+    queue
+        .eligibility
+        .failures
+        .returned_failure(key, genuine, settled)
+}
