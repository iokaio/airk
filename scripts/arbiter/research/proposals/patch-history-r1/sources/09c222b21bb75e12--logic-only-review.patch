+#[test]
+fn memo_saturation_preserves_original_resident_profile_and_typed_cause() -> Result<()> {
+    #[derive(Debug)]
+    struct NativeCause;
+    impl std::fmt::Display for NativeCause {
+        fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+            f.write_str("original typed native refusal")
+        }
+    }
+    impl std::error::Error for NativeCause {}
+    let profile = Sha256Digest::from_bytes([99; 32]);
+    let original = anyhow::Error::new(ResidentRefusal {
+        profile,
+        cause: anyhow::Error::new(NativeCause),
+    });
+    let mut memo = FailureMemo::default();
+    for n in 1..=16 {
+        memo.returned_failure(fault_key(n), true, true)?;
+    }
+    let secondary = memo.returned_failure(fault_key(17), true, true);
+    assert!(secondary.is_err());
+    let error = retain_native_failure(original, secondary);
+    assert_eq!(failed_profile(&error), Some(profile));
+    assert!(error.chain().any(|cause| cause.is::<NativeCause>()));
+    assert!(error.chain().any(|cause| cause.is::<ResidentRefusal>()));
+    assert!(format!("{error:#}").contains("memo capacity occupied"));
+    Ok(())
+}
