diff --git a/crates/airk-store/src/current/postings_tests.rs b/crates/airk-store/src/current/postings_tests.rs
--- a/crates/airk-store/src/current/postings_tests.rs
+++ b/crates/airk-store/src/current/postings_tests.rs
