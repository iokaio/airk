diff --git a/docs/research/contracts-v190/query-controls.schema.json b/docs/research/contracts-v190/query-controls.schema.json
new file mode 100644
index 0000000..50d06db
--- /dev/null
+++ b/docs/research/contracts-v190/query-controls.schema.json
@@ -0,0 +1,140 @@
+{
+  "type": "object",
+  "properties": {
+    "project": {
+      "type": "string",
+      "pattern": "^[0-9a-f]{64}$"
+    },
+    "project_ids": {
+      "type": "array",
+      "items": {
+        "type": "string",
+        "pattern": "^prj_[0-9a-f]{32}$"
+      },
+      "minItems": 1,
+      "maxItems": 32,
+      "uniqueItems": true
+    },
+    "index_ids": {
+      "type": "array",
+      "items": {
+        "type": "string",
+        "pattern": "^idx_[0-9a-f]{32}$"
+      },
+      "minItems": 1,
+      "maxItems": 32,
+      "uniqueItems": true
+    },
+    "member_availability": {
+      "enum": [
+        "report",
+        "require"
+      ]
+    },
+    "reply_detail": {
+      "enum": [
+        "lean",
+        "rich",
+        null
+      ]
+    },
+    "verification": {
+      "enum": [
+        "off",
+        "report",
+        "require"
+      ],
+      "default": "report"
+    },
+    "verification_max_sources": {
+      "type": "integer",
+      "minimum": 1,
+      "maximum": 256,
+      "default": 8
+    },
+    "verification_max_bytes": {
+      "type": "integer",
+      "minimum": 1,
+      "maximum": 1073741824,
+      "default": 16777216
+    },
+    "verification_deadline_ms": {
+      "type": "integer",
+      "minimum": 1,
+      "maximum": 30000,
+      "default": 2000
+    }
+  },
+  "required": [],
+  "additionalProperties": false,
+  "$schema": "http://json-schema.org/draft-07/schema#",
+  "$id": "https://airk.local/design/v190/query-controls.schema.json",
+  "title": "query-controls.schema.json",
+  "x-airk-activation-phase": "P4 verification; P7 Project selectors",
+  "description": "P3 design contract; not an advertised runtime capability before its phase gate.",
+  "allOf": [
+    {
+      "not": {
+        "required": [
+          "project",
+          "project_ids"
+        ]
+      }
+    },
+    {
+      "if": {
+        "required": [
+          "index_ids"
+        ]
+      },
+      "then": {
+        "required": [
+          "project_ids"
+        ]
+      }
+    },
+    {
+      "if": {
+        "required": [
+          "member_availability"
+        ]
+      },
+      "then": {
+        "required": [
+          "project_ids"
+        ]
+      }
+    },
+    {
+      "if": {
+        "anyOf": [
+          {
+            "required": [
+              "verification_max_sources"
+            ]
+          },
+          {
+            "required": [
+              "verification_max_bytes"
+            ]
+          },
+          {
+            "required": [
+              "verification_deadline_ms"
+            ]
+          }
+        ]
+      },
+      "then": {
+        "properties": {
+          "verification": {
+            "enum": [
+              "report",
+              "require"
+            ]
+          }
+        }
+      }
+    }
+  ]
+}
diff --git a/docs/research/contracts-v190/scope-discovery.schema.json b/docs/research/contracts-v190/scope-discovery.schema.json
new file mode 100644
index 0000000..0c7cdf2
--- /dev/null
+++ b/docs/research/contracts-v190/scope-discovery.schema.json
@@ -0,0 +1,105 @@
+{
+  "type": "object",
+  "properties": {
+    "view": {
+      "enum": [
+        "projects",
+        "indexes",
+        "sources"
+      ]
+    },
+    "project_id": {
+      "type": "string",
+      "pattern": "^prj_[0-9a-f]{32}$"
+    },
+    "index_id": {
+      "type": "string",
+      "pattern": "^idx_[0-9a-f]{32}$"
+    },
+    "cursor": {
+      "type": "string",
+      "minLength": 1,
+      "maxLength": 32768
+    },
+    "limit": {
+      "type": "integer",
+      "minimum": 1,
+      "maximum": 32
+    },
+    "max_bytes": {
+      "type": "integer",
+      "minimum": 1,
+      "maximum": 65536
+    }
+  },
+  "required": [
+    "view"
+  ],
+  "additionalProperties": false,
+  "$schema": "http://json-schema.org/draft-07/schema#",
+  "$id": "https://airk.local/design/v190/scope-discovery.schema.json",
+  "title": "scope-discovery.schema.json",
+  "x-airk-activation-phase": "P6 native/grants; P7 public query_scope",
+  "description": "P3 design contract; not an advertised runtime capability before its phase gate.",
+  "allOf": [
+    {
+      "if": {
+        "properties": {
+          "view": {
+            "const": "projects"
+          }
+        }
+      },
+      "then": {
+        "not": {
+          "anyOf": [
+            {
+              "required": [
+                "project_id"
+              ]
+            },
+            {
+              "required": [
+                "index_id"
+              ]
+            }
+          ]
+        }
+      }
+    },
+    {
+      "if": {
+        "properties": {
+          "view": {
+            "const": "indexes"
+          }
+        }
+      },
+      "then": {
+        "required": [
+          "project_id"
+        ],
+        "not": {
+          "required": [
+            "index_id"
+          ]
+        }
+      }
+    },
+    {
+      "if": {
+        "properties": {
+          "view": {
+            "const": "sources"
+          }
+        }
+      },
+      "then": {
+        "required": [
+          "project_id",
+          "index_id"
+        ]
+      }
+    }
+  ]
+}
