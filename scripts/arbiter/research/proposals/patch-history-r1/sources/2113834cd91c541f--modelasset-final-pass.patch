+// Private test-only hook: exercise the actual final content boundary without
+// timing sleeps, native processes or a production fault/configuration API.
+struct FinalAssetMutation;
+impl Drop for FinalAssetMutation {
+    fn drop(&mut self) { BEFORE_FINAL_ASSETS.with(|hook| {hook.borrow_mut().take();}); }
+}
+fn before_final_assets(callback: impl FnOnce() + 'static) -> FinalAssetMutation {
+    BEFORE_FINAL_ASSETS.with(|hook| {assert!(hook.borrow_mut().replace(Box::new(callback)).is_none());});
+    FinalAssetMutation
+}
+fn validation_fixture(root:&Path)->Result<(PathBuf,ModelObjectSet)> {
+    let (directory,set)=fixture(root)?;
+    fs::write(directory.join("set.json"),set.canonical_bytes()?)?;
+    Ok((directory,set))
+}
+#[test]
+fn complete_validation_hashes_each_exact_asset_once_and_never_caches_across_calls()->Result<()> {
+    let root=tempfile::tempdir()?;let (directory,set)=validation_fixture(root.path())?;
+    let expected_bytes=set.assets.values().map(|asset|asset.bytes).sum::<u64>();
+    VALIDATION_HASH_WORK.with(|work|work.set((0,0)));
+    validate_set(&directory,&set,false)?;
+    assert_eq!(VALIDATION_HASH_WORK.with(|work|work.get()),(set.assets.len() as u64,expected_bytes));
+    validate_set(&directory,&set,false)?;
+    assert_eq!(VALIDATION_HASH_WORK.with(|work|work.get()),(2*set.assets.len() as u64,2*expected_bytes));
+    Ok(())
+}
+#[test]
+fn partial_staging_keeps_its_complete_asset_hashes_and_partial_size_admission()->Result<()> {
+    let root=tempfile::tempdir()?;let (directory,set)=validation_fixture(root.path())?;
+    VALIDATION_HASH_WORK.with(|work|work.set((0,0)));
+    validate_set(&directory,&set,true)?;
+    assert_eq!(VALIDATION_HASH_WORK.with(|work|work.get()),(set.assets.len() as u64,set.assets.values().map(|asset|asset.bytes).sum()));
+    let target=directory.join(ModelAssetName::ModelJson.filename());let partial=target.with_extension("json.part");
+    fs::rename(&target,&partial)?;
+    fs::write(&partial,vec![0;set.assets[&ModelAssetName::ModelJson].bytes as usize+1])?;
+    assert!(format!("{:#}",validate_set(&directory,&set,true).unwrap_err()).contains("oversized model staging file"));
+    Ok(())
+}
+#[test]
+fn inventory_before_final_content_is_explicit_and_all_invalid_assets_remain_rejected()->Result<()> {
+    let root=tempfile::tempdir()?;let (directory,set)=validation_fixture(root.path())?;
+    let target=directory.join(ModelAssetName::ModelJson.filename());let original=fs::read(&target)?;
+    let mut corrupt=original.clone();corrupt[0]^=1;fs::write(&target,&corrupt)?;
+    let extra=directory.join("foreign-model-file");fs::write(&extra,b"preserve unknown")?;
+    VALIDATION_HASH_WORK.with(|work|work.set((0,0)));
+    let error=validate_set(&directory,&set,false).unwrap_err();
+    assert!(format!("{error:#}").contains("unknown shared model file"));
+    assert_eq!(VALIDATION_HASH_WORK.with(|work|work.get()),(0,0));
+    assert_eq!(fs::read(&extra)?,b"preserve unknown");fs::remove_file(&extra)?;
+    assert!(format!("{:#}",validate_set(&directory,&set,false).unwrap_err()).contains("shared model digest mismatch"));
+    fs::write(&target,&original)?;let alias=root.path().join("foreign-alias");fs::hard_link(&target,&alias)?;
+    assert!(validate_set(&directory,&set,false).is_err());fs::remove_file(&alias)?;
+    fs::remove_file(&target)?;assert!(validate_set(&directory,&set,false).is_err());
+    assert!(!target.exists());Ok(())
+}
+#[test]
+fn actual_final_pass_rejects_post_inventory_corruption_missing_and_alias()->Result<()> {
+    for fault in ["corrupt","missing","alias"] {
+        let root=tempfile::tempdir()?;let (directory,set)=validation_fixture(root.path())?;
+        let target=directory.join(ModelAssetName::ModelJson.filename());let changed=target.clone();let alias=root.path().join("late-alias");
+        let mutation=before_final_assets(move|| match fault {
+            "corrupt"=>{let mut bytes=fs::read(&changed).unwrap();bytes[0]^=1;fs::write(&changed,bytes).unwrap();},
+            "missing"=>fs::remove_file(&changed).unwrap(),
+            "alias"=>fs::hard_link(&changed,&alias).unwrap(),
+            _=>unreachable!(),
+        });
+        assert!(validate_set(&directory,&set,false).is_err(),"final boundary accepted {fault}");drop(mutation);
+    }Ok(())
+}
+#[test]
+fn repaired_same_length_asset_before_final_pass_is_an_explicit_contract_change()->Result<()> {
+    let root=tempfile::tempdir()?;let (directory,set)=validation_fixture(root.path())?;
+    let target=directory.join(ModelAssetName::ModelJson.filename());let original=fs::read(&target)?;
+    let mut corrupt=original.clone();corrupt[0]^=1;fs::write(&target,corrupt)?;
+    let repaired=target.clone();let mutation=before_final_assets(move||fs::write(repaired,original).unwrap());
+    validate_set(&directory,&set,false)?;drop(mutation);
+    assert!(BEFORE_FINAL_ASSETS.with(|hook|hook.borrow().is_none()));
+    Ok(())
+}
