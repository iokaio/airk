+        &mut fixture.registry,
+        &fixture.control,
+        ControlMethod::CatalogSplitApply { draft },
+    )?
+    else {
+        anyhow::bail!("exact inherited receipt replay absent");
+    };
+    assert_eq!(*replayed, saved);
+    Ok(())
