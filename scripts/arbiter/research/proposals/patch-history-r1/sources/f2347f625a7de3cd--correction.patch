+#[cfg(feature = "local-inference")]
+#[test]
+fn cpu_focus_receipt_uses_native_admitted_declared_policy_and_refuses_unbound_or_changed_description()
+-> Result<()> {
+    use airk_retrieval::arbiter::runtime::{self, ExecutionProfile};
+    let description = runtime::catalog_profiles()?
+        .into_iter()
+        .find(|profile| {
+            profile.model == airk_core::arbiter::ModelChoice::FocusQwenReranker06B
+                && profile.device_execution.is_none()
+        })
+        .context("compiled CPU Focus description absent")?;
+    let admitted = ExecutionProfile::from_release(description.manifest)?;
+    let declared = *description
+        .task_policies
+        .get(&Task::FocusRank)
+        .context("Focus task missing")?;
+    assert_eq!(
+        validated_focus_task_policy(&description, Some(&admitted))?,
+        declared
+    );
+    assert!(validated_focus_task_policy(&description, None).is_err());
+    let mut changed = description.clone();
+    changed.profile_id.push_str("-changed");
+    assert!(validated_focus_task_policy(&changed, Some(&admitted)).is_err());
+    let mut changed = description;
+    changed
+        .task_policies
+        .insert(Task::FocusRank, Sha256Digest::from_bytes([99; 32]));
+    assert!(validated_focus_task_policy(&changed, Some(&admitted)).is_err());
+    // Compiler input identity remains independently generated by current source;
+    // no receipt policy value is fed back into compiler input digest construction.
+    Ok(())
+}
