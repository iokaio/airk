+        .load(namespace)?
+        .context("receipt")?;
+    assert_eq!(
+        serde_json::to_value(state.verify.context("history")?)?,
+        history
+    );
+    let owner = collection.arm_native_owner(&mut registry, lease, &bound, identity)?;
+    owner.settle_after_owned_drain(&mut registry)?;
+    Ok(())
