+def verify_immutable_pins(card):
+    # These are immutable inputs only. The retained mutable control/state
+    # census is an ingress preimage and MUST NOT be rechecked after restart.
+    require(0<len(card['pins'])<=4096,'pin bound')
+    names=[os.path.normcase(str(Path(r['path']).resolve(strict=True))) for r in card['pins']]
+    require(len(names)==len(set(names)),'duplicate pin')
+    for row in card['pins']:
+        require(sha(row['path'])==row['sha256'],'pinned input changed: '+row['path'])
+
+
+def final_observation(report,began,cutoff,candidate,postcheck):
+    try:
+        postcheck()
+        report['postverification_passed']=True
+    except BaseException as error:
+        failure={'type':type(error).__name__,'message':str(error)}
+        if 'failure' not in report:report['failure']=failure
+        else:report.setdefault('secondary_failures',[]).append({'stage':'postverification',**failure})
+        report['postverification_passed']=False
+    # One final clock, after all proofs/hashes/handle cleanup. No renewal.
+    finished=time.monotonic()
+    report['elapsed_seconds']=finished-began
+    report['completion_observed_before_cutoff']=finished<cutoff
+    if finished>=cutoff and 'failure' not in report:
+        report['failure']={'type':'TimeoutError','message':'original retained restart phase cutoff expired at final observation'}
+    report['passed']=bool(candidate and finished<cutoff and report['postverification_passed']
+        and 'failure' not in report and 'cleanup_failure' not in report)
+    return report['passed']
+
+
+def require_restarted_identity(health,native,handle):
