+        and health['instance']!=native['previous_instance'] and handle.pid==health['process_id']
+        and handle.handle is not None,'same-image new native lease/instance/handle absent')
+    # A numeric PID may be legitimately reused. Original handle exit is proved
+    # separately by prior_proof; a new instance and retained new handle bind this run.
+
