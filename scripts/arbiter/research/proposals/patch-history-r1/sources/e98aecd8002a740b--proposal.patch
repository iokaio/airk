+#[test]
+fn actual_charge_identity_changes_joint_generation_but_metadata_never_holds_its_release()
+-> Result<()> {
+    use std::{
+        future::Future,
+        task::{Context as TaskContext, Poll, Waker},
+    };
+    let resources = airk_kernel::service_resources::Resources::new(
+        airk_core::service_resources::ResourceConfiguration::default(),
+        8,
+        Some(64 << 30),
+    )?;
+    let charge = Arc::new(resources.reserve_optional(
+        Incarnation::from_bytes([71; 16]),
+        1,
+        Some(8 << 30),
+    )?);
+    let release = charge.release_observer();
+    let profile = Sha256Digest::from_bytes([72; 32]);
+    let fact = |charge: &Arc<Reservation>| ResidentFact {
+        stage: Stage::Context,
+        profile,
+        device: None,
+        charge: Arc::downgrade(charge),
+        requires: false,
+    };
+    let mut state = State::default();
+    state.replace_facts(vec![fact(&charge)])?;
+    assert_eq!(state.generation, 1);
+    for _ in 0..20 {
+        state.replace_facts(vec![fact(&charge)])?;
+    }
+    assert_eq!(
+        state.generation, 1,
+        "borrowing one actual peak is not a new residency"
+    );
+    drop(charge);
+    let mut wait = Box::pin(release.wait());
+    assert!(
+        matches!(
+            wait.as_mut()
+                .poll(&mut TaskContext::from_waker(Waker::noop())),
+            Poll::Ready(Ok(()))
+        ),
+        "metadata Weak must not retain the host charge"
+    );
+    let other = Arc::new(resources.reserve_optional(
+        Incarnation::from_bytes([73; 16]),
+        1,
+        Some(8 << 30),
+    )?);
+    state.replace_facts(vec![fact(&other)])?;
+    assert_eq!(
+        state.generation, 2,
+        "same profile cannot hide a distinct actual charge owner"
+    );
+    Ok(())
+}
