+    store: &FileStore,
+    writer: &airk_store::WriterLock,
+    reservation: &Reservation,
+    retained_files: u64,
+) -> Result<Option<ResourceChange>> {
+    let Some(mut work) = read_work(read, store)? else {
+        return Ok(None);
+    };
