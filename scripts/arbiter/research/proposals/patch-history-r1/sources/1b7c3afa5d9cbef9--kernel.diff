+fn assert_native_denial<T>(result: Result<T>) {
+    let error = match result {
+        Ok(_) => panic!("blocked exact read unexpectedly succeeded"),
+        Err(error) => error,
+    };
+    assert!(
+        error
+            .downcast_ref::<airk_core::scoped_reads::ScopeReadRefused>()
