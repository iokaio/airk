+        let session = admin.with_scoped_reads(authority)?;
+        assert!(admin.require_unrestricted_read().is_ok());
+        assert!(
+            session
+                .require_unrestricted_read()
+                .unwrap_err()
+                .is::<ScopeReadRefused>()
+        );
+        assert!(
+            session
