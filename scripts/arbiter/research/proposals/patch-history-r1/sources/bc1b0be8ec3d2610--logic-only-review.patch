+#[cfg(feature = "local-inference")]
+fn recordable_fault_profile(
+    genuine: bool,
+    unknown: bool,
+    failed: Option<Sha256Digest>,
+    current: Sha256Digest,
+) -> Option<Sha256Digest> {
+    (genuine && !unknown).then_some(failed.unwrap_or(current))
+}
