+#[test]
+fn vector_interval_retains_cached_native_dates_without_rewriting_them() {
+    let body = json!({"observed_unix_ms":100,"cache_age_ms":25,"source_verification":{"observed_from_unix_ms":120,"observed_to_unix_ms":130}});
+    let mut from = 125;
