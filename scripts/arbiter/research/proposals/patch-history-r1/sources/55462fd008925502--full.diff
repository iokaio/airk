+        // complete rejection is observed rather than hidden by fixture retries.
+        let native = runtime
+            .block_on(direct.call("airk_diagnostics".into(), args.as_object().unwrap().clone()))?;
+        hint(&native)?;
+        let encoded = args.to_string();
