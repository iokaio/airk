+/// A live native registry observation, not a serializable authority claim.
+#[derive(Clone, Debug)]
+pub struct NativeSplitState(pub(crate) SplitSnapshot);
+impl NativeSplitState {
+    pub fn snapshot(&self) -> &SplitSnapshot {
+        &self.0
+    }
