+pub struct SplitSnapshot {
+    pub request: SplitRequest,
+    pub baseline: SourcePolicy,
+    pub plan: SplitPolicyPlan,
+    pub receipt: SplitReceipt,
+    pub receipt_digest: Sha256Digest,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub finalization: Option<SplitFinalizationStatus>,
+}
+/// Admission reserves response space for the largest terminal receipt before
+/// accepting immutable request/policy/plan data. Recovery adds at most 16 KiB.
+pub fn validate_snapshot_admission(
+    request: &SplitRequest,
+    baseline: &SourcePolicy,
+    plan: &SplitPolicyPlan,
+) -> Result<()> {
+    let envelope = serde_json::json!({"request":request,"baseline":baseline,"plan":plan,"receipt":null,"receipt_digest":"0".repeat(64)});
+    let maximum = serde_json::to_vec(&envelope)?
+        .len()
+        .checked_sub(4)
+        .and_then(|bytes| bytes.checked_add(MAX_RECEIPT_BYTES))
+        .and_then(|bytes| bytes.checked_add(MAX_SPLIT_FINALIZATION_BYTES))
+        .ok_or_else(|| anyhow::anyhow!("split terminal frame preflight overflow"))?;
+    ensure!(
+        maximum <= MAX_SPLIT_SNAPSHOT_BYTES,
+        "split immutable snapshot leaves insufficient terminal receipt/frame capacity"
+    );
+    Ok(())
+}
+impl SplitSnapshot {
+    pub fn validate(&self) -> Result<()> {
+        self.request.validate_plan(&self.baseline, &self.plan)?;
+        self.receipt.validate_for(&self.request)?;
+        ensure!(
+            self.receipt_digest == self.receipt.identity(&self.request)?,
+            "split native receipt digest differs"
+        );
+        if let Some(finalization) = &self.finalization {
+            encoded_size(finalization, MAX_SPLIT_FINALIZATION_BYTES)?;
+            ensure!(
+                finalization.schema == 1
+                    && finalization.revision > 0
+                    && finalization.slots == self.receipt.terminal_publication_slots,
+                "split finalization envelope identity differs"
+            );
+            ensure!(
+                finalization
+                    .attention
+                    .as_ref()
+                    .is_none_or(|code| !code.is_empty()
+                        && code.len() <= 128
+                        && code.bytes().all(|byte| byte.is_ascii_lowercase()
+                            || byte.is_ascii_digit()
+                            || byte == b'_')),
+                "invalid split finalization attention"
+            );
+            let terminal = self.receipt.stage == SplitStage::Complete
+                || matches!(
+                    self.receipt.state,
+                    SplitRunState::CanceledBeforeFence {
+                        cleanup_pending: false
+                    }
+                );
+            ensure!(
+                finalization.funding_acknowledged.iter().all(|digest| self
+                    .receipt
+                    .funding_release_receipts
+                    .values()
+                    .any(|release| release == digest)),
+                "finalization acknowledged unknown funding release"
+            );
+            if terminal {
+                ensure!(
+                    matches!(
+                        finalization.progress,
+                        SplitFinalizationProgress::Acknowledging
+                            | SplitFinalizationProgress::Complete
+                    ) && finalization.terminal_receipt_digest == self.receipt_digest
+                        && finalization.terminal_receipt_revision == self.receipt.revision,
+                    "split completed publication differs"
+                );
+                if finalization.progress == SplitFinalizationProgress::Complete {
+                    ensure!(
+                        finalization.funding_acknowledged.len()
+                            == self.receipt.funding_release_receipts.len(),
+                        "split terminal acknowledgment remains pending"
+                    );
+                }
+            } else {
+                ensure!(
+                    matches!(
+                        finalization.progress,
+                        SplitFinalizationProgress::Prepared | SplitFinalizationProgress::Publishing
+                    ) && finalization.terminal_receipt_revision == self.receipt.revision.next()?,
+                    "split frozen finalization revision differs"
+                );
+            }
+        }
+        validate_snapshot_admission(&self.request, &self.baseline, &self.plan)?;
+        // Recovery ack <=16 KiB plus this snapshot leaves >=2 KiB envelope room.
+        encoded_size(self, MAX_SPLIT_SNAPSHOT_BYTES)?;
+        Ok(())
+    }
+}
+
+/// Typed native job result. Removal uses the existing P9 exact policy report;
+/// a destination proof names its actual independent current publication.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct SplitJobResult {
+    pub schema: u32,
+    pub operation_id: Incarnation,
+    pub request_digest: Sha256Digest,
+    pub purpose: SplitJobPurpose,
+    pub publication: Option<RevisionToken>,
+    pub policy_digest: Sha256Digest,
+    pub selected_sources: u64,
+    pub actual_bytes: Option<u64>,
+    pub semantic_ready: bool,
+    pub cleanup_complete: bool,
+    /// Qualified from the actual retained capsule by the native Store adapter.
+    pub policy_application: Option<crate::catalog_policy::SourcePolicyApplyReport>,
+    #[serde(default)]
+    pub remainder_witness: Option<SplitRemainderWitness>,
+}
+impl SplitJobResult {
+    pub fn validate_for(&self, request: &SplitRequest, plan: &SplitPolicyPlan) -> Result<()> {
+        ensure!(
+            self.schema == 1
+                && self.operation_id == request.operation_id()?
+                && self.request_digest == request.identity()?,
+            "split job result identity differs"
+        );
+        if self.purpose == SplitJobPurpose::OriginalWitness {
+            let witness = self
+                .remainder_witness
+                .as_ref()
+                .ok_or_else(|| anyhow::anyhow!("split original witness result missing"))?;
+            ensure!(
+                self.policy_digest == request.before_policy_digest
+                    && self.publication == Some(witness.publication)
+                    && witness.index_id == request.original_index
+                    && witness.before_policy_digest == request.before_policy_digest
+                    && self.selected_sources == 1
+                    && self.actual_bytes == Some(witness.bytes_read)
+                    && self.policy_application.is_none()
+                    && !self.cleanup_complete,
+                "split original witness result differs"
+            );
+            crate::index_catalog::relative_path(&witness.source_relative_path, false)?;
+            ensure!(
+                plan.remainder
+                    .allows_canonical(witness.source_root_id, &witness.source_relative_path),
+                "split witness result outside remainder"
+            );
+        } else if self.purpose == SplitJobPurpose::DestinationBuild {
+            ensure!(
+                self.publication.is_some()
+                    && self.policy_digest == plan.destination.identity()?
+                    && self.selected_sources > 0
+                    && (!request.require_semantic_ready || self.semantic_ready),
+                "split destination validation incomplete"
+            );
+        } else {
+            let expected = if self.purpose == SplitJobPurpose::DestinationCleanup {
+                plan.destination.identity()?
+            } else {
+                plan.remainder.identity()?
+            };
+            ensure!(
+                self.policy_digest == expected,
+                "split job result policy differs"
+            );
+        }
+        ensure!(
+            self.purpose == SplitJobPurpose::OriginalWitness || self.remainder_witness.is_none(),
+            "unrelated split job contains witness result"
+        );
+        if let Some(report) = &self.policy_application {
+            report.validate()?;
+            ensure!(
+                report.policy_digest == self.policy_digest,
+                "split policy application digest differs"
+            );
+        }
+        encoded_size(self, MAX_RECEIPT_BYTES)?;
+        Ok(())
+    }
+}
diff --git a/crates/airk-core/src/catalog_split_draft.rs b/crates/airk-core/src/catalog_split_draft.rs
new file mode 100644
index 0000000..2e058a4
--- /dev/null
+++ b/crates/airk-core/src/catalog_split_draft.rs
@@ -0,0 +1,190 @@
+// SPDX-License-Identifier: Apache-2.0
+//! Bounded user choices and complete native split reviews. Neither is authority.
+use crate::{
+    catalog_management::{MAX_PAGE_BYTES, MAX_RECEIPT_BYTES},
+    catalog_setup::SetupStorageAction,
+    catalog_split::{MAX_SPLIT_PROJECTS, SplitCapacityReview, SplitRequest},
+    identity::{Sha256Digest, framed_digest},
+    index_catalog::{
+        CatalogRevision, IndexId, QueryProjectId, ScopeAtom, atoms, encoded_size, label,
+    },
+    service::RequestKey,
+    source_policy::{SourcePolicy, SplitPolicyPlan, validate_root_path},
+};
+use anyhow::{Result, ensure};
+use serde::{Deserialize, Serialize};
+use std::collections::BTreeSet;
+
+/// Scopes use original source IDs. Native review maps them to the independently
+/// assigned destination IDs; choosing membership never issues an evidence grant.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(tag = "destination", rename_all = "snake_case", deny_unknown_fields)]
+pub enum SplitMembershipSelection {
+    Omit,
+    PreserveReviewedScope,
+    Selected { scope: Vec<ScopeAtom> },
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct SplitProjectSelection {
+    pub project_id: QueryProjectId,
+    pub retain_original: bool,
+    pub membership: SplitMembershipSelection,
+}
+
+/// Explicit peak-growth ceilings, not inferred size observations or proof that
+/// quota was reserved. Native review supplies both actual quota-policy digests.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct SplitCapacitySelection {
+    pub destination_growth: u64,
+    pub destination_temporary: u64,
+    pub original_rewrite: u64,
+    pub cleanup_allowance: u64,
+}
+impl SplitCapacitySelection {
+    pub fn with_policies(
+        self,
+        original: Sha256Digest,
+        destination: Sha256Digest,
+    ) -> Result<SplitCapacityReview> {
+        let review = SplitCapacityReview {
+            destination_growth: self.destination_growth,
+            destination_temporary: self.destination_temporary,
+            original_rewrite: self.original_rewrite,
+            cleanup_allowance: self.cleanup_allowance,
+            original_quota_digest: original,
+            destination_quota_digest: destination,
+        };
+        review.total()?;
+        Ok(review)
+    }
+}
+
+/// Read-only native preparation. The service reconstructs canonical bindings,
+/// complete affected-Project revisions, policy plans and storage observations.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct SplitDraftSelection {
+    pub key: RequestKey,
+    pub expected_catalog_revision: CatalogRevision,
+    pub index_id: IndexId,
+    pub selectors: Vec<ScopeAtom>,
+    pub destination_name: String,
+    pub destination_data_root: String,
+    pub destination_collection: String,
+    pub projects: Vec<SplitProjectSelection>,
+    pub capacity: SplitCapacitySelection,
+    pub require_semantic_ready: bool,
+    pub destination_watch_enabled: bool,
+}
+impl SplitDraftSelection {
+    pub fn validate(&self) -> Result<()> {
+        ensure!(
+            self.key.epoch <= i64::MAX as u64,
+            "split request epoch exceeds supported range"
+        );
+        atoms(&self.selectors)?;
+        ensure!(
+            !self.selectors.is_empty(),
+            "split requires selected source paths"
+        );
+        label(&self.destination_name)?;
+        validate_root_path(&self.destination_data_root)?;
+        ensure!(
+            !self.destination_collection.is_empty()
+                && self.destination_collection.len() <= 128
+                && !matches!(self.destination_collection.as_str(), "." | "..")
+                && self
+                    .destination_collection
+                    .bytes()
+                    .all(|byte| byte.is_ascii_alphanumeric() || b"._-".contains(&byte)),
+            "invalid independent destination collection"
+        );
+        ensure!(
+            self.projects.len() <= MAX_SPLIT_PROJECTS,
+            "split Project choices exceed supported range"
+        );
+        let mut seen = BTreeSet::new();
+        for project in &self.projects {
+            ensure!(
+                seen.insert(project.project_id),
+                "duplicate split Project choice"
+            );
+            ensure!(
+                project.retain_original
+                    || !matches!(project.membership, SplitMembershipSelection::Omit),
+                "split Project must retain a reviewed membership"
+            );
+            if let SplitMembershipSelection::Selected { scope } = &project.membership {
+                atoms(scope)?;
+                ensure!(
+                    !scope.is_empty(),
+                    "split destination scope must be explicit and nonempty"
+                );
+            }
+        }
+        self.capacity.with_policies(
+            Sha256Digest::from_bytes([0; 32]),
+            Sha256Digest::from_bytes([0; 32]),
+        )?;
+        encoded_size(self, MAX_RECEIPT_BYTES)?;
+        Ok(())
+    }
+}
+
+/// Full review returned identically by native management, CLI and Workbench.
+/// The metadata actor independently rebuilds it before accepting its exact key.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct SplitDraft {
+    pub schema: u32,
+    pub request: SplitRequest,
+    pub request_digest: Sha256Digest,
+    pub before_policy: SourcePolicy,
+    pub plan: SplitPolicyPlan,
+    pub destination_storage_action: SetupStorageAction,
+    /// Static bounded dependency rules, not a claim that controls were scanned.
+    pub control_inputs: serde_json::Value,
+    pub review_digest: Sha256Digest,
+}
+impl SplitDraft {
+    pub fn identity(&self) -> Result<Sha256Digest> {
+        self.request
+            .validate_plan(&self.before_policy, &self.plan)?;
+        crate::catalog_split::validate_snapshot_admission(
+            &self.request,
+            &self.before_policy,
+            &self.plan,
+        )?;
+        ensure!(
+            self.request_digest == self.request.identity()?,
+            "split request digest changed"
+        );
+        ensure!(
+            self.schema == 1 && self.control_inputs.is_object(),
+            "invalid split native review"
+        );
+        encoded_size(&self.control_inputs, 2048)?;
+        Ok(framed_digest(
+            b"airk/catalog-split-draft/1",
+            &[&serde_json::to_vec(&(
+                self.schema,
+                &self.request,
+                &self.before_policy,
+                &self.plan,
+                self.destination_storage_action,
+                &self.control_inputs,
+            ))?],
+        ))
+    }
+    pub fn validate(&self) -> Result<()> {
+        ensure!(
+            self.review_digest == self.identity()?,
+            "split native review changed"
+        );
+        encoded_size(self, MAX_PAGE_BYTES)?;
+        Ok(())
+    }
+}
diff --git a/crates/airk-core/src/catalog_upgrade_recovery.rs b/crates/airk-core/src/catalog_upgrade_recovery.rs
new file mode 100644
index 0000000..8df7eef
--- /dev/null
+++ b/crates/airk-core/src/catalog_upgrade_recovery.rs
@@ -0,0 +1,275 @@
+// SPDX-License-Identifier: Apache-2.0
+//! Explicit installer-owned retirement of unavailable legacy index metadata.
+//! These values describe review and durable outcomes; they are never read grants
+//! or proof that a source path is missing, a native lease is held, or bytes were deleted.
+use crate::{
+    identity::{Incarnation, Sha256Digest, framed_digest},
+    index_catalog::{CatalogRevision, IndexId, SourceImportState},
+    service::{ProjectRegistration, RequestKey},
+};
+use anyhow::{Result, ensure};
+use serde::{Deserialize, Serialize};
+
+pub const MAX_RECOVERY_BYTES: usize = 32 * 1024;
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct UpgradeRetirementRequest {
+    pub schema: u32,
+    pub caller: Incarnation,
+    pub key: RequestKey,
+    pub upgrade_id: Incarnation,
+    pub plan_digest: Sha256Digest,
+    pub installer_identity: Sha256Digest,
+    pub index_id: IndexId,
+    pub registration: ProjectRegistration,
+    pub expected_authorizations_digest: Sha256Digest,
+}
+impl UpgradeRetirementRequest {
+    pub fn validate(&self) -> Result<()> {
+        ensure!(self.schema == 1, "unsupported legacy retirement request");
+        self.registration.validate()?;
+        crate::index_catalog::encoded_size(self, MAX_RECOVERY_BYTES)?;
+        Ok(())
+    }
+    pub fn identity(&self) -> Result<Sha256Digest> {
+        self.validate()?;
+        Ok(framed_digest(
+            b"airk/upgrade-retirement-request/1",
+            &[&serde_json::to_vec(self)?],
+        ))
+    }
+    pub fn operation_id(&self) -> Result<Incarnation> {
+        self.validate()?;
+        crate::catalog_management::catalog_operation_id(self.caller, &self.key)
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct UpgradeRetirementPreview {
+    pub schema: u32,
+    pub request: UpgradeRetirementRequest,
+    pub request_digest: Sha256Digest,
+    pub original_backup_digest: Sha256Digest,
+    pub original_legacy_data_digest: Sha256Digest,
+    pub source_configuration: SourceImportState,
+    pub effect: UpgradeRetirementEffect,
+    pub affected_work: UpgradeRetirementWork,
+}
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct UpgradeRetirementWork {
+    pub jobs: u32,
+    /// Framed digest of the exact sorted pending/running job IDs. Original job
+    /// rows and terminal outcomes remain in their existing registry owners.
+    pub job_ids_digest: Sha256Digest,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum UpgradeRetirementEffect {
+    /// Logical authority retirement and cancellation of exactly this project's
+    /// accepted work, under the upgrade owner's real process exclusion. Physical
+    /// storage cleanup remains an explicit pending outcome until ordinary cleanup.
+    RetireAndCancelWithCleanupPending,
+}
+impl UpgradeRetirementPreview {
+    pub fn validate(&self) -> Result<()> {
+        self.request.validate()?;
+        ensure!(
+            self.schema == 1
+                && self.request_digest == self.request.identity()?
+                && self.source_configuration == SourceImportState::PendingMetadata
+                && self.affected_work.jobs <= 1024,
+            "invalid unavailable legacy retirement review"
+        );
+        crate::index_catalog::encoded_size(self, MAX_RECOVERY_BYTES)?;
+        Ok(())
+    }
+    pub fn identity(&self) -> Result<Sha256Digest> {
+        self.validate()?;
+        Ok(framed_digest(
+            b"airk/upgrade-retirement-review/1",
+            &[&serde_json::to_vec(self)?],
+        ))
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct UpgradeRetirementAuthorization {
+    pub preview: UpgradeRetirementPreview,
+    pub review_digest: Sha256Digest,
+}
+impl UpgradeRetirementAuthorization {
+    pub fn validate(&self) -> Result<()> {
+        self.preview.validate()?;
+        ensure!(
+            self.review_digest == self.preview.identity()?,
+            "legacy retirement review changed"
+        );
+        Ok(())
+    }
+    pub fn identity(&self) -> Result<Sha256Digest> {
+        self.validate()?;
+        Ok(framed_digest(
+            b"airk/upgrade-retirement-authorization/1",
+            &[&serde_json::to_vec(self)?],
+        ))
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct UpgradeRetirementReceipt {
+    pub schema: u32,
+    pub authorization: UpgradeRetirementAuthorization,
+    pub catalog_revision: CatalogRevision,
+    pub canceled_work: UpgradeRetirementWork,
+    pub post_effect_legacy_data_digest: Sha256Digest,
+    pub cleanup: UpgradeRetirementCleanup,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum UpgradeRetirementCleanup {
+    Pending,
+}
+impl UpgradeRetirementReceipt {
+    pub fn validate(&self) -> Result<()> {
+        self.authorization.validate()?;
+        ensure!(
+            self.schema == 1 && self.canceled_work == self.authorization.preview.affected_work,
+            "invalid legacy retirement outcome"
+        );
+        crate::index_catalog::encoded_size(self, MAX_RECOVERY_BYTES)?;
+        Ok(())
+    }
+    pub fn identity(&self) -> Result<Sha256Digest> {
+        self.validate()?;
+        Ok(framed_digest(
+            b"airk/upgrade-retirement-receipt/1",
+            &[&serde_json::to_vec(self)?],
+        ))
+    }
+}
+
+/// Complete canonical runtime-admin response. It is not an evidence endpoint.
+/// Every variant preserves its full typed body inside the existing 64 KiB frame.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(tag = "status", rename_all = "snake_case", deny_unknown_fields)]
+pub enum UpgradeRetirementReply {
+    Review {
+        preview: UpgradeRetirementPreview,
+        review_digest: Sha256Digest,
+    },
+    Authorized {
+        authorization: UpgradeRetirementAuthorization,
+    },
+    Applied {
+        receipt: UpgradeRetirementReceipt,
+    },
+}
+impl UpgradeRetirementReply {
+    pub fn validate(&self) -> Result<()> {
+        match self {
+            Self::Review {
+                preview,
+                review_digest,
+            } => {
+                preview.validate()?;
+                ensure!(
+                    *review_digest == preview.identity()?,
+                    "native retirement review digest changed"
+                );
+            }
+            Self::Authorized { authorization } => authorization.validate()?,
+            Self::Applied { receipt } => receipt.validate()?,
+        }
+        crate::index_catalog::encoded_size(self, crate::service::MAX_FRAME_BYTES)?;
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn preview() -> Result<UpgradeRetirementPreview> {
+        let request = UpgradeRetirementRequest {
+            schema: 1,
+            caller: Incarnation::from_bytes([1; 16]),
+            key: RequestKey {
+                namespace: Incarnation::from_bytes([2; 16]),
+                epoch: 0,
+                nonce: Incarnation::from_bytes([3; 16]),
+            },
+            upgrade_id: Incarnation::from_bytes([4; 16]),
+            plan_digest: Sha256Digest::from_bytes([5; 32]),
+            installer_identity: Sha256Digest::from_bytes([6; 32]),
+            index_id: IndexId::from_identity(Incarnation::from_bytes([7; 16])),
+            registration: ProjectRegistration::new(
+                "/fictional/source".into(),
+                "/fictional/private".into(),
+                "a".into(),
+            )?,
+            expected_authorizations_digest: Sha256Digest::from_bytes([8; 32]),
+        };
+        Ok(UpgradeRetirementPreview {
+            schema: 1,
+            request_digest: request.identity()?,
+            request,
+            original_backup_digest: Sha256Digest::from_bytes([9; 32]),
+            original_legacy_data_digest: Sha256Digest::from_bytes([10; 32]),
+            source_configuration: SourceImportState::PendingMetadata,
+            effect: UpgradeRetirementEffect::RetireAndCancelWithCleanupPending,
+            affected_work: UpgradeRetirementWork {
+                jobs: 1,
+                job_ids_digest: Sha256Digest::from_bytes([11; 32]),
+            },
+        })
+    }
+    #[test]
+    fn zero_epoch_and_distinct_service_namespace_preserve_exact_review() -> Result<()> {
+        let original = preview()?;
+        original.validate()?;
+        let mut crossed = original.clone();
+        crossed.request.key.namespace = Incarnation::from_bytes([99; 16]);
+        assert!(crossed.validate().is_err());
+        let mut crossed = original.clone();
+        crossed.original_backup_digest = Sha256Digest::from_bytes([99; 32]);
+        assert_ne!(crossed.identity()?, original.identity()?);
+        let mut ready = original.clone();
+        ready.source_configuration = SourceImportState::Complete;
+        assert!(ready.validate().is_err());
+        Ok(())
+    }
+    #[test]
+    fn frozen_cleanup_receipt_binds_exact_reviewed_work_and_declines_unknown_fields() -> Result<()>
+    {
+        let preview = preview()?;
+        let authorization = UpgradeRetirementAuthorization {
+            review_digest: preview.identity()?,
+            preview,
+        };
+        let receipt = UpgradeRetirementReceipt {
+            schema: 1,
+            canceled_work: authorization.preview.affected_work.clone(),
+            authorization,
+            catalog_revision: CatalogRevision::INITIAL.next()?,
+            post_effect_legacy_data_digest: Sha256Digest::from_bytes([12; 32]),
+            cleanup: UpgradeRetirementCleanup::Pending,
+        };
+        receipt.validate()?;
+        let mut crossed = receipt.clone();
+        crossed.canceled_work.jobs = 0;
+        assert!(crossed.validate().is_err());
+        let mut value = serde_json::to_value(&receipt)?;
+        value["physical_files_deleted"] = true.into();
+        assert!(serde_json::from_value::<UpgradeRetirementReceipt>(value).is_err());
+        assert_eq!(
+            serde_json::from_slice::<UpgradeRetirementReceipt>(&serde_json::to_vec(&receipt)?)?,
+            receipt
+        );
+        Ok(())
+    }
+}
diff --git a/crates/airk-core/src/combined_reads.rs b/crates/airk-core/src/combined_reads.rs
new file mode 100644
index 0000000..3ec1326
--- /dev/null
+++ b/crates/airk-core/src/combined_reads.rs
@@ -0,0 +1,566 @@
+// SPDX-License-Identifier: Apache-2.0
+//! Inert combined-read contracts. Selection and publication identities confer no authority.
+use crate::{
+    evidence::RevisionEnvelope,
+    identity::{Sha256Digest, framed_digest},
+    index_catalog::{
+        CatalogRevision, GrantId, GrantedMembership, IndexId, MAX_SELECTION, QueryProjectId,
+        ReviewedGrant, ScopeAtom, SourceRootId, encoded_size, relative_path, unique_bounded,
+    },
+};
+use anyhow::{Result, ensure};
+use serde::{Deserialize, Serialize};
+use std::collections::{BTreeMap, BTreeSet};
+
+pub const RANK_FUSION_POLICY: &str = "airk.rank-fusion.rrf-equal/1";
+pub const COMBINED_READ_SCHEMA: &str = "airk.combined-read/1";
+pub mod header_templates;
+pub mod origins;
+pub mod query_scope;
+pub mod recommendations;
+pub mod shared_values;
+pub use origins::{PublicationMemberRef, QualifiedOrigin, RankedOrigin, materialize_ranked_origin};
+
+/// Logical metadata view only. Retain and validate the original wire body and
+/// delivery receipt separately; this expanded copy is never a replacement for
+/// the bytes authenticated by that receipt.
+pub fn materialize_combined_read(combined: &serde_json::Value) -> Result<serde_json::Value> {
+    use serde_json::Value;
+    ensure!(
+        combined.get("schema").and_then(Value::as_str) == Some(COMBINED_READ_SCHEMA),
+        "invalid combined read namespace"
+    );
+    encoded_size(combined, crate::MAX_RESPONSE_BYTES * (MAX_SELECTION + 4))?;
+    let members = combined
+        .get("members")
+        .and_then(Value::as_array)
+        .ok_or_else(|| anyhow::anyhow!("combined members are missing"))?;
+    ensure!(
+        !members.is_empty() && members.len() <= MAX_SELECTION,
+        "invalid combined member count"
+    );
+    let ranking = combined
+        .get("ranking")
+        .and_then(Value::as_array)
+        .ok_or_else(|| anyhow::anyhow!("combined ranking is missing"))?;
+    ensure!(ranking.len() <= 100, "combined ranking exceeds bound");
+    let mut logical = combined.clone();
+    if let Some(fields) = logical.as_object_mut() {
+        fields.remove("delivery_observation");
+    }
+    logical["derived_view"] = serde_json::json!("materialized_native_members");
+    for (offset, member) in members.iter().enumerate() {
+        let index: IndexId = serde_json::from_value(member["index_id"].clone())?;
+        logical["members"][offset]["result"] =
+            shared_values::materialize_combined_member_result(combined, index)?;
+    }
+    for (offset, rank) in ranking.iter().enumerate() {
+        logical["ranking"][offset]["origin"] =
+            serde_json::to_value(materialize_ranked_origin(combined, rank)?)?;
+    }
+    Ok(logical)
+}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum MemberAvailability {
+    #[default]
+    Report,
+    Require,
+}
+
+/// New Project selectors only. Legacy `project`, including mixed selectors,
+/// is rejected by this closed shape and retains its separate one-index route.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct QuerySelection {
+    pub project_ids: Vec<QueryProjectId>,
+    #[serde(
+        default,
+        skip_serializing_if = "Option::is_none",
+        deserialize_with = "present"
+    )]
+    pub index_ids: Option<Vec<IndexId>>,
+    #[serde(default)]
+    pub member_availability: MemberAvailability,
+}
+
+fn present<'de, D, T>(deserializer: D) -> std::result::Result<Option<T>, D::Error>
+where
+    D: serde::Deserializer<'de>,
+    T: Deserialize<'de>,
+{
+    T::deserialize(deserializer).map(Some)
+}
+
+impl QuerySelection {
+    pub fn validate(&self) -> Result<()> {
+        ensure!(
+            !self.project_ids.is_empty(),
+            "Project selection is required"
+        );
+        unique_bounded(&self.project_ids, MAX_SELECTION)?;
+        if let Some(indexes) = &self.index_ids {
+            ensure!(!indexes.is_empty(), "index subset must not be empty");
+            unique_bounded(indexes, MAX_SELECTION)?;
+        }
+        encoded_size(self, 4096)?;
+        Ok(())
+    }
+
+    /// Resolve only the frozen grant. The native owner must separately check
+    /// host, namespace, current membership/source/policy revisions and delivery.
+    /// Defaults and memberships outside the selected Projects never add scope.
+    pub fn resolve(&self, grant: &ReviewedGrant) -> Result<ResolvedSelection> {
+        self.validate()?;
+        grant.validate()?;
+        // A persisted catalog itself is bounded to 32 MiB. Check before
+        // cloning selected memberships, including for direct native callers.
+        encoded_size(grant, 32 * 1024 * 1024)?;
+        ensure!(!grant.revoked, "reviewed grant is revoked");
+        let projects = self.project_ids.iter().copied().collect::<BTreeSet<_>>();
+        let mut permitted = BTreeMap::<IndexId, Vec<GrantedMembership>>::new();
+        let mut seen_projects = BTreeSet::new();
+        for membership in &grant.memberships {
+            if projects.contains(&membership.membership.project_id) {
+                seen_projects.insert(membership.membership.project_id);
+                permitted
+                    .entry(membership.membership.index_id)
+                    .or_default()
+                    .push(membership.clone());
+            }
+        }
+        ensure!(projects == seen_projects, "unknown or ungranted Project");
+        if let Some(indexes) = &self.index_ids {
+            ensure!(
+                indexes.iter().all(|id| permitted.contains_key(id)),
+                "index is outside the selected Project union"
+            );
+            permitted.retain(|id, _| indexes.contains(id));
+        }
+        ensure!(
+            !permitted.is_empty() && permitted.len() <= MAX_SELECTION,
+            "selected Project union is empty or exceeds capacity"
+        );
+        let mut members = Vec::with_capacity(permitted.len());
+        for (index_id, mut memberships) in permitted {
+            memberships.sort_by_key(|member| member.membership.project_id);
+            let first = &memberships[0];
+            ensure!(
+                memberships.iter().all(|member| {
+                    member.source_revision == first.source_revision
+                        && member.policy_epoch == first.policy_epoch
+                        && member.policy_digest == first.policy_digest
+                }),
+                "inconsistent shared-index authority"
+            );
+            let scope = canonical_scope_union(
+                memberships
+                    .iter()
+                    .flat_map(|member| member.membership.scope.iter().cloned()),
+            )?;
+            members.push(ResolvedMember {
+                index_id,
+                memberships,
+                scope,
+            });
+        }
+        Ok(ResolvedSelection {
+            project_ids: projects.into_iter().collect(),
+            members,
+            grant_id: grant.id,
+            grant_revision: grant.revision,
+            member_availability: self.member_availability,
+        })
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ResolvedSelection {
+    pub project_ids: Vec<QueryProjectId>,
+    /// Sorted by unique index ID, independently of caller or Project order.
+    pub members: Vec<ResolvedMember>,
+    pub grant_id: GrantId,
+    pub grant_revision: CatalogRevision,
+    pub member_availability: MemberAvailability,
+}
+
+/// Canonical public selection observation. The native owner retains the full
+/// frozen memberships and union predicates; their digest binds every scope and
+/// revision without serializing those predicates repeatedly in each read.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct SelectedScopeObservation {
+    pub project_ids: Vec<QueryProjectId>,
+    pub index_ids: Vec<IndexId>,
+    pub grant_id: GrantId,
+    pub grant_revision: CatalogRevision,
+    pub member_availability: MemberAvailability,
+    pub identity: Sha256Digest,
+}
+
+impl ResolvedSelection {
+    pub fn observation(&self) -> Result<SelectedScopeObservation> {
+        Ok(SelectedScopeObservation {
+            project_ids: self.project_ids.clone(),
+            index_ids: self.members.iter().map(|member| member.index_id).collect(),
+            grant_id: self.grant_id,
+            grant_revision: self.grant_revision,
+            member_availability: self.member_availability,
+            identity: self.identity()?,
+        })
+    }
+    pub fn validate(&self) -> Result<()> {
+        unique_bounded(&self.project_ids, MAX_SELECTION)?;
+        ensure!(
+            !self.project_ids.is_empty()
+                && self.project_ids.windows(2).all(|pair| pair[0] < pair[1]),
+            "noncanonical selected Projects"
+        );
+        let ids = self
+            .members
+            .iter()
+            .map(|member| member.index_id)
+            .collect::<Vec<_>>();
+        unique_bounded(&ids, MAX_SELECTION)?;
+        ensure!(
+            !ids.is_empty() && ids.windows(2).all(|pair| pair[0] < pair[1]),
+            "noncanonical selected indexes"
+        );
+        for member in &self.members {
+            ensure!(
+                !member.memberships.is_empty(),
+                "selected member has no authorization"
+            );
+            let projects = member.project_ids();
+            unique_bounded(&projects, MAX_SELECTION)?;
+            ensure!(
+                projects.windows(2).all(|pair| pair[0] < pair[1])
+                    && projects.iter().all(|id| self.project_ids.contains(id)),
+                "foreign or noncanonical membership"
+            );
+            let first = &member.memberships[0];
+            for membership in &member.memberships {
+                membership.membership.validate()?;
+                ensure!(
+                    membership.membership.index_id == member.index_id
+                        && membership.source_revision == first.source_revision
+                        && membership.policy_epoch == first.policy_epoch
+                        && membership.policy_digest == first.policy_digest
+                        && membership.policy_epoch <= i64::MAX as u64
+                        && (membership.policy_epoch == 0) == membership.policy_digest.is_none(),
+                    "inconsistent selected member identity"
+                );
+            }
+            ensure!(
+                member.scope
+                    == canonical_scope_union(
+                        member.memberships.iter().flat_map(|membership| membership
+                            .membership
+                            .scope
+                            .iter()
+                            .cloned())
+                    )?,
+                "selected scope differs from membership union"
+            );
+        }
+        Ok(())
+    }
+    pub fn identity(&self) -> Result<Sha256Digest> {
+        self.validate()?;
+        Ok(framed_digest(
+            b"airk/combined-selection/1",
+            &[&serde_json::to_vec(self)?],
+        ))
+    }
+    pub fn member(&self, id: IndexId) -> Option<&ResolvedMember> {
+        self.members.iter().find(|member| member.index_id == id)
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ResolvedMember {
+    pub index_id: IndexId,
+    pub memberships: Vec<GrantedMembership>,
+    /// A positive canonical union; disjoint scopes never become an ancestor.
+    pub scope: Vec<ScopeAtom>,
+}
+
+impl ResolvedMember {
+    pub fn project_ids(&self) -> Vec<QueryProjectId> {
+        self.memberships
+            .iter()
+            .map(|member| member.membership.project_id)
+            .collect()
+    }
+    /// The supplied path is canonical source-relative text, never a virtual
+    /// alias path. Source identity must come from the native retained reader.
+    pub fn projects_for(&self, root: SourceRootId, path: &str) -> Result<Vec<QueryProjectId>> {
+        relative_path(path, false)?;
+        Ok(self
+            .memberships
+            .iter()
+            .filter_map(|member| {
+                member
+                    .membership
+                    .scope
+                    .iter()
+                    .any(|atom| atom.matches_canonical(root, path))
+                    .then_some(member.membership.project_id)
+            })
+            .collect())
+    }
+}
+
+pub fn canonical_scope_union(atoms: impl IntoIterator<Item = ScopeAtom>) -> Result<Vec<ScopeAtom>> {
+    let mut unique = BTreeSet::new();
+    // Bound before collection as well as after canonicalization. Redundant
+    // input cannot turn this metadata helper into an unbounded allocation.
+    for (offset, atom) in atoms.into_iter().enumerate() {
+        ensure!(
+            offset < MAX_SELECTION * crate::index_catalog::MAX_ATOMS,
+            "scope union capacity exceeded"
+        );
+        atom.validate()?;
+        unique.insert(atom);
+    }
+    Ok(unique
+        .iter()
+        .filter(|atom| {
+            !unique.iter().any(|other| {
+                other != *atom
+                    && other.kind == crate::index_catalog::PathScope::Subtree
+                    && other.matches_canonical(atom.source_root_id, &atom.path)
+            })
+        })
+        .cloned()
+        .collect())
+}
+
+/// One total budget, allocated without multiplying allowances by member count.
+/// Zero allocations are explicit unqueried members, never successful zero hits.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct SharedBudgets {
+    pub limit: usize,
+    pub max_bytes: usize,
+    pub deadline_ms: u64,
+    pub verification_max_sources: usize,
+    pub verification_max_bytes: u64,
+    pub verification_deadline_ms: u64,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct MemberAllocation {
+    pub index_id: IndexId,
+    pub limit: usize,
+    pub max_bytes: usize,
+    pub deadline_ms: u64,
+    pub verification_max_sources: usize,
+    pub verification_max_bytes: u64,
+    pub verification_deadline_ms: u64,
+}
+
+impl MemberAllocation {
+    pub fn admits_read(&self) -> bool {
+        self.limit > 0 && self.max_bytes > 0 && self.deadline_ms > 0
+    }
+}
+
+impl SharedBudgets {
+    pub fn validate(&self) -> Result<()> {
+        crate::validate_budget(self.limit, self.max_bytes)?;
+        ensure!(
+            (1..=30_000).contains(&self.deadline_ms),
+            "combined deadline must be 1..30000 ms"
+        );
+        ensure!(
+            self.verification_max_sources <= crate::verification::MAX_SOURCES
+                && self.verification_max_bytes <= crate::verification::MAX_BYTES
+                && self.verification_deadline_ms <= crate::verification::MAX_DEADLINE_MS,
+            "combined verification budget exceeds bounds"
+        );
+        Ok(())
+    }
+    pub fn allocate(&self, selection: &ResolvedSelection) -> Result<Vec<MemberAllocation>> {
+        self.validate()?;
+        selection.validate()?;
+        let members = selection
+            .members
+            .iter()
+            .map(|member| member.index_id)
+            .collect::<Vec<_>>();
+        unique_bounded(&members, MAX_SELECTION)?;
+        ensure!(
+            !members.is_empty() && members.windows(2).all(|pair| pair[0] < pair[1]),
+            "noncanonical combined members"
+        );
+        let n = members.len() as u64;
+        let part = |total: u64, offset: usize| total / n + u64::from((offset as u64) < total % n);
+        Ok(members
+            .into_iter()
+            .enumerate()
+            .map(|(offset, index_id)| MemberAllocation {
+                index_id,
+                limit: part(self.limit as u64, offset) as usize,
+                max_bytes: part(self.max_bytes as u64, offset) as usize,
+                deadline_ms: part(self.deadline_ms, offset),
+                verification_max_sources: part(self.verification_max_sources as u64, offset)
+                    as usize,
+                verification_max_bytes: part(self.verification_max_bytes, offset),
+                verification_deadline_ms: part(self.verification_deadline_ms, offset),
+            })
+            .collect())
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct MemberPublication {
+    pub index_id: IndexId,
+    pub publication: Option<RevisionEnvelope>,
+}
+
+/// An interval of independent member observations, never an atomic global head.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct PublicationVector {
+    pub authority: Sha256Digest,
+    pub observed_from_unix_ms: u64,
+    pub observed_to_unix_ms: u64,
+    pub members: Vec<MemberPublication>,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum PublicationRelation {
+    Equal,
+    Older,
+    Newer,
+    Incomparable,
+    Inconsistent,
+    Unknown,
+}
+
+impl PublicationVector {
+    pub fn validate(&self) -> Result<()> {
+        ensure!(
+            self.observed_to_unix_ms >= self.observed_from_unix_ms,
+            "invalid publication observation interval"
+        );
+        let ids = self
+            .members
+            .iter()
+            .map(|member| member.index_id)
+            .collect::<Vec<_>>();
+        unique_bounded(&ids, MAX_SELECTION)?;
+        ensure!(
+            !ids.is_empty() && ids.windows(2).all(|pair| pair[0] < pair[1]),
+            "noncanonical publication vector"
+        );
+        for member in &self.members {
+            if let Some(publication) = &member.publication {
+                ensure!(
+                    !publication.collection.is_empty()
+                        && publication.collection.len() <= 128
+                        && publication.incarnation == publication.token.incarnation
+                        && publication.generation == publication.token.generation
+                        && publication.revision == publication.token.revision,
+                    "inconsistent member publication"
+                );
+            }
+        }
+        Ok(())
+    }
+    /// Causal display comparison only. This is not an ancestry proof or a
+    /// historical read selector; generation comparisons require same authority,
+    /// index set, collection and backing incarnation.
+    pub fn compare(&self, other: &Self) -> PublicationRelation {
+        use PublicationRelation::*;
+        if self.validate().is_err() || other.validate().is_err() {
+            return Unknown;
+        }
+        if self.authority != other.authority
+            || self
+                .members
+                .iter()
+                .map(|m| m.index_id)
+                .ne(other.members.iter().map(|m| m.index_id))
+        {
+            return Incomparable;
+        }
+        let (mut older, mut newer) = (false, false);
+        for (left, right) in self.members.iter().zip(&other.members) {
+            let (Some(left), Some(right)) = (&left.publication, &right.publication) else {
+                return Unknown;
+            };
+            if left.collection != right.collection || left.incarnation != right.incarnation {
+                return Incomparable;
+            }
+            match left.generation.cmp(&right.generation) {
+                std::cmp::Ordering::Less => older = true,
+                std::cmp::Ordering::Greater => newer = true,
+                std::cmp::Ordering::Equal if left.revision != right.revision => {
+                    return Inconsistent;
+                }
+                std::cmp::Ordering::Equal => {}
+            }
+        }
+        match (older, newer) {
+            (true, true) => Incomparable,
+            (true, false) => Older,
+            (false, true) => Newer,
+            (false, false) => Equal,
+        }
+    }
+}
+
+/// Identity for a future paged union. Search itself has no continuation.
+/// A transport must validate the encoded cursor and live native authority;
+/// this consistency digest is not a capability.
+pub fn continuation_identity(
+    vector: &PublicationVector,
+    selection: &ResolvedSelection,
+    filters_projection_budgets: &serde_json::Value,
+    merge_positions: &BTreeMap<IndexId, usize>,
+) -> Result<Sha256Digest> {
+    vector.validate()?;
+    selection.validate()?;
+    ensure!(
+        vector
+            .members
+            .iter()
+            .map(|member| member.index_id)
+            .eq(selection.members.iter().map(|member| member.index_id)),
+        "cursor publication set differs from selection"
+    );
+    ensure!(
+        merge_positions
+            .keys()
+            .copied()
+            .eq(selection.members.iter().map(|member| member.index_id)),
+        "cursor must bind every selected member position"
+    );
+    encoded_size(filters_projection_budgets, crate::MAX_RESPONSE_BYTES)?;
+    Ok(framed_digest(
+        b"airk/combined-continuation/1",
+        &[
+            &serde_json::to_vec(&(vector.authority, &vector.members))?,
+            &serde_json::to_vec(selection)?,
+            &serde_json::to_vec(filters_projection_budgets)?,
+            &serde_json::to_vec(merge_positions)?,
+        ],
+    ))
+}
+
+/// Rank contributions deliberately ignore raw backend/model scores.
+pub fn rank_contribution(zero_based_local_rank: usize) -> f64 {
+    1.0 / (61.0 + zero_based_local_rank as f64)
+}
