+fn registry() -> Result<(tempfile::TempDir, ServiceRegistry)> {
+    let root = tempfile::tempdir()?;
+    let registry = ServiceRegistry::open(root.path(), Incarnation::from_bytes([1; 16]))?;
+    Ok((root, registry))
+}
