+        let copied = serde_json::to_value(&draft)?;
+        assert_eq!(copied["request"], serde_json::to_value(&request)?);
+        assert_eq!(copied["preview"], serde_json::to_value(&preview)?);
+        let mut mismatched = preview.clone();
