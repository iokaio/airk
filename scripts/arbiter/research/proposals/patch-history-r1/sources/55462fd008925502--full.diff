+/// Only this coordinator owns child handles and may qualify an acknowledgement
+/// or prove native absence with the actual source lease. PID caches are unused.
+fn coordinate_policy_fences(
+    root: &Path,
+    service: Incarnation,
+    child: Option<&WatchChild>,
