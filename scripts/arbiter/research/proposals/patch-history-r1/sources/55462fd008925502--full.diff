+fn assert_no_private(value: &impl Serialize) -> Result<()> {
+    let encoded = serde_json::to_string(value)?;
+    for forbidden in ["private/", "HiddenOnly", "SecretContract"] {
+        ensure!(
+            !encoded.contains(forbidden),
+            "blocked evidence escaped: {forbidden}"
