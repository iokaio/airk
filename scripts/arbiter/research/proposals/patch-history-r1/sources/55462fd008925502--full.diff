+#[test]
+fn damaged_digest_cannot_complete_shared_resource_ownership() -> Result<()> {
+    let (_root, mut registry) = fixture()?;
+    let record = registry.begin_shared_helper_drain(owner(1), unix(), boot())?;
+    registry.connection.execute(
