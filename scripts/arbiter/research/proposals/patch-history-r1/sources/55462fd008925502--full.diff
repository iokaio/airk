+impl Collection {
+    /// Select an actual owned slot for worker diagnostics before claim. The
+    /// returned store carries NO split permit, so current/evidence entry points
+    /// retain their ordinary stage denial. This is metadata selection only.
+    pub fn select_for_diagnostics(&self) -> Result<FileStore> {
+        let owner: Owner = json(&self.directory.join("service-owner.json"))?;
+        ensure!(
+            owner_digest(&owner)? == self.binding
+                && owner_registration(&owner)? == owner_registration(&self.owner)?,
+            "diagnostic collection ownership changed"
+        );
+        let split = owner
+            .required_split
+            .as_ref()
+            .map(|pointer| capsule(&self.directory, pointer))
+            .transpose()?;
+        let canceled = split.as_ref().is_some_and(|state| {
+            matches!(
+                state.snapshot.receipt.state,
+                SplitRunState::CanceledBeforeFence {
+                    cleanup_pending: true
+                }
+            )
+        });
+        let _lock = match retry_manifest_lock(|| {
+            crate::service::acquire_shared_file(&self.directory, "manifest.lock")
+        }) {
+            Ok(lock) => lock,
+            Err(error)
+                if canceled
+                    && error
+                        .downcast_ref::<std::io::Error>()
+                        .is_some_and(|error| error.kind() == std::io::ErrorKind::NotFound) =>
+            {
+                match fs::symlink_metadata(self.directory.join("incarnations")) {
+                    Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
+                        return Ok(FileStore::new(&self.directory));
+                    }
+                    Err(error) => return Err(error.into()),
+                    Ok(_) => anyhow::bail!(
+                        "split cleanup lacks its manifest lock but retains unexplained incarnations"
+                    ),
+                }
+            }
+            Err(error) => return Err(error),
+        };
+        match self.manifest() {
+            Ok(manifest) => Ok(FileStore::new(self.slot(manifest.active))),
+            Err(error)
+                if error
+                    .downcast_ref::<std::io::Error>()
+                    .is_some_and(|error| error.kind() == std::io::ErrorKind::NotFound)
+                    && split.as_ref().is_some_and(|state| {
+                        matches!(
+                            state.snapshot.receipt.state,
+                            SplitRunState::CanceledBeforeFence {
+                                cleanup_pending: true
+                            }
+                        )
+                    }) =>
+            {
+                match fs::symlink_metadata(self.directory.join("incarnations")) {
+                    Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
+                        Ok(FileStore::new(&self.directory))
+                    }
+                    Err(error) => Err(error.into()),
+                    Ok(_) => anyhow::bail!(
+                        "split cleanup has no manifest but retains unexplained incarnations"
+                    ),
+                }
+            }
+            Err(error) => Err(error),
+        }
+    }
+    /// Build only a compact native job configuration from owned metadata. No
+    /// evidence read/model bind/source capture is authorized by this result.
+    pub fn split_work_configuration(
+        &self,
+        state: &NativeSplitState,
+        purpose: SplitJobPurpose,
+    ) -> Result<airk_core::service_configuration::ConfigurationRequest> {
+        use airk_core::service_configuration::{ConfigurationRequest, ProjectConfiguration};
+        let value = &state.0;
+        value.validate()?;
+        let registration = match purpose {
+            SplitJobPurpose::DestinationBuild | SplitJobPurpose::DestinationCleanup => {
+                &value.request.destination_registration
+            }
+            SplitJobPurpose::OriginalWitness | SplitJobPurpose::OriginalCleanup => {
+                &value.request.original_registration
+            }
+            SplitJobPurpose::OriginalRemoval => {
+                anyhow::bail!("original removal reuses its exact admitted P9 policy configuration")
+            }
+        };
+        ensure!(
+            owner_registration(&self.owner)? == *registration,
+            "split configuration collection differs"
+        );
+        let owner: Owner = json(&self.directory.join("service-owner.json"))?;
+        if let Some(pointer) = owner.required_split.as_ref() {
+            let previous = capsule(&self.directory, pointer)?.snapshot;
+            ensure!(
+                previous.request == value.request
+                    && previous.plan == value.plan
+                    && pointer.revision <= value.receipt.revision,
+                "split configuration owner lineage differs"
+            );
+        } else {
+            ensure!(
+                purpose == SplitJobPurpose::OriginalWitness,
+                "split configuration lacks stable required owner"
+            );
+        }
+        let allowed = match purpose {
+            SplitJobPurpose::DestinationBuild => {
+                matches!(
+                    value.receipt.stage,
+                    SplitStage::DestinationPrepared | SplitStage::Building
+                ) && !matches!(
+                    value.receipt.state,
+                    SplitRunState::CanceledBeforeFence { .. } | SplitRunState::Complete
+                )
+            }
+            SplitJobPurpose::DestinationCleanup => matches!(
+                value.receipt.state,
+                SplitRunState::CanceledBeforeFence {
+                    cleanup_pending: true
+                }
+            ),
+            SplitJobPurpose::OriginalWitness => {
+                value.receipt.stage == SplitStage::DestinationValidated
+                    && !matches!(
+                        value.receipt.state,
+                        SplitRunState::CanceledBeforeFence { .. } | SplitRunState::Complete
+                    )
+            }
+            SplitJobPurpose::OriginalCleanup => {
+                value.receipt.stage >= SplitStage::MembershipApplied
+                    && value.receipt.stage < SplitStage::Complete
+            }
+            SplitJobPurpose::OriginalRemoval => false,
+        };
+        ensure!(allowed, "split job configuration phase differs");
+        let store = self.select_for_diagnostics()?;
+        let incarnation = store
+            .service_incarnation()?
+            .context("split slot already removed; use exact saved cleanup configuration")?;
+        let _writer = store.existing_writer_exclusion()?;
+        let settings = settings_id(&settings(&store, &registration.root)?);
+        if purpose == SplitJobPurpose::OriginalWitness {
+            ensure!(
+                incarnation == value.request.original_incarnation
+                    && settings == value.request.original_settings_digest,
+                "split original witness settings/incarnation changed"
+            );
+        }
+        let request = ConfigurationRequest {
+            prepare: false,
+            incarnation,
+            settings,
+            configuration: ProjectConfiguration::SplitWork {
+                operation_id: value.receipt.operation_id,
+                request_digest: value.receipt.request_digest,
+                expected_receipt_digest: value.receipt_digest,
+                purpose,
+                require_semantic_ready: purpose == SplitJobPurpose::DestinationBuild
+                    && value.request.require_semantic_ready,
+            },
+        };
+        request.validate()?;
+        Ok(request)
+    }
+    /// Inspect only the stable owner/capsule before any recovery or slot open.
+    pub fn split_evidence_constraint(&self) -> Result<Option<SplitEvidenceConstraint>> {
+        let owner: Owner = json(&self.directory.join("service-owner.json"))?;
+        ensure!(
+            owner_digest(&owner)? == self.binding
+                && owner_registration(&owner)? == owner_registration(&self.owner)?,
+            "split owner metadata changed"
+        );
+        let Some(pointer) = owner.required_split.as_ref() else {
+            return Ok(None);
+        };
+        let value = capsule(&self.directory, pointer)?.snapshot;
+        Ok(Some(
+            pointer
+                .reference
+                .evidence_constraint(&value.request, &value.receipt)?,
+        ))
+    }
+    /// Metadata-only observation; opening this owner confers no evidence access.
+    pub fn required_split(&self) -> Result<Option<SplitOwnerReference>> {
+        let owner: Owner = json(&self.directory.join("service-owner.json"))?;
+        Ok(owner.required_split.map(|pointer| pointer.reference))
+    }
+    pub fn with_split_access(mut self, permit: SplitBuildPermit) -> Result<Self> {
+        ensure!(
+            permit.registration == owner_registration(&self.owner)?,
+            "split collection permit binding differs"
+        );
+        self.split_access = Some(permit);
+        Ok(self)
+    }
+    pub(super) fn check_split_access(&self) -> Result<()> {
+        let manifest = self.manifest()?;
+        let mut store = FileStore::new(self.slot(manifest.active));
+        if let Some(permit) = &self.split_access {
+            store = store.with_split_access(permit.clone())?;
+        }
+        validate_split_store_access(&store)
+    }
+    /// Publish a content-addressed immutable capsule BEFORE changing its owner
+    /// pointer. Readers of an earlier pre-fence original capsule stay available.
+    /// The caller supplies the exact funded quota after admission; an Accepted
+    /// metadata shell may use its existing finite setup metadata allowance.
+    pub fn retain_split_state(&self, state: &NativeSplitState, quota: &Quota) -> Result<()> {
+        let value = &state.0;
+        value.validate()?;
+        let registration = owner_registration(&self.owner)?;
+        let (role, index) = if registration == value.request.original_registration {
+            (
+                SplitOwnerRole::OriginalRemainder,
+                value.request.original_index,
+            )
+        } else {
+            ensure!(
+                registration == value.request.destination_registration,
+                "split owner registration differs"
+            );
+            (
+                SplitOwnerRole::Destination,
+                value.request.destination.index_id,
+            )
+        };
+        ensure!(
+            quota.root() == Path::new(&registration.data_root),
+            "split metadata quota owner differs"
+        );
+        let reference = SplitOwnerReference {
+            required_contract: airk_core::catalog_split::SPLIT_CONTRACT,
+            operation_id: value.receipt.operation_id,
+            request_digest: value.receipt.request_digest,
+            index_id: index,
+            role,
+            activation_receipt: value.receipt.membership_receipt,
+        };
+        reference.validate_for(&value.request, &value.receipt)?;
+        let bytes = serde_json::to_vec(&Capsule {
+            schema: 1,
+            snapshot: value.clone(),
+        })?;
+        ensure!(
+            bytes.len() <= MAX_SPLIT_STATE,
+            "split capsule exceeds format budget"
+        );
+        let digest = framed_digest(b"airk/stable-split-state/1", &[&bytes]);
+        let _lock = manifest_lock(&self.directory)?;
+        let mut owner: Owner = json(&self.directory.join("service-owner.json"))?;
+        ensure!(
+            owner_digest(&owner)? == self.binding && owner_registration(&owner)? == registration,
+            "split stable ownership changed"
+        );
+        if let Some(old) = &owner.required_split {
+            let previous = capsule(&self.directory, old)?;
+            if old.reference.operation_id == reference.operation_id {
+                ensure!(
+                    old.reference.request_digest == reference.request_digest
+                        && old.revision <= value.receipt.revision,
+                    "split owner lifecycle regressed"
+                );
+                if old.revision == value.receipt.revision {
+                    ensure!(old.digest == digest, "split owner revision was reused");
+                    return Ok(());
+                }
+            } else {
+                ensure!(
+                    matches!(
+                        previous.snapshot.receipt.state,
+                        SplitRunState::Complete
+                            | SplitRunState::CanceledBeforeFence {
+                                cleanup_pending: false
+                            }
+                    ),
+                    "previous split owner remains active"
+                );
+            }
+        }
+        let reservation = quota.reserve(
+            &registration.collection,
+            u64::try_from(bytes.len() + MAX_METADATA * 2)?,
+        )?;
+        reservation.charge(bytes.len() as u64)?;
+        let path = self.directory.join(filename(digest));
+        if path.try_exists()? {
+            ensure!(fs::read(&path)? == bytes, "split capsule name collision");
+        } else {
+            let mut file = tempfile::Builder::new()
+                .prefix(".service-metadata-")
+                .tempfile_in(&self.directory)?;
+            file.write_all(&bytes)?;
+            file.as_file().sync_all()?;
+            crate::durability::persist_synced(file, &path)?;
+        }
+        owner.required_split = Some(SplitOwnerPointer {
+            reference,
+            revision: value.receipt.revision,
+            digest,
+        });
+        let owner_bytes = serde_json::to_vec(&owner)?;
+        ensure!(
+            owner_bytes.len() <= MAX_METADATA,
+            "split owner metadata exceeds bound"
+        );
+        reservation.charge(owner_bytes.len() as u64)?;
+        let mut file = tempfile::Builder::new()
+            .prefix(".service-metadata-")
+            .tempfile_in(&self.directory)?;
+        file.write_all(&owner_bytes)?;
+        file.as_file().sync_all()?;
+        crate::durability::persist_synced(file, &self.directory.join("service-owner.json"))
+    }
+    /// Native metadata checkpoint under the participant's existing funded
+    /// phase. The internal store never receives an evidence permit and never
+    /// escapes this method; journal qualification returns only quota accounting.
+    pub fn retain_split_state_and_reconcile(
+        &self,
+        state: &NativeSplitState,
+        expected: &crate::quota::funding::FundingReceipt,
+    ) -> Result<crate::quota::funding::FundingReceipt> {
+        let value = &state.0;
+        value.validate()?;
+        expected.validate_for(&value.request)?;
+        let registration = owner_registration(&self.owner)?;
+        let index = if registration == value.request.original_registration {
+            value.request.original_index
+        } else {
+            ensure!(
+                registration == value.request.destination_registration,
+                "split metadata checkpoint owner differs"
+            );
+            value.request.destination.index_id
+        };
+        ensure!(
+            expected.data_root == Path::new(&registration.data_root)
+                && value.receipt.funding_receipts.get(&registration.data_root)
+                    == Some(&expected.identity()?),
+            "split metadata checkpoint funding was not admitted"
+        );
+        let quota = Quota::open_service(&expected.data_root)?;
+        quota.validate_funding(expected)?;
+        let participant = expected
+            .participants
+            .iter()
+            .find(|participant| participant.index_id == index)
+            .context("split metadata funding participant missing")?;
+        let phase = participant
+            .phase
+            .as_ref()
+            .context("split metadata checkpoint requires its admitted participant phase")?;
+        let owner = quota.adopt_funding_phase(expected, index, phase)?;
+        let quota = quota.with_funding(owner.clone())?;
+        let mut store = self.select_for_diagnostics()?;
+        let writer = store.lock()?;
+        ensure!(
+            self.select_for_diagnostics()?.directory() == store.directory(),
+            "split metadata selected slot changed"
+        );
+        // Private quota-only attachment. split_access remains absent, so ordinary
+        // current/evidence APIs still refuse the staged destination.
+        store.funding = Some(owner);
+        self.retain_split_state(state, &quota)?;
+        store.reconcile_native_split_metadata(&writer, &quota)
+    }
+    /// Native protected setup validates this owned metadata without granting an
+    /// evidence reader to the staged destination.
+    pub fn split_preparation(
+        &self,
+        state: &NativeSplitState,
+    ) -> Result<crate::service::registry::catalog::split::NativeSplitPreparation> {
+        let value = &state.0;
+        ensure!(
+            owner_registration(&self.owner)? == value.request.destination_registration,
+            "split preparation owner differs"
+        );
+        let manifest = self.manifest()?;
+        let store = FileStore::new(self.slot(manifest.active));
+        let roots = crate::roots::RootConfig::load(store.directory(), &self.owner.root)?;
+        ensure!(
+            SourceConfigurationSnapshot {
+                primary_root: self.owner.root.clone(),
+                aliases: roots.roots
+            } == value.request.source_configuration,
+            "split prepared root configuration differs"
+        );
+        let pointer: Owner = json(&self.directory.join("service-owner.json"))?;
+        let pointer = pointer
+            .required_split
+            .context("split preparation lacks required staging owner")?;
+        ensure!(
+            pointer.reference.role == SplitOwnerRole::Destination
+                && pointer.reference.operation_id == value.receipt.operation_id,
+            "split preparation staging owner differs"
+        );
+        Ok(
+            crate::service::registry::catalog::split::NativeSplitPreparation::new(
+                state,
+                framed_digest(
+                    b"airk/split-prepared-storage/1",
+                    &[&serde_json::to_vec(&(
+                        self.binding,
+                        manifest.active,
+                        &value.request.source_configuration,
+                    ))?],
+                ),
+            ),
+        )
+    }
+}
diff --git a/crates/airk-store/src/service_collection_split_terminal.rs b/crates/airk-store/src/service_collection_split_terminal.rs
new file mode 100644
index 0000000..9715301
--- /dev/null
+++ b/crates/airk-store/src/service_collection_split_terminal.rs
@@ -0,0 +1,439 @@
+// SPDX-License-Identifier: Apache-2.0
+//! Fixed native final-publication capacity; no document/evidence access.
+use super::*;
+use crate::service::registry::catalog::setup::storage::{
+    SetupDirectory, SetupFileMode, file_identity,
+};
+use std::{
+    ffi::OsStr,
+    io::{Seek, SeekFrom},
+};
+const CAPSULE_BYTES: u64 = airk_core::catalog_management::MAX_PAGE_BYTES as u64;
+const OWNER_BYTES: u64 = MAX_METADATA as u64;
+const INTENT_BYTES: u64 = 16384;
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct TerminalSlot {
+    pub schema: u32,
+    pub operation: Incarnation,
+    pub request: Sha256Digest,
+    pub index: airk_core::index_catalog::IndexId,
+    pub registration: ProjectRegistration,
+    pub directory: (u64, u64),
+    pub capsule_file: (u64, u64),
+    pub owner_file: (u64, u64),
+}
+impl TerminalSlot {
+    pub(crate) fn identity(&self) -> Result<Sha256Digest> {
+        ensure!(self.schema == 1, "unsupported split terminal allocation");
+        Ok(framed_digest(
+            b"airk/split-terminal-allocation/1",
+            &[&serde_json::to_vec(self)?],
+        ))
+    }
+    fn names(&self) -> (String, String, String) {
+        names(self.operation)
+    }
+    pub(crate) fn validate_for(&self, state: &NativeSplitState) -> Result<()> {
+        let value = &state.0;
+        value.validate()?;
+        ensure!(
+            self.operation == value.receipt.operation_id
+                && self.request == value.receipt.request_digest
+                && ((self.index == value.request.original_index
+                    && self.registration == value.request.original_registration)
+                    || (self.index == value.request.destination.index_id
+                        && self.registration == value.request.destination_registration)),
+            "split terminal slot request/owner differs"
+        );
+        Ok(())
+    }
+}
+fn names(operation: Incarnation) -> (String, String, String) {
+    (
+        format!(".split-final-{operation}-capsule.part"),
+        format!(".split-final-{operation}-owner.part"),
+        format!(".split-final-{operation}.json"),
+    )
+}
+fn absent(error: &anyhow::Error) -> bool {
+    error
+        .downcast_ref::<std::io::Error>()
+        .is_some_and(|error| error.kind() == std::io::ErrorKind::NotFound)
+}
+fn open_initial(directory: &SetupDirectory, name: &str) -> Result<File> {
+    match directory.open_file(OsStr::new(name), SetupFileMode::ReadWrite) {
+        Ok(file) => {
+            ensure!(
+                file.metadata()?.len() == 0,
+                "unrecorded nonempty terminal allocation is preserved"
+            );
+            Ok(file)
+        }
+        Err(error) if absent(&error) => {
+            directory.open_file(OsStr::new(name), SetupFileMode::CreateNew)
+        }
+        Err(error) => Err(error),
+    }
+}
+fn allocate(file: &mut File, bytes: u64) -> Result<()> {
+    ensure!(
+        file.metadata()?.len() <= bytes,
+        "split terminal allocation length exceeded"
+    );
+    file.seek(SeekFrom::Start(0))?;
+    let zero = [0u8; 8192];
+    let mut left = bytes;
+    while left > 0 {
+        let count = left.min(zero.len() as u64) as usize;
+        file.write_all(&zero[..count])?;
+        left -= count as u64;
+    }
+    file.set_len(bytes)?;
+    file.sync_all()?;
+    Ok(())
+}
+fn fill(file: &mut File, bytes: &[u8], limit: u64) -> Result<()> {
+    ensure!(
+        bytes.len() as u64 <= limit && file.metadata()?.len() >= bytes.len() as u64,
+        "terminal publication would require unreserved growth"
+    );
+    file.seek(SeekFrom::Start(0))?;
+    file.write_all(bytes)?;
+    file.set_len(bytes.len() as u64)?;
+    file.sync_all()?;
+    Ok(())
+}
+impl Collection {
+    pub(crate) fn prepare_split_terminal_slot(
+        &self,
+        state: &NativeSplitState,
+        expected: &crate::quota::funding::FundingReceipt,
+    ) -> Result<(TerminalSlot, crate::quota::funding::FundingReceipt)> {
+        let value = &state.0;
+        value.validate()?;
+        expected.validate_for(&value.request)?;
+        ensure!(
+            value.receipt.physical_cleanup_authorization.is_some()
+                && (value.receipt.stage == SplitStage::CleanupPending
+                    || matches!(
+                        value.receipt.state,
+                        SplitRunState::CanceledBeforeFence {
+                            cleanup_pending: true
+                        }
+                    )),
+            "terminal allocation precedes native physical cleanup"
+        );
+        let registration = owner_registration(&self.owner)?;
+        let index = if registration == value.request.original_registration {
+            value.request.original_index
+        } else {
+            ensure!(
+                registration == value.request.destination_registration,
+                "terminal allocation owner differs"
+            );
+            value.request.destination.index_id
+        };
+        ensure!(
+            value.receipt.funding_receipts.get(&registration.data_root)
+                == Some(&expected.identity()?)
+                && expected.data_root == Path::new(&registration.data_root),
+            "terminal allocation funding was not admitted"
+        );
+        let quota = Quota::open_service(&expected.data_root)?;
+        quota.validate_funding(expected)?;
+        let participant = expected
+            .participants
+            .iter()
+            .find(|participant| participant.index_id == index)
+            .context("terminal allocation participant missing")?;
+        let phase = participant
+            .phase
+            .as_ref()
+            .context("terminal allocation lacks admitted phase")?;
+        let funding = quota.adopt_funding_phase(expected, index, phase)?;
+        let quota = quota.with_funding(funding.clone())?;
+        let mut store = self.select_for_diagnostics()?;
+        let writer = store.lock()?;
+        ensure!(
+            self.select_for_diagnostics()?.directory() == store.directory(),
+            "terminal allocation selected slot changed"
+        );
+        store.funding = Some(funding);
+        let directory = SetupDirectory::open_canonical(&self.directory)?;
+        let owner: Owner = serde_json::from_slice(
+            &directory.read_file(OsStr::new("service-owner.json"), MAX_METADATA as u64)?,
+        )?;
+        let pointer = owner
+            .required_split
+            .as_ref()
+            .context("terminal allocation lacks split owner")?;
+        let previous = capsule(&self.directory, pointer)?.snapshot;
+        ensure!(
+            previous.request == value.request
+                && previous.plan == value.plan
+                && pointer.revision <= value.receipt.revision,
+            "terminal allocation lifecycle differs"
+        );
+        let (capsule_name, owner_name, intent_name) = names(value.receipt.operation_id);
+        let (intent, mut capsule_file, mut owner_file) =
+            match directory.read_file(OsStr::new(&intent_name), INTENT_BYTES) {
+                Ok(bytes) => {
+                    let intent: TerminalSlot = serde_json::from_slice(&bytes)?;
+                    intent.validate_for(state)?;
+                    ensure!(
+                        serde_json::to_vec(&intent)? == bytes
+                            && intent.directory == directory.identity()?,
+                        "terminal allocation record differs"
+                    );
+                    let capsule_file =
+                        directory.open_file(OsStr::new(&capsule_name), SetupFileMode::ReadWrite)?;
+                    let owner_file =
+                        directory.open_file(OsStr::new(&owner_name), SetupFileMode::ReadWrite)?;
+                    ensure!(
+                        file_identity(&capsule_file)? == intent.capsule_file
+                            && file_identity(&owner_file)? == intent.owner_file,
+                        "terminal allocated file identity changed"
+                    );
+                    (intent, capsule_file, owner_file)
+                }
+                Err(error) if absent(&error) => {
+                    let capsule_file = open_initial(&directory, &capsule_name)?;
+                    let owner_file = open_initial(&directory, &owner_name)?;
+                    let intent = TerminalSlot {
+                        schema: 1,
+                        operation: value.receipt.operation_id,
+                        request: value.receipt.request_digest,
+                        index,
+                        registration: registration.clone(),
+                        directory: directory.identity()?,
+                        capsule_file: file_identity(&capsule_file)?,
+                        owner_file: file_identity(&owner_file)?,
+                    };
+                    (intent, capsule_file, owner_file)
+                }
+                Err(error) => return Err(error),
+            };
+        if capsule_file.metadata()?.len() == CAPSULE_BYTES
+            && owner_file.metadata()?.len() == OWNER_BYTES
+        {
+            let receipt = store.reconcile_native_split_metadata(&writer, &quota)?;
+            return Ok((intent, receipt));
+        }
+        let reservation = quota.reserve(
+            &registration.collection,
+            CAPSULE_BYTES + OWNER_BYTES + INTENT_BYTES,
+        )?;
+        let bytes = serde_json::to_vec(&intent)?;
+        ensure!(
+            bytes.len() as u64 <= INTENT_BYTES,
+            "terminal allocation intent exceeds bound"
+        );
+        match directory.read_file(OsStr::new(&intent_name), INTENT_BYTES) {
+            Ok(actual) => ensure!(actual == bytes, "terminal allocation intent changed"),
+            Err(error) if absent(&error) => {
+                let mut file =
+                    directory.open_file(OsStr::new(&intent_name), SetupFileMode::CreateNew)?;
+                file.write_all(&bytes)?;
+                file.sync_all()?;
+            }
+            Err(error) => return Err(error),
+        }
+        allocate(&mut capsule_file, CAPSULE_BYTES)?;
+        allocate(&mut owner_file, OWNER_BYTES)?;
+        directory.sync()?;
+        reservation.charge(CAPSULE_BYTES + OWNER_BYTES + bytes.len() as u64)?;
+        drop(reservation);
+        let receipt = store.reconcile_native_split_metadata(&writer, &quota)?;
+        Ok((intent, receipt))
+    }
+    pub(crate) fn publish_split_terminal_slot(
+        &self,
+        state: &NativeSplitState,
+        intent: &TerminalSlot,
+    ) -> Result<NativeTerminalPublication> {
+        intent.validate_for(state)?;
+        let value = &state.0;
+        ensure!(
+            matches!(
+                value.receipt.state,
+                SplitRunState::Complete
+                    | SplitRunState::CanceledBeforeFence {
+                        cleanup_pending: false
+                    }
+            ),
+            "terminal publication target is not terminal"
+        );
+        ensure!(
+            value.receipt.terminal_publication_slots.get(&intent.index)
+                == Some(&intent.identity()?),
+            "terminal publication allocation differs"
+        );
+        let store = FileStore::new(&self.directory);
+        let writer = store.existing_writer_exclusion()?;
+        let directory = SetupDirectory::open_canonical(&self.directory)?;
+        ensure!(
+            directory.identity()? == intent.directory,
+            "terminal publication directory changed"
+        );
+        let mut old_owner_file =
+            directory.open_file(OsStr::new("service-owner.json"), SetupFileMode::Read)?;
+        let mut old_bytes = Vec::new();
+        (&mut old_owner_file)
+            .take(MAX_METADATA as u64 + 1)
+            .read_to_end(&mut old_bytes)?;
+        ensure!(
+            old_bytes.len() <= MAX_METADATA,
+            "terminal previous owner exceeds bound"
+        );
+        let mut owner: Owner = serde_json::from_slice(&old_bytes)?;
+        ensure!(
+            owner_registration(&owner)? == intent.registration
+                && owner_digest(&owner)? == self.binding,
+            "terminal publication previous owner differs"
+        );
+        let old = owner
+            .required_split
+            .as_ref()
+            .context("terminal publication previous split owner missing")?;
+        let previous = capsule(&self.directory, old)?.snapshot;
+        ensure!(
+            previous.request == value.request && previous.plan == value.plan,
+            "terminal publication previous request differs"
+        );
+        let capsule_bytes = serde_json::to_vec(&Capsule {
+            schema: 1,
+            snapshot: value.clone(),
+        })?;
+        ensure!(
+            capsule_bytes.len() as u64 <= CAPSULE_BYTES,
+            "terminal capsule exceeds prepared allocation"
+        );
+        let digest = framed_digest(b"airk/stable-split-state/1", &[&capsule_bytes]);
+        let target = filename(digest);
+        let (capsule_name, owner_name, intent_name) = intent.names();
+        let capsule_file = match directory.open_file(OsStr::new(&target), SetupFileMode::Read) {
+            Ok(file) => {
+                ensure!(
+                    file_identity(&file)? == intent.capsule_file
+                        && directory.read_file(OsStr::new(&target), CAPSULE_BYTES)?
+                            == capsule_bytes,
+                    "terminal capsule target differs"
+                );
+                file
+            }
+            Err(error) if absent(&error) => {
+                let mut file =
+                    directory.open_file(OsStr::new(&capsule_name), SetupFileMode::ReadWrite)?;
+                ensure!(
+                    file_identity(&file)? == intent.capsule_file,
+                    "terminal capsule allocation changed"
+                );
+                fill(&mut file, &capsule_bytes, CAPSULE_BYTES)?;
+                directory.publish_no_replace(
+                    OsStr::new(&capsule_name),
+                    &file,
+                    &directory,
+                    OsStr::new(&target),
+                )?;
+                file
+            }
+            Err(error) => return Err(error),
+        };
+        let role = if intent.index == value.request.original_index {
+            SplitOwnerRole::OriginalRemainder
+        } else {
+            SplitOwnerRole::Destination
+        };
+        let reference = SplitOwnerReference {
+            required_contract: airk_core::catalog_split::SPLIT_CONTRACT,
+            operation_id: intent.operation,
+            request_digest: intent.request,
+            index_id: intent.index,
+            role,
+            activation_receipt: value.receipt.membership_receipt,
+        };
+        reference.validate_for(&value.request, &value.receipt)?;
+        owner.required_split = Some(SplitOwnerPointer {
+            reference,
+            revision: value.receipt.revision,
+            digest,
+        });
+        let owner_bytes = serde_json::to_vec(&owner)?;
+        ensure!(
+            owner_bytes.len() <= MAX_METADATA,
+            "terminal owner exceeds prepared allocation"
+        );
+        let owner_file = if old_bytes == owner_bytes {
+            ensure!(
+                file_identity(&old_owner_file)? == intent.owner_file,
+                "terminal owner target allocation differs"
+            );
+            old_owner_file
+        } else {
+            let mut file =
+                directory.open_file(OsStr::new(&owner_name), SetupFileMode::ReadWrite)?;
+            ensure!(
+                file_identity(&file)? == intent.owner_file,
+                "terminal owner allocation changed"
+            );
+            fill(&mut file, &owner_bytes, OWNER_BYTES)?;
+            directory.replace_file(
+                OsStr::new(&owner_name),
+                &file,
+                OsStr::new("service-owner.json"),
+                &old_owner_file,
+            )?;
+            file
+        };
+        match directory.open_file(OsStr::new(&intent_name), SetupFileMode::Read) {
+            Ok(file) => directory.unlink_file_if_identity(OsStr::new(&intent_name), &file)?,
+            Err(error) if absent(&error) => (),
+            Err(error) => return Err(error),
+        };
+        directory.sync()?;
+        Ok(NativeTerminalPublication {
+            intent: intent.clone(),
+            receipt: value.receipt_digest,
+            directory,
+            capsule_file,
+            owner_file,
+            _writer: writer,
+            capsule_name: target,
+            capsule_bytes,
+            owner_bytes,
+        })
+    }
+}
+pub(crate) struct NativeTerminalPublication {
+    pub intent: TerminalSlot,
+    pub receipt: Sha256Digest,
+    directory: SetupDirectory,
+    capsule_file: File,
+    owner_file: File,
+    _writer: crate::ExistingWriterExclusion,
+    capsule_name: String,
+    capsule_bytes: Vec<u8>,
+    owner_bytes: Vec<u8>,
+}
+impl NativeTerminalPublication {
+    pub(crate) fn revalidate(&self) -> Result<()> {
+        ensure!(
+            self.directory.identity()? == self.intent.directory
+                && file_identity(&self.capsule_file)? == self.intent.capsule_file
+                && file_identity(&self.owner_file)? == self.intent.owner_file,
+            "terminal publication physical identity differs"
+        );
+        ensure!(
+            self.directory
+                .read_file(OsStr::new(&self.capsule_name), CAPSULE_BYTES)?
+                == self.capsule_bytes
+                && self
+                    .directory
+                    .read_file(OsStr::new("service-owner.json"), MAX_METADATA as u64)?
+                    == self.owner_bytes,
+            "terminal publication bytes changed"
+        );
+        Ok(())
+    }
+}
