+#[cfg(test)]
+mod tests {
+    use super::*;
+    use airk_core::{
+        index_catalog::{CatalogRevision, DenyId, IndexId, PathScope, SourceRootId},
+        source_policy::{DenyReason, DenyRule, POLICY_SCHEMA, SourceRoot},
