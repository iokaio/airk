+// SPDX-License-Identifier: Apache-2.0
+//! Native durable catalog authority fences. Store owns transactions and opaque
+//! absence observations; Core wire validation alone never authenticates workers.
+use super::*;
+pub use airk_core::catalog_fences::{
+    CatalogFenceProof, FenceConfirmation, FenceConfirmationMethod, FenceIntent, FenceObservation,
+    FencePlan, FencePreparation, FencePrepareRejected, FenceStage, FenceTarget, FencedReceipt,
+    WorkerDrainObligation, WorkerFenceConfirmation, WorkerFenceConfirmationMethod,
+    WorkerProviderHistory, WorkerProviderObligation,
+};
+use airk_core::catalog_fences::{validate_confirmations, validate_worker_confirmations};
+
+const KIND: &str = "catalog_management_fenced";
+
+#[cfg(test)]
+#[path = "service_catalog_fence_tests.rs"]
+mod tests;
+
+/// A native read snapshot proving this exact non-evicting operation key has no
+/// receipt and the reviewed catalog is unchanged. This is intentionally not a
+/// wire type: deserializing JSON must never construct native absence authority.
+#[derive(Clone, Debug)]
+pub struct CatalogFenceAbsence {
+    caller: Incarnation,
+    key: RequestKey,
+    request_digest: Sha256Digest,
+    state: super::super::CatalogState,
+}
+impl CatalogFenceAbsence {
+    pub fn validate_for(&self, request: &CatalogRequest) -> Result<()> {
+        ensure!(
+            self.caller == request.caller
+                && self.key == request.key
+                && self.request_digest == request.identity()?
+                && self.state.namespace == request.key.namespace
+                && self.state.revision == request.expected_catalog_revision,
+            "catalog exact absence observation changed"
+        );
+        Ok(())
+    }
+    pub fn catalog_state(&self) -> &super::super::CatalogState {
+        &self.state
+    }
+}
+
+/// Exact unprepared-operation absence observed at a current catalog clock.
+/// Independent native completion may advance that clock; this opaque read
+/// never authorizes a stale request or establishes absence of native effects.
+#[derive(Clone, Debug)]
+pub struct CatalogFenceUnpreparedAbsence {
+    caller: Incarnation,
+    key: RequestKey,
+    request_digest: Sha256Digest,
+    state: super::super::CatalogState,
+}
+impl CatalogFenceUnpreparedAbsence {
+    pub fn validate_for(&self, request: &CatalogRequest) -> Result<()> {
+        ensure!(
+            self.caller == request.caller
+                && self.key == request.key
+                && self.request_digest == request.identity()?
+                && self.state.namespace == request.key.namespace
+                && self.state.revision >= request.expected_catalog_revision
+                && self.state.activated
+                && self.state.authority_contract == 1
+                && self.state.policy_contract <= super::super::SUPPORTED_POLICY_CONTRACT,
+            "catalog unprepared absence observation changed"
+        );
+        Ok(())
+    }
+    pub fn catalog_state(&self) -> &super::super::CatalogState {
+        &self.state
+    }
+}
+
+/// Admission-free native diagnostic inspection. A metadata receipt which still
+/// requires an authority fence is not evidence of completed native fencing.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum CatalogSavedObservation {
+    Fence(Box<FenceObservation>),
+    Metadata(CatalogReceipt),
+}
+
+pub(super) fn observation(
+    db: &Connection,
+    caller: Incarnation,
+    key: &RequestKey,
+) -> Result<Option<FenceObservation>> {
+    let row: Option<(String, i64, Vec<u8>)> = db.query_row("SELECT stage,revision,substr(payload,1,16385) FROM index_operation_receipts WHERE id=?1 AND kind=?2", params![operation_id(caller,key)?.to_string(),KIND], |row| Ok((row.get(0)?,row.get(1)?,row.get(2)?))).optional()?;
+    let Some((stage, revision, bytes)) = row else {
+        return Ok(None);
+    };
+    ensure!(
+        bytes.len() <= MAX_RECEIPT_BYTES,
+        "catalog fence receipt exceeds bound"
+    );
+    let result = if stage == "metadata_applied" {
+        let receipt: FencedReceipt = serde_json::from_slice(&bytes)?;
+        receipt.validate()?;
+        ensure!(
+            receipt.metadata.caller == caller
+                && receipt.metadata.key == *key
+                && number(receipt.metadata.catalog_revision) == revision,
+            "catalog fence receipt owner conflict"
+        );
+        FenceObservation::Applied(receipt)
+    } else {
+        let intent: FenceIntent = serde_json::from_slice(&bytes)?;
+        intent.validate()?;
+        ensure!(
+            intent.request.caller == caller
+                && intent.request.key == *key
+                && number(intent.request.expected_catalog_revision) == revision
+                && stage == intent.stage.as_str(),
+            "catalog fence intent owner/stage conflict"
+        );
+        FenceObservation::Pending(intent)
+    };
+    Ok(Some(result))
+}
+pub(super) fn require_no_pending(db: &Connection) -> Result<()> {
+    let pending: bool = db.query_row("SELECT EXISTS(SELECT 1 FROM index_operation_receipts WHERE kind=?1 AND stage<>'metadata_applied')", [KIND], |row| row.get(0))?;
+    ensure!(
+        !pending,
+        "catalog mutation blocked by pending native authority fence"
+    );
+    Ok(())
+}
+fn require_exact_pending(db: &Connection, id: Incarnation) -> Result<()> {
+    let (count,first):(i64,String) = db.query_row("SELECT count(*),coalesce(min(id),'') FROM index_operation_receipts WHERE kind=?1 AND stage<>'metadata_applied'",[KIND],|row|Ok((row.get(0)?,row.get(1)?)))?;
+    ensure!(
+        count == 1 && first == id.to_string(),
+        "catalog pending fence set changed"
+    );
+    Ok(())
+}
+fn replace_intent(db: &Connection, before: &FenceIntent, after: &FenceIntent) -> Result<()> {
+    after.validate()?;
+    changed(db.execute("UPDATE index_operation_receipts SET stage=?1,payload=?2 WHERE id=?3 AND kind=?4 AND stage=?5 AND payload=?6", params![after.stage.as_str(),serde_json::to_vec(after)?,after.operation_id.to_string(),KIND,before.stage.as_str(),serde_json::to_vec(before)?])?)
+}
+fn confirmed_stage(intent: &FenceIntent) -> FenceStage {
+    if intent.confirmations.len() == intent.plan.targets.len()
+        && intent.worker_confirmations.len()
+            == intent
+                .plan
+                .worker_obligation
+                .as_ref()
+                .map_or(0, |o| o.workers.len())
+    {
+        FenceStage::Fenced
+    } else {
+        FenceStage::FenceUnknown
+    }
+}
+impl ServiceRegistry {
+    /// Inspect the complete durable lane before reasoning about a retained
+    /// never-prepared request. Old epochs may be observed, never newly admitted.
+    /// Only a successful ANY-kind receipt lookup can establish exact absence;
+    /// unsupported kinds, corrupt rows and database errors remain errors.
+    pub fn catalog_saved_observation(
+        &self,
+        caller: Incarnation,
+        key: &RequestKey,
+    ) -> Result<Option<CatalogSavedObservation>> {
+        let tx = self.connection.unchecked_transaction()?;
+        let current = ready(&tx)?;
+        ensure!(
+            current.namespace == key.namespace,
+            "catalog saved observation namespace changed"
+        );
+        let kind: Option<String> = tx
+            .query_row(
+                "SELECT substr(kind,1,65) FROM index_operation_receipts WHERE id=?1",
+                [operation_id(caller, key)?.to_string()],
+                |row| row.get(0),
+            )
+            .optional()?;
+        match kind.as_deref() {
+            None => Ok(None),
+            Some(KIND) => Ok(Some(CatalogSavedObservation::Fence(Box::new(
+                observation(&tx, caller, key)?.context("catalog fence receipt disappeared")?,
+            )))),
+            Some("catalog_management") => Ok(Some(CatalogSavedObservation::Metadata(
+                saved(&tx, caller, key)?.context("catalog metadata receipt disappeared")?,
+            ))),
+            Some(_) => anyhow::bail!("catalog operation key belongs to another receipt kind"),
+        }
+    }
+    /// Native reconciliation only. This checks exact receipt absence without
+    /// admitting an expired request key or advancing its epoch. The accepted
+    /// metadata actor must separately retain its closed gate and prove no native
+    /// effects; neither a generic error nor this snapshot alone reopens issuance.
+    pub fn catalog_fence_absence(&self, request: &CatalogRequest) -> Result<CatalogFenceAbsence> {
+        request.validate()?;
+        let tx = self.connection.unchecked_transaction()?;
+        let current = ready(&tx)?;
+        ensure!(
+            current.namespace == request.key.namespace
+                && current.revision == request.expected_catalog_revision,
+            "catalog preparation observation changed"
+        );
+        let exists: bool = tx.query_row(
+            "SELECT EXISTS(SELECT 1 FROM index_operation_receipts WHERE id=?1)",
+            [operation_id(request.caller, &request.key)?.to_string()],
+            |row| row.get(0),
+        )?;
+        ensure!(!exists, "catalog preparation receipt is not absent");
+        require_no_pending(&tx)?;
+        // An independent setup is not this operation's authority fence. Its
+        // index remains unavailable for grants until ready, while exact absence
+        // may safely reopen unaffected issuance after a zero-effect rejection.
+        Ok(CatalogFenceAbsence {
+            caller: request.caller,
+            key: request.key.clone(),
+            request_digest: request.identity()?,
+            state: current,
+        })
+    }
+    /// Native reconciliation read for a never-prepared exact request whose
+    /// reviewed clock may precede an independent native completion. Bypass of
+    /// epoch admission applies only to this read; no request, receipt or epoch
+    /// is written, and the native coordinator must retain its closed gate.
+    pub fn catalog_fence_unprepared_absence(
+        &self,
+        request: &CatalogRequest,
+    ) -> Result<CatalogFenceUnpreparedAbsence> {
+        request.validate()?;
+        let tx = self.connection.unchecked_transaction()?;
+        let current = ready(&tx)?;
+        ensure!(
+            current.namespace == request.key.namespace
+                && current.revision >= request.expected_catalog_revision
+                && current.authority_contract == 1
+                && current.policy_contract <= super::super::SUPPORTED_POLICY_CONTRACT,
+            "catalog unprepared absence namespace, revision or contract changed"
+        );
+        let exists: bool = tx.query_row(
+            "SELECT EXISTS(SELECT 1 FROM index_operation_receipts WHERE id=?1)",
+            [operation_id(request.caller, &request.key)?.to_string()],
+            |row| row.get(0),
+        )?;
+        ensure!(!exists, "catalog preparation receipt is not absent");
+        require_no_pending(&tx)?;
+        Ok(CatalogFenceUnpreparedAbsence {
+            caller: request.caller,
+            key: request.key.clone(),
+            request_digest: request.identity()?,
+            state: current,
+        })
+    }
+    /// Native-only admission. The coordinator must already have closed issuance
+    /// and captured its complete exact-worker target census, including installs.
+    pub fn catalog_prepare_fence(
+        &mut self,
+        request: &CatalogRequest,
+        preview_digest: Sha256Digest,
+        plan: &FencePlan,
+    ) -> Result<FencePreparation> {
+        request.validate()?;
+        plan.validate()?;
+        let tx = self
+            .connection
+            .transaction_with_behavior(TransactionBehavior::Immediate)?;
+        ready(&tx)?;
+        if let Some(saved) = observation(&tx, request.caller, &request.key)? {
+            return match saved {
+                FenceObservation::Applied(receipt) => {
+                    ensure!(
+                        receipt.metadata.request_digest == request.identity()?
+                            && receipt.preview_digest == preview_digest,
+                        "catalog request key conflict"
+                    );
+                    Ok(FencePreparation::Replay(receipt))
+                }
+                FenceObservation::Pending(intent) => {
+                    require_exact_pending(&tx, intent.operation_id)?;
+                    ensure!(
+                        intent.request == *request
+                            && intent.preview_digest == preview_digest
+                            && intent.plan == *plan,
+                        "catalog request key conflict"
+                    );
+                    Ok(FencePreparation::Prepared(intent))
+                }
+            };
+        }
+        if let Some(receipt) = saved(&tx, request.caller, &request.key)? {
+            ensure!(
+                receipt.request_digest == request.identity()?,
+                "catalog request key conflict"
+            );
+            anyhow::bail!("metadata-only catalog receipt has no verified native fence");
+        }
+        require_no_pending(&tx)?;
+        plan.validate_for(request)?;
+        if let Some(obligation) = &plan.worker_obligation {
+            let CatalogItem::Index(index) =
+                item(&tx, CatalogKind::Indexes, &obligation.index_id.to_string())?
+            else {
+                anyhow::bail!("catalog worker obligation index unavailable");
+            };
+            ensure!(
+                index.backing.binding == obligation.backing,
+                "catalog worker obligation backing changed"
+            );
+        }
+        // This known rejection is safe only before the durable fence exists.
+        // Reserved-apply failures must retain their outcome-unknown semantics.
+        let reviewed = preview(&tx, request, &self.root).map_err(|error| {
+            if error.is::<airk_core::catalog_source_change::SourceChangeBusy>() {
+                error.context(FencePrepareRejected::SourceBusy)
+            } else {
+                error
+            }
+        })?;
+        ensure!(
+            reviewed.authority_fence_required,
+            "catalog native fence unnecessary"
+        );
+        ensure!(
+            reviewed.identity()? == preview_digest,
+            FencePrepareRejected::StaleReview
+        );
+        let mut intent = FenceIntent {
+            schema: 1,
+            operation_id: operation_id(request.caller, &request.key)?,
+            request: request.clone(),
+            preview_digest,
+            prepared_digest: Sha256Digest::from_bytes([0; 32]),
+            plan: plan.clone(),
+            stage: FenceStage::Prepared,
+            confirmations: Vec::new(),
+            worker_confirmations: Vec::new(),
+        };
+        intent.prepared_digest = intent.identity()?;
+        ensure!(
+            serde_json::to_vec(&intent)?.len() <= MAX_RECEIPT_BYTES,
+            FencePrepareRejected::Capacity
+        );
+        intent.validate()?;
+        // Reserve the complete longest-method confirmation state, retaining
+        // every captured provider helper generation in its obligation, BEFORE
+        // worker side effects; never discover a full receipt after revocation.
+        let mut completed = intent.clone();
+        completed.stage = FenceStage::Fenced;
+        completed.confirmations = completed
+            .plan
+            .targets
+            .iter()
+            .map(|target| FenceConfirmation {
+                target: target.clone(),
+                method: FenceConfirmationMethod::NativeWorkerReap,
+            })
+            .collect();
+        completed.worker_confirmations = completed
+            .plan
+            .worker_obligation
+            .as_ref()
+            .map(|obligation| {
+                obligation
+                    .workers
+                    .iter()
+                    .map(|worker| WorkerFenceConfirmation {
+                        worker: *worker,
+                        method: WorkerFenceConfirmationMethod::NativeWorkerReap,
+                    })
+                    .collect()
+            })
+            .unwrap_or_default();
+        ensure!(
+            serde_json::to_vec(&completed)?.len() <= MAX_RECEIPT_BYTES,
+            FencePrepareRejected::Capacity
+        );
+        completed.validate()?;
+        let terminal = FencedReceipt {
+            request: request.clone(),
+            metadata: CatalogReceipt {
+                schema: 1,
+                operation_id: intent.operation_id,
+                caller: request.caller,
+                key: request.key.clone(),
+                request_digest: request.identity()?,
+                catalog_revision: reviewed.next_revision,
+                authority_fence_required: true,
+            },
+            preview_digest,
+            prepared_digest: intent.prepared_digest,
+            proof: CatalogFenceProof::from_intent(&completed)?,
+        };
+        ensure!(
+            serde_json::to_vec(&terminal)?.len() <= MAX_RECEIPT_BYTES,
+            FencePrepareRejected::Capacity
+        );
+        terminal.validate()?;
+        super::super::source_change::reserve_completion_slot(&tx, request)?;
+        tx.execute(
+            "INSERT INTO index_operation_receipts VALUES(?1,?2,'prepared',?3,?4)",
+            params![
+                intent.operation_id.to_string(),
+                KIND,
+                number(request.expected_catalog_revision),
+                serde_json::to_vec(&intent)?
+            ],
+        )?;
+        tx.commit()?;
+        Ok(FencePreparation::Prepared(intent))
+    }
+    /// Reconciliation read preserves prepared/fenced/unknown stages; it never
+    /// mistakes an intent for successful metadata or repeats a worker command.
+    pub fn catalog_fence_observation(
+        &self,
+        caller: Incarnation,
+        key: &RequestKey,
+    ) -> Result<Option<FenceObservation>> {
+        ready(&self.connection)?;
+        let result = observation(&self.connection, caller, key)?;
+        if result.is_none() {
+            current_key(&self.connection, key)?;
+        }
+        Ok(result)
+    }
+    /// At most one pending mutation is admitted. Startup uses this bounded read
+    /// before exposing Health/Connect; none of these APIs starts normal admission.
+    pub fn catalog_pending_fence(&self) -> Result<Option<FenceIntent>> {
+        ready(&self.connection)?;
+        let mut stmt = self.connection.prepare("SELECT substr(payload,1,16385) FROM index_operation_receipts WHERE kind=?1 AND stage<>'metadata_applied' ORDER BY id LIMIT 2")?;
+        let rows = stmt
+            .query_map([KIND], |row| row.get::<_, Vec<u8>>(0))?
+            .collect::<rusqlite::Result<Vec<_>>>()?;
+        ensure!(rows.len() <= 1, "multiple pending catalog fences");
+        let Some(bytes) = rows.into_iter().next() else {
+            return Ok(None);
+        };
+        ensure!(
+            bytes.len() <= MAX_RECEIPT_BYTES,
+            "catalog fence intent exceeds bound"
+        );
+        let intent: FenceIntent = serde_json::from_slice(&bytes)?;
+        intent.validate()?;
+        let observed = observation(&self.connection, intent.request.caller, &intent.request.key)?;
+        ensure!(
+            observed == Some(FenceObservation::Pending(intent.clone())),
+            "catalog pending fence identity conflict"
+        );
+        Ok(Some(intent))
+    }
+    /// Native coordinator records exact scope acknowledgements or observed native
+    /// worker reaping. A timeout/EOF is NOT either proof; retain partial progress.
+    pub fn catalog_record_fence_confirmations(
+        &mut self,
+        caller: Incarnation,
+        key: &RequestKey,
+        prepared_digest: Sha256Digest,
+        confirmations: &[FenceConfirmation],
+    ) -> Result<FenceIntent> {
+        let tx = self
+            .connection
+            .transaction_with_behavior(TransactionBehavior::Immediate)?;
+        ready(&tx)?;
+        let before = match observation(&tx, caller, key)? {
+            Some(FenceObservation::Pending(intent)) => intent,
+            _ => anyhow::bail!("catalog pending fence unavailable"),
+        };
+        ensure!(
+            before.prepared_digest == prepared_digest,
+            "catalog prepared fence changed"
+        );
+        require_exact_pending(&tx, before.operation_id)?;
+        validate_confirmations(&before.plan, confirmations)?;
+        ensure!(
+            before
+                .confirmations
+                .iter()
+                .all(|old| confirmations.iter().any(|new| new.target == old.target)),
+            "catalog fence confirmations cannot regress"
+        );
+        let mut after = before.clone();
+        after.confirmations = confirmations
+            .iter()
+            .map(|confirmation| {
+                // A later process reap may confirm the same target already fenced by
+                // an acknowledged scope command. Preserve the first actual method.
+                before
+                    .confirmations
+                    .iter()
+                    .find(|old| old.target == confirmation.target)
+                    .unwrap_or(confirmation)
+                    .clone()
+            })
+            .collect();
+        after.stage = confirmed_stage(&after);
+        replace_intent(&tx, &before, &after)?;
+        tx.commit()?;
+        Ok(after)
+    }
+    /// Native coordinator records actual mutating-worker reaps independently
+    /// from scope revocation. Caller cancellation, EOF or a scope ACK is no reap.
+    pub fn catalog_record_worker_fence_confirmations(
+        &mut self,
+        caller: Incarnation,
+        key: &RequestKey,
+        prepared_digest: Sha256Digest,
+        confirmations: &[WorkerFenceConfirmation],
+    ) -> Result<FenceIntent> {
+        let tx = self
+            .connection
+            .transaction_with_behavior(TransactionBehavior::Immediate)?;
+        ready(&tx)?;
+        let before = match observation(&tx, caller, key)? {
+            Some(FenceObservation::Pending(intent)) => intent,
+            _ => anyhow::bail!("catalog pending fence unavailable"),
+        };
+        ensure!(
+            before.prepared_digest == prepared_digest,
+            "catalog prepared fence changed"
+        );
+        require_exact_pending(&tx, before.operation_id)?;
+        validate_worker_confirmations(&before.plan, confirmations)?;
+        ensure!(
+            before
+                .worker_confirmations
+                .iter()
+                .all(|old| confirmations.iter().any(|new| new.worker == old.worker)),
+            "catalog worker confirmations cannot regress"
+        );
+        let mut after = before.clone();
+        after.worker_confirmations = confirmations
+            .iter()
+            .map(|confirmation| {
+                before
+                    .worker_confirmations
+                    .iter()
+                    .find(|old| old.worker == confirmation.worker)
+                    .unwrap_or(confirmation)
+                    .clone()
+            })
+            .collect();
+        after.stage = confirmed_stage(&after);
+        replace_intent(&tx, &before, &after)?;
+        tx.commit()?;
+        Ok(after)
+    }
+    /// Commit only after every captured exact-worker target has a confirmation.
+    /// Metadata and terminal proof replace the one reserved receipt atomically.
+    pub fn catalog_apply_fenced(
+        &mut self,
+        request: &CatalogRequest,
+        preview_digest: Sha256Digest,
+        prepared_digest: Sha256Digest,
+    ) -> Result<FencedReceipt> {
+        request.validate()?;
+        self.catalog_split_seal_pending_original(request)?;
+        let tx = self
+            .connection
+            .transaction_with_behavior(TransactionBehavior::Immediate)?;
+        ready(&tx)?;
+        let intent = match observation(&tx, request.caller, &request.key)? {
+            Some(FenceObservation::Applied(receipt)) => {
+                ensure!(
+                    receipt.metadata.request_digest == request.identity()?
+                        && receipt.preview_digest == preview_digest
+                        && receipt.prepared_digest == prepared_digest,
+                    "catalog request key conflict"
+                );
+                return Ok(receipt);
+            }
+            Some(FenceObservation::Pending(intent)) => intent,
+            None => anyhow::bail!("catalog prepared fence unavailable"),
+        };
+        ensure!(
+            intent.request == *request
+                && intent.preview_digest == preview_digest
+                && intent.prepared_digest == prepared_digest,
+            "catalog request key conflict"
+        );
+        let proof = CatalogFenceProof::from_intent(&intent)?;
+        require_exact_pending(&tx, intent.operation_id)?;
+        let reviewed = preview_reserved(&tx, request, Some(intent.operation_id), &self.root)?;
+        ensure!(
+            reviewed.identity()? == preview_digest,
+            "catalog fenced review changed"
+        );
+        let receipt = FencedReceipt {
+            request: request.clone(),
+            metadata: CatalogReceipt {
+                schema: 1,
+                operation_id: intent.operation_id,
+                caller: request.caller,
+                key: request.key.clone(),
+                request_digest: request.identity()?,
+                catalog_revision: reviewed.next_revision,
+                authority_fence_required: true,
+            },
+            preview_digest,
+            prepared_digest,
+            proof,
+        };
+        receipt.validate_for(request, preview_digest, prepared_digest, &intent.plan)?;
+        changed(tx.execute("UPDATE index_operation_receipts SET stage='metadata_applied',revision=?1,payload=?2 WHERE id=?3 AND kind=?4 AND stage='fenced' AND payload=?5", params![number(receipt.metadata.catalog_revision),serde_json::to_vec(&receipt)?,intent.operation_id.to_string(),KIND,serde_json::to_vec(&intent)?])?)?;
+        mutate(&tx, request, &self.root)?;
+        changed(tx.execute(
+            "UPDATE index_catalog_meta SET revision=?1 WHERE id=1 AND revision=?2",
+            params![
+                number(receipt.metadata.catalog_revision),
+                number(request.expected_catalog_revision)
+            ],
+        )?)?;
+        tx.commit()?;
+        Ok(receipt)
+    }
+}
diff --git a/crates/airk-store/src/service_catalog_genesis.rs b/crates/airk-store/src/service_catalog_genesis.rs
new file mode 100644
index 0000000..7155965
--- /dev/null
+++ b/crates/airk-store/src/service_catalog_genesis.rs
@@ -0,0 +1,725 @@
+// SPDX-License-Identifier: Apache-2.0
+//! Empty-registry genesis and separately qualified authority-1 activation.
+//! This never fabricates P5 predecessor readiness, grants access or scans sources.
+use super::{backup, upgrade};
+use crate::service::{EmbeddingLease, ProjectLease, ServiceLease, SourceWatchLease};
+use airk_core::{
+    identity::{Incarnation, Sha256Digest},
+    index_catalog::encoded_size,
+};
+use anyhow::{Context, Result, ensure};
+use rusqlite::{Connection, OpenFlags, TransactionBehavior, params};
+use serde::{Deserialize, Serialize};
+use std::{
+    fs,
+    io::{Read, Write},
+    path::{Path, PathBuf},
+    time::Duration,
+};
+
+const DATABASE: &str = "service-1.4.sqlite3";
+const INTENT: &str = "index-catalog-genesis.json";
+const MAX_RECEIPT_BYTES: usize = 16384;
+
+#[path = "service_catalog_activation.rs"]
+pub mod activation;
+pub use activation::observe_authority_v1;
+#[path = "service_catalog_genesis_origin.rs"]
+mod origin;
+pub use origin::{ManagedGenesisOrigin, preflight_managed_origin};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum GenesisStage {
+    Admitted,
+    BackedUp,
+    Migrating,
+    Migrated,
+    Promoting,
+    Promoted,
+    Qualified,
+    Activating,
+    Settled,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct GenesisReceipt {
+    pub schema: u32,
+    pub root: PathBuf,
+    pub namespace: Incarnation,
+    pub operation: Incarnation,
+    pub installer_identity: Sha256Digest,
+    pub legacy_schema_digest: Sha256Digest,
+    pub legacy_data_digest: Sha256Digest,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub coordinator_origin: Option<ManagedGenesisOrigin>,
+    pub stage: GenesisStage,
+    pub backups: Vec<backup::BackupAttempt>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub authority_v1: Option<activation::AuthorityV1ActivationRecord>,
+}
+
+impl GenesisReceipt {
+    fn validate(&self, root: &Path) -> Result<()> {
+        if let Some(origin) = &self.coordinator_origin {
+            origin.require_binding(
+                root,
+                self.namespace,
+                self.installer_identity,
+                self.operation,
+            )?;
+        }
+        ensure!(
+            self.schema == 1 && self.root == root && root.is_absolute(),
+            "foreign catalog genesis intent"
+        );
+        ensure!(
+            self.backups.len() <= backup::MAX_ATTEMPTS,
+            "genesis backup capacity exceeded"
+        );
+        let mut complete = 0;
+        for (slot, attempt) in self.backups.iter().enumerate() {
+            attempt.validate()?;
+            ensure!(
+                usize::from(attempt.slot) == slot,
+                "noncanonical genesis backup slot"
+            );
+            complete += usize::from(attempt.complete);
+        }
+        ensure!(complete <= 1, "ambiguous genesis backup selection");
+        ensure!(
+            self.stage == GenesisStage::Admitted || complete == 1,
+            "genesis stage lacks a qualified backup"
+        );
+        encoded_size(self, MAX_RECEIPT_BYTES)?;
+        if let Some(record) = &self.authority_v1 {
+            activation::validate_genesis_record(self, record)?;
+        }
+        ensure!(
+            !matches!(
+                self.stage,
+                GenesisStage::Qualified | GenesisStage::Activating | GenesisStage::Settled
+            ) || self.authority_v1.is_some(),
+            "genesis authority-1 qualification missing"
+        );
+        Ok(())
+    }
+
+    fn same_intent(&self, other: &Self) -> bool {
+        self.schema == other.schema
+            && self.root == other.root
+            && self.namespace == other.namespace
+            && self.operation == other.operation
+            && self.installer_identity == other.installer_identity
+            && self.legacy_schema_digest == other.legacy_schema_digest
+            && self.legacy_data_digest == other.legacy_data_digest
+            && self.coordinator_origin == other.coordinator_origin
+    }
+}
+
+fn exists(path: &Path) -> Result<bool> {
+    match fs::symlink_metadata(path) {
+        Ok(_) => Ok(true),
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(false),
+        Err(error) => Err(error.into()),
+    }
+}
+
+/// Positive native read of the exact completed managed operation. A saved
+/// `Settled` label alone never permits normal service startup.
+pub fn require_managed_settled(root: &Path, origin: &ManagedGenesisOrigin) -> Result<()> {
+    let receipt = pending(root)?.context("managed catalog admission must be resumed")?;
+    ensure!(
+        receipt.coordinator_origin.as_ref() == Some(origin)
+            && receipt.stage == GenesisStage::Settled,
+        "managed catalog operation is not settled"
+    );
+    activation::validate_live_completed_genesis(root, &receipt)
+}
+
+/// Read only the bounded saved intent. This neither acquires ownership nor
+/// opens/initializes SQLite; callers still need the owned genesis adapter.
+pub fn pending(root: &Path) -> Result<Option<GenesisReceipt>> {
+    let root = root.canonicalize()?;
+    let path = root.join(INTENT);
+    let metadata = match fs::symlink_metadata(&path) {
+        Ok(metadata) => metadata,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+        Err(error) => return Err(error.into()),
+    };
+    crate::managed_collection::reject_file_aliases(&path, &metadata)?;
+    ensure!(
+        metadata.len() <= MAX_RECEIPT_BYTES as u64,
+        "genesis intent exceeds bound"
+    );
+    let file = fs::File::open(&path)?;
+    crate::managed_collection::reject_file_aliases(&path, &file.metadata()?)?;
+    let mut bytes = Vec::new();
+    file.take(MAX_RECEIPT_BYTES as u64 + 1)
+        .read_to_end(&mut bytes)?;
+    ensure!(
+        bytes.len() <= MAX_RECEIPT_BYTES,
+        "genesis intent grew beyond bound"
+    );
+    let receipt: GenesisReceipt = serde_json::from_slice(&bytes)?;
+    receipt.validate(&root)?;
+    Ok(Some(receipt))
+}
+
+fn persist(receipt: &GenesisReceipt, initial: bool) -> Result<()> {
+    receipt.validate(&receipt.root)?;
+    ensure!(
+        receipt.root.canonicalize()? == receipt.root,
+        "redirected genesis root"
+    );
+    let path = receipt.root.join(INTENT);
+    if !initial {
+        let previous = pending(&receipt.root)?.context("genesis intent disappeared")?;
+        ensure!(
+            receipt.same_intent(&previous),
+            "genesis intent was replaced"
+        );
+    }
+    let mut temporary = tempfile::NamedTempFile::new_in(&receipt.root)?;
+    temporary.write_all(&serde_json::to_vec(receipt)?)?;
+    if initial {
+        temporary.as_file().sync_all()?;
+        temporary.persist_noclobber(path)?;
+        crate::maintenance::sync_parent(&receipt.root)
+    } else {
+        crate::durability::persist_synced(temporary, &path)
+    }
+}
+
+fn no_competing_upgrade(root: &Path) -> Result<()> {
+    ensure!(
+        !exists(&root.join("index-catalog-upgrade.json"))?,
+        "existing catalog upgrade requires its original recovery path"
+    );
+    super::super::data_relocation::require_settled(root)
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum GenesisAdmission {
+    Fenced,
+    Committed,
+}
+
+fn admission(root: &Path, receipt: &GenesisReceipt) -> Result<GenesisAdmission> {
+    no_competing_upgrade(root)?;
+    let owner = super::super::owner_record(root, true, receipt.namespace)?;
+    ensure!(
+        owner.ready && owner.format == 2 && owner.incarnation == receipt.namespace,
+        "genesis native owner identity changed"
+    );
+    if owner.catalog_upgrade == Some(receipt.operation) {
+        return Ok(GenesisAdmission::Fenced);
+    }
+    if owner.catalog_upgrade.is_none()
+        && matches!(
+            receipt.stage,
+            GenesisStage::Activating | GenesisStage::Settled
+        )
+    {
+        activation::validate_completed_genesis(root, receipt)?;
+        return Ok(GenesisAdmission::Committed);
+    }
+    anyhow::bail!("genesis admission fence changed")
+}
+
+fn require_fence(root: &Path, receipt: &GenesisReceipt) -> Result<()> {
+    ensure!(
+        admission(root, receipt)? == GenesisAdmission::Fenced,
+        "genesis mutation/recovery requires its exact pending native fence"
+    );
+    Ok(())
+}
+
+fn refuse_overlays(root: &Path) -> Result<()> {
+    for suffix in ["-wal", "-shm", "-journal"] {
+        ensure!(
+            !exists(&root.join(format!("{DATABASE}{suffix}")))?,
+            "unrecovered genesis registry overlay"
+        );
+    }
+    Ok(())
+}
+
+fn registry(root: &Path, write: bool) -> Result<Connection> {
+    refuse_overlays(root)?;
+    let path = upgrade::validate_registry_files(root)?;
+    let connection = Connection::open_with_flags(
+        path,
+        if write {
+            OpenFlags::SQLITE_OPEN_READ_WRITE
+        } else {
+            OpenFlags::SQLITE_OPEN_READ_ONLY
+        },
+    )?;
+    connection.busy_timeout(Duration::from_millis(100))?;
+    connection.execute_batch("PRAGMA foreign_keys=ON; PRAGMA cache_size=-8192;")?;
+    if write {
+        connection.execute_batch("PRAGMA synchronous=FULL; PRAGMA max_page_count=8192;")?;
+    } else {
+        connection.execute_batch("PRAGMA query_only=ON;")?;
+    }
+    let application: i64 =
+        connection.pragma_query_value(None, "application_id", |row| row.get(0))?;
+    ensure!(
+        application == super::super::APPLICATION,
+        "foreign genesis registry"
+    );
+    Ok(connection)
+}
+
+/// An empty catalog is not inferred from an empty projects list: history,
+/// requests, lifecycle changes and consumed AUTOINCREMENT sequences also refuse.
+fn empty_legacy(connection: &Connection, namespace: Incarnation) -> Result<()> {
+    for object in super::expected(11)?
+        .iter()
+        .filter(|object| object.kind == "table")
+    {
+        if matches!(
+            object.name.as_str(),
+            "service_meta" | "service_lifecycle_state"
+        ) {
+            continue;
+        }
+        let empty: bool = connection.query_row(
+            &format!(
+                "SELECT NOT EXISTS(SELECT 1 FROM \"{}\" LIMIT 1)",
+                object.name
+            ),
+            [],
+            |row| row.get(0),
+        )?;
+        ensure!(
+            empty,
+            "populated registry requires the real catalog upgrade"
+        );
+    }
+    let meta: (i64, String, i64, i64) = connection.query_row(
+        "SELECT id,incarnation,revision,request_epoch FROM service_meta",
+        [],
+        |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?, row.get(3)?)),
+    )?;
+    let lifecycle: (i64, i64, Option<String>) = connection.query_row(
+        "SELECT id,stopped,instance FROM service_lifecycle_state",
+        [],
+        |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?)),
+    )?;
+    let singleton_counts: (i64, i64) = connection.query_row(
+        "SELECT (SELECT count(*) FROM service_meta),(SELECT count(*) FROM service_lifecycle_state)",
+        [],
+        |row| Ok((row.get(0)?, row.get(1)?)),
+    )?;
+    let sequences: i64 =
+        connection.query_row("SELECT count(*) FROM sqlite_sequence", [], |row| row.get(0))?;
+    ensure!(
+        meta == (1, namespace.to_string(), 0, 0)
+            && lifecycle == (1, 0, None)
+            && singleton_counts == (1, 1)
+            && sequences == 0,
+        "changed registry singleton/history requires the real catalog upgrade"
+    );
+    Ok(())
+}
+
+fn verify_legacy(connection: &Connection, receipt: &GenesisReceipt) -> Result<()> {
+    let version: u32 = connection.pragma_query_value(None, "user_version", |row| row.get(0))?;
+    ensure!(
+        version == 11
+            && matches!(
+                receipt.stage,
+                GenesisStage::Admitted | GenesisStage::BackedUp | GenesisStage::Migrating
+            ),
+        "genesis requires its canonical schema 11 source"
+    );
+    super::validate_shape(connection, 11)?;
+    empty_legacy(connection, receipt.namespace)?;
+    ensure!(
+        super::schema_digest(connection)? == receipt.legacy_schema_digest
+            && backup::legacy_data_digest(connection)? == receipt.legacy_data_digest,
+        "genesis source changed after admission"
+    );
+    Ok(())
+}
+
+/// Owns the same exclusion order as legacy upgrades. Dropping this adapter does
+/// not clear its durable admission fence. Ordinary runtime admission requires
+/// the separate native producer qualification and authority-1 settlement.
+pub struct CatalogGenesis {
+    root: PathBuf,
+    intent: GenesisReceipt,
+    _workers: Vec<ProjectLease>,
+    _watcher: SourceWatchLease,
+    _embedding: EmbeddingLease,
+    service: ServiceLease,
+}
+
+impl CatalogGenesis {
+    pub fn begin(
+        service: ServiceLease,
+        installer: Sha256Digest,
+        operation: Incarnation,
+    ) -> Result<Self> {
+        Self::begin_with_origin(service, installer, operation, None)
+    }
+
+    /// Native managed admission. Origin bytes identify the exact reservation;
+    /// the caller still owns payload approval and actual process quiescence.
+    pub fn begin_managed(service: ServiceLease, origin: &ManagedGenesisOrigin) -> Result<Self> {
+        origin.require_binding(
+            service.root(),
+            origin.namespace,
+            origin.installer_identity,
+            origin.operation,
+        )?;
+        Self::begin_with_origin(
+            service,
+            origin.installer_identity,
+            origin.operation,
+            Some(origin.clone()),
+        )
+    }
+
+    fn begin_with_origin(
+        service: ServiceLease,
+        installer: Sha256Digest,
+        operation: Incarnation,
+        coordinator_origin: Option<ManagedGenesisOrigin>,
+    ) -> Result<Self> {
+        let root = service.root().to_path_buf();
+        ensure!(
+            root.canonicalize()? == root,
+            "redirected genesis control root"
+        );
+        no_competing_upgrade(&root)?;
+        let embedding = EmbeddingLease::acquire(&root)?;
+        let watcher = SourceWatchLease::acquire(&root)?;
+        let workers = upgrade::genesis_worker_leases(&root)?;
+        let saved = pending(&root)?;
+        let intent = if let Some(receipt) = saved {
+            ensure!(
+                receipt.operation == operation && receipt.installer_identity == installer,
+                "genesis belongs to another operation or installer"
+            );
+            ensure!(
+                receipt.coordinator_origin == coordinator_origin,
+                "genesis coordinator origin changed"
+            );
+            receipt
+        } else {
+            refuse_overlays(&root)?;
+            let existing = exists(&root.join(DATABASE))?;
+            let registry = if existing {
+                // Never migrate an existing registry merely to ask if it is empty.
+                super::super::ServiceRegistry::open_saved(&root)?
+            } else {
+                // Existing ready/protected owner with a missing database refuses
+                // inside the canonical initializer; it is never recreated here.
+                super::super::ServiceRegistry::open(&root, operation)?
+            };
+            let namespace = registry.incarnation()?;
+            if let Some(origin) = &coordinator_origin {
+                origin.require_binding(&root, namespace, installer, operation)?;
+            }
+            let version: u32 =
+                registry
+                    .connection
+                    .pragma_query_value(None, "user_version", |row| row.get(0))?;
+            ensure!(
+                version == 11,
+                "fresh genesis refuses an existing catalog or earlier registry format"
+            );
+            super::validate_shape(&registry.connection, 11)?;
+            empty_legacy(&registry.connection, namespace)?;
+            let owner = super::super::owner_record(&root, true, namespace)?;
+            ensure!(
+                owner.ready && owner.format == 2 && owner.catalog_upgrade.is_none(),
+                "unexplained genesis admission fence"
+            );
+            let receipt = GenesisReceipt {
+                schema: 1,
+                root: root.clone(),
+                namespace,
+                operation,
+                installer_identity: installer,
+                legacy_schema_digest: super::schema_digest(&registry.connection)?,
+                legacy_data_digest: backup::legacy_data_digest(&registry.connection)?,
+                coordinator_origin,
+                stage: GenesisStage::Admitted,
+                backups: Vec::new(),
+                authority_v1: None,
+            };
+            persist(&receipt, true)?;
+            receipt
+        };
+        let mut owner = super::super::owner_record(&root, true, intent.namespace)?;
+        ensure!(
+            owner.ready && owner.format == 2 && owner.incarnation == intent.namespace,
+            "genesis namespace changed"
+        );
+        if owner.catalog_upgrade.is_none() && intent.stage == GenesisStage::Admitted {
+            let read = registry(&root, false)?;
+            verify_legacy(&read, &intent)?;
+            owner.catalog_upgrade = Some(intent.operation);
+            owner.complete(&root)?;
+        }
+        let admitted = admission(&root, &intent)?;
+        if admitted == GenesisAdmission::Fenced
+            && matches!(
+                intent.stage,
+                GenesisStage::Promoting
+                    | GenesisStage::Promoted
+                    | GenesisStage::Qualified
+                    | GenesisStage::Activating
+                    | GenesisStage::Settled
+            )
+        {
+            activation::recover_genesis_v1(&root, &intent)?;
+        } else if admitted == GenesisAdmission::Fenced {
+            upgrade::recover_owned_registry(
+                &root,
+                intent.operation,
+                intent.namespace,
+                Some(intent.legacy_data_digest),
+                &intent.backups,
+                intent.stage == GenesisStage::Migrating,
+            )?;
+        }
+        let result = Self {
+            root,
+            intent,
+            _workers: workers,
+            _watcher: watcher,
+            _embedding: embedding,
+            service,
+        };
+        result.validate_current()?;
+        Ok(result)
+    }
+
+    pub fn receipt(&self) -> Result<GenesisReceipt> {
+        let receipt = pending(&self.root)?.context("genesis intent missing")?;
+        ensure!(receipt.same_intent(&self.intent), "genesis intent changed");
+        admission(&self.root, &receipt)?;
+        Ok(receipt)
+    }
+
+    fn validate_current(&self) -> Result<()> {
+        let receipt = self.receipt()?;
+        if matches!(
+            receipt.stage,
+            GenesisStage::Promoting
+                | GenesisStage::Promoted
+                | GenesisStage::Qualified
+                | GenesisStage::Activating
+                | GenesisStage::Settled
+        ) {
+            return activation::validate_owned_genesis(&self.root, &receipt);
+        }
+        let read = registry(&self.root, false)?;
+        let version: u32 = read.pragma_query_value(None, "user_version", |row| row.get(0))?;
+        if version == 11 {
+            verify_legacy(&read, &receipt)?;
+        } else {
+            self.verify_migrated(&read, &receipt)?;
+        }
+        if let Some(attempt) = receipt.backups.iter().find(|attempt| attempt.complete) {
+            backup::validate(&self.root, receipt.operation, attempt)?;
+        }
+        Ok(())
+    }
+
+    fn verify_migrated(&self, read: &Connection, receipt: &GenesisReceipt) -> Result<()> {
+        ensure!(
+            matches!(
+                receipt.stage,
+                GenesisStage::Migrating | GenesisStage::Migrated | GenesisStage::Promoting
+            ),
+            "unexpected catalog before genesis migration"
+        );
+        super::validate_existing(read)?;
+        let state = super::state(read)?;
+        let attempt = receipt
+            .backups
+            .iter()
+            .find(|attempt| attempt.complete)
+            .context("qualified genesis backup missing")?;
+        ensure!(
+            state.namespace == receipt.namespace
+                && state.upgrade_id == receipt.operation
+                && state.revision == airk_core::index_catalog::CatalogRevision::INITIAL
+                && !state.activated
+                && !state.accepted_new_writes
+                && state.authority_contract == 0
+                && state.policy_contract == 0
+                && state.legacy_schema_digest == receipt.legacy_schema_digest
+                && Some(state.backup_digest) == attempt.sha256,
+            "genesis catalog identity or admission changed"
+        );
+        empty_legacy(read, receipt.namespace)?;
+        ensure!(
+            backup::legacy_data_digest(read)? == receipt.legacy_data_digest,
+            "genesis changed legacy rows"
+        );
+        for object in super::expected(12)?
+            .iter()
+            .filter(|object| object.kind == "table")
+        {
+            if object.name == "index_catalog_meta"
+                || super::expected(11)?
+                    .iter()
+                    .any(|old| old.kind == "table" && old.name == object.name)
+            {
+                continue;
+            }
+            let empty: bool = read.query_row(
+                &format!(
+                    "SELECT NOT EXISTS(SELECT 1 FROM \"{}\" LIMIT 1)",
+                    object.name
+                ),
+                [],
+                |row| row.get(0),
+            )?;
+            ensure!(empty, "genesis catalog has accepted user metadata");
+        }
+        Ok(())
+    }
+
+    pub fn backup(&mut self) -> Result<GenesisReceipt> {
+        self.validate_current()?;
+        let mut receipt = self.receipt()?;
+        if receipt.backups.iter().any(|attempt| attempt.complete) {
+            if receipt.stage == GenesisStage::Admitted {
+                receipt.stage = GenesisStage::BackedUp;
+                persist(&receipt, false)?;
+            }
+            return Ok(receipt);
+        }
+        ensure!(
+            receipt.stage == GenesisStage::Admitted,
+            "genesis backup is not admitted"
+        );
+        let read = registry(&self.root, false)?;
+        read.execute_batch("BEGIN;")?;
+        verify_legacy(&read, &receipt)?;
+        loop {
+            let slot = if let Some(slot) = receipt
+                .backups
+                .iter()
+                .position(|attempt| !attempt.abandoned)
+            {
+                slot
+            } else {
+                ensure!(
+                    receipt.backups.len() < backup::MAX_ATTEMPTS,
+                    "genesis backup attempts exhausted; unknown files preserved"
+                );
+                receipt
+                    .backups
+                    .push(backup::BackupAttempt::reserved(receipt.backups.len() as u8));
+                persist(&receipt, false)?;
+                receipt.backups.len() - 1
+            };
+            let mut attempt = receipt.backups[slot].clone();
+            let captured = backup::capture(
+                &self.root,
+                receipt.operation,
+                &read,
+                receipt.legacy_data_digest,
+                &mut attempt,
+                |current| {
+                    receipt.backups[slot] = current.clone();
+                    persist(&receipt, false)
+                },
+            )?;
+            if captured {
+                receipt.stage = GenesisStage::BackedUp;
+                persist(&receipt, false)?;
+                return Ok(receipt);
+            }
+            receipt.backups[slot].abandoned = true;
+            persist(&receipt, false)?;
+        }
+    }
+
+    pub fn migrate(&mut self) -> Result<GenesisReceipt> {
+        self.migrate_at(|_, _| Ok(()))
+    }
+
+    fn migrate_at(
+        &mut self,
+        mut checkpoint: impl FnMut(&Connection, &str) -> Result<()>,
+    ) -> Result<GenesisReceipt> {
+        self.validate_current()?;
+        let mut receipt = self.receipt()?;
+        let mut write = registry(&self.root, true)?;
+        let version: u32 = write.pragma_query_value(None, "user_version", |row| row.get(0))?;
+        if version == 12 {
+            self.verify_migrated(&write, &receipt)?;
+            receipt.stage = GenesisStage::Migrated;
+            persist(&receipt, false)?;
+            return Ok(receipt);
+        }
+        ensure!(
+            matches!(
+                receipt.stage,
+                GenesisStage::BackedUp | GenesisStage::Migrating
+            ),
+            "genesis migration requires its qualified backup"
+        );
+        let attempt = receipt
+            .backups
+            .iter()
+            .find(|attempt| attempt.complete)
+            .context("qualified genesis backup missing")?;
+        backup::validate(&self.root, receipt.operation, attempt)?;
+        let digest = attempt.sha256.context("genesis backup digest missing")?;
+        receipt.stage = GenesisStage::Migrating;
+        persist(&receipt, false)?;
+        checkpoint(&write, "before_transaction")?;
+        let tx = write.transaction_with_behavior(TransactionBehavior::Immediate)?;
+        require_fence(&self.root, &receipt)?;
+        verify_legacy(&tx, &receipt)?;
+        super::install_schema(&tx)?;
+        tx.execute(
+            "INSERT INTO index_catalog_meta VALUES(1,1,0,0,0,0,?1,?2,?3)",
+            params![
+                receipt.operation.to_string(),
+                receipt.legacy_schema_digest.to_string(),
+                digest.to_string()
+            ],
+        )?;
+        tx.pragma_update(None, "user_version", 12)?;
+        checkpoint(&tx, "before_commit")?;
+        require_fence(&self.root, &receipt)?;
+        ensure!(
+            backup::legacy_data_digest(&tx)? == receipt.legacy_data_digest,
+            "genesis transaction changed legacy rows"
+        );
+        self.verify_migrated(&tx, &receipt)?;
+        tx.commit()?;
+        checkpoint(&write, "after_commit")?;
+        receipt.stage = GenesisStage::Migrated;
+        persist(&receipt, false)?;
+        Ok(receipt)
+    }
+
+    /// This transfers only process ownership. Any pending fence remains
+    /// authoritative; ordinary supervisors and connections require completed
+    /// candidate readiness, authority activation and durable settlement.
+    pub fn into_service_lease(self) -> ServiceLease {
+        self.service
+    }
+}
+
