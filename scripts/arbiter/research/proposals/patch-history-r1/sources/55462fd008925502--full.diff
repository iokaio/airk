+    #[test]
+    fn native_canceled_takeover_recovers_abrupt_capture_without_releasing_stage_before_disposal()
+    -> Result<()> {
+        let mut fixture = crate::catalog_split_control::tests::native_fixture(true)?;
+        let prepared = fixture.snapshot.take().context("prepared split absent")?;
+        let crate::catalog_split_control::SplitAdvance::Advanced(building) =
+            crate::catalog_split_control::advance_pending(
+                &mut fixture.registry,
+                &fixture.control,
+                fixture.engine,
+                prepared.receipt.operation_id,
+            )?
+        else {
+            anyhow::bail!("build not enqueued")
+        };
+        let build = building.receipt.jobs.last().context("build missing")?.job;
+        let stdout_path = fixture.control.join("capture-crash.stdout.log");
+        let stderr_path = fixture.control.join("capture-crash.stderr.log");
+        let stdout = std::fs::OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .open(&stdout_path)?;
+        let stderr = std::fs::OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .open(&stderr_path)?;
+        let mut command = std::process::Command::new(std::env::current_exe()?);
+        command
+            .args([
+                "--ignored",
+                "--exact",
+                "project_worker_split::tests::abrupt_paid_capture_child",
+                "--nocapture",
+            ])
+            .env("AIRK_SPLIT_CAPTURE_CRASH_CONTROL", &fixture.control)
+            .env("AIRK_SPLIT_CAPTURE_CRASH_JOB", build.to_string())
+            .env(
+                "AIRK_SPLIT_CAPTURE_CRASH_ENGINE",
+                fixture.engine.to_string(),
+            )
+            .stdin(std::process::Stdio::null())
+            .stdout(stdout)
+            .stderr(stderr);
+        let mut child = crate::native_process::ContainedChild::spawn(&mut command)?;
+        drop(command);
+        let deadline = std::time::Instant::now() + std::time::Duration::from_secs(60);
+        let status = loop {
+            if let Some(status) = child.try_wait()? {
+                break status;
+            }
+            ensure!(
+                std::time::Instant::now() < deadline,
+                "contained crash child exceeded 60s; see {:?} and {:?}",
+                stdout_path,
+                stderr_path
+            );
+            std::thread::sleep(std::time::Duration::from_millis(25));
+        };
+        // ContainedChild drains/reaps this exact process and descendants on
+        // every path, including timeout or native wait errors above.
+        drop(child);
+        ensure!(
+            std::fs::metadata(&stdout_path)?.len() <= 16 << 20
+                && std::fs::metadata(&stderr_path)?.len() <= 16 << 20,
+            "crash child log exceeds bounded diagnostic read"
+        );
+        assert_eq!(
+            status.code(),
+            Some(79),
+            "{}\n{}",
+            String::from_utf8_lossy(&std::fs::read(&stdout_path)?),
+            String::from_utf8_lossy(&std::fs::read(&stderr_path)?)
+        );
+        let crash: serde_json::Value =
+            serde_json::from_slice(&std::fs::read(fixture.control.join("capture-crash.json"))?)?;
+        let child: Sha256Digest = serde_json::from_value(crash["child"].clone())?;
+        let staging = Path::new(
+            crash["staging"]
+                .as_str()
+                .context("crash stage path absent")?,
+        );
+        assert!(staging.starts_with(&building.request.destination_registration.data_root));
+        let quota = airk_store::quota::Quota::open_service(Path::new(
+            &building.request.destination_registration.data_root,
+        ))?;
+        let before = quota.observe_funding(building.receipt.operation_id)?;
+        let abandoned = before
+            .children
+            .iter()
+            .find(|row| row.id == child)
+            .context("crash capture lost")?;
+        assert!(!abandoned.closed);
+        assert_eq!(
+            std::fs::read(staging.join("owned-sentinel"))?,
+            b"preserved crash evidence"
+        );
+        let mut lease = ProjectLease::acquire(
+            &fixture.control,
+            building.request.destination_registration.binding,
+        )?;
+        fixture.registry.admit_worker(&mut lease)?;
+        fixture.registry.recover_jobs(&lease)?;
+        let current = fixture
+            .registry
+            .catalog_split_status(building.receipt.operation_id)?
+            .context("split disappeared")?;
+        let cancel = airk_core::catalog_split::SplitRecoveryRequest {
+            caller: current.request.caller,
+            key: airk_core::service::RequestKey {
+                nonce: airk_core::identity::Incarnation::from_bytes([104; 16]),
+                ..current.request.key.clone()
+            },
+            operation_id: current.receipt.operation_id,
+            request_digest: current.receipt.request_digest,
+            expected_receipt_digest: current.receipt_digest,
+            expected_finalization_revision: None,
+            action: airk_core::catalog_split::SplitRecoveryAction::Cancel,
+        };
+        crate::catalog_split_control::execute(
+            &mut fixture.registry,
+            &fixture.control,
+            &airk_core::service::ControlMethod::CatalogSplitRecover {
+                request: Box::new(cancel),
+            },
+        )?
+        .context("canonical cancel absent")?;
+        let mut cleanup = None;
+        for _ in 0..6 {
+            let current = fixture
+                .registry
+                .catalog_split_status(building.receipt.operation_id)?
+                .context("canceled state absent")?;
+            if let Some(job) = current
+                .receipt
+                .jobs
+                .last()
+                .filter(|job| job.purpose == SplitJobPurpose::DestinationCleanup)
+            {
+                cleanup = Some(job.job);
+                break;
+            }
+            crate::catalog_split_control::advance_pending(
+                &mut fixture.registry,
+                &fixture.control,
+                fixture.engine,
+                building.receipt.operation_id,
+            )?;
+        }
+        let cleanup = cleanup.context("actual cleanup child absent")?;
+        fixture
+            .registry
+            .claim_job_id(&lease, cleanup)?
+            .context("cleanup not claimable")?;
+        let work = fixture
+            .registry
+            .claimed_split_work(&lease, cleanup, fixture.engine)?;
+        crate::catalog_split_control::prepare_claimed_funding(&fixture.registry, &work)?
+            .context("cleanup funding absent")?;
+        let held = quota.observe_funding(building.receipt.operation_id)?;
+        let closed = held
+            .children
+            .iter()
+            .find(|row| row.id == child)
+            .context("custody transfer prematurely removed capture")?;
+        assert!(closed.closed);
+        assert_eq!(closed.capacity, abandoned.capacity);
+        assert_eq!(closed.charged, abandoned.charged);
+        assert_eq!(closed.phase.job, cleanup);
+        let current_rows = |record: &airk_store::quota::funding::FundingReceipt| {
+            record
+                .children
+                .iter()
+                .filter(|row| {
+                    matches!(
+                        row.kind,
+                        airk_store::quota::funding::FundingChildKind::Current { .. }
+                    )
+                })
+                .map(|row| (row.id, row.capacity, row.charged, row.closed))
+                .collect::<Vec<_>>()
+        };
+        assert_eq!(
+            current_rows(&held),
+            current_rows(&before),
+            "capture custody must not release or alter journal grants"
+        );
+        assert_eq!(
+            std::fs::read(staging.join("owned-sentinel"))?,
+            b"preserved crash evidence"
+        );
+        // A same-prefix entry with no exact admitted child remains unowned.
+        // Preflight must preserve both it and all current recovery evidence.
+        let logical = staging.parent().context("crash stage collection absent")?;
+        let unknown = logical.join(format!(
+            ".quota-stage-r-funded-{}",
+            Sha256Digest::from_bytes([0; 32])
+        ));
+        assert_ne!(unknown, staging);
+        std::fs::create_dir(&unknown)?;
+        std::fs::write(
+            unknown.join("foreign-source"),
+            b"unadmitted entry remains unchanged",
+        )?;
+        let native_current = airk_store::service::collection::Collection::existing(
+            Path::new(&building.request.destination_registration.data_root),
+            &building.request.destination_registration.root,
+            &building.request.destination_registration.collection,
+        )?
+        .select_for_diagnostics()?
+        .directory()
+        .join("current.sqlite3");
+        assert!(native_current.is_file());
+        let observer =
+            Kernel::open_existing_service_observer(&building.request.destination_registration)?;
+        let error = execute(
+            &observer,
+            &mut fixture.registry,
+            &lease,
+            cleanup,
+            fixture.engine,
+            &fixture.control,
+        )
+        .err()
+        .context("unadmitted staging was accepted")?;
+        assert!(
+            format!("{error:#}").contains("unknown removal entry is preserved"),
+            "{error:#}"
+        );
+        assert!(
+            native_current.is_file(),
+            "unknown staging must refuse before payload deletion"
+        );
+        assert_eq!(
+            std::fs::read(unknown.join("foreign-source"))?,
+            b"unadmitted entry remains unchanged"
+        );
+        assert_eq!(
+            std::fs::read(staging.join("owned-sentinel"))?,
+            b"preserved crash evidence"
+        );
+        std::fs::remove_file(unknown.join("foreign-source"))?;
+        std::fs::remove_dir(&unknown)?;
+        let outcome = execute(
+            &observer,
+            &mut fixture.registry,
+            &lease,
+            cleanup,
+            fixture.engine,
+            &fixture.control,
+        )?;
+        assert!(matches!(outcome, JobOutcome::Succeeded { .. }));
+        assert!(
+            !staging.exists(),
+            "only actual completed disposal may remove abandoned staging"
+        );
+        let after = quota.observe_funding(building.receipt.operation_id)?;
+        assert!(after.children.iter().all(|row| row.id != child));
+        assert_eq!(
+            std::fs::read(Path::new(&fixture.original.root).join("docs/selected.md"))?,
+            b"selected native split document\n"
+        );
+        assert_eq!(
+            std::fs::read(Path::new(&fixture.original.root).join("remainder.md"))?,
+            b"original positive remainder\n"
+        );
+        Ok(())
+    }
+}
diff --git a/crates/airk-cli/src/reference_refresh_control.rs b/crates/airk-cli/src/reference_refresh_control.rs
new file mode 100644
index 0000000..925217f
--- /dev/null
+++ b/crates/airk-cli/src/reference_refresh_control.rs
@@ -0,0 +1,247 @@
+// SPDX-License-Identifier: Apache-2.0
+//! Native-only refresh admission and existing Configure-job completion.
+use airk_core::{
+    catalog_management::{CatalogEntity, CatalogItem},
+    catalog_refresh::{RefreshMode, RefreshSelection},
+    identity::Incarnation,
+    service::{JobOutcome, JobRecord, ProjectBinding, RequestKey, ScopedConnectRequest},
+    service_configuration::{ConfigurationRequest, ProjectConfiguration},
+};
+use airk_store::service::{ProjectLease, registry::ServiceRegistry};
+use anyhow::{Context, Result, ensure};
+
+fn selected(request: &ConfigurationRequest) -> Result<&RefreshSelection> {
+    request.validate()?;
+    ensure!(!request.prepare, "refresh never defers native preparation");
+    let ProjectConfiguration::RefreshReferences { selection } = &request.configuration else {
+        anyhow::bail!("native refresh selection missing");
+    };
+    ensure!(
+        selection.members.len() == 1,
+        "native refresh currently admits one exact selected member"
+    );
+    Ok(selection)
+}
+
+/// Reuse canonical authenticated host/grant/catalog/backing construction.
+/// This creates no grant, default preference, bearer credential or worker.
+fn qualify(
+    registry: &mut ServiceRegistry,
+    project: ProjectBinding,
+    request: &ConfigurationRequest,
+) -> Result<airk_kernel::Kernel> {
+    let selection = selected(request)?;
+    let member = &selection.members[0];
+    let scoped = ScopedConnectRequest {
+        schema: 1,
+        context_key: selection.selection.context_key,
+        namespace: selection.selection.namespace,
+        expected_catalog_revision: selection.selection.expected_catalog_revision,
+        grant_id: selection.selection.grant_id,
+        expected_grant_revision: selection.selection.expected_grant_revision,
+        index_id: member.index_id,
+        project_ids: selection.selection.project_ids.clone(),
+    };
+    let native = crate::catalog_coordinator::native_scoped_selection(registry, &scoped)?;
+    ensure!(
+        native.backing == project,
+        "refresh target differs from selected native backing"
+    );
+    let authority = crate::catalog_authority::build_catalog_read_authority(registry, &native)?;
+    let detail = registry.catalog_detail(
+        &CatalogEntity::Index {
+            id: member.index_id,
+        },
+        Some(scoped.expected_catalog_revision),
+    )?;
+    let Some(CatalogItem::Index(index)) = detail.item else {
+        anyhow::bail!("refresh index unavailable")
+    };
+    ensure!(index.backing.binding == project, "refresh backing changed");
+    // Match the ordinary native worker's read-only model context. This binds
+    // immutable descriptors/runtime only: no provisioning, model weights,
+    // inference, source scan or Current mutation is performed by qualification.
+    let kernel = airk_kernel::Kernel::open_existing_service_observer(&index.backing)?
+        .with_expected_source_policy(registry.catalog_source_policy(index.id)?)?
+        .with_service_models(
+            registry.control_root(),
+            crate::bundled_assets::default_plan()?,
+        )?;
+    let scoped_kernel = kernel.with_scoped_reads(authority.clone())?;
+    // First-wave selected refresh AND full fallback require full-index metadata
+    // authority. Partial Project/path grants are unsupported; never broaden them.
+    // Root/alias/profile metadata follows authenticated complete coverage.
+    scoped_kernel.qualify_reference_refresh(selection, &authority.sources)?;
+    kernel.validate_service_configuration(project, request)?;
+    let observed = kernel.inspect_service(project)?;
+    ensure!(
+        observed.source_state == airk_core::service_inspection::SourceState::Available
+            && observed.recovery_required == Some(false),
+        "refresh sources/recovery are not ready; preserve publication and review again"
+    );
+    Ok(kernel)
+}
+
+pub(crate) fn admit(
+    registry: &mut ServiceRegistry,
+    project: ProjectBinding,
+    caller: Incarnation,
+    key: &RequestKey,
+    request: &ConfigurationRequest,
+) -> Result<JobRecord> {
+    let selection = selected(request)?;
+    ensure!(
+        selection.caller == caller && selection.key == *key,
+        "refresh exact caller/key binding changed"
+    );
+    // Exact already-accepted work remains a dated receipt after later catalog
+    // changes. Store compares the complete immutable request before returning.
+    if registry.request_receipt(caller, key)?.0.is_none() {
+        qualify(registry, project, request)?;
+    }
+    registry.enqueue_native_reference_refresh(
+        project,
+        caller,
+        key,
+        request,
+        crate::runtime_pair::engine_identity()?,
+    )
+}
+
+/// Only a fresh pre-admission typed refusal can claim no accepted job.
+/// An exact already-accepted key always returns its historical accepted job.
+pub(crate) fn admit_response(
+    registry: &mut ServiceRegistry,
+    project: ProjectBinding,
+    caller: Incarnation,
+    key: &RequestKey,
+    request: &ConfigurationRequest,
+) -> Result<airk_core::service::ControlResponse> {
+    match admit(registry, project, caller, key, request) {
+        Ok(job) => Ok(airk_core::service::ControlResponse::Job { job }),
+        Err(error) => {
+            if let Some(review) =
+                error.downcast_ref::<airk_core::catalog_refresh::RefreshReviewRequired>()
+            {
+                review.validate()?;
+                Ok(
+                    airk_core::service::ControlResponse::ReferenceRefreshReviewRequired {
+                        project,
+                        caller,
+                        key: key.clone(),
+                        request: Box::new(request.clone()),
+                        review: review.clone(),
+                    },
+                )
+            } else {
+                Err(error)
+            }
+        }
+    }
+}
+
+/// Exact saved acknowledgment, independent of current/superseding grants,
+/// settings and engine. Missing/pruned evidence is unknown, never replay leave.
+pub(crate) fn receipt(
+    registry: &ServiceRegistry,
+    caller: Incarnation,
+    key: &RequestKey,
+) -> Result<airk_core::service::ControlResponse> {
+    let (job, expired) = registry.request_receipt(caller, key)?;
+    let (configuration, result) = if let Some(job) = &job {
+        let work = registry.configuration_work(job.id)?;
+        if let Some(work) = &work {
+            let selection = selected(&work.request)?;
+            ensure!(
+                selection.caller == caller && selection.key == *key,
+                "saved refresh receipt belongs to a different intent"
+            );
+        }
+        ensure!(
+            job.kind == airk_core::service::JobKind::Configure,
+            "saved key is not a refresh configuration job"
+        );
+        let result = if work.is_some() {
+            registry.configuration_result(job.id)?
+        } else {
+            None
+        };
+        (work, result)
+    } else {
+        (None, None)
+    };
+    Ok(
+        airk_core::service::ControlResponse::ReferenceRefreshReceipt {
+            job,
+            configuration,
+            result,
+            expired,
+        },
+    )
+}
+
+pub(crate) fn execute(
+    kernel: &airk_kernel::Kernel,
+    registry: &mut ServiceRegistry,
+    lease: &ProjectLease,
+    job: airk_core::identity::Sha256Digest,
+) -> Result<JobOutcome> {
+    let project = registry.job(job)?.project;
+    let work = registry
+        .configuration_work(job)?
+        .context("accepted refresh work missing")?;
+    ensure!(
+        work.engine == crate::runtime_pair::engine_identity()?,
+        "refresh engine changed; new review required"
+    );
+    let selection = selected(&work.request)?;
+    // A queued operation rechecks current grant/context/backing before its
+    // first effect; a changed grant does not silently expand permission.
+    let before = selection.members[0].original_publication;
+    let effect = (|| {
+        qualify(registry, project, &work.request)?;
+        kernel.refresh_service_references(project, &work.request)
+    })();
+    let report = match effect {
+        Ok(report) => report,
+        Err(error) => {
+            if let Some(review) =
+                error.downcast_ref::<airk_core::catalog_refresh::RefreshReviewRequired>()
+            {
+                review.validate()?;
+                let refusal = serde_json::json!({"schema":"airk.reference-refresh-review-required/1","selection_digest":selection.identity()?,"original_query_digest":selection.original_query_digest,"review":review,"publication_applied":false,"requery_executed":false});
+                registry.record_configuration_result(lease, job, &refusal)?;
+                return Ok(JobOutcome::Failed {
+                    code: "refresh_scope_changed_review_required".into(),
+                });
+            } else {
+                return Err(error);
+            }
+        }
+    };
