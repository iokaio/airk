+            "files":[{"path":path,"content_hash":"ab".repeat(32),"language":"rust","parse_status":"syntax","line_basis":"source","provenance":0}],
+            "provenance":[{"basis":"syntax","producer":"original-fixture","coverage":"written syntax"}]})
