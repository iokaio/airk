+    assert!(
+        complete
+            .read_native(
+                NativeRead::Settings {
+                    view: SettingsView::ExtractionPolicy,
+                    cursor: Some(cursor),
+                    max_bytes: 20 << 10
+                },
+                binding
+            )
+            .await
+            .is_err()
+    );
+    complete.close().await?;
+    second.close().await?;
+    first.close().await?;
+    owner.close().await?;
+    Ok(())
+}
