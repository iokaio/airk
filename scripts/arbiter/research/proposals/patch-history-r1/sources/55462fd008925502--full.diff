+// SPDX-License-Identifier: Apache-2.0
+//! Real native object observations plus isolated catalog-format fixtures. SQL
+//! activation here does not qualify managed activation or the guarded child.
+use super::*;
+use airk_core::identity::Sha256Digest;
+#[cfg(unix)]
+use airk_store::service::registry::{ProviderBoot, SharedHelperContainment};
+use airk_store::service::{ServiceLease, registry::catalog::upgrade::CatalogUpgrade};
+#[path = "embedding_pool_shared_native_tests.rs"]
+mod native;
+
+const OLD: Incarnation = Incarnation::from_bytes([31; 16]);
+const CURRENT: Incarnation = Incarnation::from_bytes([32; 16]);
+const HELPER: Incarnation = Incarnation::from_bytes([33; 16]);
+
+struct Fixture {
+    _directory: tempfile::TempDir,
+    root: PathBuf,
+    lease: ServiceLease,
+}
+impl Fixture {
+    fn new() -> Result<Self> {
+        let directory = tempfile::tempdir()?;
+        let root = directory.path().join("runtime");
+        crate::local_ipc::prepare_root(&root)?;
+        let root = root.canonicalize()?;
+        drop(ServiceRegistry::open(&root, OLD)?);
+        let upgrade = CatalogUpgrade::acquire(&root)?;
+        airk_kernel::service_catalog_upgrade::prepare(&upgrade, Sha256Digest::from_bytes([2; 32]))?;
+        upgrade.migrate()?;
+        drop(upgrade);
+        let sql = rusqlite::Connection::open(root.join("service-1.4.sqlite3"))?;
+        let tx = sql.unchecked_transaction()?;
+        tx.execute_batch(include_str!(
+            "../../airk-store/src/service_catalog_authority_v1.sql"
+        ))?;
+        tx.execute(
+            "UPDATE index_catalog_meta SET activated=1,authority_contract=1",
+            [],
+        )?;
+        tx.commit()?;
+        drop(sql);
+        let owner_path = root.join("service-1.4.owner.json");
+        let mut owner: serde_json::Value = serde_json::from_slice(&std::fs::read(&owner_path)?)?;
+        owner
+            .as_object_mut()
+            .context("fixture owner")?
+            .remove("catalog_upgrade");
+        std::fs::write(owner_path, serde_json::to_vec(&owner)?)?;
+        let lease = ServiceLease::acquire(&root)?;
+        registry(&root)?.record_service_instance(&lease, OLD)?;
+        Ok(Self {
+            _directory: directory,
+            root,
+            lease,
+        })
+    }
+    fn restart(&self) -> Result<()> {
+        registry(&self.root)?.record_service_instance(&self.lease, CURRENT)
+    }
+}
+
+#[test]
+fn shared_recovery_requires_positive_coverage_and_exact_admission() -> Result<()> {
+    let directory = tempfile::tempdir()?;
+    let root = directory.path().join("legacy-runtime");
+    crate::local_ipc::prepare_root(&root)?;
+    drop(ServiceRegistry::open(&root, OLD)?);
+    assert!(!crate::embedding_pool_bootstrap::shared_mode(&root)?);
+    assert!(recover_predecessor_shared_helpers(&root, CURRENT).is_err());
+    let fixture = Fixture::new()?;
+    fixture.restart()?;
+    assert!(
+        recover_shared_helper(
+            &fixture.root,
+            SharedHelperIdentity {
+                service: OLD,
+                helper: HELPER
+            }
+        )
+        .is_err()
+    );
+    let proof = recover_predecessor_shared_helpers(&fixture.root, CURRENT)?
+        .context("positive empty coverage")?;
+    assert!(proof.matches(registry(&fixture.root)?.incarnation()?, CURRENT));
+    assert!(proof.witnesses().is_empty());
+    assert!(!proof.matches(Incarnation::from_bytes([99; 16]), CURRENT));
+    Ok(())
+}
+
+#[test]
+fn maintenance_keeps_legacy_identity_and_refuses_inactive_shared_coverage() -> Result<()> {
+    let directory = tempfile::tempdir()?;
+    let root = directory.path().join("legacy");
+    crate::local_ipc::prepare_root(&root)?;
+    drop(ServiceRegistry::open(&root, OLD)?);
+    let lease = ServiceLease::acquire(&root)?;
+    assert!(quiesce_for_maintenance(&lease)?);
+    assert!(
+        ServiceRegistry::open_saved(&root)?
+            .catalog_state()?
+            .is_none()
+    );
+    let fixture = Fixture::new()?;
+    assert!(quiesce_for_maintenance(&fixture.lease)?);
+    assert_eq!(
+        registry(&fixture.root)?.recorded_service_instance()?,
+        Some(OLD)
+    );
+    let sql = rusqlite::Connection::open(fixture.root.join("service-1.4.sqlite3"))?;
+    sql.execute("UPDATE index_catalog_meta SET activated=0", [])?;
+    assert!(quiesce_for_maintenance(&fixture.lease).is_err());
+    Ok(())
+}
+
+#[test]
+fn guarded_mode_never_falls_back_for_unqualified_or_unknown_catalog_contracts() -> Result<()> {
+    let fixture = Fixture::new()?;
+    assert!(crate::embedding_pool_bootstrap::shared_mode(&fixture.root)?);
+    let sql = rusqlite::Connection::open(fixture.root.join("service-1.4.sqlite3"))?;
+    sql.execute("UPDATE index_catalog_meta SET activated=0", [])?;
+    assert!(crate::embedding_pool_bootstrap::shared_mode(&fixture.root).is_err());
+    sql.execute(
+        "UPDATE index_catalog_meta SET activated=1,policy_contract=1",
+        [],
+    )?;
+    assert!(crate::embedding_pool_bootstrap::shared_mode(&fixture.root).is_err());
+    sql.execute(
+        "UPDATE index_catalog_meta SET policy_contract=0,authority_contract=2",
+        [],
+    )?;
+    assert!(crate::embedding_pool_bootstrap::shared_mode(&fixture.root).is_err());
+    Ok(())
+}
+
+#[cfg(unix)]
+#[test]
+fn admitted_unbound_startup_retains_its_actual_pin_until_every_native_copy_closes() -> Result<()> {
+    let fixture = Fixture::new()?;
+    let owner = SharedHelperIdentity {
+        service: OLD,
+        helper: HELPER,
+    };
+    let pin = airk_store::service::SharedHelperLease::acquire(&fixture.root, owner)?;
+    let (device, inode) = pin.identity()?;
+    let inherited = pin.duplicate_native_pin()?;
+    #[cfg(target_os = "macos")]
+    let scope = "darwin-global".to_owned();
+    #[cfg(target_os = "linux")]
+    let scope = std::fs::read_link("/proc/self/ns/pid")?
+        .to_str()
+        .context("native fixture PID scope")?
+        .to_owned();
+    registry(&fixture.root)?.begin_shared_helper_drain(
+        owner,
+        SharedHelperContainment::Unix {
+            guardian_pid: None,
+            group: None,
+            pin_device: device,
+            pin_inode: inode,
+        },
+        ProviderBoot {
+            boot_id: None,
+            process_scope: scope,
+            elapsed_ns: 0,
+            monotonic_reset_proves_boot: false,
+        },
+    )?;
+    fixture.restart()?;
+    drop(pin);
+    assert!(recover_shared_helper(&fixture.root, owner)?.is_none());
+    assert!(recover_predecessor_shared_helpers(&fixture.root, CURRENT)?.is_none());
+    drop(inherited);
+    assert!(
+        recover_shared_helper(&fixture.root, owner)?
+            .context("covered no-permit startup ended")?
+            .matches(OLD, HELPER)
+    );
+    // A terminal row records the native observation. The lock inode can no
+    // longer authorize effects and is not reopened as new ownership proof.
+    let path = fixture
+        .root
+        .join(airk_store::service::shared_helper_pin_name(owner));
+    std::fs::rename(&path, path.with_extension("old"))?;
+    std::fs::write(&path, b"foreign replacement preserved")?;
+    assert!(
+        recover_shared_helper(&fixture.root, owner)?
+            .context("durable terminal proof")?
+            .matches(OLD, HELPER)
+    );
+    assert_eq!(std::fs::read(path)?, b"foreign replacement preserved");
+    let proof = recover_predecessor_shared_helpers(&fixture.root, CURRENT)?
+        .context("captured actual native completion")?;
+    assert_eq!(
+        prune_predecessor_shared_helpers(&fixture.root, CURRENT, &fixture.lease, &proof)?,
+        1
+    );
+    // Reusing the retained opaque native proof after a successful commit whose
+    // observation was lost must be idempotent. Missing rows mint no new proof.
+    assert_eq!(
+        prune_predecessor_shared_helpers(&fixture.root, CURRENT, &fixture.lease, &proof)?,
+        0
+    );
+    Ok(())
+}
+
+#[cfg(windows)]
+#[test]
+fn uncreated_collision_is_not_adopted_and_terminal_recovery_never_reopens_reused_name() -> Result<()>
+{
+    use std::os::windows::io::{AsHandle, AsRawHandle, FromRawHandle, OwnedHandle};
+    use windows_sys::Win32::System::JobObjects::{
+        CreateJobObjectW, JOBOBJECT_EXTENDED_LIMIT_INFORMATION, JobObjectExtendedLimitInformation,
+        OpenJobObjectW, QueryInformationJobObject,
+    };
+    let fixture = Fixture::new()?;
+    let mut catalog = registry(&fixture.root)?;
+    let namespace = catalog.incarnation()?;
+    let owner = SharedHelperIdentity {
+        service: OLD,
+        helper: HELPER,
+    };
+    let user = crate::local_ipc::current_user()?;
+    let name = shared_helper_job_name(namespace, owner, &user)?;
+    catalog.begin_shared_helper_drain(
+        owner,
+        SharedHelperContainment::Windows {
+            job_name: name.clone(),
+            user_sid: user.clone(),
+            session: session()?,
+            created: false,
+            leader_pid: None,
+        },
+        boot(&user)?,
+    )?;
+    let job = crate::local_ipc::with_current_user_job_security(|attributes, _| {
+        airk_process::ChildJob::unassigned_named(&name, attributes)
+    })?;
+    fixture.restart()?;
+    assert!(
+        recover_shared_helper(&fixture.root, owner)?
+            .context("no-spawn native proof")?
+            .matches(OLD, HELPER)
+    );
+    let wide = name.encode_utf16().chain(Some(0)).collect::<Vec<_>>();
+    // SAFETY: live terminated name and inspection-only rights.
+    let raw = unsafe { OpenJobObjectW(0x0004, 0, wide.as_ptr()) };
+    ensure!(!raw.is_null(), std::io::Error::last_os_error());
+    // SAFETY: successful native open transfers one owned handle.
+    let inspection = unsafe { OwnedHandle::from_raw_handle(raw) };
+    let mut limits: JOBOBJECT_EXTENDED_LIMIT_INFORMATION = unsafe { std::mem::zeroed() };
+    // SAFETY: retained job handle and correctly sized output.
+    ensure!(
+        unsafe {
+            QueryInformationJobObject(
+                inspection.as_raw_handle(),
+                JobObjectExtendedLimitInformation,
+                (&mut limits as *mut JOBOBJECT_EXTENDED_LIMIT_INFORMATION).cast(),
+                std::mem::size_of_val(&limits) as u32,
+                std::ptr::null_mut(),
+            )
+        } != 0,
+        std::io::Error::last_os_error()
+    );
+    assert_eq!(
+        limits.BasicLimitInformation.ActiveProcessLimit, 32,
+        "recovery must not adopt/drain a collided job"
+    );
+    drop((inspection, job));
+    // This is a new native object under the old name with ordinary inherited
+    // security, not the protected producer ACL. Terminal recovery must not open
+    // it or attempt to repair/terminate it.
+    let raw = unsafe { CreateJobObjectW(std::ptr::null(), wide.as_ptr()) };
+    ensure!(!raw.is_null(), std::io::Error::last_os_error());
+    let replacement = unsafe { OwnedHandle::from_raw_handle(raw) };
+    assert!(crate::local_ipc::require_job_user(replacement.as_handle(), &user).is_err());
+    assert!(
+        recover_shared_helper(&fixture.root, owner)?
+            .context("durable terminal proof")?
+            .matches(OLD, HELPER)
+    );
+    let proof = recover_predecessor_shared_helpers(&fixture.root, CURRENT)?
+        .context("captured native no-spawn proof")?;
+    assert_eq!(
+        prune_predecessor_shared_helpers(&fixture.root, CURRENT, &fixture.lease, &proof)?,
+        1
+    );
+    assert_eq!(
+        prune_predecessor_shared_helpers(&fixture.root, CURRENT, &fixture.lease, &proof)?,
+        0
+    );
+    Ok(())
+}
diff --git a/crates/airk-cli/src/helper_recovery.rs b/crates/airk-cli/src/helper_recovery.rs
new file mode 100644
index 0000000..4244ad1
--- /dev/null
+++ b/crates/airk-cli/src/helper_recovery.rs
@@ -0,0 +1,290 @@
+// SPDX-License-Identifier: Apache-2.0
+//! Service-owned helper recovery. Saved state is translated to monotonic time once.
+use crate::embedding_pool_process::PoolHealth;
+use airk_core::identity::{Incarnation, Sha256Digest};
+use airk_store::service::registry::{HelperRecoveryClear, HelperRecoverySnapshot, ServiceRegistry};
+use anyhow::Result;
+use std::time::{Duration, Instant};
+
+const HEALTHY_WINDOW: Duration = Duration::from_secs(60);
+
+pub(super) struct PoolRecovery {
+    pub attempts: u32,
+    pub suppressed: bool,
+    pub requested: bool,
+    retry_at: Instant,
+    observed: Option<HelperRecoverySnapshot>,
+    initialized: bool,
+    healthy_basis: Option<(Incarnation, Option<HelperRecoverySnapshot>)>,
+    reaped: Vec<crate::embedding_pool_process::ProviderReapWitness>,
+}
+
+impl PoolRecovery {
+    pub fn new(now: Instant) -> Self {
+        Self {
+            attempts: 0,
+            suppressed: false,
+            requested: false,
+            retry_at: now,
+            observed: None,
+            initialized: false,
+            healthy_basis: None,
+            reaped: Vec::new(),
+        }
+    }
+    pub fn record_reaped(
+        &mut self,
+        witness: crate::embedding_pool_process::ProviderReapWitness,
+    ) -> Result<()> {
+        if !self
+            .reaped
+            .iter()
+            .any(|old| old.matches(witness.service(), witness.helper()))
+        {
+            anyhow::ensure!(
+                self.reaped.len() < 128,
+                "native provider reap history capacity exceeded"
+            );
+            self.reaped.push(witness);
+        }
+        Ok(())
+    }
+    pub fn reap_witnesses(&self) -> &[crate::embedding_pool_process::ProviderReapWitness] {
+        &self.reaped
+    }
+    pub fn clear_reap_witnesses(&mut self) {
+        self.reaped.clear();
+    }
+
+    pub fn due(&self, now: Instant) -> bool {
+        self.admission_pending() && now >= self.retry_at
+    }
+
+    pub fn admission_pending(&self) -> bool {
+        !self.suppressed && self.attempts < 3
+    }
+
+    pub fn attempted(&mut self) {
+        self.attempts += 1;
+    }
+
+    pub fn failed(&mut self, now: Instant) {
+        self.healthy_basis = None;
+        self.retry_at = now + Duration::from_secs(1 << self.attempts.min(3));
+    }
+
+    pub fn started(&mut self, instance: Incarnation) {
+        self.healthy_basis = Some((instance, self.observed.clone()));
+    }
+
+    pub fn refresh(
+        &mut self,
+        registry: &mut ServiceRegistry,
+        engine: Sha256Digest,
+        now: Instant,
+        wall_ms: u64,
+    ) -> Result<Option<&'static str>> {
+        if self.suppressed {
+            return Ok(None); // Only explicit Start may reopen local terminal admission.
+        }
+        let mut observed = registry.helper_recovery_snapshot()?;
+        let mut transition = None;
+        if let Some(saved) = &observed
+            && saved.engine != engine
+            && !saved.suppressed
+        {
+            if !registry.clear_helper_recovery(engine, saved, HelperRecoveryClear::EngineChanged)? {
+                self.initialized = false;
+                self.attempts = 3; // Reload before another admission, never use stale proof.
+                return Ok(None);
+            }
+            observed = None;
+            transition = Some("helper_engine_changed");
+        }
+        if !self.initialized || self.observed != observed {
+            self.initialized = true;
+            self.observed = observed.clone();
+            self.attempts = observed.as_ref().map_or(0, |saved| saved.failures);
+            self.suppressed = observed.as_ref().is_some_and(|saved| saved.suppressed);
+            self.retry_at = now
+                + Duration::from_millis(
+                    observed
+                        .as_ref()
+                        .map_or(0, |saved| saved.next_ms.saturating_sub(wall_ms).min(60_000)),
+                );
+            transition = transition.or(if self.suppressed {
+                Some("helper_recovery_suppressed")
+            } else if self.attempts == 3 {
+                Some("helper_cooldown")
+            } else if self.attempts > 0 {
+                Some("helper_backoff")
+            } else {
+                None
+            });
+        }
+        if !self.suppressed && self.attempts == 3 && now >= self.retry_at {
+            let saved = self
+                .observed
+                .as_ref()
+                .expect("three failures have a saved basis");
+            if !registry.resume_helper_after_cooldown(engine, saved)? {
+                self.initialized = false;
+                return Ok(None);
+            }
+            let mut resumed = saved.clone();
+            resumed.failures = 0;
+            resumed.next_ms = 0;
+            self.observed = Some(resumed);
+            self.attempts = 0;
+            self.retry_at = now;
+            transition = Some("helper_cooldown_elapsed");
+        }
+        Ok(transition)
+    }
+
+    pub fn healthy(
+        &mut self,
+        registry: &mut ServiceRegistry,
+        engine: Sha256Digest,
+        health: PoolHealth,
+        now: Instant,
+    ) -> Result<bool> {
+        let Some((instance, basis)) = &self.healthy_basis else {
+            return Ok(false);
+        };
+        if self.suppressed
+            || *instance != health.instance
+            || now.saturating_duration_since(health.ready_at) < HEALTHY_WINDOW
+            || health.last_ack_at < health.ready_at + HEALTHY_WINDOW
+            || health.last_ack_at > now
+        {
+            return Ok(false);
+        }
+        let cleared = match basis {
+            Some(saved) => {
+                registry.clear_helper_recovery(engine, saved, HelperRecoveryClear::Healthy)?
+            }
+            None => registry.helper_recovery_snapshot()?.is_none(),
+        };
+        self.healthy_basis = None; // This pool's old proof cannot clear a later outage.
+        if cleared {
+            self.attempts = 0;
+            self.observed = None;
+            self.initialized = true;
+        }
+        Ok(cleared)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn engine() -> Sha256Digest {
+        Sha256Digest::from_bytes([7; 32])
+    }
+    fn instance() -> Incarnation {
+        Incarnation::from_bytes([8; 16])
+    }
+
+    #[test]
+    fn cooldown_uses_one_monotonic_translation_and_does_not_reset_outage_anchor() -> Result<()> {
+        let root = tempfile::tempdir()?;
+        let mut registry = ServiceRegistry::open(root.path(), instance())?;
+        for wall in [100, 200, 300] {
+            registry.recovery_failed("helper", engine(), wall)?;
+        }
+        let now = Instant::now();
+        let mut recovery = PoolRecovery::new(now);
+        assert_eq!(
+            recovery.refresh(&mut registry, engine(), now, 300)?,
+            Some("helper_cooldown")
+        );
+        assert!(!recovery.due(now + Duration::from_secs(59)));
+        // Wall-clock jumps do not shorten or extend the already observed deadline.
+        assert_eq!(
+            recovery.refresh(
+                &mut registry,
+                engine(),
+                now + Duration::from_secs(59),
+                u64::MAX
+            )?,
+            None
+        );
+        assert!(!recovery.admission_pending());
+        assert_eq!(
+            recovery.refresh(&mut registry, engine(), now + Duration::from_secs(60), 0)?,
+            Some("helper_cooldown_elapsed")
+        );
+        assert!(recovery.due(now + Duration::from_secs(60)));
+        let saved = registry.helper_recovery_snapshot()?.unwrap();
+        assert_eq!((saved.failures, saved.started_ms), (0, 100));
+        registry.suppress_helper_recovery(engine())?;
+        recovery.refresh(
+            &mut registry,
+            engine(),
+            now + Duration::from_secs(61),
+            61_300,
+        )?;
+        assert!(!recovery.due(now + Duration::from_secs(3600)));
+        Ok(())
+    }
+
+    #[test]
+    fn healthy_reset_requires_same_instance_later_ack_and_exact_captured_outage() -> Result<()> {
+        let root = tempfile::tempdir()?;
+        let mut registry = ServiceRegistry::open(root.path(), instance())?;
+        registry.recovery_failed("helper", engine(), 100)?;
+        let now = Instant::now();
+        let mut recovery = PoolRecovery::new(now);
+        recovery.refresh(&mut registry, engine(), now, 100)?;
+        recovery.started(instance());
+        let health = PoolHealth {
+            instance: instance(),
+            ready_at: now,
+            last_ack_at: now,
+        };
+        assert!(!recovery.healthy(
+            &mut registry,
+            engine(),
+            health,
+            now + Duration::from_secs(61)
+        )?);
+        let acknowledged = PoolHealth {
+            last_ack_at: now + Duration::from_secs(60),
+            ..health
+        };
+        assert!(!recovery.healthy(
+            &mut registry,
+            engine(),
+            PoolHealth {
+                instance: Incarnation::from_bytes([9; 16]),
+                ..acknowledged
+            },
+            now + Duration::from_secs(61)
+        )?);
+        registry.recovery_failed("helper", engine(), 200)?;
+        assert!(!recovery.healthy(
+            &mut registry,
+            engine(),
+            acknowledged,
+            now + Duration::from_secs(61)
+        )?);
+        assert_eq!(registry.helper_recovery_snapshot()?.unwrap().failures, 2);
+        recovery.refresh(
+            &mut registry,
+            engine(),
+            now + Duration::from_secs(62),
+            62_000,
+        )?;
+        recovery.started(instance());
+        assert!(recovery.healthy(
+            &mut registry,
+            engine(),
+            acknowledged,
+            now + Duration::from_secs(63)
+        )?);
+        assert!(registry.helper_recovery_snapshot()?.is_none());
+        assert_eq!(recovery.attempts, 0);
+        Ok(())
+    }
+}
