+    )?;
+    kernel.index()?;
+    let error = first
+        .read_native(
+            NativeRead::Settings {
+                view: SettingsView::ExtractionPolicy,
+                cursor: Some(cursor.clone()),
+                max_bytes: 20 << 10,
