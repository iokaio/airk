+    caller: Incarnation,
+    key: &RequestKey,
+    kind: JobKind,
+    configuration: Option<&airk_core::service_configuration::ConfigurationWork>,
+) -> Result<Sha256Digest> {
+    let jobs: i64 =
+        connection.query_row("SELECT count(*) FROM service_jobs", [], |row| row.get(0))?;
