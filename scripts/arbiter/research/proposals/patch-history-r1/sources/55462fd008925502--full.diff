+    let adapter = Kernel::extraction_adapters()[0].profile.adapter_id.clone();
+    let policy = serde_json::from_value(json!({"version":1,"rules":(0..45).map(|n|json!({
+        "selector":{"kind":"exact","path":format!("unused/{n}/{}", "x".repeat(700))},
