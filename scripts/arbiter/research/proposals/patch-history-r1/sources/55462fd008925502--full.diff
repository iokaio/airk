+                fs::create_dir(&data)?;
+            }
+            for directory in ["api", "impl", "private", "api-other"] {
+                fs::create_dir(source.join(directory))?;
+                fs::write(
+                    source.join(directory).join("policy.md"),
+                    format!("# boundaryneedle {n} {directory}\nOriginal isolated source.\n"),
