+use airk_store::service::{ProjectLease, registry::ServiceRegistry};
+use anyhow::{Context, Result, ensure};
+use rusqlite::{Connection, params};
+use serde_json::{Value, json};
+use std::{
+    fs,
+    io::{BufRead, BufReader, Write},
+    path::{Path, PathBuf},
+    process::{Command, Stdio},
+    sync::mpsc,
+    time::{Duration, Instant},
+};
+
+fn binary() -> PathBuf {
+    std::env::var_os("AIRK_CATALOG_CANDIDATE_BINARY")
+        .map(PathBuf::from)
+        .unwrap_or_else(|| env!("CARGO_BIN_EXE_airk").into())
+}
+
+fn fixture_candidate(base: &Path, helper: bool) -> Result<PathBuf> {
+    let candidate = binary();
+    // An explicitly supplied immutable runtime remains the selected producer.
+    // Lexical fixtures need only Cargo's main image and never require inference.
+    if std::env::var_os("AIRK_CATALOG_CANDIDATE_BINARY").is_some() || !helper {
+        return Ok(candidate);
+    }
+    #[cfg(feature = "embedding-worker")]
+    {
+        // Match the existing owning helper fixtures: Cargo builds the two
+        // images, while this disposable owner supplies their exact pair receipt.
+        let pair = base.join("pair");
+        let main = pair.join(airk_cli::runtime_install::main_name());
+        let embed = main.with_file_name(if cfg!(windows) {
+            "airk-embed.exe"
+        } else {
+            "airk-embed"
+        });
+        fs::create_dir_all(main.parent().context("owned pair main parent missing")?)?;
+        fs::copy(&candidate, &main)?;
+        fs::copy(env!("CARGO_BIN_EXE_airk-embed"), &embed)?;
+        let receipt = airk_cli::runtime_pair::RuntimePair {
+            schema: 1,
+            version: env!("CARGO_PKG_VERSION").into(),
+            os: std::env::consts::OS.into(),
+            arch: std::env::consts::ARCH.into(),
+            airk_sha256: airk_cli::runtime_pair::digest_file(&main)?,
+            embed_sha256: airk_cli::runtime_pair::digest_file(&embed)?,
+        };
+        fs::write(
+            pair.join("airk-runtime.json"),
+            serde_json::to_vec(&receipt)?,
+        )?;
+        Ok(main)
+    }
+    #[cfg(not(feature = "embedding-worker"))]
+    {
+        let _ = base;
+        anyhow::bail!("owned helper fixture requires embedding-worker feature")
+    }
+}
+
+struct OwnedProcess {
+    #[cfg(unix)]
+    child: airk_process::GroupChild,
+    #[cfg(not(unix))]
+    child: std::process::Child,
+    #[cfg(not(unix))]
+    job: airk_process::ChildJob,
+}
+impl OwnedProcess {
+    fn start(command: Command) -> Result<Self> {
+        Self::start_with_process_limit(command, 32)
+    }
+
+    fn start_with_process_limit(mut command: Command, process_limit: u32) -> Result<Self> {
+        #[cfg(unix)]
+        let _ = process_limit;
+        #[cfg(windows)]
+        {
+            use std::os::windows::process::CommandExt;
+            command.creation_flags(0x08000000);
+        }
+        #[cfg(unix)]
+        {
+            Ok(Self {
+                child: airk_process::GroupChild::spawn(&mut command)?,
+            })
+        }
+        #[cfg(not(unix))]
+        {
+            let mut child = command.spawn()?;
+            let job = match airk_process::ChildJob::attach_with_process_limit(
+                &mut child,
+                process_limit,
+            ) {
+                Ok(job) => job,
+                Err(error) => {
+                    let _ = child.kill();
+                    let _ = child.wait();
+                    return Err(error);
+                }
+            };
+            Ok(Self { child, job })
+        }
+    }
+}
+impl Drop for OwnedProcess {
+    fn drop(&mut self) {
+        #[cfg(unix)]
+        self.child.drain();
+        #[cfg(not(unix))]
+        {
+            self.job.drain();
+            let _ = self.child.wait();
+        }
+    }
+}
+
+struct Fixture {
+    owner: tempfile::TempDir,
+    candidate: PathBuf,
+    control: PathBuf,
+    session: CombinedConnectRequest,
+    registrations: Vec<ProjectRegistration>,
+    indexes: Vec<IndexId>,
+    projects: Vec<QueryProjectId>,
+}
+impl Fixture {
+    fn new(dedicated_is_indexed: bool) -> Result<Self> {
+        Self::with_indexes(dedicated_is_indexed, 3)
+    }
+
+    fn with_indexes(dedicated_is_indexed: bool, count: usize) -> Result<Self> {
+        Self::with_runtime(dedicated_is_indexed, count, false)
+    }
+
+    #[cfg(feature = "embedding-worker")]
+    fn with_helper() -> Result<Self> {
+        Self::with_runtime(true, 3, true)
+    }
+
+    fn with_runtime(dedicated_is_indexed: bool, count: usize, helper: bool) -> Result<Self> {
+        Self::with_runtime_layout(dedicated_is_indexed, count, helper, None)
