+                                measurement = {"elapsed_ms": timing["elapsed_ms"], "retries": timing["retries"],
+                                               "response_bytes": len(bench.canonical(envelope)),
+                                               "receipt_bytes": len(bench.canonical(receipt)) if receipt else 0}
+                                if sample == 0:
+                                    row["modes"][mode] = {"warmup": measurement}
+                                else:
