+fn revision(value: i64) -> Result<CatalogRevision> {
+    u64::try_from(value)?.try_into()
+}
+fn number(value: CatalogRevision) -> i64 {
+    i64::try_from(value.get()).expect("CatalogRevision validates the signed SQLite range")
