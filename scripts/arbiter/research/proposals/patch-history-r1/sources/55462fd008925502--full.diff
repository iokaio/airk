+REVISION_TOKEN = re.compile(r"airk-r1:([0-9a-f]{32}):(0|[1-9][0-9]{0,19}):([0-9a-f]{64})", re.ASCII)
+QUERY_RECIPE = {"mode": "lexical", "verification": "off", "response_mode": "full",
+                "limit": 8, "max_bytes": 8192}
