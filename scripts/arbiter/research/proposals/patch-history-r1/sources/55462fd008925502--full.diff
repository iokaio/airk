+        "content":[{"type":"text","text":"helper unavailable"}],"structuredContent":{"error":{"code":"helper_unavailable",
+        "retry":{"fresh_brokerage_required":true,"query_replay_safe":false},"custom_nested_detail":[1,2,3]},
