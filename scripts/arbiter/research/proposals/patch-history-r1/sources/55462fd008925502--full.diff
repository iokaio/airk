+    assert_eq!(
+        fixture
+            .registry
+            .catalog_split_status(latest.receipt.operation_id)?,
+        before
+    );
+    assert!(!Path::new(&fixture.selection.destination_data_root).exists());
+    assert_eq!(
+        fs::read(Path::new(&fixture.original.root).join("remainder.md"))?,
