+                    member.membership.index_id = index(n);
+                    member
+                })
+                .collect(),
+        };
+        request.selection = QuerySelection {
+            project_ids: vec![project(1)],
+            index_ids: None,
+            member_availability: MemberAvailability::Report,
+        }
