+fn finish_native_document(
+    mut document: Value,
+    project: ProjectBinding,
+    headers: &NativeScopeHeaders,
+) -> Result<Value> {
+    ensure!(
+        document["project"] == serde_json::to_value(project)? && document.get("value").is_some(),
