+        assert!(
+            expand(&bound, &outputs, 12).is_err(),
+            "multiple definitions need a choice"
+        );
+        let mut partial = page("one.rs");
+        partial["cursor"] = json!("next");
+        outputs.insert("find".into(), partial);
+        assert!(
