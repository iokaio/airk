+    assert!(
+        Collection::initialize(
+            Path::new(&registration.data_root),
+            &registration.root,
+            &registration.collection,
+            Incarnation::from_bytes([74; 16])
+        )
+        .is_err()
+    );
+    assert_eq!(fs::read(&path)?, valid);
+    assert_eq!(fs::read(&source)?, b"original policy source");
