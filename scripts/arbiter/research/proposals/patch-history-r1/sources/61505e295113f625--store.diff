+            connection.execute_batch("PRAGMA journal_mode=WAL; PRAGMA synchronous=FULL; PRAGMA wal_autocheckpoint=0; UPDATE projects SET epoch=9;")?;
+            std::process::exit(73);
+        }
+        "journal" => {
+            let owner = CatalogUpgrade::acquire(&root)?;
+            owner.migrate_at(|stage, connection| {
