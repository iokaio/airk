+        CatalogKind::Sources => {
+            let (index, path, owner, enabled): (String, String, bool, bool) = db.query_row(
+                "SELECT index_id,canonical_path,owner,enabled FROM index_sources WHERE id=?1",
+                [id],
+                |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?, r.get(3)?)),
