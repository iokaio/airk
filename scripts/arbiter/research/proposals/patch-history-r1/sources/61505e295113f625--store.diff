+    let bytes = match pin.read_file(
+        std::ffi::OsStr::new("extraction-policy.json"),
+        MAX_BYTES as u64,
+    ) {
+        Ok(bytes) => bytes,
+        Err(error)
+            if error
+                .downcast_ref::<std::io::Error>()
+                .is_some_and(|e| e.kind() == std::io::ErrorKind::NotFound) =>
+        {
+            return Ok(None);
+        }
+        Err(error) => return Err(error),
+    };
