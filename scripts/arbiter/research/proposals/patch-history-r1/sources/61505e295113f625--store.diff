+    assert!(registry.source_relationships(&input).is_err());
+    changed = input;
+    changed.after = None;
+    changed.bindings = Some(vec![]);
+    assert!(registry.source_relationships(&changed).is_err());
+    changed.bindings = Some(vec![Sha256Digest::from_bytes([99; 32])]);
+    assert!(registry.source_relationships(&changed).is_err());
+    Ok(())
