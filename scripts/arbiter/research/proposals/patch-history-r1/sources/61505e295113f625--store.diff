+// SPDX-License-Identifier: Apache-2.0
+//! Explicit native recovery evidence. A tombstone or missing journal is never
+//! equivalent to the full committed native retirement fence.
+use super::{ServiceRegistry, operations::index_record, state, validate_existing};
+pub use airk_core::catalog_fences::NativeIndexRetirementEvidence;
+use airk_core::{
+    catalog_fences::FencedReceipt,
+    catalog_management::{CatalogOperation, MAX_RECEIPT_BYTES},
+    index_catalog::IndexId,
+    service::CatalogClock,
+};
+use anyhow::{Result, ensure};
+use rusqlite::{OptionalExtension, params};
+
+impl ServiceRegistry {
+    /// Explicit selected-index recovery only. This scans at most the bounded
+    /// 1024 native receipt rows, each capped before decoding to 16 KiB. There is
+    /// no JSON expression index, source scan, mutation or retrieval-path work.
+    pub fn catalog_index_retirement_evidence(
+        &self,
+        index_id: IndexId,
+    ) -> Result<Option<NativeIndexRetirementEvidence>> {
+        let read = self.connection.unchecked_transaction()?;
+        validate_existing(&read)?;
+        let catalog = state(&read)?;
+        ensure!(
+            catalog.activated
+                && catalog.authority_contract == 1
+                && catalog.policy_contract <= super::SUPPORTED_POLICY_CONTRACT,
+            "native retirement evidence requires the active native catalog"
+        );
+        let row: Option<(String, Option<String>)> = read
+            .query_row(
+                "SELECT legacy_binding,active_registration FROM index_definitions WHERE id=?1",
+                [index_id.to_string()],
+                |row| Ok((row.get(0)?, row.get(1)?)),
+            )
+            .optional()?;
+        let Some((binding, active)) = row else {
+            return Ok(None);
+        };
+        let index = index_record(&read, index_id)?;
+        if !index.tombstone {
+            return Ok(None);
+        }
+        let mut statement = read.prepare("SELECT id,kind,stage,revision,length(payload),substr(payload,1,16385) FROM index_operation_receipts ORDER BY id LIMIT 1025")?;
+        let mut rows = statement.query([])?;
+        let mut count = 0;
+        let mut retirement = None;
+        while let Some(row) = rows.next()? {
+            count += 1;
+            ensure!(count <= 1024, "native retirement receipt capacity exceeded");
+            let length: i64 = row.get(4)?;
+            let bytes: Vec<u8> = row.get(5)?;
+            ensure!(
+                length >= 0
+                    && length <= i64::try_from(MAX_RECEIPT_BYTES)?
+                    && usize::try_from(length)? == bytes.len(),
+                "native retirement receipt exceeds bound"
+            );
+            let kind: String = row.get(1)?;
+            let stage: String = row.get(2)?;
+            if kind != "catalog_management_fenced" || stage != "metadata_applied" {
+                continue;
+            }
+            let receipt: FencedReceipt = serde_json::from_slice(&bytes)?;
+            receipt.validate()?;
+            let operation: String = row.get(0)?;
+            let revision: i64 = row.get(3)?;
+            ensure!(
+                receipt.metadata.operation_id.to_string() == operation
+                    && i64::try_from(receipt.metadata.catalog_revision.get())? == revision,
+                "native retirement saved receipt identity changed"
+            );
+            if let CatalogOperation::RetireIndex { id, .. } = &receipt.request.operation
+                && *id == index_id
+            {
+                let evidence = NativeIndexRetirementEvidence {
+                    catalog_clock: CatalogClock {
+                        namespace: catalog.namespace,
+                        revision: catalog.revision,
+                    },
+                    index: index.clone(),
+                    retirement: receipt,
+                };
+                evidence.validate()?;
+                ensure!(
+                    retirement.replace(evidence).is_none(),
+                    "ambiguous native retirement lineage"
+                );
+            }
+        }
+        let Some(evidence) = retirement else {
+            return Ok(None);
+        };
+        ensure!(
+            binding == index.backing.binding.to_string()
+                && active.as_deref() == Some(binding.as_str()),
+            "native retirement backing pointer changed"
+        );
+        let (payload, registered, paused): (Vec<u8>, bool, bool) = read.query_row(
+            "SELECT substr(payload,1,20481),registered,paused FROM projects WHERE binding=?1",
+            [&binding],
+            |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?)),
+        )?;
+        ensure!(
+            !registered && paused && payload == serde_json::to_vec(&index.backing)?,
+            "native retirement retained registration changed"
+        );
+        let enabled: bool = read.query_row(
+            "SELECT EXISTS(SELECT 1 FROM index_sources WHERE index_id=?1 AND enabled<>0)",
+            params![index_id.to_string()],
+            |row| row.get(0),
+        )?;
+        ensure!(
+            !enabled,
+            "native retirement still has enabled source authority"
+        );
+        Ok(Some(evidence))
+    }
+}
diff --git a/crates/airk-store/src/service_catalog_retirement_evidence_tests.rs b/crates/airk-store/src/service_catalog_retirement_evidence_tests.rs
new file mode 100644
index 0000000..3762b48
--- /dev/null
+++ b/crates/airk-store/src/service_catalog_retirement_evidence_tests.rs
@@ -0,0 +1,207 @@
+// SPDX-License-Identifier: Apache-2.0
+use super::*;
+
+fn retire_request(
+    registry: &mut ServiceRegistry,
+    original: &CatalogRequest,
+) -> Result<CatalogRequest> {
+    let CatalogOperation::BeginIndexSourceChange { id, .. } = &original.operation else {
+        unreachable!()
+    };
+    let (_, definition, source, _, _) = registration(&registry.connection, *id)?;
+    let (namespace, epoch) = registry.request_epoch()?;
+    let mut request = original.clone();
+    request.caller = Incarnation::from_bytes([105; 16]);
+    request.key = RequestKey {
+        namespace,
+        epoch,
+        nonce: Incarnation::from_bytes([106; 16]),
+    };
+    request.expected_catalog_revision = super::super::super::state(&registry.connection)?.revision;
+    request.operation = CatalogOperation::RetireIndex {
+        id: *id,
+        expected_definition_revision: definition,
+        expected_source_revision: source,
+        reason: IndexRetirementReason::Explicit,
+    };
+    Ok(request)
+}
+
+fn id(request: &CatalogRequest) -> IndexId {
+    match &request.operation {
+        CatalogOperation::RetireIndex { id, .. } => *id,
+        _ => unreachable!(),
+    }
+}
+
+#[test]
+fn full_native_retirement_evidence_preserves_pending_source_state_and_current_clock() -> Result<()>
+{
+    let (_temp, mut registry, original) = fixture()?;
+    apply(&mut registry, &original)?;
+    let request = retire_request(&mut registry, &original)?;
+    assert!(
+        registry
+            .catalog_index_retirement_evidence(id(&request))?
+            .is_none()
+    );
+    let retired = apply(&mut registry, &request)?;
+    // Native retirement invalidates unknown legacy keys by advancing the global
+    // request epoch. A new independent mutation must obtain a fresh native key.
+    let (namespace, epoch) = registry.request_epoch()?;
+    assert!(epoch > request.key.epoch);
+    let mut unrelated = request.clone();
+    unrelated.key = RequestKey {
+        namespace,
+        epoch,
+        nonce: Incarnation::from_bytes([107; 16]),
+    };
+    unrelated.expected_catalog_revision = retired.metadata.catalog_revision;
+    unrelated.operation = CatalogOperation::CreateProject {
+        id: airk_core::index_catalog::QueryProjectId::from_identity(Incarnation::from_bytes(
+            [108; 16],
+        )),
+        name: "Current native clock".into(),
+    };
+    let preview = registry.catalog_preview(&unrelated)?.identity()?;
+    let current = registry.catalog_apply(&unrelated, preview)?;
+    let evidence = registry
+        .catalog_index_retirement_evidence(id(&request))?
+        .context("native proof missing")?;
+    evidence.validate()?;
+    assert_eq!(evidence.retirement, retired);
+    assert_eq!(evidence.catalog_clock.revision, current.catalog_revision);
+    assert_eq!(
+        evidence.index.source_import,
+        airk_core::index_catalog::SourceImportState::PendingMetadata
+    );
+    assert_ne!(
+        evidence.retirement.request.caller, original.caller,
+        "actual native caller need not be the source operation's UI caller"
+    );
+    assert!(
+        registry
+            .catalog_index_retirement_evidence(IndexId::from_identity(Incarnation::from_bytes(
+                [109; 16]
+            )))?
+            .is_none()
+    );
+    Ok(())
+}
+
+#[test]
+fn tombstone_alone_is_not_retirement_evidence_and_corrupt_or_stale_proof_refuses() -> Result<()> {
+    let (_temp, mut registry, original) = fixture()?;
+    let request = retire_request(&mut registry, &original)?;
+    registry.connection.execute(
+        "UPDATE index_definitions SET tombstone=1 WHERE id=?1",
+        [id(&request).to_string()],
+    )?;
+    assert!(
+        registry
+            .catalog_index_retirement_evidence(id(&request))?
+            .is_none()
+    );
+    registry.connection.execute(
+        "UPDATE index_definitions SET tombstone=0 WHERE id=?1",
+        [id(&request).to_string()],
+    )?;
+    let retired = apply(&mut registry, &request)?;
+    registry.connection.execute(
+        "UPDATE index_operation_receipts SET payload=X'7b7d' WHERE id=?1",
+        [retired.metadata.operation_id.to_string()],
+    )?;
+    assert!(
+        registry
+            .catalog_index_retirement_evidence(id(&request))
+            .is_err()
+    );
+    registry.connection.execute(
+        "UPDATE index_operation_receipts SET payload=?1 WHERE id=?2",
+        params![
+            serde_json::to_vec(&retired)?,
+            retired.metadata.operation_id.to_string()
+        ],
+    )?;
+    registry.connection.execute(
+        "UPDATE index_definitions SET source_revision=source_revision+1 WHERE id=?1",
+        [id(&request).to_string()],
+    )?;
+    assert!(
+        registry
+            .catalog_index_retirement_evidence(id(&request))
+            .is_err()
+    );
+    registry.connection.execute(
+        "UPDATE index_definitions SET source_revision=source_revision-1 WHERE id=?1",
+        [id(&request).to_string()],
+    )?;
+    registry.connection.execute(
+        "UPDATE index_sources SET enabled=1 WHERE index_id=?1",
+        [id(&request).to_string()],
+    )?;
+    assert!(
+        registry
+            .catalog_index_retirement_evidence(id(&request))
+            .is_err()
+    );
+    registry.connection.execute(
+        "UPDATE index_sources SET enabled=0 WHERE index_id=?1",
+        [id(&request).to_string()],
+    )?;
+    registry.connection.execute(
+        "UPDATE index_definitions SET active_registration=NULL WHERE id=?1",
+        [id(&request).to_string()],
+    )?;
+    assert!(
+        registry
+            .catalog_index_retirement_evidence(id(&request))
+            .is_err()
+    );
+    Ok(())
+}
+
+#[test]
+fn native_retirement_evidence_rejects_ambiguous_full_saved_lineage() -> Result<()> {
+    let (_temp, mut registry, original) = fixture()?;
+    let request = retire_request(&mut registry, &original)?;
+    let mut duplicate = apply(&mut registry, &request)?;
+    duplicate.request.key.nonce = Incarnation::from_bytes([110; 16]);
+    duplicate.metadata.operation_id =
+        catalog_operation_id(duplicate.request.caller, &duplicate.request.key)?;
+    duplicate.metadata.key = duplicate.request.key.clone();
+    duplicate.metadata.request_digest = duplicate.request.identity()?;
+    let plan = FencePlan::new(
+        duplicate.proof.service,
+        duplicate.proof.gate_generation,
+        vec![],
+    )?
+    .with_worker_obligation(
+        duplicate
+            .proof
+            .worker_obligation
+            .clone()
+            .context("native census missing")?,
+    )?;
+    let intent = airk_core::catalog_fences::FenceIntent {
+        schema: 1,
+        operation_id: duplicate.metadata.operation_id,
+        request: duplicate.request.clone(),
+        preview_digest: duplicate.preview_digest,
+        prepared_digest: Sha256Digest::from_bytes([0; 32]),
+        plan,
+        stage: airk_core::catalog_fences::FenceStage::Fenced,
+        confirmations: vec![],
+        worker_confirmations: vec![],
+    };
+    duplicate.prepared_digest = intent.identity()?;
+    duplicate.validate()?;
+    registry.connection.execute("INSERT INTO index_operation_receipts VALUES(?1,'catalog_management_fenced','metadata_applied',?2,?3)",
+        params![duplicate.metadata.operation_id.to_string(),number(duplicate.metadata.catalog_revision),serde_json::to_vec(&duplicate)?])?;
+    assert!(
+        registry
+            .catalog_index_retirement_evidence(id(&request))
+            .is_err()
+    );
+    Ok(())
+}
diff --git a/crates/airk-store/src/service_catalog_schema.sql b/crates/airk-store/src/service_catalog_schema.sql
new file mode 100644
index 0000000..7145a12
--- /dev/null
+++ b/crates/airk-store/src/service_catalog_schema.sql
@@ -0,0 +1,146 @@
+-- SPDX-License-Identifier: Apache-2.0
+-- Additive schema 12. Executed only by the owned upgrade adapter, never a read.
+CREATE TABLE index_catalog_meta(
+ id INTEGER PRIMARY KEY CHECK(id=1),
+ revision INTEGER NOT NULL CHECK(revision>=1),
+ activated INTEGER NOT NULL CHECK(activated IN(0,1)),
+ accepted_new_writes INTEGER NOT NULL CHECK(accepted_new_writes IN(0,1)),
+ authority_contract INTEGER NOT NULL CHECK(authority_contract>=0),
+ policy_contract INTEGER NOT NULL CHECK(policy_contract>=0),
+ upgrade_id TEXT NOT NULL CHECK(length(upgrade_id)=32 AND upgrade_id NOT GLOB '*[^0-9a-f]*'),
+ legacy_schema_digest TEXT NOT NULL CHECK(length(legacy_schema_digest)=64 AND legacy_schema_digest NOT GLOB '*[^0-9a-f]*'),
+ backup_digest TEXT NOT NULL CHECK(length(backup_digest)=64 AND backup_digest NOT GLOB '*[^0-9a-f]*'));
+
+CREATE TABLE index_definitions(
+ id TEXT PRIMARY KEY CHECK(substr(id,1,4)='idx_' AND length(id)=36 AND substr(id,5) NOT GLOB '*[^0-9a-f]*'),
+ legacy_binding TEXT NOT NULL UNIQUE CHECK(length(legacy_binding)=64 AND legacy_binding NOT GLOB '*[^0-9a-f]*'),
+ active_registration TEXT REFERENCES projects(binding) ON DELETE SET NULL,
+ backing_root TEXT NOT NULL CHECK(length(CAST(backing_root AS BLOB)) BETWEEN 1 AND 4096),
+ data_root TEXT NOT NULL CHECK(length(CAST(data_root AS BLOB)) BETWEEN 1 AND 4096),
+ namespace TEXT NOT NULL CHECK(namespace='collections-1.4'),
+ collection TEXT NOT NULL CHECK(length(CAST(collection AS BLOB)) BETWEEN 1 AND 128),
+ name TEXT NOT NULL CHECK(length(CAST(name AS BLOB)) BETWEEN 1 AND 256),
+ definition_revision INTEGER NOT NULL CHECK(definition_revision>=1),
+ source_revision INTEGER NOT NULL CHECK(source_revision>=1),
+ policy_epoch INTEGER NOT NULL CHECK(policy_epoch>=0),
+ policy_digest TEXT CHECK(policy_digest IS NULL OR length(policy_digest)=64 AND policy_digest NOT GLOB '*[^0-9a-f]*'),
+ tombstone INTEGER NOT NULL CHECK(tombstone IN(0,1)),
+ source_import_state TEXT NOT NULL CHECK(source_import_state IN('complete','pending_metadata')),
+ CHECK(active_registration IS NULL OR active_registration=legacy_binding),
+ CHECK((policy_epoch=0 AND policy_digest IS NULL) OR (policy_epoch>0 AND policy_digest IS NOT NULL)),
+ UNIQUE(data_root,namespace,collection)) WITHOUT ROWID;
+CREATE TRIGGER index_definition_identity BEFORE UPDATE OF id,legacy_binding,backing_root,data_root,namespace,collection ON index_definitions
+ BEGIN SELECT RAISE(ABORT,'index backing identity is immutable'); END;
+
+CREATE TABLE index_sources(
+ id TEXT PRIMARY KEY CHECK(substr(id,1,4)='src_' AND length(id)=36 AND substr(id,5) NOT GLOB '*[^0-9a-f]*'),
+ index_id TEXT NOT NULL REFERENCES index_definitions(id) ON DELETE RESTRICT,
+ canonical_path TEXT NOT NULL CHECK(length(CAST(canonical_path AS BLOB)) BETWEEN 1 AND 32768),
+ owner INTEGER NOT NULL CHECK(owner IN(0,1)),
+ enabled INTEGER NOT NULL CHECK(enabled IN(0,1)),
+ UNIQUE(index_id,id), UNIQUE(index_id,canonical_path)) WITHOUT ROWID;
+CREATE UNIQUE INDEX index_sources_primary ON index_sources(index_id) WHERE owner=1;
+CREATE TRIGGER index_source_identity BEFORE UPDATE OF id,index_id,canonical_path,owner ON index_sources
+ BEGIN SELECT RAISE(ABORT,'source identity is immutable'); END;
+CREATE TABLE index_source_aliases(
+ index_id TEXT NOT NULL,
+ source_id TEXT NOT NULL,
+ alias TEXT NOT NULL CHECK(length(CAST(alias AS BLOB)) BETWEEN 1 AND 128),
+ PRIMARY KEY(index_id,alias),
+ FOREIGN KEY(index_id,source_id) REFERENCES index_sources(index_id,id) ON DELETE CASCADE) WITHOUT ROWID;
+CREATE INDEX index_alias_source ON index_source_aliases(source_id);
+
+CREATE TABLE query_projects(
+ id TEXT PRIMARY KEY CHECK(substr(id,1,4)='prj_' AND length(id)=36 AND substr(id,5) NOT GLOB '*[^0-9a-f]*'),
+ name TEXT NOT NULL CHECK(length(CAST(name AS BLOB)) BETWEEN 1 AND 256),
+ definition_revision INTEGER NOT NULL CHECK(definition_revision>=1),
+ scope_revision INTEGER NOT NULL CHECK(scope_revision>=1),
+ defaults_revision INTEGER NOT NULL CHECK(defaults_revision>=1)) WITHOUT ROWID;
+CREATE TABLE project_index_memberships(
+ project_id TEXT NOT NULL REFERENCES query_projects(id) ON DELETE CASCADE,
+ index_id TEXT NOT NULL REFERENCES index_definitions(id) ON DELETE RESTRICT,
+ revision INTEGER NOT NULL CHECK(revision>=1),
+ PRIMARY KEY(project_id,index_id)) WITHOUT ROWID;
+CREATE INDEX index_project_memberships ON project_index_memberships(index_id,project_id);
+CREATE TABLE project_index_scopes(
+ project_id TEXT NOT NULL, index_id TEXT NOT NULL, source_id TEXT NOT NULL,
+ kind TEXT NOT NULL CHECK(kind IN('exact','subtree')),
+ path TEXT NOT NULL CHECK(length(CAST(path AS BLOB))<=4096 AND (kind='subtree' OR path<>'')),
+ PRIMARY KEY(project_id,index_id,source_id,kind,path),
+ FOREIGN KEY(project_id,index_id) REFERENCES project_index_memberships(project_id,index_id) ON DELETE CASCADE,
+ FOREIGN KEY(index_id,source_id) REFERENCES index_sources(index_id,id) ON DELETE RESTRICT) WITHOUT ROWID;
+CREATE INDEX index_scope_sources ON project_index_scopes(source_id);
+CREATE TABLE project_default_indexes(
+ project_id TEXT NOT NULL, index_id TEXT NOT NULL,
+ PRIMARY KEY(project_id,index_id),
+ FOREIGN KEY(project_id,index_id) REFERENCES project_index_memberships(project_id,index_id) ON DELETE CASCADE) WITHOUT ROWID;
+
+CREATE TABLE legacy_index_projects(
+ legacy_binding TEXT PRIMARY KEY REFERENCES index_definitions(legacy_binding) ON DELETE RESTRICT,
+ project_id TEXT REFERENCES query_projects(id) ON DELETE SET NULL,
+ project_identity TEXT NOT NULL UNIQUE CHECK(substr(project_identity,1,4)='prj_' AND length(project_identity)=36 AND substr(project_identity,5) NOT GLOB '*[^0-9a-f]*'),
+ CHECK(project_id IS NULL OR project_id=project_identity)) WITHOUT ROWID;
+
+CREATE TABLE index_contexts(
+ id TEXT PRIMARY KEY CHECK(substr(id,1,4)='ctx_' AND length(id)=36 AND substr(id,5) NOT GLOB '*[^0-9a-f]*'),
+ host TEXT NOT NULL CHECK(length(host)=64 AND host NOT GLOB '*[^0-9a-f]*'),
+ context_key TEXT NOT NULL CHECK(length(context_key)=64 AND context_key NOT GLOB '*[^0-9a-f]*'),
+ kind TEXT NOT NULL CHECK(kind IN('folder','workspace','empty','untitled','legacy_pending')),
+ name TEXT NOT NULL CHECK(length(CAST(name AS BLOB)) BETWEEN 1 AND 256),
+ revision INTEGER NOT NULL CHECK(revision>=1),
+ UNIQUE(host,context_key)) WITHOUT ROWID;
+CREATE TABLE context_projects(
+ context_id TEXT NOT NULL REFERENCES index_contexts(id) ON DELETE CASCADE,
+ project_id TEXT NOT NULL REFERENCES query_projects(id) ON DELETE CASCADE,
+ PRIMARY KEY(context_id,project_id)) WITHOUT ROWID;
+CREATE INDEX project_contexts ON context_projects(project_id,context_id);
+CREATE TABLE context_default_indexes(
+ context_id TEXT NOT NULL REFERENCES index_contexts(id) ON DELETE CASCADE,
+ index_id TEXT NOT NULL REFERENCES index_definitions(id) ON DELETE RESTRICT,
+ PRIMARY KEY(context_id,index_id)) WITHOUT ROWID;
+CREATE INDEX index_context_defaults ON context_default_indexes(index_id,context_id);
+
+CREATE TABLE index_access_grants(
+ id TEXT PRIMARY KEY CHECK(substr(id,1,4)='grt_' AND length(id)=36 AND substr(id,5) NOT GLOB '*[^0-9a-f]*'),
+ host TEXT NOT NULL CHECK(length(host)=64 AND host NOT GLOB '*[^0-9a-f]*'),
+ revision INTEGER NOT NULL CHECK(revision>=1),
+ revoked INTEGER NOT NULL CHECK(revoked IN(0,1))) WITHOUT ROWID;
+-- Project IDs are frozen history, not cascading current preferences. Effective
+-- authority must also resolve the current Project and membership at delivery.
+CREATE TABLE index_access_memberships(
+ grant_id TEXT NOT NULL REFERENCES index_access_grants(id) ON DELETE CASCADE,
+ project_id TEXT NOT NULL CHECK(substr(project_id,1,4)='prj_' AND length(project_id)=36 AND substr(project_id,5) NOT GLOB '*[^0-9a-f]*'),
+ index_id TEXT NOT NULL REFERENCES index_definitions(id) ON DELETE RESTRICT,
+ membership_revision INTEGER NOT NULL CHECK(membership_revision>=1),
+ source_revision INTEGER NOT NULL CHECK(source_revision>=1),
+ policy_epoch INTEGER NOT NULL CHECK(policy_epoch>=0),
+ policy_digest TEXT CHECK(policy_digest IS NULL OR length(policy_digest)=64 AND policy_digest NOT GLOB '*[^0-9a-f]*'),
+ CHECK((policy_epoch=0 AND policy_digest IS NULL) OR (policy_epoch>0 AND policy_digest IS NOT NULL)),
+ PRIMARY KEY(grant_id,project_id,index_id)) WITHOUT ROWID;
+CREATE INDEX index_grant_memberships ON index_access_memberships(index_id,grant_id,project_id);
+CREATE TRIGGER index_grant_source_ready BEFORE INSERT ON index_access_memberships
+ WHEN NOT EXISTS(SELECT 1 FROM index_definitions WHERE id=NEW.index_id AND tombstone=0 AND source_import_state='complete')
+ BEGIN SELECT RAISE(ABORT,'index source metadata is unavailable'); END;
+CREATE TABLE index_access_scopes(
+ grant_id TEXT NOT NULL, project_id TEXT NOT NULL, index_id TEXT NOT NULL, source_id TEXT NOT NULL,
+ kind TEXT NOT NULL CHECK(kind IN('exact','subtree')),
+ path TEXT NOT NULL CHECK(length(CAST(path AS BLOB))<=4096 AND (kind='subtree' OR path<>'')),
+ PRIMARY KEY(grant_id,project_id,index_id,source_id,kind,path),
+ FOREIGN KEY(grant_id,project_id,index_id) REFERENCES index_access_memberships(grant_id,project_id,index_id) ON DELETE CASCADE,
+ FOREIGN KEY(index_id,source_id) REFERENCES index_sources(index_id,id) ON DELETE RESTRICT) WITHOUT ROWID;
+CREATE INDEX source_grants ON index_access_scopes(source_id,grant_id);
+
+CREATE TABLE index_context_imports(
+ import_key TEXT PRIMARY KEY CHECK(length(import_key)=64 AND import_key NOT GLOB '*[^0-9a-f]*'),
+ request_digest TEXT NOT NULL CHECK(length(request_digest)=64 AND request_digest NOT GLOB '*[^0-9a-f]*'),
+ catalog_revision INTEGER NOT NULL CHECK(catalog_revision>=1),
+ context_id TEXT REFERENCES index_contexts(id) ON DELETE SET NULL,
+ context_identity TEXT NOT NULL CHECK(substr(context_identity,1,4)='ctx_' AND length(context_identity)=36 AND substr(context_identity,5) NOT GLOB '*[^0-9a-f]*'),
+ CHECK(context_id IS NULL OR context_id=context_identity)) WITHOUT ROWID;
+CREATE INDEX context_import_receipts ON index_context_imports(context_identity);
+CREATE TABLE index_operation_receipts(
+ id TEXT PRIMARY KEY CHECK(length(id)=32 AND id NOT GLOB '*[^0-9a-f]*'),
+ kind TEXT NOT NULL CHECK(length(CAST(kind AS BLOB)) BETWEEN 1 AND 32),
+ stage TEXT NOT NULL CHECK(length(CAST(stage AS BLOB)) BETWEEN 1 AND 64),
+ revision INTEGER NOT NULL CHECK(revision>=1),
+ payload BLOB NOT NULL CHECK(length(payload)<=16384)) WITHOUT ROWID;
diff --git a/crates/airk-store/src/service_catalog_settlement.rs b/crates/airk-store/src/service_catalog_settlement.rs
new file mode 100644
index 0000000..77f3f0c
--- /dev/null
+++ b/crates/airk-store/src/service_catalog_settlement.rs
@@ -0,0 +1,345 @@
+// SPDX-License-Identifier: Apache-2.0
+//! Readiness records, gated settlement and snapshot restoration before new writes.
+use super::*;
+
+/// CLI owns process execution and payload verification. Store persists its exact
+/// refusal evidence; a command-parser error is not a registry refusal. This is
+/// an installer contract, not an untrusted MCP or editor request.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct RuntimeRefusal {
+    pub payload_identity: Sha256Digest,
+    pub read_refusal_digest: Sha256Digest,
+    pub write_refusal_digest: Sha256Digest,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub native_provenance: Option<NativeRefusalProvenance>,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum NativeReadRefusalEntrypoint {
+    ServiceRequestsList,
+    HiddenUpgradeProbe,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum NativeWriteRefusalEntrypoint {
+    ServiceRequestsForget,
+    HiddenUpgradeMigrate,
+}
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct NativeRefusalEntrypoints {
+    pub read: NativeReadRefusalEntrypoint,
+    pub write: NativeWriteRefusalEntrypoint,
+}
+/// Digests of actual native diagnostics. The executing producer must classify
+/// the final diagnostic as a format/authority refusal, never parser failure or
+/// AdmissionPending. Store validates binding, not the truth of raw diagnostics.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct NativeRefusalDiagnostic {
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub initial_admission_pending_digest: Option<Sha256Digest>,
+    pub final_classified_diagnostic_digest: Sha256Digest,
+}
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct NativeRefusalProvenance {
+    pub native_entrypoints: NativeRefusalEntrypoints,
+    pub read: NativeRefusalDiagnostic,
+    pub write: NativeRefusalDiagnostic,
+}
+impl NativeRefusalProvenance {
+    fn validate(&self) -> Result<()> {
+        ensure!(
+            matches!(
+                self.native_entrypoints.read,
+                NativeReadRefusalEntrypoint::HiddenUpgradeProbe
+            ) == self.read.initial_admission_pending_digest.is_some()
+                && matches!(
+                    self.native_entrypoints.write,
+                    NativeWriteRefusalEntrypoint::HiddenUpgradeMigrate
+                ) == self.write.initial_admission_pending_digest.is_some(),
+            "native refusal entrypoint/fallback provenance differs"
+        );
+        airk_core::index_catalog::encoded_size(self, 4096)?;
+        Ok(())
+    }
+}
+impl RuntimeRefusal {
+    pub fn from_native(
+        payload_identity: Sha256Digest,
+        provenance: NativeRefusalProvenance,
+    ) -> Result<Self> {
+        provenance.validate()?;
+        let bytes = serde_json::to_vec(&provenance)?;
+        let bind = |direction: &[u8]| {
+            framed_digest(
+                b"airk/catalog-native-refusal-provenance/1",
+                &[payload_identity.as_bytes(), &bytes, direction],
+            )
+        };
+        Ok(Self {
+            payload_identity,
+            read_refusal_digest: bind(b"read"),
+            write_refusal_digest: bind(b"write"),
+            native_provenance: Some(provenance),
+        })
+    }
+    pub fn validate(&self) -> Result<()> {
+        if let Some(provenance) = &self.native_provenance {
+            let expected = Self::from_native(self.payload_identity, provenance.clone())?;
+            ensure!(
+                self.read_refusal_digest == expected.read_refusal_digest
+                    && self.write_refusal_digest == expected.write_refusal_digest,
+                "native refusal digest does not bind its full provenance"
+            );
+        }
+        // None is an existing P5 proof: preserve its exact bytes and historical
+        // digest meaning. Never reinterpret or rewrite stored predecessor proof.
+        Ok(())
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ReadinessEvidence {
+    pub schema: u32,
+    pub candidate: CatalogUpgradeObservation,
+    pub predecessor_refusals: Vec<RuntimeRefusal>,
+}
+impl ReadinessEvidence {
+    pub(super) fn validate(&self, receipt: &UpgradeReceipt) -> Result<()> {
+        let observation = &self.candidate;
+        ensure!(
+            self.schema == 1
+                && observation.schema == 1
+                && observation.plan_digest == receipt.plan_digest
+                && observation.installer_identity == receipt.plan.installer_identity
+                && observation.catalog.namespace == receipt.plan.namespace
+                && observation.catalog.upgrade_id == receipt.plan.id
+                && observation.catalog.schema == 12
+                && !observation.catalog.activated
+                && !observation.catalog.accepted_new_writes,
+            "catalog readiness is not bound to this inactive upgrade"
+        );
+        ensure!(
+            !self.predecessor_refusals.is_empty() && self.predecessor_refusals.len() <= 8,
+            "catalog readiness requires bounded predecessor read/write refusal evidence"
+        );
+        let mut identities = BTreeSet::new();
+        for predecessor in &self.predecessor_refusals {
+            predecessor.validate()?;
+            ensure!(
+                predecessor.payload_identity != observation.installer_identity
+                    && identities.insert(predecessor.payload_identity),
+                "ambiguous predecessor compatibility evidence"
+            );
+        }
+        airk_core::index_catalog::encoded_size(self, 16384)?;
+        Ok(())
+    }
+}
+
+impl CatalogUpgrade {
+    pub fn record_readiness(&self, evidence: ReadinessEvidence) -> Result<UpgradeReceipt> {
+        let mut receipt = self.receipt()?;
+        ensure!(
+            matches!(
+                receipt.stage,
+                UpgradeStage::Imports | UpgradeStage::Readiness
+            ),
+            "catalog readiness is not admitted in this stage"
+        );
+        evidence.validate(&receipt)?;
+        let current = observe(&self.root, receipt.plan.id, evidence.candidate.nonce)?;
+        ensure!(
+            current == evidence.candidate,
+            "candidate catalog observation is stale or incomplete"
+        );
+        if let Some(previous) = &receipt.readiness {
+            ensure!(previous == &evidence, "catalog readiness evidence changed");
+        }
+        receipt.readiness = Some(evidence);
+        receipt.stage = UpgradeStage::Readiness;
+        self.save(&receipt)?;
+        Ok(receipt)
+    }
+
+    pub fn settle(&self) -> Result<UpgradeReceipt> {
+        anyhow::bail!(
+            "P5 readiness cannot activate a production catalog; qualify and settle authority contract 1"
+        )
+    }
+
+    #[cfg(test)]
+    fn settle_at(&self, checkpoint: impl Fn(&str) -> Result<()>) -> Result<UpgradeReceipt> {
+        let mut receipt = pending(&self.root)?.context("catalog upgrade intent missing")?;
+        ensure!(
+            receipt.plan.namespace == self.namespace
+                && matches!(
+                    receipt.stage,
+                    UpgradeStage::Readiness | UpgradeStage::Settled
+                ),
+            "catalog settlement is not admitted in this stage"
+        );
+        let read = registry_read(&self.root)?;
+        super::super::validate_existing(&read)?;
+        let state = super::super::state(&read)?;
+        ensure!(
+            state.namespace == self.namespace && state.upgrade_id == receipt.plan.id,
+            "catalog settlement identity changed"
+        );
+        let owner = super::super::super::owner_record(&self.root, true, self.namespace)?;
+        ensure!(
+            owner.catalog_upgrade.is_none() || owner.catalog_upgrade == Some(receipt.plan.id),
+            "catalog settlement owner fence changed"
+        );
+        if owner.catalog_upgrade.is_none() {
+            // A crash after clearing admission may be followed by legitimate new
+            // writes. The durable activation and saved readiness prove cutover;
+            // never restore or demand that legacy rows remain frozen afterwards.
+            ensure!(
+                state.activated && receipt.readiness.is_some(),
+                "catalog settlement lost admission before activation"
+            );
+            receipt.stage = UpgradeStage::Settled;
+            self.save(&receipt)?;
+            return Ok(receipt);
+        }
+        ensure!(
+            !state.accepted_new_writes,
+            "catalog accepted new writes before settlement; forward repair required"
+        );
+        Self::validate_backfill(&self.root, self.namespace, &read, &receipt)?;
+        let evidence = receipt
+            .readiness
+            .as_ref()
+            .context("catalog readiness evidence missing")?;
+        ensure!(
+            state.revision == evidence.candidate.catalog.revision,
+            "catalog changed after candidate readiness probe"
+        );
+        drop(read);
+        if !state.activated {
+            let connection = Connection::open_with_flags(
+                self.root.join(DATABASE),
+                OpenFlags::SQLITE_OPEN_READ_WRITE,
+            )?;
+            connection.execute_batch("PRAGMA synchronous=FULL; BEGIN IMMEDIATE; UPDATE index_catalog_meta SET activated=1 WHERE id=1 AND activated=0 AND accepted_new_writes=0; COMMIT;")?;
+        }
+        checkpoint("after_catalog_activation")?;
+        self.clear_fence(receipt.plan.id)?;
+        checkpoint("after_admission_clear")?;
+        receipt.stage = UpgradeStage::Settled;
+        self.save(&receipt)?;
+        Ok(receipt)
+    }
+
+    fn clear_fence(&self, id: Incarnation) -> Result<()> {
+        let mut owner = super::super::super::owner_record(&self.root, true, self.namespace)?;
+        ensure!(
+            owner.catalog_upgrade == Some(id),
+            "catalog admission fence changed before settlement"
+        );
+        owner.catalog_upgrade = None;
+        persist(
+            &self.root.join("service-1.4.owner.json"),
+            &serde_json::to_vec(&owner)?,
+        )
+    }
+
+    /// Before any settled new-format write, restore only the qualified private
+    /// registry snapshot. Source directories and collection bytes are untouched.
+    /// After the write barrier, refuse downgrade and require forward repair.
+    pub fn restore(&self) -> Result<UpgradeReceipt> {
+        self.restore_at(|_| Ok(()))
+    }
+
+    fn restore_at(&self, checkpoint: impl Fn(&str) -> Result<()>) -> Result<UpgradeReceipt> {
+        let mut receipt = pending(&self.root)?.context("catalog upgrade intent missing")?;
+        ensure!(
+            receipt.plan.namespace == self.namespace,
+            "catalog restore namespace changed"
+        );
+        let read = registry_read(&self.root)?;
+        let version: u32 = read.pragma_query_value(None, "user_version", |row| row.get(0))?;
+        let mut owner = super::super::super::owner_record(&self.root, true, self.namespace)?;
+        ensure!(
+            owner.catalog_upgrade.is_none() || owner.catalog_upgrade == Some(receipt.plan.id),
+            "catalog restore owner changed"
+        );
+        if receipt.stage == UpgradeStage::Restored {
+            ensure!(
+                version == 11 && owner.catalog_upgrade.is_none(),
+                "restored catalog no longer matches its supported format"
+            );
+            return Ok(receipt);
+        }
+        if version == 11
+            && owner.catalog_upgrade.is_none()
+            && receipt.stage == UpgradeStage::Restoring
+        {
+            // Admission is cleared only after successful snapshot restore.
+            // Legacy writes may have resumed before the external receipt was
+            // saved. Finalize it without replaying or freezing those rows.
+            super::super::backup::integrity(&read)?;
+            receipt.stage = UpgradeStage::Restored;
+            self.save(&receipt)?;
+            return Ok(receipt);
+        }
+        if version == 12 {
+            super::super::validate_existing(&read)?;
+            let state = super::super::state(&read)?;
+            ensure!(
+                state.namespace == self.namespace && state.upgrade_id == receipt.plan.id,
+                "catalog restore identity changed"
+            );
+            ensure!(
+                !state.accepted_new_writes,
+                "catalog has accepted new writes; automatic restore or downgrade refused; forward repair required"
+            );
+            Self::validate_backfill(&self.root, self.namespace, &read, &receipt)?;
+            self.qualified_backup(&receipt)?;
+        } else {
+            super::super::backup::integrity(&read)?;
+            if let Some(digest) = receipt.legacy_data_digest {
+                ensure!(
+                    super::super::backup::legacy_data_digest(&read)? == digest,
+                    "legacy rows changed before restore settlement"
+                );
+            }
+        }
+        drop(read);
+        owner.catalog_upgrade = Some(receipt.plan.id);
+        persist(
+            &self.root.join("service-1.4.owner.json"),
+            &serde_json::to_vec(&owner)?,
+        )?;
+        receipt.stage = UpgradeStage::Restoring;
+        self.save(&receipt)?;
+        checkpoint("restore_intent")?;
+        if version == 12 {
+            let attempt = self.qualified_backup(&receipt)?;
+            super::super::backup::restore(
+                &self.root,
+                receipt.plan.id,
+                attempt,
+                receipt
+                    .legacy_data_digest
+                    .context("catalog restore row identity missing")?,
+            )?;
+        }
+        checkpoint("after_snapshot_restore")?;
+        self.clear_fence(receipt.plan.id)?;
+        checkpoint("after_restore_admission_clear")?;
+        receipt.stage = UpgradeStage::Restored;
+        self.save(&receipt)?;
+        Ok(receipt)
+    }
+}
