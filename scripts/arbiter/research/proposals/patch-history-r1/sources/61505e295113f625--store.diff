+    let status = fixture.quota.status()?;
+    assert_eq!(
+        status.collections["destination"].used_bytes,
+        participant.baseline_used_bytes + consumed
+    );
+    assert_eq!(status.reserved_bytes + consumed, 2 * BUDGET);
+    Ok(())
+}
