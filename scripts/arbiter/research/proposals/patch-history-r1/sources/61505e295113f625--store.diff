+    fs::remove_file(&control)?;
+    fs::create_dir(&control)?;
+    let reservations = control.join("reservations");
+    std::os::unix::fs::symlink(&foreign_path, &reservations)?;
+    assert!(validate_existing_service_claim(&root).is_err());
