+            expected,
+            temporary: None,
+            _reservation: None,
+            had_current: false,
+        };
+        if let Some(expected) = prepared.expected.as_mut() {
+            let bytes = database::extraction_contract_bytes(
+                self.directory(),
+                expected,
+                root,
+                collection,
+                contract,
+            )?;
+            let reservation = quota.reserve(collection, 2 * 65_536)?;
+            reservation.charge(bytes.len() as u64)?;
+            prepared.temporary = Some(
