+        let enabled: bool = db.query_row(
+            "SELECT EXISTS(SELECT 1 FROM index_sources WHERE id=?1 AND index_id=?2 AND enabled=1)",
+            params![atom.source_root_id.to_string(), m.index_id.to_string()],
+            |r| r.get(0),
