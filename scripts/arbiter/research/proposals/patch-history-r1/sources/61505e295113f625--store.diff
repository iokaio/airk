+        } else {
+            require_absent_current(&prepared.pin)?;
+            require_absent_native_entries(&prepared.pin, &["current-runtime-bootstrap.json"])?;
+        }
+        writer.invalidate_census_before_mutation()?;
+        Ok(prepared)
+    }
