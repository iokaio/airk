+    registry.record_service_instance(&lease, current)?;
+    let mut changed = second.clone();
+    changed.boot.elapsed_ns += 1;
+    assert!(
+        registry
+            .prune_drained_shared_helpers(&lease, current, &[first.clone(), changed])
+            .is_err()
+    );
