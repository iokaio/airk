+                        .context("transaction checkpoint missing")?
+                        .cache_flush()?;
+                    std::process::exit(73);
+                }
+                Ok(())
+            })?;
+            anyhow::bail!("migration did not reach the interruption point")
+        }
+        _ => anyhow::bail!("unknown crash fixture"),
