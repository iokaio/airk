+    let install_receipt = base.join("install/runtime-layout.json");
+    let state_receipt = base.join("state/airk-state-1.4.owner.json");
+    let save = |value: &serde_json::Value| -> Result<()> {
+        let bytes = serde_json::to_vec(value)?;
