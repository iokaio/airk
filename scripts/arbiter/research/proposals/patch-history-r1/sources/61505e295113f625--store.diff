+            Err(error) if missing_entry(&error) => (),
+            Err(error) => return Err(error),
+            Ok(directory) => ensure!(
+                directory.entries()?.next().transpose()?.is_none(),
+                "unbound retired collection namespace is not empty"
+            ),
+        }
+        Ok(())
+    }
