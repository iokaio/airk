+            assert_eq!(
+                registry.due_background_jobs(None, 100, 1)?[0].2,
+                JobKind::Vectors
+            );
+            if failures < 3 {
+                assert!(registry.due_background_jobs(None, 101, 1)?.is_empty());
+            }
+            let vector =
+                registry.enqueue_internal(project, nonce(2), JobKind::Vectors, nonce(3))?;
