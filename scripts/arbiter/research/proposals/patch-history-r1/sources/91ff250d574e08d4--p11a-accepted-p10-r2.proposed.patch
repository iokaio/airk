+// SPDX-License-Identifier: Apache-2.0
+//! Real scoped workers, native frontend, CLI call/console/info, and stdio MCP.
+use super::*;
+
+async fn cli_catalog(f: &Fixture) -> Result<Value> {
+    let mut command = Command::new(&f.candidate);
+    command
+        .arg("--combined-session")
+        .arg(serde_json::to_string(&f.session)?)
+        .arg("--service-runtime-dir")
+        .arg(&f.control)
+        .args(["tools", "list", "--json"]);
+    let output = tokio::task::spawn_blocking(move || read_retry::output(&mut command)).await??;
+    ensure!(
+        output.status.success(),
+        "native CLI catalog failed: {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    Ok(serde_json::from_slice(&output.stdout)?)
+}
+async fn console(f: &Fixture, args: &Value) -> Result<Value> {
+    let input = f.owner.path().join("profile-families-console.in");
+    let stdout = f.owner.path().join("profile-families-console.out");
+    let stderr = f.owner.path().join("profile-families-console.err");
+    fs::write(&input, format!("call airk_file_info {args}\nexit\n"))?;
+    let mut command = Command::new(&f.candidate);
+    command
+        .arg("--combined-session")
+        .arg(serde_json::to_string(&f.session)?)
+        .arg("--service-runtime-dir")
+        .arg(&f.control)
+        .args(["tools", "shell"])
+        .stdin(fs::File::open(input)?)
+        .stdout(
+            fs::OpenOptions::new()
+                .create_new(true)
+                .write(true)
+                .open(&stdout)?,
+        )
+        .stderr(
+            fs::OpenOptions::new()
+                .create_new(true)
+                .write(true)
+                .open(&stderr)?,
+        );
+    let mut process = OwnedProcess::start(command)?;
+    let deadline = Instant::now() + Duration::from_secs(60);
+    loop {
+        if let Some(status) = process.child.try_wait()? {
+            ensure!(status.success(), "console failed");
+            break;
+        }
+        ensure!(Instant::now() < deadline, "native console timeout");
+        tokio::time::sleep(Duration::from_millis(25)).await;
+    }
+    drop(process);
+    ensure!(
+        fs::metadata(&stdout)?.len() <= 16 << 20 && fs::metadata(&stderr)?.len() <= 16 << 20,
+        "console diagnostics exceed bound"
+    );
+    ensure!(
+        fs::read(&stderr)?.is_empty(),
+        "console tool failed: {}",
+        fs::read_to_string(&stderr)?
+    );
+    let text = fs::read_to_string(stdout)?;
+    let offset = text.find("airk> {").context("console result absent")? + "airk> ".len();
+    serde_json::Deserializer::from_str(&text[offset..])
+        .into_iter::<Value>()
+        .next()
+        .context("console JSON result absent")?
+        .map_err(Into::into)
+}
+async fn convenience(f: &Fixture) -> Result<Value> {
+    let mut command = Command::new(&f.candidate);
+    command
+        .arg("--combined-session")
+        .arg(serde_json::to_string(&f.session)?)
+        .arg("--service-runtime-dir")
+        .arg(&f.control)
+        .arg("--project-ids")
+        .arg(f.projects[0].to_string())
+        .arg("--index-ids")
+        .arg(f.indexes[0].to_string())
+        .args([
+            "--member-availability",
+            "require",
+            "info",
+            "api/policy.md",
+            "--include-profile-families",
+            "--verification",
+            "off",
+            "--reply-detail",
+            "rich",
+        ])
+        .env("AIRK_MCP_RESPONSE_MODE", "full");
+    let output = tokio::task::spawn_blocking(move || read_retry::output(&mut command)).await??;
+    ensure!(
+        output.status.success(),
+        "native convenience info failed: {}",
