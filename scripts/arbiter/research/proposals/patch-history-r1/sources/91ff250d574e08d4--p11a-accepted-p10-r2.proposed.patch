+            .err()
+            .context("real private metadata error was downgraded")?;
+        assert!(!full_error.is::<ScopeReadRefused>());
+        std::fs::rename(&root, base.join("unavailable-originals"))?;
+        let options = EvidenceReadOptions {
+            revision: Some(token),
