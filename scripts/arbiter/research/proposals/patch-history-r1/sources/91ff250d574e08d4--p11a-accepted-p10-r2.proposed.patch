+    let native = body(&native_read(backend.as_ref(), "airk_file_info", &conditional).await?)?;
+    let cli = body(&f.cli("airk_file_info", &conditional).await?)?;
+    let wire = conditional_mcp.call(3, "file_info", conditional.clone())?;
