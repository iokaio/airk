+// SPDX-License-Identifier: Apache-2.0
+//! Bounded observations only; never a session, scorer or execution capability.
+use super::*;
+#[derive(Clone, Debug, Serialize)]
+pub struct LogRow {
+    pub location: String,
+    pub message: String,
