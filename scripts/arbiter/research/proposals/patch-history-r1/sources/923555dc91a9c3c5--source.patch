+                && logs.selected == logs.retained
+                && logs.seen >= logs.selected
+                && logs.bytes <= 65536
+                && logs
+                    .rows
+                    .iter()
+                    .all(|r| r.location.len() + 2 + r.message.len() <= 4096)
