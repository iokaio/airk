+pub(super) fn retired_inventory(
+    directory: &crate::service::registry::catalog::setup::storage::SetupDirectory,
+    collection: &str,
+) -> Result<Vec<(std::ffi::OsString, File)>> {
+    use crate::service::registry::catalog::setup::storage::SetupFileMode;
