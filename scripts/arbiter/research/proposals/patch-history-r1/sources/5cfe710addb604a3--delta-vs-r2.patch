+            ModelAdmissionStatus::Unavailable
+        } else {
+            admission
+        };
+        let available = if chosen {
+            Availability::Ready
+        } else if kind == ModelAdmissionStatus::Unavailable {
+            Availability::Unqualified
+        } else if precision == Some(DevicePrecision::Float32)
