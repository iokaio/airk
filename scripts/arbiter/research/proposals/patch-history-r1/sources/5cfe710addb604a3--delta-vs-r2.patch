+fn abi(focus: bool) -> ScoreAbi {
+    let mut inputs = ["input_ids", "attention_mask", "position_ids"]
+        .into_iter()
+        .map(|name| TensorContract {
+            name: name.into(),
+            element: TensorType::Int64,
+            axes: vec![
+                if focus { "batch" } else { "batch_1" }.into(),
+                "tokens".into(),
+            ],
+        })
+        .collect::<Vec<_>>();
+    if !focus {
+        inputs.extend([
+            TensorContract {
+                name: "decision_positions".into(),
+                element: TensorType::Int64,
+                axes: vec!["batch_1".into()],
+            },
+            TensorContract {
+                name: "candidate_positions".into(),
+                element: TensorType::Int64,
+                axes: vec!["batch_1".into(), "options".into()],
+            },
+            TensorContract {
+                name: "option_mask".into(),
+                element: TensorType::Bool,
+                axes: vec!["batch_1".into(), "options".into()],
+            },
+        ]);
+    }
+    ScoreAbi {
+        readout: if focus {
+            Readout::FocusYesNo
+        } else {
+            Readout::DecisionSymbol
+        },
+        inputs,
+        output: TensorContract {
+            name: if focus { "logits" } else { "scores" }.into(),
+            element: TensorType::Float32,
+            axes: vec![
+                if focus { "batch" } else { "batch_1" }.into(),
+                if focus { "labels" } else { "options" }.into(),
+            ],
+        },
+    }
+}
+
+fn structural_calibration(profile: &Profile, policy: Sha256Digest) -> JointCalibration {
+    JointCalibration {
+        schema: CALIBRATION_SCHEMA.into(),
+        class_support: None,
+        model: profile.model,
+        compiler: profile.compiler,
+        task_policy: policy,
+        score_abi: profile.abi.clone(),
+        assets: trained_assets(profile),
+        // Structural input for raw-score collection only; never a fitted rule.
+        rules: vec![JointRule {
+            action: ContextActionClass::Read,
+            allowed_gaps: vec![Gap::Unsupported],
+            allowed_reasons: vec![ContextReason::AdditionalEvidenceMayHelp],
+            allowed_roles: vec![EvidenceRole::Unknown],
+            allowed_relevance: vec![RelevanceHypothesis::Uncertain],
+            minimum_raw_margin: f32::MAX,
+        }],
+    }
+}
+fn trained_assets(profile: &Profile) -> BTreeMap<String, JointAssetBinding> {
+    profile
+        .assets
+        .iter()
+        .filter(|asset| {
+            matches!(
+                asset.role,
+                AssetRole::Model | AssetRole::ExternalWeights | AssetRole::Tokenizer
+            )
+        })
+        .map(|asset| {
+            (
+                asset.name.clone(),
+                JointAssetBinding {
+                    role: asset.role.clone(),
+                    sha256: asset.sha256,
+                },
+            )
+        })
+        .collect()
+}
