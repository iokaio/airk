+                attention_mask: vec![1; tokens],
+                position_ids: (0..tokens as i64).collect(),
+                decision_position: tokens as i64 - 1,
+                candidate_positions: (32..32 + options as i64).collect(),
+                option_mask: vec![true; options],
+                input_digest: sha(1),
