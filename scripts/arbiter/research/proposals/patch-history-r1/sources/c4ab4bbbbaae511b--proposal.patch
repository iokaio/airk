+            reference_same_artifact: vec![0.; options],
+            reference_original_fp32: vec![0.; options],
+        })
+        .collect();
+    let mut fixture = Fixture {
+        schema: "airk.arbiter.device-acceptance-input/1".into(),
+        model: profile.model,
+        compiler: profile.compiler,
