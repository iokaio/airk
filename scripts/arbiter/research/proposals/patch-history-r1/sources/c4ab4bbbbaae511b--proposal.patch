+#[test]
+fn complete_fixture_denominator_masks_and_source_are_required_before_native_work() -> Result<()> {
+    let mut profile = crate::arbiter::runtime::catalog_profiles()?
+        .into_iter()
+        .find(|p| p.model == ModelChoice::ContextQwenCompact)
