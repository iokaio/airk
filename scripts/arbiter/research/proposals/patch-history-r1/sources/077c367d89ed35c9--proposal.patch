+        "a passing early row must not hide late posthash growth"
+    );
+    assert!(final_host_peak(None, 10).is_err());
+    assert!(final_host_peak(Some(0), 10).is_err());
+    assert_eq!(final_host_peak(Some(10), 10)?, 10);
+    Ok(())
+}
