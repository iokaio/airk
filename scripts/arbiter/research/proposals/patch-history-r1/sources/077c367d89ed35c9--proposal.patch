+        .iter()
+        .any(|v| v.name == current.name && v.path == current.path && v.id == current.id)
+        || baseline.iter().any(|v| {
+            v.address == current.address
+                && v.name == current.name
+                && v.path == current.path
+                && v.id == current.id
+        })
