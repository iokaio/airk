+const HF_BACKUP: &str = "https://huggingface.co/Qwen/Qwen3-1.7B/resolve/70d244cc86ccca08cf5af4e1e306ecf908b1ad5e/LICENSE";
+fn part() -> AssetPart {
+    AssetPart {
+        url: HF.into(),
+        backup_urls: vec![],
+        bytes: 11_343,
+        sha256: "832dd9e00a68dd83b3c3fb9f5588dad7dcf337a0db50f7d9483f310cd292e92e"
