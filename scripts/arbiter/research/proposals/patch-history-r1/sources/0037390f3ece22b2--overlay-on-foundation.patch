+        if self.recipe == CompilerRecipe::QwenSingleChoiceV1 {
+            let ids: BTreeSet<_> = self.symbols.iter().map(|symbol| symbol.id).collect();
+            ensure!(
+                ids.len() == self.symbols.len(),
+                "duplicate Qwen decision symbol ID"
