+            self.schema == COMPILER_SCHEMA
+                && (1..=8192).contains(&self.max_tokens)
+                && (1..=8).contains(&self.max_options),
+            "invalid Arbiter compiler profile"
+        );
+        ensure!(
+            self.controls.len() <= 16 && self.symbols.len() <= 8,
+            "Arbiter compiler token catalog limit"
