+        value
+    );
+    let mut wrong = binding();
+    wrong.source = Sha256Digest::from_bytes([12; 32]);
+    assert!(
+        DeviceConfiguration::decode(&bytes, value.installation, value.catalog, &wrong).is_err()
+    );
+    assert!(
+        DeviceConfiguration::decode(
