+            self.schema == 1 && self.lease_generation > 0,
+            "unsupported scoped read contract"
+        );
+        ensure!(
+            matches!(
+                (self.grant_id, self.grant_revision, self.selection),
+                (Some(_), Some(_), None) | (None, None, Some(_))
