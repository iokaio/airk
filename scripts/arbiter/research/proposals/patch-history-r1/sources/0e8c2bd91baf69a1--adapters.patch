+export function retirementJson(reply:RecordValue):string{return JSON.stringify(reply,null,2);}
+export function retirementMarkdown(reply:RecordValue):string {
+    return '# AIRK legacy upgrade retirement\n\nNative runtime administration; source files are preserved. Physical cleanup remains pending. This is not indexing/read authority. No recovery evidence is persisted by this view.\n\n```json\n'+retirementJson(reply)+'\n```\n';
+}
