+        for (name,digest) in [(ModelAssetName::ModelOnnx,&manifest.model_sha256),(ModelAssetName::TokenizerJson,&manifest.tokenizer_sha256),(ModelAssetName::License,&manifest.license_sha256)] {
+            let bytes=profile.assets.iter().find(|asset|asset.name==name.filename()).context("known native asset absent")?.bytes;
+            refs.insert(name,ModelObjectRef {sha256:digest.parse()?,bytes});
+        }
+        refs.insert(ModelAssetName::ModelJson,ModelObjectRef {sha256:Sha256Digest::from_bytes(Sha256::digest(&raw).into()),bytes:raw.len() as u64});
+        let set=airk_retrieval::model::plan_from_asset_references(&raw,refs)?;Ok((raw,set))
+    };
+    let (raw,active)=build(&profile.manifest)?;
+    let mut old_manifest=profile.manifest;old_manifest.model_sha256="03".repeat(32);
+    let (_,old)=build(&old_manifest)?;
+    let assets=Arc::new(MetadataSource {assets:BTreeMap::from([(ModelAssetName::ModelJson,raw)]),reads:Mutex::new(Vec::new())});
+    let kernel=Kernel::open_service_collection(&source,Some(data),"fixture")?
