+#[test]
+fn active_manifest_metadata_is_lazy_and_same_runtime_weight_change_cannot_mix_cache_keys() -> Result<()> {
+    struct OnlyMetadata(Vec<u8>);
+    impl ModelAssetSource for OnlyMetadata {
+        fn read_asset(&self,name:ModelAssetName,maximum:u64)->Result<Vec<u8>> {
+            ensure!(name==ModelAssetName::ModelJson && self.0.len() as u64<=maximum,"payload opened in metadata fence");
+            Ok(self.0.clone())
+        }
+    }
+    let profile=crate::model_catalog::selected_profile()?;
+    let build=|manifest:&OnnxManifest|->Result<(OnlyMetadata,ModelObjectSet)> {
+        let bytes=serde_json::to_vec(manifest)?;
+        let mut refs=BTreeMap::from([
+            (ModelAssetName::ModelOnnx,ModelObjectRef {sha256:manifest.model_sha256.parse()?,bytes:1}),
+            (ModelAssetName::TokenizerJson,ModelObjectRef {sha256:manifest.tokenizer_sha256.parse()?,bytes:1}),
+            (ModelAssetName::License,ModelObjectRef {sha256:manifest.license_sha256.parse()?,bytes:1}),
+        ]);
+        refs.insert(ModelAssetName::ModelJson,ModelObjectRef {sha256:Sha256Digest::from_bytes(Sha256::digest(&bytes).into()),bytes:bytes.len() as u64});
+        let set=plan_from_asset_references(&bytes,refs)?;Ok((OnlyMetadata(bytes),set))
+    };
+    let (source,current)=build(&profile.manifest)?;
+    assert!(onnx_asset_metadata_uses_active_catalog(&source,&current)?);
+    assert!(onnx_asset_metadata_uses_active_catalog(&OnlyMetadata(b"{}".to_vec()),&current).is_err(),"corrupt active metadata must remain an error");
+    let mut other=profile.manifest;other.model_sha256="01".repeat(32);
+    let (old_source,old)=build(&other)?;
+    assert!(!onnx_asset_metadata_uses_active_catalog(&old_source,&old)?);
+    assert_ne!(current.pipeline_digest,old.pipeline_digest);
+    let a=descriptor_from_asset_metadata(&source,&current)?;
+    let b=descriptor_from_asset_metadata(&old_source,&old)?;
+    assert_eq!(a.inference,b.inference,"regression must preserve the exact runtime");
+    assert_ne!(airk_core::embedding::embedding_key(&a,b"same input")?,airk_core::embedding::embedding_key(&b,b"same input")?);
+    let mut crossed=old.clone();crossed.pipeline_digest=current.pipeline_digest;
+    assert!(descriptor_from_asset_metadata(&old_source,&crossed).is_err());
+    Ok(())
+}
