+#[test]
+fn same_runtime_retired_weights_arm_the_shared_semantic_upgrade_fence() -> Result<()> {
+    use airk_core::{identity::Sha256Digest,model_objects::{ModelAssetName,ModelObjectRef}};
+    use sha2::{Digest,Sha256};
+    let owner=tempfile::Builder::new().tempdir_in(std::env::temp_dir().canonicalize()?)?;
+    let store=FileStore::new(owner.path().join("collection"));
+    let metadata=store.directory().join("objects/models");fs::create_dir_all(&metadata)?;
+    let selected=airk_retrieval::model_catalog::selected_profile()?;
+    let retain=|manifest:&airk_retrieval::model::OnnxManifest|->Result<ModelObjectSet> {
+        let raw=serde_json::to_vec(manifest)?;
+        let mut refs=std::collections::BTreeMap::new();
+        for (name,digest) in [(ModelAssetName::ModelOnnx,&manifest.model_sha256),(ModelAssetName::TokenizerJson,&manifest.tokenizer_sha256),(ModelAssetName::License,&manifest.license_sha256)] {
+            refs.insert(name,ModelObjectRef {sha256:digest.parse()?,bytes:1});
+        }
+        let pin=Sha256Digest::from_bytes(Sha256::digest(&raw).into());
+        fs::write(metadata.join(pin.to_string()),&raw)?;
+        refs.insert(ModelAssetName::ModelJson,ModelObjectRef {sha256:pin,bytes:raw.len() as u64});
+        airk_retrieval::model::plan_from_asset_references(&raw,refs)
+    };
+    let active=retain(&selected.manifest)?;
+    assert!(!semantic_upgrade_pending(&store,Some(&active))?);
+    let mut retired=selected.manifest;retired.model_sha256="02".repeat(32);
+    let old=retain(&retired)?;
+    let a=descriptor(&store,&active)?;let b=descriptor(&store,&old)?;
+    assert_eq!(a.inference,b.inference,"test must preserve exact runtime");
+    assert_ne!(a.identity()?,b.identity()?);
+    assert!(semantic_upgrade_pending(&store,Some(&old))?);
+    assert!(open_model(&store,&old).is_err(),"retired metadata must not authorize model execution");
+    assert!(!metadata.join(old.assets[&ModelAssetName::ModelOnnx].sha256.to_string()).exists(),"metadata fence read weights");
+    Ok(())
+}
