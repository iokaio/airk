+    let current=kernel.store.embedded_default_reference()?.context("active embedded reference absent")?;
+    assert!(!semantic_upgrade_pending(&kernel.store,Some(&current))?);
+    let old=old.shared_with(airk_store::service::model_files::model_scope(&runtime)?)?;
+    assert!(kernel.store.shared_model_source(&old).is_err(),"fixture unexpectedly installed historical assets");
+    assert!(semantic_upgrade_pending(&kernel.store,Some(&old))?);
+    let missing_active=kernel.store.clone().with_service_models(&runtime,active)?;
+    assert!(semantic_upgrade_pending(&missing_active,Some(&current)).is_err(),"missing active metadata must not become a success-shaped pending result");
+    let foreign=old.local_set().shared_with(Sha256Digest::from_bytes([9;32]))?;
+    assert!(semantic_upgrade_pending(&kernel.store,Some(&foreign)).is_err(),"foreign owner hidden by missing-retired fallback");
+    assert!(!runtime.join("model-files-1.4").exists());
+    assert_eq!(fs::read(source.join("memo.md"))?,b"original source remains unchanged");
+    assert!(assets.reads.lock().unwrap().iter().all(|name|*name==ModelAssetName::ModelJson));
