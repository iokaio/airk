// SPDX-License-Identifier: Apache-2.0
//! Effective current-object ACL decisions; inheritance alone grants nothing here.
use super::*;
pub(super) fn trusted(sid: &str) -> bool {
    matches!(
        sid,
        "S-1-5-18"
            | "S-1-5-32-544"
            | "S-1-5-80-956008885-3418522649-1831038044-1853292631-2271478464"
    )
}
/// Only inert proof metadata may choose its owner class from this actual object.
/// No ACL, JSON flag or parent owner selects an active runtime/payload class.
pub(super) fn proof_private(user:&str,owner:&str)->Result<bool>{
    ensure!(!user.is_empty()&&!owner.is_empty(),"unknown proof-source owner");
    if owner==user {Ok(true)} else {ensure!(trusted(owner),"proof source owner is neither current human nor OS trusted");Ok(false)}
}
pub(super) fn proof_grant(user:&str,who:&str,mask:u32)->Result<()> {
    // Inert proof integrity trusts current human and OS trustees independently
    // from which of them owns this same opened object; others remain read-only.
    grant(true,user,who,mask)
}
pub(super) fn effective_allow(header: [u8; 4]) -> Result<bool> {
    if header[1] & 0x08 != 0 {
        return Ok(false);
    } // INHERIT_ONLY, not INHERITED(0x10).
    if header[0] == 1 {
        return Ok(false);
    } // DENY never grants current-object access.
    ensure!(
        header[0] == 0 && u16::from_le_bytes([header[2], header[3]]) >= 20,
        "unsupported effective GPU custody ACE"
    );
    Ok(true)
}
pub(super) fn grant(private: bool, user: &str, who: &str, mask: u32) -> Result<()> {
    ensure!(
        (private && who == user) || trusted(who) || mask & 0x500d0156 == 0,
        "effective GPU custody grant permits foreign access/write"
    );
    Ok(())
}
#[cfg(test)]
mod tests {
    use super::*;
    #[test]
    fn creator_owner_raw_inherit_only_does_not_grant_current_object() {
        let ace = [
            0u8, 0x0b, 20, 0, 0, 0, 0, 0x10, 1, 1, 0, 0, 0, 0, 0, 3, 0, 0, 0, 0,
        ];
        assert!(!effective_allow(ace[..4].try_into().unwrap()).unwrap());
        let mut applied = ace;
        applied[1] = 3;
        assert!(effective_allow(applied[..4].try_into().unwrap()).unwrap());
        assert!(
            grant(
                false,
                "S-1-5-21-1",
                "S-1-3-0",
                u32::from_le_bytes(applied[4..8].try_into().unwrap())
            )
            .is_err()
        );
    }
    #[test]
    fn inherited_effective_foreign_write_is_not_ignored_or_child_authorized() {
        assert!(effective_allow([0, 0x10, 20, 0]).unwrap());
        assert!(grant(false, "u", "foreign", 0x10000000).is_err());
        assert!(grant(false, "u", "foreign", 0x1200a9).is_ok());
        assert!(grant(true, "u", "foreign", 0x1200a9).is_ok());
        assert!(grant(true, "u", "foreign", 0x40000000).is_err());
        assert!(effective_allow([5, 0, 20, 0]).is_err());
        assert!(!effective_allow([5, 8, 20, 0]).unwrap());
    }
    #[test]
    fn proof_parent_and_file_classes_are_independent_and_never_unknown()->Result<()> {
        let user="S-1-5-21-1002";
        // Legitimate OS-owned parent with human-owned child; inverse also valid.
        assert!(!proof_private(user,"S-1-5-32-544")?);
        assert!(proof_private(user,user)?);
        assert!(proof_private(user,user)?);
        assert!(!proof_private(user,"S-1-5-18")?);
        assert!(proof_private(user,"S-1-5-21-1011").is_err());
        assert!(proof_private("",user).is_err());
        Ok(())
    }
    #[test]
    fn proof_choice_preserves_foreign_write_and_exact_active_grant_refusals()->Result<()> {
        let user="S-1-5-21-1002";let private=proof_private(user,user)?;
        grant(private,user,user,0x10000000)?;
        assert!(grant(private,user,"foreign",0x40000000).is_err());
        assert!(grant(private,user,"foreign",0x00040000).is_err());
        assert!(grant(false,user,user,0x10000000).is_err(),"active system class still forbids human write grants");
        assert!(!proof_private(user,"S-1-5-18")?);
        proof_grant(user,user,0x10000000)?; // also valid with OS-owned proof metadata.
        proof_grant(user,"S-1-5-18",0x10000000)?;
        assert!(proof_grant(user,"foreign",0x10000000).is_err());
        assert!(proof_grant(user,"foreign",0x40000).is_err());
        Ok(())
    }

}
