{
  "type": "object",
  "properties": {
    "view": {
      "enum": [
        "projects",
        "indexes",
        "sources"
      ]
    },
    "project_id": {
      "type": "string",
      "pattern": "^prj_[0-9a-f]{32}$"
    },
    "index_id": {
      "type": "string",
      "pattern": "^idx_[0-9a-f]{32}$"
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "max_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65536
    }
  },
  "required": [
    "view"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://airk.local/design/v190/scope-discovery.schema.json",
  "title": "scope-discovery.schema.json",
  "x-airk-activation-phase": "P6 native/grants; P7 public query_scope",
  "description": "P3 design contract; not an advertised runtime capability before its phase gate.",
  "allOf": [
    {
      "if": {
        "properties": {
          "view": {
            "const": "projects"
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "project_id"
              ]
            },
            {
              "required": [
                "index_id"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "view": {
            "const": "indexes"
          }
        }
      },
      "then": {
        "required": [
          "project_id"
        ],
        "not": {
          "required": [
            "index_id"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "view": {
            "const": "sources"
          }
        }
      },
      "then": {
        "required": [
          "project_id",
          "index_id"
        ]
      }
    }
  ]
}
