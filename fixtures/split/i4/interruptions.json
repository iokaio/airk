{
 "schema": "airk.split-fixture.i4-interruptions/1",
 "contract": "docs/split/contracts.md section 5.6; crates/airk-cli/src/setup_role/CONTRACT.md",
 "note": "Reviewed expectations, written by hand from the setup contract, not derived from the code: for an operation kind, its options, the run mode and the phases its receipt already records, the actions setup runs next. lock always runs; a drain is re-observed until the step after it (placed, or login_unregistered for removals) is durable; the legacy trust retirement (local trust plan C: remove an HTTPS build's owned CA and TLS files) runs after the login step and before the start for placing kinds, and where the trust removal used to run for removals.",
 "options": {
  "default": {"login_startup": true, "start": true, "delete_indexes": "keep"},
  "minimal": {"login_startup": false, "start": false, "delete_indexes": "keep"},
  "purge": {"login_startup": true, "start": true, "delete_indexes": "purge"},
  "ask": {"login_startup": true, "start": true, "delete_indexes": "ask"}
 },
 "cases": [
  {"name": "fresh install, installer preflight", "kind": "install", "options": "default", "mode": "prepare", "recorded": [],
   "expect": ["lock", "retire_predecessors", "drain"]},
  {"name": "install after its preflight: the drain is re-observed before placement is verified", "kind": "install", "options": "default", "mode": "complete",
   "recorded": ["locked", "predecessors_retired", "service_drained"],
   "expect": ["lock", "drain", "verify_placement", "write_record", "write_pointer", "register_login", "retire_legacy_trust", "start", "close"]},
  {"name": "single-step install with nothing recorded", "kind": "install", "options": "default", "mode": "complete", "recorded": [],
   "expect": ["lock", "retire_predecessors", "drain", "verify_placement", "write_record", "write_pointer", "register_login", "retire_legacy_trust", "start", "close"]},
  {"name": "interrupted after the record: resume writes the pointer", "kind": "install", "options": "default", "mode": "complete",
   "recorded": ["locked", "predecessors_retired", "service_drained", "placed", "record_written"],
   "expect": ["lock", "write_pointer", "register_login", "retire_legacy_trust", "start", "close"]},
  {"name": "interrupted after the pointer: retirement is never repeated", "kind": "upgrade", "options": "default", "mode": "complete",
   "recorded": ["locked", "predecessors_retired", "service_drained", "placed", "record_written", "pointer_written"],
   "expect": ["lock", "register_login", "retire_legacy_trust", "start", "close"]},
  {"name": "a failed login is recorded and not retried; a start without health is retried", "kind": "repair", "options": "default", "mode": "complete",
   "recorded": ["locked", "predecessors_retired", "service_drained", "placed", "record_written", "pointer_written", "login_failed", "legacy_trust_retired", "started"],
   "expect": ["lock", "start", "close"]},
  {"name": "unsupported login counts as recorded", "kind": "install", "options": "default", "mode": "complete",
   "recorded": ["locked", "predecessors_retired", "service_drained", "placed", "record_written", "pointer_written", "login_unsupported", "legacy_trust_retired", "started", "healthy"],
   "expect": ["lock", "close"]},
  {"name": "no login, no start: the legacy trust retirement still runs", "kind": "install", "options": "minimal", "mode": "complete", "recorded": [],
   "expect": ["lock", "retire_predecessors", "drain", "verify_placement", "write_record", "write_pointer", "retire_legacy_trust", "close"]},
  {"name": "interrupted after the legacy trust retirement: the start remains", "kind": "upgrade", "options": "default", "mode": "complete",
   "recorded": ["locked", "predecessors_retired", "service_drained", "placed", "record_written", "pointer_written", "login_registered", "legacy_trust_retired"],
   "expect": ["lock", "start", "close"]},
  {"name": "uninstall keeps index data", "kind": "uninstall", "options": "default", "mode": "complete", "recorded": [],
   "expect": ["lock", "drain", "unregister_login", "retire_legacy_trust", "remove_pointer", "remove_record", "close"]},
  {"name": "uninstall with an unresolved ask keeps index data", "kind": "uninstall", "options": "ask", "mode": "complete", "recorded": [],
   "expect": ["lock", "drain", "unregister_login", "retire_legacy_trust", "remove_pointer", "remove_record", "close"]},
  {"name": "uninstall with explicit purge", "kind": "uninstall", "options": "purge", "mode": "complete", "recorded": [],
   "expect": ["lock", "drain", "unregister_login", "retire_legacy_trust", "remove_pointer", "remove_record", "purge_data", "close"]},
  {"name": "the purge kind purges whatever delete_indexes says", "kind": "purge", "options": "default", "mode": "complete", "recorded": [],
   "expect": ["lock", "drain", "unregister_login", "retire_legacy_trust", "remove_pointer", "remove_record", "purge_data", "close"]},
  {"name": "uninstall interrupted after the pointer: no second drain", "kind": "uninstall", "options": "default", "mode": "complete",
   "recorded": ["locked", "service_drained", "login_unregistered", "legacy_trust_retired", "pointer_removed"],
   "expect": ["lock", "remove_record", "close"]},
  {"name": "uninstall interrupted after its drain: the drain is re-observed", "kind": "uninstall", "options": "default", "mode": "complete",
   "recorded": ["locked", "service_drained"],
   "expect": ["lock", "drain", "unregister_login", "retire_legacy_trust", "remove_pointer", "remove_record", "close"]},
  {"name": "removals have no preflight", "kind": "uninstall", "options": "default", "mode": "prepare", "recorded": [],
   "refused": "setup_prepare_not_applicable"}
 ]
}
