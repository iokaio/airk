{
 "schema": "airk-golden-cases/1",
 "note": "Seeded from the one-process golden capture (30 offline cases), then extended in P0.3 with --help for every command path in docs/cli-reference.md, tools help for every tool listed by `tools list --json`, and offline explorer/tools calls. Live-service cases are captured separately (P0.3b).",
 "normalize": [
  {
   "why": "digest of the absolute fixture install path",
   "pattern": "\"expected_predecessor\":\"[0-9a-f]{64}\"",
   "replacement": "\"expected_predecessor\":\"<PATH-DIGEST>\""
  },
  {
   "why": "digest of the absolute fixture source/data binding",
   "pattern": "\"binding\":\"[0-9a-f]{64}\"",
   "replacement": "\"binding\":\"<PATH-DIGEST>\""
  },
  {
   "why": "Windows executable suffix in usage and guidance text",
   "pattern": "\\bairk\\.exe\\b",
   "replacement": "airk"
  }
 ],
